---
import "../styles/global.css";

interface Props {
    title: string;
    section?: "tests" | "questions" | "dashboard";
}
const { title, section = "dashboard" } = Astro.props;
const fullTitle = `${title} — Admin | Brinto MockTest`;

const nav = [
    { href: "/admin", label: "Dashboard", icon: "⊞", key: "dashboard" },
    { href: "/admin/tests", label: "Tests", icon: "📋", key: "tests" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="robots" content="noindex,nofollow" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            :root {
                --brand: #b00020;
                --brand-dark: #7b0015;
                --brand-light: #fff0f2;
                --brand-mid: #f5c6ce;
                --gold: #d4830f;
                --gold-light: #fef3e2;
                --green: #1b6b3a;
                --green-light: #e8f5ee;
                --bg: #f4f2ee;
                --surface: #ffffff;
                --surface-2: #f0ede8;
                --surface-3: #e8e4dd;
                --ink: #1a1410;
                --ink-soft: #5c5248;
                --ink-muted: #9c9189;
                --rule: #e0d9ce;
                --sidebar-w: 220px;
                --font-body: "Inter", -apple-system, sans-serif;
                --r-sm: 8px;
                --r-md: 12px;
                --r-lg: 16px;
                --r-pill: 999px;
            }
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }
            html,
            body {
                height: 100%;
                margin: 0;
            }
            body {
                font-family: var(--font-body);
                font-size: 15px;
                background: var(--bg);
                color: var(--ink);
                display: grid;
                grid-template-columns: var(--sidebar-w) 1fr;
                grid-template-rows: auto 1fr;
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }
            a {
                color: inherit;
                text-decoration: none;
            }
            button {
                cursor: pointer;
                font-family: inherit;
            }
            h1,
            h2,
            h3,
            h4 {
                margin: 0;
                font-weight: 700;
                line-height: 1.2;
            }
            p {
                margin: 0;
            }
            input,
            textarea,
            select {
                font-family: var(--font-body);
                font-size: 0.9rem;
                border: 1.5px solid var(--rule);
                border-radius: var(--r-sm);
                background: #fff;
                color: var(--ink);
                width: 100%;
                padding: 9px 12px;
                outline: none;
                transition:
                    border-color 0.15s,
                    box-shadow 0.15s;
            }
            input:focus,
            textarea:focus,
            select:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 3px rgba(176, 0, 32, 0.08);
            }
            textarea {
                resize: vertical;
            }

            /* ── SIDEBAR ── */
            .sidebar {
                grid-column: 1;
                grid-row: 1/3;
                background: var(--ink);
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
                overflow-y: auto;
            }
            .sb-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 20px 16px 18px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            }
            .sb-logo {
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: var(--brand);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
            .sb-brand-text .sb-name {
                font-size: 0.95rem;
                font-weight: 700;
                color: #fff;
            }
            .sb-brand-text .sb-tag {
                font-size: 0.62rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: rgba(255, 255, 255, 0.4);
            }
            .sb-nav {
                padding: 12px 10px;
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }
            .sb-label {
                font-size: 0.62rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: rgba(255, 255, 255, 0.3);
                padding: 8px 8px 4px;
            }
            .sb-link {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 10px;
                border-radius: var(--r-sm);
                font-size: 0.88rem;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.55);
                transition:
                    background 0.12s,
                    color 0.12s;
            }
            .sb-link:hover {
                background: rgba(255, 255, 255, 0.07);
                color: #fff;
            }
            .sb-link.active {
                background: rgba(176, 0, 32, 0.4);
                color: #fff;
                font-weight: 700;
            }
            .sb-link-icon {
                font-size: 1rem;
                flex-shrink: 0;
            }
            .sb-footer {
                padding: 14px 16px;
                border-top: 1px solid rgba(255, 255, 255, 0.08);
            }
            .sb-footer a {
                font-size: 0.8rem;
                color: rgba(255, 255, 255, 0.4);
                display: flex;
                align-items: center;
                gap: 6px;
            }
            .sb-footer a:hover {
                color: rgba(255, 255, 255, 0.7);
            }

            /* ── TOP BAR ── */
            .topbar {
                grid-column: 2;
                grid-row: 1;
                background: #fff;
                border-bottom: 1px solid var(--rule);
                padding: 0 28px;
                height: 56px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 10;
            }
            .topbar h1 {
                font-size: 1rem;
                font-weight: 700;
                color: var(--ink);
            }
            .tb-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            /* ── MAIN ── */
            .admin-main {
                grid-column: 2;
                grid-row: 2;
                padding: 28px;
                overflow-y: auto;
            }

            /* ── BUTTONS ── */
            .btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 9px 18px;
                border-radius: var(--r-pill);
                font-size: 0.86rem;
                font-weight: 700;
                border: none;
                cursor: pointer;
                white-space: nowrap;
                transition:
                    background 0.15s,
                    transform 0.1s,
                    opacity 0.15s;
            }
            .btn:hover {
                transform: translateY(-1px);
            }
            .btn:active {
                transform: translateY(0);
            }
            .btn-primary {
                background: var(--brand);
                color: #fff;
            }
            .btn-primary:hover {
                background: var(--brand-dark);
            }
            .btn-secondary {
                background: var(--surface-2);
                color: var(--ink);
                border: 1.5px solid var(--rule);
            }
            .btn-secondary:hover {
                background: var(--surface-3);
            }
            .btn-danger {
                background: #fee2e2;
                color: #991b1b;
                border: 1.5px solid #fecaca;
            }
            .btn-danger:hover {
                background: #fca5a5;
            }
            .btn-sm {
                padding: 6px 13px;
                font-size: 0.78rem;
            }
            .btn-ghost {
                background: none;
                border: 1.5px solid var(--rule);
                color: var(--ink-soft);
            }
            .btn-ghost:hover {
                border-color: var(--ink-soft);
                color: var(--ink);
            }

            /* ── CARDS ── */
            .card {
                background: #fff;
                border: 1px solid var(--rule);
                border-radius: var(--r-lg);
                padding: 24px;
            }
            .card + .card {
                margin-top: 20px;
            }
            .card-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
            }
            .card-title {
                font-size: 0.92rem;
                font-weight: 700;
                color: var(--ink);
            }
            .card-sub {
                font-size: 0.8rem;
                color: var(--ink-muted);
                margin-top: 2px;
            }

            /* ── FORM ── */
            .form-grid {
                display: grid;
                gap: 16px;
            }
            .form-grid-2 {
                grid-template-columns: 1fr 1fr;
            }
            .form-grid-3 {
                grid-template-columns: 1fr 1fr 1fr;
            }
            .form-group {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }
            .form-label {
                font-size: 0.78rem;
                font-weight: 700;
                color: var(--ink-soft);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            .form-hint {
                font-size: 0.74rem;
                color: var(--ink-muted);
                margin-top: 3px;
            }
            .form-divider {
                border: none;
                border-top: 1px solid var(--rule);
                margin: 4px 0;
            }
            .required {
                color: var(--brand);
            }

            /* ── ALERTS ── */
            .alert {
                padding: 12px 16px;
                border-radius: var(--r-sm);
                font-size: 0.86rem;
                font-weight: 500;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .alert-success {
                background: var(--green-light);
                color: var(--green);
                border: 1px solid #a7d7b8;
            }
            .alert-error {
                background: var(--brand-light);
                color: var(--brand);
                border: 1px solid var(--brand-mid);
            }

            /* ── TABLE ── */
            .data-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 0.88rem;
            }
            .data-table th {
                background: var(--surface-2);
                padding: 10px 14px;
                text-align: left;
                font-size: 0.7rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--ink-muted);
                border-bottom: 2px solid var(--rule);
            }
            .data-table td {
                padding: 13px 14px;
                border-bottom: 1px solid var(--rule);
                color: var(--ink);
                vertical-align: middle;
            }
            .data-table tr:last-child td {
                border-bottom: none;
            }
            .data-table tr:hover td {
                background: var(--surface-2);
            }

            /* ── BADGES ── */
            .badge {
                display: inline-flex;
                align-items: center;
                font-size: 0.68rem;
                font-weight: 700;
                padding: 3px 9px;
                border-radius: var(--r-pill);
                text-transform: uppercase;
                letter-spacing: 0.03em;
            }
            .badge-easy {
                background: #dcfce7;
                color: #166534;
            }
            .badge-medium {
                background: var(--gold-light);
                color: var(--gold);
            }
            .badge-hard {
                background: var(--brand-light);
                color: var(--brand);
            }
            .badge-free {
                background: #eff6ff;
                color: #1d4ed8;
            }
            .badge-new {
                background: var(--green-light);
                color: var(--green);
            }
            .badge-exam {
                background: var(--brand-light);
                color: var(--brand);
                border: 1px solid var(--brand-mid);
            }

            /* ── OPTION ROWS ── */
            .option-row {
                display: grid;
                grid-template-columns: 32px 1fr auto;
                align-items: center;
                gap: 10px;
            }
            .opt-letter {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--surface-2);
                border: 1.5px solid var(--rule);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.82rem;
                font-weight: 800;
                color: var(--ink-soft);
                flex-shrink: 0;
            }
            .correct-radio {
                display: flex;
                align-items: center;
                gap: 6px;
                white-space: nowrap;
            }
            .correct-radio input[type="radio"] {
                accent-color: var(--brand);
                width: 16px;
                height: 16px;
            }
            .correct-radio label {
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--ink-soft);
                cursor: pointer;
            }

            /* ── QUESTION CARD ── */
            .q-card {
                background: #fff;
                border: 1px solid var(--rule);
                border-radius: var(--r-md);
                overflow: hidden;
                margin-bottom: 10px;
            }
            .q-card-header {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                padding: 14px 16px;
                cursor: pointer;
                border-bottom: 1px solid transparent;
            }
            .q-card-header:hover {
                background: var(--surface-2);
            }
            .q-card.open .q-card-header {
                border-bottom-color: var(--rule);
            }
            .q-num {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: var(--surface-2);
                border: 1.5px solid var(--rule);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.75rem;
                font-weight: 800;
                color: var(--ink-muted);
                flex-shrink: 0;
                margin-top: 1px;
            }
            .q-card-text {
                flex: 1;
                font-size: 0.9rem;
                color: var(--ink);
                font-weight: 500;
                line-height: 1.5;
            }
            .q-section-tag {
                font-size: 0.65rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--brand);
                background: var(--brand-light);
                padding: 3px 8px;
                border-radius: var(--r-pill);
                border: 1px solid var(--brand-mid);
                flex-shrink: 0;
            }
            .q-chevron {
                color: var(--ink-muted);
                flex-shrink: 0;
                transition: transform 0.2s;
            }
            .q-card.open .q-chevron {
                transform: rotate(180deg);
            }
            .q-card-body {
                display: none;
                padding: 14px 16px;
            }
            .q-card.open .q-card-body {
                display: block;
            }
            .q-options {
                display: flex;
                flex-direction: column;
                gap: 6px;
                margin-bottom: 12px;
            }
            .q-opt {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 12px;
                border-radius: var(--r-sm);
                font-size: 0.86rem;
                border: 1px solid var(--rule);
                background: var(--surface-2);
                color: var(--ink-soft);
            }
            .q-opt.correct {
                background: var(--green-light);
                border-color: #a7d7b8;
                color: var(--green);
                font-weight: 700;
            }
            .q-opt-key {
                font-weight: 800;
                flex-shrink: 0;
                width: 20px;
            }
            .q-explanation {
                background: var(--gold-light);
                border: 1px solid #f6d8a0;
                border-radius: var(--r-sm);
                padding: 10px 12px;
                font-size: 0.82rem;
                color: var(--ink-soft);
                line-height: 1.6;
                margin-bottom: 12px;
            }
            .q-explanation strong {
                color: var(--ink);
            }
            .q-actions {
                display: flex;
                gap: 8px;
            }

            /* ── EMPTY ── */
            .empty-state {
                text-align: center;
                padding: 48px 24px;
                color: var(--ink-muted);
            }
            .empty-state .empty-icon {
                font-size: 2.5rem;
                margin-bottom: 12px;
            }
            .empty-state p {
                font-size: 0.9rem;
            }

            /* ── STATS STRIP ── */
            .stats-strip {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 14px;
                margin-bottom: 24px;
            }
            .stat-box {
                background: #fff;
                border: 1px solid var(--rule);
                border-radius: var(--r-md);
                padding: 16px 18px;
            }
            .stat-box .sn {
                font-size: 1.6rem;
                font-weight: 800;
                line-height: 1;
                margin-bottom: 4px;
            }
            .stat-box .sl {
                font-size: 0.72rem;
                color: var(--ink-muted);
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            @media (max-width: 768px) {
                body {
                    grid-template-columns: 1fr;
                    grid-template-rows: 56px auto 1fr;
                }
                .sidebar {
                    grid-column: 1;
                    grid-row: 1;
                    height: 56px;
                    flex-direction: row;
                    overflow-x: auto;
                }
                .sb-brand {
                    padding: 12px;
                    border-bottom: none;
                    border-right: 1px solid rgba(255, 255, 255, 0.08);
                }
                .sb-nav {
                    flex-direction: row;
                    padding: 8px;
                    gap: 4px;
                }
                .sb-label {
                    display: none;
                }
                .sb-footer {
                    display: none;
                }
                .topbar {
                    grid-column: 1;
                    grid-row: 2;
                }
                .admin-main {
                    grid-column: 1;
                    grid-row: 3;
                    padding: 16px;
                }
                .form-grid-2,
                .form-grid-3 {
                    grid-template-columns: 1fr;
                }
                .stats-strip {
                    grid-template-columns: 1fr 1fr;
                }
            }
        </style>
    </head>
    <body>
        <!-- ── SIDEBAR ── -->
        <aside class="sidebar">
            <div class="sb-brand">
                <div class="sb-logo">
                    <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
                        <path
                            d="M8 9h10a5 5 0 0 1 0 10H8V9Z"
                            fill="#fff"
                            opacity=".9"></path>
                        <path d="M8 19h12a5 5 0 0 1 0 10H8V19Z" fill="#fff"
                        ></path>
                    </svg>
                </div>
                <div class="sb-brand-text">
                    <div class="sb-name">Brinto</div>
                    <div class="sb-tag">Admin Panel</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-label">Menu</div>
                {
                    nav.map((n) => (
                        <a
                            href={n.href}
                            class={`sb-link${section === n.key ? " active" : ""}`}
                        >
                            <span class="sb-link-icon">{n.icon}</span>
                            {n.label}
                        </a>
                    ))
                }
            </nav>
            <div class="sb-footer">
                <a href="/" target="_blank">
                    <svg
                        width="14"
                        height="14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        ><path
                            d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                        ></path><polyline points="15 3 21 3 21 9"
                        ></polyline><line x1="10" y1="14" x2="21" y2="3"
                        ></line></svg
                    >
                    View Site
                </a>
            </div>
        </aside>

        <!-- ── TOPBAR ── -->
        <div class="topbar">
            <h1>{title}</h1>
            <div class="tb-actions">
                <slot name="topbar-actions" />
            </div>
        </div>

        <!-- ── MAIN ── -->
        <main class="admin-main">
            <slot />
        </main>

        <script is:inline>
            // Toggle question expand/collapse
            document.addEventListener("click", function (e) {
                const header = e.target.closest(".q-card-header");
                if (header) {
                    header.closest(".q-card").classList.toggle("open");
                }
            });
        </script>
    </body>
</html>
