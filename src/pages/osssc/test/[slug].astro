---
export const prerender = false;
import ComboExamUI from "../../../components/ComboExamUI.astro";
import { fetchTestDetails } from "../../../lib/api";

const { slug = "11" } = Astro.params;
const testId = !slug || slug === "combo" ? "11" : slug;

let testDetails = null;
if (testId) {
  testDetails = await fetchTestDetails(testId);
}
---

<ComboExamUI slug={testId} test={testDetails || undefined} />

