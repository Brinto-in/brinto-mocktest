---
export const prerender = false;
import ComboExamUI from "../../../components/ComboExamUI.astro";
import { fetchTestDetails } from "../../../lib/api";

const { slug } = Astro.params;
if (!slug || slug === "combo") {
  return new Response("Test ID or slug is required", { status: 400 });
}

let testDetails = null;
try {
  testDetails = await fetchTestDetails(slug);
} catch (err) {
  console.warn("Server-side fetchTestDetails failed for OSSSC test, falling back to client-side loading:", err);
}
---

<ComboExamUI slug={slug} test={testDetails || undefined} />
