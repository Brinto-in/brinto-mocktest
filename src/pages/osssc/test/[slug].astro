---
export const prerender = false;
import ComboExamUI from "../../../components/ComboExamUI.astro";
import { fetchTestDetails } from "../../../lib/api";

const { slug } = Astro.params;
if (!slug || slug === "combo") {
  return new Response("Test ID or slug is required", { status: 400 });
}

const testDetails = await fetchTestDetails(slug);
if (!testDetails) {
  return new Response("Test not found", { status: 404 });
}
---

<ComboExamUI slug={slug} test={testDetails} />
