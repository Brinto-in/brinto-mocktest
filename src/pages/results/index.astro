---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PerformanceChart from "../../components/result/PerformanceChart.astro";
---

<BaseLayout
    title="My Results"
    description="Track your mock test performance, scores, and progress across all exams."
>
    <!-- ── HERO ── -->
    <section class="results-hero">
        <div class="wrap rh-inner">
            <div class="rh-text">
                <p class="rh-eyebrow">Your Performance</p>
                <h1>My Results</h1>
                <p class="rh-sub">
                    All your past test attempts and scores in one place.
                </p>
            </div>
            <div class="rh-stats" id="rh-stats">
                <div class="stat-card">
                    <span class="stat-n" id="st-total">0</span>
                    <span class="stat-l" id="st-total-l">Tests Taken</span>
                </div>
                <div class="stat-card">
                    <span class="stat-n" id="st-avg">0%</span>
                    <span class="stat-l" id="st-avg-l">Avg Score</span>
                </div>
                <div class="stat-card">
                    <span class="stat-n" id="st-best">0%</span>
                    <span class="stat-l" id="st-best-l">Best Score</span>
                </div>
                <div class="stat-card">
                    <span class="stat-n" id="st-time">0h</span>
                    <span class="stat-l" id="st-time-l">Time Spent</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── MCQ / TYPING SWITCH ── -->
    <div class="wrap rt-switch-wrap">
        <div class="rt-switch" role="tablist" aria-label="Result type">
            <button type="button" class="rt-tab active" role="tab" data-view="mcq" aria-selected="true" aria-controls="view-mcq">
                <span aria-hidden="true">📝</span> MCQ tests
            </button>
            <button type="button" class="rt-tab" role="tab" data-view="typing" aria-selected="false" aria-controls="view-typing">
                <span aria-hidden="true">⌨️</span> Typing tests
            </button>
        </div>
    </div>

    <div id="view-mcq" role="tabpanel">
    <!-- ── PERFORMANCE CHART ── -->
    <div class="wrap perf-wrap">
        <PerformanceChart id="perf-chart" />
    </div>

    <!-- ── FILTERS ── -->
    <div class="wrap filter-bar" id="filter-bar">
        <div class="filter-tabs" id="filter-tabs">
            <button class="ft active" data-exam="All">All</button>
        </div>
        <div class="sort-wrap">
            <label for="sort-sel">Sort:</label>
            <select id="sort-sel">
                <option value="newest">Newest First</option>
                <option value="best">Best Score</option>
                <option value="worst">Lowest Score</option>
            </select>
        </div>
    </div>

    <!-- ── RESULTS LIST ── -->
    <div class="wrap results-body">
        <!-- Empty state -->
        <div class="empty-state" id="empty-state" style="display:none">
            <div class="empty-icon-wrap">
                <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </div>
            <h2>No test attempts yet</h2>
            <p>You haven't attempted any mock tests yet. Take your first test to track your scores, analytics, and solutions here.</p>
            <a href="/mocktest/tests" class="btn-browse">Explore Mock Tests →</a>
        </div>

        <!-- Results grid (populated by JS) -->
        <div class="results-grid" id="results-grid"></div>
    </div>
    </div>

    <!-- ── TYPING VIEW ── -->
    <div id="view-typing" role="tabpanel" hidden>
        <div class="wrap perf-wrap">
            <PerformanceChart
                id="typing-chart"
                title="Typing speed trend"
                trendTitle="Speed per passage"
                donutTitle="Words breakdown"
                bands={["40+ WPM", "25–39", "<25"]}
            />
        </div>

        <div class="wrap results-body">
            <div class="tr-loading" id="typing-loading" hidden>
                <div class="am-spinner"></div>
                <p>Loading typing results…</p>
            </div>

            <div class="empty-state" id="typing-empty" style="display:none">
                <div class="empty-icon-wrap" aria-hidden="true">⌨️</div>
                <h2>No typing tests yet</h2>
                <p>Take a typing test to track your speed (WPM), accuracy and progress here.</p>
                <a href="/mocktest/tests/osssc-typing" class="btn-browse">Start a Typing Test →</a>
            </div>

            <div class="results-grid" id="typing-grid"></div>
        </div>
    </div>

    <!-- ── ATTEMPT ANALYSIS MODAL ── -->
    <div class="am-overlay" id="am-overlay" role="dialog" aria-modal="true" style="display:none">
        <div class="am-modal">
            <div class="am-header">
                <div class="am-header-left">
                    <span class="rc-exam-tag" id="am-exam">EXAM</span>
                    <h2 class="am-title" id="am-title">Attempt Analysis</h2>
                    <p class="am-meta" id="am-meta">Submitted on —</p>
                </div>
                <button class="am-close-btn" id="am-close-btn" aria-label="Close modal">✕</button>
            </div>

            <!-- Stats Strip -->
            <div class="am-stats-strip">
                <div class="am-stat-box">
                    <span class="am-sb-val" id="am-val-score">0%</span>
                    <span class="am-sb-lbl">Score</span>
                </div>
                <div class="am-stat-box">
                    <span class="am-sb-val text-green" id="am-val-correct">0</span>
                    <span class="am-sb-lbl">Correct</span>
                </div>
                <div class="am-stat-box">
                    <span class="am-sb-val text-red" id="am-val-wrong">0</span>
                    <span class="am-sb-lbl">Wrong</span>
                </div>
                <div class="am-stat-box">
                    <span class="am-sb-val text-muted" id="am-val-skip">0</span>
                    <span class="am-sb-lbl">Skipped</span>
                </div>
                <div class="am-stat-box">
                    <span class="am-sb-val" id="am-val-time">0m</span>
                    <span class="am-sb-lbl">Time</span>
                </div>
            </div>

            <!-- Question Filter Tabs -->
            <div class="am-q-filters">
                <span style="font-size:0.75rem;font-weight:600;color:var(--ink-muted);">Filter:</span>
                <button class="am-qf-btn active" data-qfilter="all" id="am-qf-all">All (<span id="am-cnt-all">0</span>)</button>
                <button class="am-qf-btn" data-qfilter="correct" id="am-qf-correct">Correct (<span id="am-cnt-correct">0</span>)</button>
                <button class="am-qf-btn" data-qfilter="wrong" id="am-qf-wrong">Incorrect (<span id="am-cnt-wrong">0</span>)</button>
                <button class="am-qf-btn" data-qfilter="skipped" id="am-qf-skipped">Skipped (<span id="am-cnt-skipped">0</span>)</button>
            </div>

            <!-- Modal Body / Questions List -->
            <div class="am-body">
                <div class="am-loading" id="am-loading" style="display:none">
                    <div class="am-spinner"></div>
                    <p>Loading attempt analysis...</p>
                </div>
                <div class="am-questions" id="am-questions"></div>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    import { renderPerformanceChart, renderTypingChart, WPM_TARGET } from "../../components/result/performanceChart";

    let allResults = [];
    const perfChartEl = document.getElementById("perf-chart");
    let activeExam = "All";

    const emptyEl = document.getElementById("empty-state");
    const gridEl = document.getElementById("results-grid");
    const statsEl = document.getElementById("rh-stats");
    const filterBar = document.getElementById("filter-bar");

    // Modal elements
    const amOverlay = document.getElementById("am-overlay");
    const amCloseBtn = document.getElementById("am-close-btn");
    const amLoading = document.getElementById("am-loading");
    const amQuestionsContainer = document.getElementById("am-questions");

    let currentAttemptDetails = null;
    let currentQFilter = "all";

    if (amCloseBtn) {
        amCloseBtn.addEventListener("click", closeAnalysisModal);
    }
    if (amOverlay) {
        amOverlay.addEventListener("click", (e) => {
            if (e.target === amOverlay) closeAnalysisModal();
        });
    }

    function closeAnalysisModal() {
        if (amOverlay) amOverlay.style.display = "none";
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";
    }

    window.openAttemptModal = async function(attemptId) {
        if (!amOverlay) return;
        amOverlay.style.display = "flex";
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        amLoading.style.display = "flex";
        amQuestionsContainer.innerHTML = "";

        try {
            const token = localStorage.getItem("brinto_token") || "";
            const guestId = localStorage.getItem("brinto_guest_id") || "";

            const res = await fetch(`https://brintoapi.brinto.in/api/mocktests/my-attempts/${attemptId}`, {
                headers: {
                    "Accept": "*/*",
                    "X-Guest-Id": guestId,
                    "Authorization": token ? `Bearer ${token}` : ""
                }
            });

            const json = await res.json();
            if (json?.success && json?.data) {
                currentAttemptDetails = json.data;
                renderAttemptDetailsModal(json.data);
            } else {
                amQuestionsContainer.innerHTML = `<p class="am-error">Unable to load details for this attempt.</p>`;
            }
        } catch (e) {
            console.error("Error loading attempt details:", e);
            amQuestionsContainer.innerHTML = `<p class="am-error">Failed to connect to server. Please try again.</p>`;
        } finally {
            amLoading.style.display = "none";
        }
    };

    function renderAttemptDetailsModal(d) {
        const totalQs = d.totalQuestions || (d.questions ? d.questions.length : 0) || 1;
        const correctCount = d.correct || 0;
        const wrongCount = d.wrong || 0;
        const skippedCount = d.skipped || 0;
        const pct = Math.min(100, Math.max(0, Math.round((correctCount / totalQs) * 100)));
        const date = d.submittedAt ? new Date(d.submittedAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "—";
        const timeTakenStr = d.timeTaken ? `${Math.floor(d.timeTaken / 60)}m ${d.timeTaken % 60}s` : "—";

        document.getElementById("am-exam").textContent = d.exam || "EXAM";
        document.getElementById("am-title").textContent = d.title || "Attempt Analysis";
        document.getElementById("am-meta").textContent = `Submitted on ${date} • Duration: ${timeTakenStr}`;

        document.getElementById("am-val-score").textContent = `${pct}%`;
        document.getElementById("am-val-correct").textContent = correctCount;
        document.getElementById("am-val-wrong").textContent = wrongCount;
        document.getElementById("am-val-skip").textContent = skippedCount;
        document.getElementById("am-val-time").textContent = timeTakenStr;

        const questionsList = d.questions || [];
        document.getElementById("am-cnt-all").textContent = questionsList.length;
        document.getElementById("am-cnt-correct").textContent = questionsList.filter(q => q.isCorrect).length;
        document.getElementById("am-cnt-wrong").textContent = questionsList.filter(q => !q.isCorrect && !q.isSkipped).length;
        document.getElementById("am-cnt-skipped").textContent = questionsList.filter(q => q.isSkipped).length;

        currentQFilter = "all";
        setupQuestionFilterButtons();
        renderQuestionList();
    }

    function setupQuestionFilterButtons() {
        const btns = document.querySelectorAll(".am-qf-btn");
        btns.forEach(b => {
            b.classList.toggle("active", b.dataset.qfilter === currentQFilter);
            b.onclick = () => {
                currentQFilter = b.dataset.qfilter;
                btns.forEach(btn => btn.classList.remove("active"));
                b.classList.add("active");
                renderQuestionList();
            };
        });
    }

    function renderQuestionList() {
        if (!currentAttemptDetails || !Array.isArray(currentAttemptDetails.questions)) return;

        let qList = currentAttemptDetails.questions;
        if (currentQFilter === "correct") qList = qList.filter(q => q.isCorrect);
        else if (currentQFilter === "wrong") qList = qList.filter(q => !q.isCorrect && !q.isSkipped);
        else if (currentQFilter === "skipped") qList = qList.filter(q => q.isSkipped);

        if (qList.length === 0) {
            amQuestionsContainer.innerHTML = `<div class="am-empty-q">No questions match this filter.</div>`;
            return;
        }

        amQuestionsContainer.innerHTML = qList.map((q, idx) => {
            const statusClass = q.isCorrect ? "q-status-correct" : (q.isSkipped ? "q-status-skipped" : "q-status-wrong");
            const statusLabel = q.isCorrect ? "✓ Correct" : (q.isSkipped ? "⊘ Skipped" : "✕ Incorrect");

            const optionsHtml = (q.options || []).map((opt) => {
                let optClass = "am-opt";
                let badge = "";
                if (opt.isCorrect) {
                    optClass += " opt-correct";
                    badge = `<span class="opt-badge badge-correct">✓ Correct Answer</span>`;
                } else if (opt.isSelected) {
                    optClass += " opt-wrong";
                    badge = `<span class="opt-badge badge-wrong">✕ Your Choice</span>`;
                }

                return `
                    <div class="${optClass}">
                        <div class="opt-text">${opt.text}</div>
                        ${badge}
                    </div>
                `;
            }).join("");

            return `
                <div class="am-q-card">
                    <div class="am-q-top">
                        <div class="am-q-meta">
                            <span class="am-q-num">Q${q.questionNumber || (idx + 1)}</span>
                            <span class="am-q-sec">${q.section || "General"}</span>
                        </div>
                        <span class="am-q-badge ${statusClass}">${statusLabel}</span>
                    </div>
                    <div class="am-q-text">${q.text}</div>
                    <div class="am-q-options">
                        ${optionsHtml}
                    </div>
                </div>
            `;
        }).join("");
    }

    function formatAttempt(r) {
        const totalQs = r.totalQuestions || r.total_questions || ((r.correct || 0) + (r.wrong || 0) + (r.skipped || 0)) || 1;
        const correctCount = r.correct || 0;
        const pct = Math.min(100, Math.max(0, Math.round((correctCount / totalQs) * 100)));

        return {
            id: r.id || r.attemptId || `att-${Math.random()}`,
            slug: r.slug || r.testId || "11",
            exam: r.exam || "Exam",
            title: r.title || "Mock Test Attempt",
            score: pct,
            correct: correctCount,
            wrong: r.wrong || 0,
            skipped: r.skipped || 0,
            totalQuestions: totalQs,
            timeTaken: r.timeTaken || r.time_taken || 0,
            submittedAt: r.submittedAt || r.created_at || new Date().toISOString(),
            sections: Array.isArray(r.sections) ? r.sections : []
        };
    }

    function updateUI(results) {
        if (!results || results.length === 0) {
            emptyEl.style.display = "flex";
            gridEl.style.display = "none";
            if (perfChartEl) renderPerformanceChart(perfChartEl, []);
            statsEl.style.display = "none";
            filterBar.style.display = "none";
        } else {
            emptyEl.style.display = "none";
            gridEl.style.display = "grid";
            statsEl.style.display = "grid";
            filterBar.style.display = "flex";
            renderStats(results);
            renderFilterTabs(results);
            renderResults(results);
            if (perfChartEl) renderPerformanceChart(perfChartEl, results);
        }
    }

    // Initial render with fallback dummy data
    updateUI(allResults);

    // Fetch dynamic attempts from API
    async function loadDynamicAttempts() {
        try {
            const token = localStorage.getItem("brinto_token") || "";
            const guestId = localStorage.getItem("brinto_guest_id") || "";

            const headers = {
                "Accept": "*/*",
                "X-Guest-Id": guestId,
            };
            if (token) {
                headers["Authorization"] = `Bearer ${token}`;
            }

            const res = await fetch("https://brintoapi.brinto.in/api/mocktests/my-attempts?page=1&limit=10&section=true", {
                headers
            });

            if (!res.ok) return;

            const json = await res.json();
            if (json?.success && Array.isArray(json?.data) && json.data.length > 0) {
                allResults = json.data.map(formatAttempt);
                activeExam = "All";
                // Don't overwrite the typing view if the user is on it
                if (!document.getElementById("view-mcq").hidden) updateUI(allResults);
            }
        } catch (err) {
            console.warn("Failed to fetch dynamic attempts:", err);
        }
    }

    loadDynamicAttempts();

    // ── MCQ / TYPING SWITCH ──
    const viewMcq = document.getElementById("view-mcq");
    const viewTyping = document.getElementById("view-typing");
    const typingChartEl = document.getElementById("typing-chart");
    const tabs = document.querySelectorAll(".rt-tab");
    let typingResults = null; // loaded on first open

    function setStatLabels(labels) {
        ["st-total-l", "st-avg-l", "st-best-l", "st-time-l"].forEach((id, i) => {
            document.getElementById(id).textContent = labels[i];
        });
    }

    function showView(view, push = true) {
        const isTyping = view === "typing";
        tabs.forEach((t) => {
            const on = t.dataset.view === view;
            t.classList.toggle("active", on);
            t.setAttribute("aria-selected", on ? "true" : "false");
        });
        viewMcq.hidden = isTyping;
        viewTyping.hidden = !isTyping;

        if (push) {
            const url = new URL(location.href);
            if (isTyping) url.searchParams.set("type", "typing");
            else url.searchParams.delete("type");
            history.pushState({ view }, "", url);
        }

        if (isTyping) {
            if (typingResults) renderTypingView(typingResults);
            else loadTypingResults();
        } else {
            setStatLabels(["Tests Taken", "Avg Score", "Best Score", "Time Spent"]);
            updateUI(allResults);
        }
    }

    tabs.forEach((t) => t.addEventListener("click", () => showView(t.dataset.view)));
    window.addEventListener("popstate", () => {
        showView(new URL(location.href).searchParams.get("type") === "typing" ? "typing" : "mcq", false);
    });
    if (new URL(location.href).searchParams.get("type") === "typing") showView("typing", false);

    // ── TYPING RESULTS ──
    // API dates look like "2026-10-23 05:32:21" (UTC, no zone)
    const toIso = (s) => (s && !s.endsWith("Z") ? s.replace(" ", "T") + "Z" : s);

    async function loadTypingResults() {
        const loading = document.getElementById("typing-loading");
        loading.hidden = false;
        try {
            const token = localStorage.getItem("brinto_token") || "";
            const guestId = localStorage.getItem("brinto_guest_id") || "";
            const headers = { Accept: "*/*", "X-Guest-Id": guestId };
            if (token) headers["Authorization"] = `Bearer ${token}`;

            const res = await fetch("https://brintoapi.brinto.in/api/mocktest-passages/results", { headers });
            const json = res.ok ? await res.json() : null;
            typingResults = (json?.success && Array.isArray(json.data) ? json.data : []).map((r) => ({
                id: r.id,
                session: r.session_id,
                passageNumber: r.passage_number,
                wpm: Number(r.wpm) || 0,
                typedWords: r.typed_word_count || 0,
                totalWords: r.total_word_count || 0,
                errors: r.error_count || 0,
                backspaces: r.backspace_count || 0,
                keystrokes: r.keystrokes_count || 0,
                date: toIso(r.created_at),
            }));
        } catch (err) {
            console.warn("Failed to fetch typing results:", err);
            typingResults = [];
        } finally {
            loading.hidden = true;
        }
        if (!viewTyping.hidden) renderTypingView(typingResults);
    }

    function renderTypingView(results) {
        // Passages that were opened but never typed don't count towards speed/stats
        const attempted = results.filter((r) => r.typedWords > 0);
        const emptyEl = document.getElementById("typing-empty");
        const grid = document.getElementById("typing-grid");

        setStatLabels(["Sessions", "Avg WPM", "Best WPM", "Words Typed"]);
        if (!results.length) {
            emptyEl.style.display = "flex";
            grid.innerHTML = "";
            statsEl.style.display = "none";
            renderTypingChart(typingChartEl, []);
            return;
        }
        emptyEl.style.display = "none";
        statsEl.style.display = "grid";

        const sessions = new Set(results.map((r) => r.session)).size;
        const avg = attempted.length ? attempted.reduce((s, r) => s + r.wpm, 0) / attempted.length : 0;
        const best = attempted.length ? Math.max(...attempted.map((r) => r.wpm)) : 0;
        const words = attempted.reduce((s, r) => s + r.typedWords, 0);
        document.getElementById("st-total").textContent = sessions;
        document.getElementById("st-avg").textContent = Math.round(avg * 10) / 10;
        document.getElementById("st-best").textContent = best;
        document.getElementById("st-time").textContent = words.toLocaleString("en-IN");

        renderTypingChart(typingChartEl, attempted);
        renderTypingSessions(results);
    }

    function wpmClass(w) {
        return w >= WPM_TARGET ? "rank-good" : w >= 25 ? "rank-avg" : "rank-low";
    }

    function renderTypingSessions(results) {
        // Group passages by session, newest session first
        const bySession = new Map();
        results.forEach((r) => {
            if (!bySession.has(r.session)) bySession.set(r.session, []);
            bySession.get(r.session).push(r);
        });
        const sessions = [...bySession.values()]
            .map((rows) => rows.sort((a, b) => a.passageNumber - b.passageNumber))
            .sort((a, b) => Math.max(...b.map((r) => +new Date(r.date))) - Math.max(...a.map((r) => +new Date(r.date))));

        const grid = document.getElementById("typing-grid");
        grid.innerHTML = sessions.map((rows) => {
            const started = rows.filter((r) => r.typedWords > 0);
            const avg = started.length ? Math.round((started.reduce((s, r) => s + r.wpm, 0) / started.length) * 10) / 10 : 0;
            const date = new Date(Math.min(...rows.map((r) => +new Date(r.date)))).toLocaleString("en-IN", {
                day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit",
            });
            const passages = rows.map((r) => {
                const pct = r.totalWords ? Math.round((r.typedWords / r.totalWords) * 100) : 0;
                if (!r.typedWords) {
                    return `
            <div class="tr-passage is-empty">
              <div class="tr-p-head"><span class="tr-p-name">Passage ${r.passageNumber}</span><span class="tr-p-status">Not started</span></div>
            </div>`;
                }
                return `
            <div class="tr-passage">
              <div class="tr-p-head">
                <span class="tr-p-name">Passage ${r.passageNumber}</span>
                <span class="tr-p-wpm ${wpmClass(r.wpm)}">${r.wpm} WPM</span>
              </div>
              <div class="sec-bar-track"><div class="sec-bar-fill" style="width:${pct}%;background:var(--brand)"></div></div>
              <div class="tr-p-meta">
                <span>${r.typedWords}/${r.totalWords} words · ${pct}%</span>
                <span>${r.errors} errors · ${r.backspaces} ⌫</span>
              </div>
            </div>`;
            }).join("");
            return `
        <div class="result-card">
          <div class="rc-top">
            <div class="rc-left">
              <span class="rc-exam-tag">Typing</span>
              <h3 class="rc-title">Typing test session</h3>
              <div class="rc-meta"><span class="rc-date">${date}</span><span>${rows.length} ${rows.length === 1 ? "passage" : "passages"}</span></div>
            </div>
            <div class="tr-avg">
              <span class="tr-avg-v">${started.length ? avg : "–"}</span>
              <span class="tr-avg-l">avg WPM</span>
            </div>
          </div>
          <div class="tr-passages">${passages}</div>
          <div class="rc-footer">
            ${started.length
                ? `<span class="rc-rank ${wpmClass(avg)}">${avg >= WPM_TARGET ? "🏆 Target reached" : avg >= 25 ? "📈 Getting there" : "📉 Keep practising"}</span>`
                : `<span class="rc-rank tr-rank-none">Not started</span>`}
            <div class="rc-actions">
              <a href="/mocktest/tests/osssc-typing" class="rc-retake">Practise again →</a>
            </div>
          </div>
        </div>`;
        }).join("");
    }

    // ── STATS ──
    function renderStats(results) {
        const total = results.length;
        const avg = Math.round(
            results.reduce((s, r) => s + r.score, 0) / total,
        );
        const best = Math.max(...results.map((r) => r.score));
        const totalSecs = results.reduce((s, r) => s + (r.timeTaken || 0), 0);
        const hrs = Math.floor(totalSecs / 3600);
        const mins = Math.floor((totalSecs % 3600) / 60);

        document.getElementById("st-total").textContent = total;
        document.getElementById("st-avg").textContent = avg + "%";
        document.getElementById("st-best").textContent = best + "%";
        document.getElementById("st-time").textContent =
            hrs > 0 ? `${hrs}h ${mins}m` : `${mins}m`;
    }

    // ── FILTER TABS ──
    function renderFilterTabs(results) {
        const exams = ["All", ...new Set(results.map((r) => r.exam))];
        const container = document.getElementById("filter-tabs");
        container.innerHTML = "";
        exams.forEach((ex) => {
            const btn = document.createElement("button");
            btn.className = "ft" + (ex === activeExam ? " active" : "");
            btn.dataset.exam = ex;
            btn.textContent = ex;
            if (ex !== "All") {
                const count = results.filter((r) => r.exam === ex).length;
                btn.textContent += ` (${count})`;
            }
            btn.addEventListener("click", () => {
                activeExam = ex;
                document
                    .querySelectorAll(".ft")
                    .forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                applyFilters();
            });
            container.appendChild(btn);
        });
    }

    // ── SORT + FILTER ──
    function applyFilters() {
        const sort = document.getElementById("sort-sel").value;
        let filtered =
            activeExam === "All"
                ? [...allResults]
                : allResults.filter((r) => r.exam === activeExam);
        if (sort === "best") filtered.sort((a, b) => b.score - a.score);
        if (sort === "worst") filtered.sort((a, b) => a.score - b.score);
        renderResults(filtered);
        // Chart follows the exam filter (it always plots oldest → newest)
        if (perfChartEl) renderPerformanceChart(perfChartEl, filtered);
    }

    document
        .getElementById("sort-sel")
        .addEventListener("change", applyFilters);

    // ── SCORE COLOUR ──
    function scoreColor(pct) {
        if (pct >= 70)
            return { stroke: "#166534", bg: "#DCFCE7", text: "#166534" };
        if (pct >= 40)
            return { stroke: "#D4830F", bg: "#FEF3E2", text: "#D4830F" };
        return { stroke: "#B00020", bg: "#FFF0F2", text: "#B00020" };
    }

    // ── RENDER RESULTS ──
    function renderResults(results) {
        const grid = document.getElementById("results-grid");
        grid.innerHTML = "";

        results.forEach((r) => {
            const col = scoreColor(r.score);
            const circ = 2 * Math.PI * 28; // r=28
            const offset = circ - (circ * r.score) / 100;
            const date = new Date(r.submittedAt).toLocaleDateString("en-IN", {
                day: "numeric",
                month: "short",
                year: "numeric",
            });
            const timeTakenStr = r.timeTaken
                ? `${Math.floor(r.timeTaken / 60)}m ${r.timeTaken % 60}s`
                : "—";

            // Section bars
            const sectionBars = (r.sections || [])
                .map((sec) => {
                    const pct = Math.round((sec.correct / sec.total) * 100);
                    const c = scoreColor(pct);
                    return `
        <div class="sec-bar-row">
          <span class="sec-bar-label">${sec.name}</span>
          <div class="sec-bar-track">
            <div class="sec-bar-fill" style="width:${pct}%;background:${c.stroke}"></div>
          </div>
          <span class="sec-bar-pct" style="color:${c.text}">${pct}%</span>
        </div>`;
                })
                .join("");

            const card = document.createElement("div");
            card.className = "result-card";
            card.innerHTML = `
      <div class="rc-top">
        <div class="rc-left">
          <span class="rc-exam-tag">${r.exam}</span>
          <h3 class="rc-title">${r.title}</h3>
          <div class="rc-meta">
            <span class="rc-date">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              ${date}
            </span>
            <span class="rc-time">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${timeTakenStr}
            </span>
          </div>
        </div>
        <div class="rc-score-ring">
          <svg width="72" height="72" viewBox="0 0 72 72">
            <circle cx="36" cy="36" r="28" fill="none" stroke="#E4DDD0" stroke-width="6"/>
            <circle cx="36" cy="36" r="28" fill="none"
              stroke="${col.stroke}" stroke-width="6"
              stroke-dasharray="${circ.toFixed(2)}"
              stroke-dashoffset="${offset.toFixed(2)}"
              stroke-linecap="round"
              transform="rotate(-90 36 36)"/>
          </svg>
          <span class="rc-score-pct" style="color:${col.text}">${r.score}%</span>
        </div>
      </div>

      <div class="rc-breakdown">
        <div class="bd-item bd-correct">
          <span class="bd-n">${r.correct}</span>
          <span class="bd-l">Correct</span>
        </div>
        <div class="bd-item bd-wrong">
          <span class="bd-n">${r.wrong}</span>
          <span class="bd-l">Wrong</span>
        </div>
        <div class="bd-item bd-skip">
          <span class="bd-n">${r.skipped}</span>
          <span class="bd-l">Skipped</span>
        </div>
        <div class="bd-item bd-total">
          <span class="bd-n">${r.totalQuestions}</span>
          <span class="bd-l">Total Qs</span>
        </div>
      </div>

      ${sectionBars ? `<div class="rc-sections">${sectionBars}</div>` : ""}

      <div class="rc-footer">
        <span class="rc-rank ${r.score >= 70 ? "rank-good" : r.score >= 40 ? "rank-avg" : "rank-low"}">
          ${r.score >= 70 ? "🏆 Excellent" : r.score >= 40 ? "📈 Average" : "📉 Needs Practice"}
        </span>
        <div class="rc-actions">
          <button class="rc-btn-details" onclick="openAttemptModal('${r.id}')">View Analysis →</button>
          <a href="/mocktest/test/${r.slug}" class="rc-retake">Retake →</a>
        </div>
      </div>
    `;
            grid.appendChild(card);
        });
    }
</script>

