---
export const prerender = false;
import ExamUI from "../../components/ExamUI.astro";
import type { Test } from "../../lib/types";

const { slug } = Astro.params;

const test: Test = {
  id: slug || "11",
  title: "Online Mock Test",
  exam: "Competitive Exam",
  questions: 20,
  duration: 30,
  difficulty: "Medium",
  attempts: 0,
  rating: 5,
  href: `/mocktest/test/${slug || "11"}`,
  isNew: true,
  isFree: true,
};

const questionsData: any[] = [];

const title = `${test.title} - Free Online Mock Test & Practice Questions`;
const description = `Take the free online mock test for ${test.title} (${test.exam}). Practice ${test.questions} questions in ${test.duration} mins with instant scoring, detailed solutions, and all-India rank analysis.`;
---

<ExamUI test={test} questionsData={questionsData} />
