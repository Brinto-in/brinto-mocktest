---
export const prerender = false;
import ExamUI from "../../components/ExamUI.astro";
import { fetchTestDetails } from "../../lib/api/mockTestService";

const { slug } = Astro.params;

let testDetails = null;
if (slug) {
  try {
    testDetails = await fetchTestDetails(slug);
  } catch (err) {
    console.warn("Server-side fetchTestDetails failed, falling back to client-side loading:", err);
  }
}
---

<ExamUI slug={slug} test={testDetails || undefined} />
