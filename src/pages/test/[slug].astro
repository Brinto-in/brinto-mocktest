---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExamUI from "../../components/ExamUI.astro";
import type { Test } from "../../lib/types";

const { slug } = Astro.params;

let test: Test | null = null;
let questionsData: any[] = [];

try {
  const res = await fetch(`https://outsource.brinto.in/api/test/${slug}`);
  const json = await res.json();

  if (json?.success && json?.data) {
    test = json.data.test as Test;
    questionsData = json.data.questions || [];
  }
} catch (err) {
  console.error("Error fetching test from outsource API:", err);
}

if (!test) {
  return Astro.redirect("/404");
}

const title = `${test.title} - Free Online Mock Test & Practice Questions`;
const description = `Take the free online mock test for ${test.title} (${test.exam}). Practice ${test.questions} questions in ${test.duration} mins with instant scoring, detailed solutions, and all-India rank analysis.`;
---

<BaseLayout title={title} description={description}>
  <ExamUI test={test} questionsData={questionsData} />
</BaseLayout>
