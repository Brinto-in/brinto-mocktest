---
export const prerender = false;
import ExamUI from "../../components/ExamUI.astro";
import type { Test } from "../../lib/types";

const { slug } = Astro.params;

let test: Test | null = null;
let questionsData: any[] = [];

try {
  const res = await fetch(`https://outsource.brinto.in/api/test/${slug}`);
  const json = await res.json();

  if (json?.success && json?.data) {
    test = json.data.test as Test;
    questionsData = json.data.questions || [];
  }
} catch (err) {
  console.error("Error fetching test from outsource API:", err);
}

if (!test) {
  return Astro.redirect("/404");
}
---

<ExamUI test={test} questionsData={questionsData} />
