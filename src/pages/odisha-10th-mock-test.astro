        <div class="hsc-modal-body hsc-mode-modal-body" style="padding: 20px 24px; display: flex; flex-direction: column; gap: 14px;">
          <p style="color: var(--ink-soft); font-size: 0.9rem; margin: 0; line-height: 1.4;">
            Choose whether to attempt the full subject test or practice a specific chapter for <strong id="mode-subject-name" style="color: var(--ink);">Subject</strong>:
          </p>

          <!-- Option 1: Full Test -->
