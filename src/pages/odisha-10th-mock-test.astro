---
// src/pages/odisha-10th-mock-test.astro
// Dedicated comprehensive mock test & syllabus portal for BSE Odisha Class 10 (HSC Matriculation)
import BaseLayout from '../layouts/BaseLayout.astro';
import { ODISHA_10TH_SUBJECTS, ODISHA_10TH_ACTIVE } from '../lib/odisha/hsc/10/subjects';
import {
  ODISHA_10TH_QUESTIONS,
  EXAM_PATTERN_DETAILS,
  OMR_TIPS,
  FAQS_ODISHA_10TH,
} from '../data/odisha10thData';

const canonicalPath = '/mocktest/odisha-10th-mock-test';

// Poster paths come from the subject/chapter data; add the site base here.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const poster = (path?: string) => (path ? `${base}${path}` : '');
// A question belongs to a chapter when its topic and the chapter's topicKey overlap
// (tags are sometimes shorter than chapter titles, so check both directions).
const topicMatch = (topic: string | undefined, key: string) =>
  !!topic && (topic.includes(key) || key.includes(topic));
const questionsFor = (subjectId: string, key?: string) =>
  ODISHA_10TH_QUESTIONS.filter((q) => q.subjectId === subjectId && (!key || topicMatch(q.topic, key)));
const paceMinutes = (count: number) => Math.max(5, Math.ceil(count * 0.9));

// Live tests with their real question counts (topic tests use only matching questions).
// Time follows the board pace of 45 min for 50 MCQs, with a 5-minute minimum.
const activeTests = ODISHA_10TH_ACTIVE.map((t) => {
  const subject = ODISHA_10TH_SUBJECTS.find((s) => s.id === t.subjectId);
  // Linked tests use the numbers given in the data; in-page tests count local questions
  const count = t.href ? (t.questions ?? 0) : questionsFor(t.subjectId, t.topicKey).length;
  const minutes = t.href ? (t.minutes ?? 0) : paceMinutes(count);
  return { ...t, subject, count, minutes };
}).filter((t) => t.subject && (t.href || t.count > 0));
const firstActive = activeTests[0];
// Removes a missing poster so the gradient + icon underneath shows instead
const IMG_FALLBACK = 'this.remove()';
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImage = new URL('/logo.png', Astro.site).toString();

const pageTitle = 'BSE Odisha 10th HSC Mock Test 2026-2027 | All Subjects Free Practice';
const pageDescription =
  'Free BSE Odisha Class 10th Matriculation online mock tests for all 6 subjects: Mathematics, Science, Social Science, Odia, English, Sanskrit & Hindi. 50-mark OMR pattern, chapter-wise MCQs, instant result & detailed Odia solutions.';

// Schema.org structured data
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_ODISHA_10TH.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.brinto.in/' },
    { '@type': 'ListItem', position: 2, name: 'Mock Tests', item: 'https://www.brinto.in/mocktest/' },
    { '@type': 'ListItem', position: 3, name: 'BSE Odisha 10th HSC Mock Test', item: canonicalUrl },
  ],
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: ['en-IN', 'or-IN'],
  publisher: {
    '@type': 'Organization',
    name: 'Brinto',
    url: 'https://www.brinto.in',
    logo: ogImage,
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  <meta slot="head" property="og:image" content={ogImage} />
  <meta slot="head" name="twitter:title" content={pageTitle} />
  <meta slot="head" name="twitter:description" content={pageDescription} />
  <meta slot="head" name="twitter:image" content={ogImage} />

  <div class="hsc-page">
    <!-- ── 1. HERO SECTION ────────────────────────────────── -->
    <section class="hsc-hero" aria-labelledby="hero-title">
      <div class="wrap">
        <nav class="hsc-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/mocktest/">Home</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/mocktest/tests">Mock Tests</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">BSE Odisha 10th HSC</li>
          </ol>
        </nav>

        <div class="hsc-hero-content">
          <div class="hsc-pill">
            <span class="hsc-pill-dot"></span>
            🎓 BSE ODISHA CLASS 10TH (MATRIC) EXAM 2026–2027
          </div>

          <h1 id="hero-title">
            BSE Odisha 10th HSC Mock Test <br />
            <span class="hsc-highlight">All Subjects Free Practice</span>
          </h1>

          <p class="hsc-hero-sub-odia">
            ଦଶମ ଶ୍ରେଣୀ ମାଟ୍ରିକ ବୋର୍ଡ ପରୀକ୍ଷା: ସମସ୍ତ ୬ଟି ବିଷୟର ଅଧ୍ୟାୟ ଭିତ୍ତିକ OMR ବସ୍ତୁନିଷ୍ଠ ପ୍ରଶ୍ନୋତ୍ତର ଓ ମକ୍ ଟେଷ୍ଟ।
          </p>

          <p class="hsc-hero-desc">
            Practice strictly on the latest Board of Secondary Education (BSE), Odisha pattern — featuring 50 Objective MCQs,
            zero negative marking, instant score calculation, and bilingual explanations in Odia and English.
          </p>

          <div class="hsc-hero-tags" aria-label="Key Exam Features">
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 50 Marks OMR Pattern</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> All 6 Compulsory Subjects</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 0 Negative Marking</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Instant Odia & English Explanations</span>
            <span class="hsc-badge hsc-badge-free">100% Free Practice</span>
          </div>

          <div class="hsc-hero-actions">
            {firstActive ? (
              <a href="#active-tests" class="hsc-btn hsc-btn-primary" id="btn-start-grand-test">
                Start Free Chapter Test 🚀
              </a>
            ) : (
              <span class="hsc-btn hsc-btn-primary is-disabled" aria-disabled="true">Grand Mock Test – Coming Soon</span>
            )}
            <a href="#subjects-section" class="hsc-btn hsc-btn-secondary">
              Browse All 6 Subjects ↓
            </a>
          </div>
        </div>

        <!-- Metric Ribbon -->
        <div class="hsc-metrics-ribbon">
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">6</div>
            <div class="hsc-metric-lbl">Core Subjects</div>
            <div class="hsc-metric-sub">FLO, SLE, MTH, GSC, SSC, TLS</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">50</div>
            <div class="hsc-metric-lbl">OMR MCQs / Paper</div>
            <div class="hsc-metric-sub">50% Objective Weightage</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">0</div>
            <div class="hsc-metric-lbl">Negative Marks</div>
            <div class="hsc-metric-sub">Full Attempt Allowed</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">600</div>
            <div class="hsc-metric-lbl">Total Aggregate</div>
            <div class="hsc-metric-sub">100 Marks Each Subject</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2. SUBJECTS SHOWCASE SECTION ───────────────────── -->
    <section class="hsc-section" id="subjects-section" aria-labelledby="subjects-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📚 COMPULSORY CURRICULUM</span>
            <h2 id="subjects-title">Select a Subject to Practice</h2>
            <p>
              Full subject mock tests and chapter-wise tests are coming soon. Start with the free chapter test available now, or open any subject's syllabus.
            </p>
          </div>
          <div class="hsc-header-right">
            <span class="hsc-quick-all-btn is-disabled" id="btn-quick-grand" aria-disabled="true">
              ⚡ Combined Grand Test · Coming soon
            </span>
          </div>
        </div>

        <!-- Available now: live topic tests -->
        {activeTests.length > 0 && (
          <div class="sx-subject sx-active" id="active-tests" aria-labelledby="sx-active-title">
            <header class="sx-head">
              <div class="sx-head-text">
                <h3 id="sx-active-title" class="sx-title">
                  <span class="sx-live-dot" aria-hidden="true"></span>
                  Available now
                </h3>
                <p class="sx-meta">Free chapter tests you can take today · more subjects coming soon</p>
              </div>
            </header>
            <ul class="sx-row">
              {activeTests.map((t) => {
                const Tag = t.href ? 'a' : 'button';
                const stats = [
                  t.count ? `${t.count} ${t.count === 1 ? 'MCQ' : 'MCQs'}` : '',
                  t.minutes ? `${t.minutes} min` : '',
                  'Free',
                ].filter(Boolean).join(' · ');
                return (
                <li>
                  <Tag
                    type={t.href ? undefined : 'button'}
                    href={t.href}
                    class="sx-card sx-main"
                    style={`--accent:${t.subject!.accentColor};`}
                    data-start-topic={t.href ? undefined : t.subjectId}
                    data-topic-key={t.href ? undefined : t.topicKey}
                    data-topic-title={t.href ? undefined : `${t.subtitle}: ${t.title} (${t.titleEn})`}
                    data-minutes={t.href ? undefined : t.minutes}
                    aria-label={`${t.subtitle} chapter test: ${t.title} (${t.titleEn}) – ${stats}`}
                  >
                    <span class="sx-fallback" aria-hidden="true">{t.subject!.icon}</span>
                    {t.poster && (
                      <img class="sx-img" src={poster(t.poster)} alt="" loading="lazy" decoding="async" onerror={IMG_FALLBACK} />
                    )}
                    <span class="sx-badge sx-badge-live">● LIVE</span>
                    <span class="sx-overlay">
                      <span class="sx-kicker">{t.subtitle} · Chapter test</span>
                      <span class="sx-name">{t.title} ({t.titleEn})</span>
                      <span class="sx-info">{t.href && !t.count ? `${stats} · Start test →` : stats}</span>
                    </span>
                  </Tag>
                </li>
                );
              })}
            </ul>
          </div>
        )}

        <!-- Subject Filter Pills -->
        <div class="hsc-filter-tabs" role="tablist" aria-label="Subject filter tabs">
          <button class="hsc-filter-tab active" data-filter="all" role="tab" aria-selected="true">
            All Subjects ({ODISHA_10TH_SUBJECTS.length})
          </button>
          {ODISHA_10TH_SUBJECTS.map((s) => (
            <button class="hsc-filter-tab" data-filter={s.id} role="tab" aria-selected="false">
              <span>{s.icon}</span> {s.nameOdia}
            </button>
          ))}
        </div>

        <!-- Subject rows: full mock poster + chapter mock tests -->
        <div class="sx-rows" id="subjects-grid">
          {ODISHA_10TH_SUBJECTS.map((s) => {
            const subjectCount = questionsFor(s.id).length;
            const subjectSoon = s.comingSoon || subjectCount === 0;
            const units = (s.chapters.length > 1 ? s.chapters : []).map((u) => {
              const count = u.topicKey ? questionsFor(s.id, u.topicKey).length : subjectCount;
              return { ...u, count, soon: u.comingSoon || count === 0 };
            });
            return (
              <article
                class="sx-subject hsc-subject-row"
                data-subject-id={s.id}
                id={`subject-${s.id}`}
                style={`--accent:${s.accentColor};`}
                aria-labelledby={`sx-title-${s.id}`}
              >
                <header class="sx-head">
                  <div class="sx-head-text">
                    <h3 id={`sx-title-${s.id}`} class="sx-title">
                      <span class="sx-title-icon" aria-hidden="true">{s.icon}</span>
                      {s.nameOdia}
                    </h3>
                    <p class="sx-meta">
                      {s.code} · {s.paperType}
                      {units.length > 0 && <> · {units.length} chapter tests</>}
                    </p>
                  </div>
                  <div class="sx-head-right">
                    <a href={`#blueprint-${s.id}`} class="sx-syllabus">Syllabus</a>
                    <div class="sx-nav" aria-hidden="true">
                      <button type="button" class="sx-arrow" data-dir="-1" tabindex="-1">‹</button>
                      <button type="button" class="sx-arrow" data-dir="1" tabindex="-1">›</button>
                    </div>
                  </div>
                </header>

                <ul class="sx-row">
                  <!-- Main subject: full mock test -->
                  <li>
                    <button
                      type="button"
                      class={`sx-card sx-main ${subjectSoon ? 'is-soon' : ''}`}
                      data-start-test={subjectSoon ? undefined : s.id}
                      data-minutes={subjectSoon ? undefined : paceMinutes(subjectCount)}
                      disabled={subjectSoon}
                      aria-label={subjectSoon
                        ? `${s.name} full mock test – coming soon`
                        : `${s.name} full mock test – ${subjectCount} questions, ${paceMinutes(subjectCount)} minutes`}
                    >
                      <span class="sx-fallback" aria-hidden="true">{s.icon}</span>
                      {s.poster && (
                        <img class="sx-img" src={poster(s.poster)} alt="" loading="lazy" decoding="async" onerror={IMG_FALLBACK} />
                      )}
                      <span class="sx-badge">FULL TEST</span>
                      {subjectSoon
                        ? <span class="sx-badge sx-badge-pop sx-badge-soon">COMING SOON</span>
                        : s.isPopular && <span class="sx-badge sx-badge-pop">★ POPULAR</span>}
                      <span class="sx-overlay">
                        <span class="sx-kicker">{s.code} · Full mock</span>
                        <span class="sx-name">{s.name}</span>
                        <span class="sx-info">
                          {subjectSoon
                            ? 'Full mock test coming soon'
                            : `${subjectCount} ${subjectCount === 1 ? 'MCQ' : 'MCQs'} · ${paceMinutes(subjectCount)} min · Free`}
                        </span>
                      </span>
                    </button>
                  </li>

                  <!-- Chapter mock tests -->
                  {units.map((u, i) => {
                    const img = poster(u.poster);
                    return (
                      <li>
                        <button
                          type="button"
                          class={`sx-card ${img ? 'sx-chapter-img' : 'sx-chapter'} ${u.soon ? 'is-soon' : ''}`}
                          data-start-test={u.soon ? undefined : s.id}
                          data-chapter={u.soon ? undefined : i}
                          data-minutes={u.soon ? undefined : paceMinutes(u.count)}
                          disabled={u.soon}
                          aria-label={`${s.name} chapter test: ${u.unit} – ${u.soon ? 'coming soon' : `${u.count} ${u.count === 1 ? 'question' : 'questions'}`}`}
                        >
                          {img ? (
                            <>
                              <span class="sx-fallback" aria-hidden="true">{s.icon}</span>
                              <img class="sx-img" src={img} alt="" loading="lazy" decoding="async" onerror={IMG_FALLBACK} />
                              <span class="sx-badge sx-badge-ch">CHAPTER {String(i + 1).padStart(2, '0')}</span>
                              {u.soon && <span class="sx-badge sx-badge-pop sx-badge-soon">SOON</span>}
                              <span class="sx-overlay">
                                <span class="sx-kicker">{u.weightageMarks ? `${u.weightageMarks} marks · ` : ''}{u.topics.length} topics</span>
                                <span class="sx-name">{u.unitOdia}</span>
                                <span class="sx-info">{u.soon ? 'Coming soon' : 'Chapter practice →'}</span>
                              </span>
                            </>
                          ) : (
                            <>
                              <span class="sx-ch-top">
                                <span class="sx-ch-num">{String(i + 1).padStart(2, '0')}</span>
                                <span class="sx-ch-marks">
                                  {u.soon ? 'Soon' : `${u.count} ${u.count === 1 ? 'MCQ' : 'MCQs'}`}
                                </span>
                              </span>
                              <span class="sx-ch-label">Chapter test</span>
                              <span class="sx-ch-title">{u.unitOdia}</span>
                              {u.topicKey && u.unit !== u.unitOdia && <span class="sx-ch-en">{u.unit}</span>}
                              <span class="sx-ch-topics">
                                {u.topics.slice(0, 3).map((t) => <span>{t}</span>)}
                                {u.topics.length > 3 && <span class="sx-ch-more">+{u.topics.length - 3} more topics</span>}
                              </span>
                              <span class="sx-ch-cta">{u.soon ? 'Coming soon' : 'Practice →'}</span>
                            </>
                          )}
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── 3. EXAM PATTERN & MARKING SCHEME ───────────────── -->
    <section class="hsc-section hsc-section-alt" id="pattern-section" aria-labelledby="pattern-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📋 BSE ODISHA BLUEPRINT</span>
            <h2 id="pattern-title">Class 10th HSC Exam Pattern & Marks Distribution</h2>
            <p>
              Under the latest BSE Odisha scheme, every core subject has a 100-mark paper divided equally into 50 marks OMR Objective and 50 marks Subjective.
            </p>
          </div>
        </div>

        <div class="hsc-table-wrapper">
          <table class="hsc-pattern-table">
            <thead>
              <tr>
                <th scope="col">Paper / Code</th>
                <th scope="col">Subject Name (ବିଷୟ)</th>
                <th scope="col">OMR Objective</th>
                <th scope="col">Subjective</th>
                <th scope="col">Total Marks</th>
                <th scope="col">Time Limit</th>
                <th scope="col">Pass Marks</th>
              </tr>
            </thead>
            <tbody>
              {ODISHA_10TH_SUBJECTS.map((s, idx) => (
                <tr>
                  <td>
                    <div class="hsc-table-code">
                      <span class="hsc-code-badge">{s.code}</span>
                      <small>Paper {idx + 1}</small>
                    </div>
                  </td>
                  <td>
                    <strong>{s.name}</strong>
                    <div class="hsc-odia-sm">{s.nameOdia}</div>
                  </td>
                  <td>
                    <span class="hsc-mark-highlight">50 MCQs (50 Marks)</span>
                  </td>
                  <td>50 Marks</td>
                  <td>
                    <strong>100 Marks</strong>
                  </td>
                  <td>{s.id === 'math' ? '2h 45m (Extra 15m)' : '2h 30m'}</td>
                  <td>
                    <span class="hsc-pass-tag">30 Marks</span>
                  </td>
                </tr>
              ))}
              <tr class="hsc-table-total-row">
                <td colspan="2"><strong>Total (6 Compulsory Subjects)</strong></td>
                <td><strong>300 MCQs</strong></td>
                <td><strong>300 Marks</strong></td>
                <td><strong class="hsc-total-marks">600 Marks</strong></td>
                <td>--</td>
                <td><strong>198 Marks (33%)</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Division Criteria Slabs -->
        <div class="hsc-division-cards">
          <div class="hsc-div-card hsc-div-first">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥇</span>
              <div>
                <h4>First Division (A1 & A2)</h4>
                <p>360 Marks & Above (60%+)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Grade A1 requires 90%+, Grade A2 requires 80%–89%.</div>
          </div>
          <div class="hsc-div-card hsc-div-second">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥈</span>
              <div>
                <h4>Second Division (B1 & B2)</h4>
                <p>270 to 359 Marks (45%–59%)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Grade B1 requires 70%–79%, Grade B2 requires 60%–69%.</div>
          </div>
          <div class="hsc-div-card hsc-div-third">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥉</span>
              <div>
                <h4>Third Division (C & D)</h4>
                <p>198 to 269 Marks (33%–44%)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Minimum aggregate required to receive passing certificate.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 4. COMPLETE CHAPTER BLUEPRINT & SYLLABUS ACCORDION ─ -->
    <section class="hsc-section" id="blueprint-section" aria-labelledby="blueprint-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📖 UNIT-WISE CHAPTERS</span>
            <h2 id="blueprint-title">Detailed Subject-Wise Syllabus & Blueprints</h2>
            <p>
              Explore the exact units, chapter topics, and question weightage prescribed by the Board of Secondary Education, Odisha.
            </p>
          </div>
        </div>

        <div class="hsc-accordion-group">
          {ODISHA_10TH_SUBJECTS.map((s) => (
            <details class="hsc-details-card" id={`blueprint-${s.id}`} name="blueprint-acc">
              <summary class="hsc-details-summary">
                <div class="hsc-summary-left">
                  <span class="hsc-summary-icon">{s.icon}</span>
                  <div>
                    <h3 class="hsc-summary-title">
                      {s.name} – {s.nameOdia} ({s.code})
                    </h3>
                    <p class="hsc-summary-sub">{s.chapters.length} Units • 50 Marks MCQ • {s.subStreams.join(', ')}</p>
                  </div>
                </div>
                <span class="hsc-details-arrow" aria-hidden="true">+</span>
              </summary>

              <div class="hsc-details-content">
                <div class="hsc-units-grid">
                  {s.chapters.map((unit) => (
                    <div class="hsc-unit-box">
                      <div class="hsc-unit-head">
                        <div>
                          <h4>{unit.unit}</h4>
                          <span class="hsc-unit-odia">{unit.unitOdia}</span>
                        </div>
                        {unit.weightageMarks && <span class="hsc-weightage-badge">{unit.weightageMarks} Marks</span>}
                      </div>
                      <ul class="hsc-unit-topics">
                        {unit.topics.map((t) => (
                          <li>
                            <span class="hsc-bullet"></span>
                            <span>{t}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                <div class="hsc-details-cta">
                  <span>Ready to test your knowledge in {s.name}?</span>
                  {s.comingSoon || questionsFor(s.id).length === 0 ? (
                    <span class="hsc-btn hsc-btn-primary hsc-btn-sm is-disabled" aria-disabled="true">
                      {s.name} Mock Test · Coming soon
                    </span>
                  ) : (
                    <button
                      type="button"
                      class="hsc-btn hsc-btn-primary hsc-btn-sm"
                      data-subject={s.id}
                    >
                      Start {s.name} Mock Test 🎯
                    </button>
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 5. OMR SHEET FILLING TIPS & STRATEGY ───────────── -->
    <section class="hsc-section hsc-section-alt" id="omr-tips-section" aria-labelledby="omr-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">✍️ OMR EXAM MASTERY</span>
