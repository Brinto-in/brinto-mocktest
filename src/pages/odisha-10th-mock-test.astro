    white-space: nowrap;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .hsc-quick-all-btn:hover {
    background: var(--brand);
    color: #ffffff;
  }

  /* ── FILTER TABS ────────────────────────────────────── */
  .hsc-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .hsc-filter-tab {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hsc-filter-tab:hover {
    border-color: var(--brand-mid);
    color: var(--brand);
  }

  .hsc-filter-tab.active {
    background: var(--brand);
    color: #ffffff;
    border-color: var(--brand);
    box-shadow: 0 2px 8px rgba(176, 0, 32, 0.2);
  }

  /* ── SUBJECT CARDS GRID ─────────────────────────────── */

  .hsc-code-badge {
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--ink);
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .hsc-substreams {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .hsc-substream-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .hsc-substream-chip {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brand-dark);
    background: var(--brand-light);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* Chapters preview */
  .hsc-chapters-preview {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .hsc-chapters-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .hsc-view-all-link {
    font-size: 0.72rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
  }

  .hsc-view-all-link:hover {
    text-decoration: underline;
  }

  .hsc-chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hsc-chapter-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .hsc-chapter-list svg {
    color: var(--green);
    flex-shrink: 0;
  }

  /* ── EXAM PATTERN TABLE ─────────────────────────────── */
  .hsc-table-wrapper {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-pattern-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .hsc-pattern-table th {
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 700;
    padding: 16px 20px;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }

  .hsc-pattern-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    vertical-align: middle;
  }

  .hsc-table-code {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hsc-table-code small {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .hsc-odia-sm {
    font-size: 0.8rem;
    color: var(--brand);
  }

  .hsc-mark-highlight {
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.82rem;
    display: inline-block;
  }

  .hsc-pass-tag {
    font-weight: 700;
    color: var(--ink);
  }

  .hsc-table-total-row {
    background: #fff5f6;
  }

  .hsc-table-total-row td {
    color: var(--ink);
    font-weight: 700;
  }

  .hsc-total-marks {
    color: var(--brand);
    font-size: 1.05rem;
  }

  /* Division cards */
  .hsc-division-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hsc-div-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 20px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-div-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .hsc-div-medal {
    font-size: 1.8rem;
  }

  .hsc-div-header h4 {
    font-size: 1rem;
    color: var(--ink);
    margin: 0;
  }

  .hsc-div-header p {
    font-size: 0.82rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .hsc-div-first .hsc-div-header p {
    color: var(--green);
  }

  .hsc-div-second .hsc-div-header p {
    color: #2563eb;
  }

  .hsc-div-third .hsc-div-header p {
    color: var(--gold);
  }

  .hsc-div-desc {
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  /* ── SYLLABUS & BLUEPRINT ACCORDION ─────────────────── */
  .hsc-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hsc-details-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .hsc-details-card[open] {
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
  }

  .hsc-details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    background: var(--surface);
  }

  .hsc-details-summary::-webkit-details-marker {
    display: none;
  }

  .hsc-summary-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hsc-summary-icon {
    font-size: 1.8rem;
    background: var(--surface-2);
    padding: 8px;
    border-radius: 10px;
    line-height: 1;
  }

  .hsc-summary-title {
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .hsc-summary-sub {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .hsc-details-arrow {
    font-size: 1.4rem;
    color: var(--ink-muted);
    transition: transform 0.2s ease;
  }

  .hsc-details-card[open] .hsc-details-arrow {
    transform: rotate(45deg);
    color: var(--brand);
  }

  .hsc-details-content {
    padding: 0 24px 24px;
    border-top: 1px solid var(--rule);
    background: #f8fafc;
  }

  .hsc-units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .hsc-unit-box {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 18px;
  }

  .hsc-unit-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .hsc-unit-head h4 {
    font-size: 0.95rem;
    color: var(--ink);
    margin: 0;
  }

  .hsc-unit-odia {
    font-size: 0.78rem;
    color: var(--brand);
    font-weight: 600;
  }

  .hsc-weightage-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .hsc-unit-topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hsc-unit-topics li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .hsc-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .hsc-details-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px dashed var(--rule);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* ── OMR TIPS ───────────────────────────────────────── */
  .hsc-tips-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .hsc-tip-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }

  .hsc-tip-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .hsc-tip-icon {
    font-size: 1.8rem;
  }

  .hsc-tip-num {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--brand);
    opacity: 0.4;
    font-family: var(--font-display);
  }

  .hsc-tip-title {
    font-size: 1rem;
    color: var(--ink);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .hsc-tip-odia {
    font-size: 0.8rem;
    color: var(--brand);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .hsc-tip-desc {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .hsc-omr-callout {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    padding: 18px 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    color: #92400e;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .hsc-callout-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  /* ── FAQS ───────────────────────────────────────────── */
  .hsc-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 900px;
  }

  .hsc-faq-item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
  }

  .hsc-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    gap: 16px;
  }

  .hsc-faq-summary::-webkit-details-marker {
    display: none;
  }

  .hsc-faq-q-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hsc-faq-q-text {
    font-weight: 700;
    color: var(--ink);
    font-size: 0.98rem;
  }

  .hsc-faq-q-odia {
    font-size: 0.84rem;
    color: var(--brand);
    font-weight: 600;
  }

  .hsc-faq-icon {
    font-size: 1.4rem;
    color: var(--ink-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .hsc-faq-item[open] .hsc-faq-icon {
    transform: rotate(45deg);
    color: var(--brand);
  }

  .hsc-faq-answer {
    padding: 0 22px 20px;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    border-top: 1px solid var(--surface-2);
  }

  /* ── FINAL CTA ──────────────────────────────────────── */
  .hsc-final-cta {
    background: linear-gradient(135deg, #7b0015 0%, #b00020 100%);
    color: #ffffff;
    padding: clamp(48px, 6vw, 80px) 0;
    text-align: center;
  }

  .hsc-cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hsc-cta-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .hsc-cta-inner h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: #ffffff;
    margin-bottom: 12px;
  }

  .hsc-cta-inner p {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .hsc-final-cta .hsc-btn-primary {
    background: #ffffff;
    color: var(--brand);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .hsc-final-cta .hsc-btn-primary:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .hsc-cta-disclaimer {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.7) !important;
    margin-top: 24px;
  }

  /* ── INTERACTIVE TEST RUNNER MODAL ──────────────────── */
  .hsc-test-modal:not([open]) {
    display: none !important;
  }
  .hsc-test-modal[open] {
    display: flex;
    flex-direction: column;
  }
  .hsc-test-modal {
    width: 96vw;
    max-width: 1100px;
    height: 94vh;
    max-height: 900px;
    border: none;
    border-radius: 20px;
    padding: 0;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .hsc-test-modal::backdrop {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }

  @media (max-width: 768px) {
    .hsc-test-modal {
      width: 100vw;
      height: 100vh;
      max-width: 100vw;
      max-height: 100vh;
      border-radius: 0;
    }
    .hsc-modal-header {
      padding: 10px 16px;
      gap: 10px;
    }
    .hsc-modal-test-name {
      font-size: 0.95rem;
    }
    .hsc-modal-timer-box {
      font-size: 0.9rem;
      padding: 4px 10px;
    }
    .hsc-test-main-view {
      padding: 16px;
    }
  }

  @media (max-width: 540px) {
    .hsc-modal-header-left {
      gap: 8px;
    }
    .hsc-test-badge {
      display: none;
    }
  }

  .hsc-modal-container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hsc-modal-header {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .hsc-modal-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hsc-test-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .hsc-modal-test-name {
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 700;
  }

  .hsc-modal-timer-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff1f2;
    color: #e11d48;
    border: 1px solid #fecdd3;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: monospace;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .hsc-modal-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hsc-modal-btn-palette {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .hsc-modal-btn-palette:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .hsc-modal-btn-close {
    background: transparent;
    border: none;
    font-size: 1.8rem;
    color: var(--ink-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
  }

  .hsc-modal-btn-close:hover {
    color: var(--brand);
  }

  .hsc-modal-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .hsc-test-main-view {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .hsc-progress-track {
    height: 4px;
    background: var(--rule);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .hsc-progress-fill {
    height: 100%;
    background: var(--brand);
    transition: width 0.3s ease;
  }

  /* Question card */
  .hsc-question-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 28px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
    flex: 1;
  }

  .hsc-q-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .hsc-q-counter {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brand);
  }

  .hsc-q-section-tag {
    font-size: 0.78rem;
    background: var(--surface-2);
    color: var(--ink-soft);
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 600;
  }

  .hsc-btn-mark-review {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 4px 12px;
    cursor: pointer;
  }

  .hsc-btn-mark-review.marked {
    background: #f3e8ff;
    border-color: #d8b4fe;
    color: #7c3aed;
    font-weight: 700;
  }

  .hsc-q-text-wrap {
    margin-bottom: 24px;
  }

  .hsc-q-text {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .hsc-q-text-odia {
    font-size: 1.05rem;
    color: var(--brand-dark);
    line-height: 1.5;
    font-weight: 500;
  }

  /* Options Grid */
  .hsc-options-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hsc-opt-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface-2);
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 14px 18px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hsc-opt-card:hover {
    background: #ffffff;
    border-color: var(--brand-mid);
  }

  .hsc-opt-card.selected {
    background: #ffffff;
    border-color: var(--brand);
    box-shadow: 0 4px 12px rgba(176, 0, 32, 0.1);
  }

  .hsc-opt-card input {
    display: none;
  }

  .hsc-opt-letter {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--ink);
    flex-shrink: 0;
  }

  .hsc-opt-card.selected .hsc-opt-letter {
    background: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
  }

  .hsc-opt-label {
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.4;
  }

  /* Test Footer */
  .hsc-test-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    gap: 16px;
  }

  .hsc-footer-left,
  .hsc-footer-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hsc-btn-text {
    background: transparent;
    border: none;
    color: var(--ink-muted);
    font-size: 0.84rem;
    cursor: pointer;
    text-decoration: underline;
  }

  .hsc-btn-text:hover {
    color: var(--brand);
  }

  .hsc-btn-submit {
    background: var(--green);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: 999px;
    cursor: pointer;
