    <!-- ── 9. TEST MODE & CHAPTER SELECTOR MODAL ─────────── -->
    <dialog class="hsc-mode-modal" id="hsc-mode-modal" aria-label="Choose Test Mode">
      <div class="hsc-modal-container">
