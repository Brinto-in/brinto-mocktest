<script>
  // Subject filter pills: show one subject row or all
  const filterTabs = document.querySelectorAll<HTMLButtonElement>('.hsc-filter-tab');
  const subjectRows = document.querySelectorAll<HTMLElement>('.hsc-subject-row');

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const filterVal = tab.dataset.filter;
      subjectRows.forEach((row) => {
        row.style.display = filterVal === 'all' || row.dataset.subjectId === filterVal ? '' : 'none';
      });
    });
  });

  // Row arrows
  document.querySelectorAll<HTMLElement>('.sx-subject').forEach((sec) => {
    const row = sec.querySelector<HTMLElement>('.sx-row');
    const arrows = sec.querySelectorAll<HTMLButtonElement>('.sx-arrow');
    if (!row || arrows.length < 2) return;
    const update = () => {
      const max = row.scrollWidth - row.clientWidth - 2;
      arrows[0].disabled = row.scrollLeft <= 2;
      arrows[1].disabled = row.scrollLeft >= max;
      sec.classList.toggle('sx-no-scroll', max <= 0);
    };
    arrows.forEach((a) =>
      a.addEventListener('click', () => {
        row.scrollBy({ left: Number(a.dataset.dir) * row.clientWidth * 0.85, behavior: 'smooth' });
      })
    );
    row.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

