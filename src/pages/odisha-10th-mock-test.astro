---
// src/pages/odisha-10th-mock-test.astro
// Dedicated comprehensive mock test & syllabus portal for BSE Odisha Class 10 (HSC Matriculation)
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ODISHA_10TH_SUBJECTS,
  ODISHA_10TH_QUESTIONS,
  EXAM_PATTERN_DETAILS,
  OMR_TIPS,
  FAQS_ODISHA_10TH,
} from '../data/odisha10thData';

const canonicalPath = '/mocktest/odisha-10th-mock-test';
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImage = new URL('/logo.png', Astro.site).toString();

const pageTitle = 'BSE Odisha 10th HSC Mock Test 2026-2027 | All Subjects Free Practice';
const pageDescription =
  'Free BSE Odisha Class 10th Matriculation online mock tests for all 6 subjects: Mathematics, Science, Social Science, Odia, English, Sanskrit & Hindi. 50-mark OMR pattern, chapter-wise MCQs, instant result & detailed Odia solutions.';

// Schema.org structured data
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS_ODISHA_10TH.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.brinto.in/' },
    { '@type': 'ListItem', position: 2, name: 'Mock Tests', item: 'https://www.brinto.in/mocktest/' },
    { '@type': 'ListItem', position: 3, name: 'BSE Odisha 10th HSC Mock Test', item: canonicalUrl },
  ],
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: ['en-IN', 'or-IN'],
  publisher: {
    '@type': 'Organization',
    name: 'Brinto',
    url: 'https://www.brinto.in',
    logo: ogImage,
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  <meta slot="head" property="og:image" content={ogImage} />
  <meta slot="head" name="twitter:title" content={pageTitle} />
  <meta slot="head" name="twitter:description" content={pageDescription} />
  <meta slot="head" name="twitter:image" content={ogImage} />

  <div class="hsc-page">
    <!-- ── 1. HERO SECTION ────────────────────────────────── -->
    <section class="hsc-hero" aria-labelledby="hero-title">
      <div class="wrap">
        <nav class="hsc-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/mocktest/">Home</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/mocktest/tests">Mock Tests</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">BSE Odisha 10th HSC</li>
          </ol>
        </nav>

        <div class="hsc-hero-content">
          <div class="hsc-pill">
            <span class="hsc-pill-dot"></span>
            🎓 BSE ODISHA CLASS 10TH (MATRIC) EXAM 2026–2027
          </div>

          <h1 id="hero-title">
            BSE Odisha 10th HSC Mock Test <br />
            <span class="hsc-highlight">All Subjects Free Practice</span>
          </h1>

          <p class="hsc-hero-sub-odia">
            ଦଶମ ଶ୍ରେଣୀ ମାଟ୍ରିକ ବୋର୍ଡ ପରୀକ୍ଷା: ସମସ୍ତ ୬ଟି ବିଷୟର ଅଧ୍ୟାୟ ଭିତ୍ତିକ OMR ବସ୍ତୁନିଷ୍ଠ ପ୍ରଶ୍ନୋତ୍ତର ଓ ମକ୍ ଟେଷ୍ଟ।
          </p>

          <p class="hsc-hero-desc">
            Practice strictly on the latest Board of Secondary Education (BSE), Odisha pattern — featuring 50 Objective MCQs,
            zero negative marking, instant score calculation, and bilingual explanations in Odia and English.
          </p>

          <div class="hsc-hero-tags" aria-label="Key Exam Features">
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 50 Marks OMR Pattern</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> All 6 Compulsory Subjects</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> 0 Negative Marking</span>
            <span class="hsc-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Instant Odia & English Explanations</span>
            <span class="hsc-badge hsc-badge-free">100% Free Practice</span>
          </div>

          <div class="hsc-hero-actions">
            <button
              type="button"
              class="hsc-btn hsc-btn-primary"
              id="btn-start-grand-test"
              data-subject="all"
            >
              Take Grand Mock Test Now 🚀
            </button>
            <a href="#subjects-section" class="hsc-btn hsc-btn-secondary">
              Browse All 6 Subjects ↓
            </a>
          </div>
        </div>

        <!-- Metric Ribbon -->
        <div class="hsc-metrics-ribbon">
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">6</div>
            <div class="hsc-metric-lbl">Core Subjects</div>
            <div class="hsc-metric-sub">FLO, SLE, MTH, GSC, SSC, TLS</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">50</div>
            <div class="hsc-metric-lbl">OMR MCQs / Paper</div>
            <div class="hsc-metric-sub">50% Objective Weightage</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">0</div>
            <div class="hsc-metric-lbl">Negative Marks</div>
            <div class="hsc-metric-sub">Full Attempt Allowed</div>
          </div>
          <div class="hsc-metric-divider"></div>
          <div class="hsc-metric-card">
            <div class="hsc-metric-val">600</div>
            <div class="hsc-metric-lbl">Total Aggregate</div>
            <div class="hsc-metric-sub">100 Marks Each Subject</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 2. SUBJECTS SHOWCASE SECTION ───────────────────── -->
    <section class="hsc-section" id="subjects-section" aria-labelledby="subjects-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📚 COMPULSORY CURRICULUM</span>
            <h2 id="subjects-title">Select a Subject to Practice</h2>
            <p>
              Choose any of the 6 compulsory subjects below to start an interactive 50-mark objective practice test or review its detailed chapter syllabus.
            </p>
          </div>
          <div class="hsc-header-right">
            <button type="button" class="hsc-quick-all-btn" id="btn-quick-grand" data-subject="all">
              ⚡ Start Combined Grand Test
            </button>
          </div>
        </div>

        <!-- Subject Filter Pills -->
        <div class="hsc-filter-tabs" role="tablist" aria-label="Subject filter tabs">
          <button class="hsc-filter-tab active" data-filter="all" role="tab" aria-selected="true">
            All Subjects (6)
          </button>
          {ODISHA_10TH_SUBJECTS.map((s) => (
            <button class="hsc-filter-tab" data-filter={s.id} role="tab" aria-selected="false">
              <span>{s.icon}</span> {s.name} ({s.nameOdia})
            </button>
          ))}
        </div>

        <!-- Subject Cards Grid -->
        <div class="hsc-subjects-grid" id="subjects-grid">
          {ODISHA_10TH_SUBJECTS.map((s) => (
            <article class="hsc-subject-card" data-subject-id={s.id} id={`subject-${s.id}`}>
              <div class="hsc-card-top-bar" style={`background-color: ${s.accentColor};`}></div>

              <div class="hsc-card-body">
                <div class="hsc-card-header">
                  <div class="hsc-card-icon-wrap" style={`background: ${s.gradient};`}>
                    <span class="hsc-card-icon">{s.icon}</span>
                  </div>
                  <div class="hsc-card-title-group">
                    <div class="hsc-card-badges">
                      <span class="hsc-code-badge">{s.code}</span>
                      <span class="hsc-paper-badge">{s.paperType}</span>
                      {s.isPopular && <span class="hsc-popular-badge">★ Popular</span>}
                    </div>
                    <h3 class="hsc-card-title">
                      {s.name} <span class="hsc-card-title-odia">({s.nameOdia})</span>
                    </h3>
                  </div>
                </div>

                <p class="hsc-card-desc">{s.description}</p>
                <p class="hsc-card-desc-odia">{s.descriptionOdia}</p>

                <!-- Meta Specs -->
                <div class="hsc-card-meta">
                  <div class="hsc-meta-item">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    <strong>50 MCQs</strong>
                  </div>
                  <div class="hsc-meta-item">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>{s.durationMinutes} mins</span>
                  </div>
                  <div class="hsc-meta-item">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    <span>{s.rating} ({s.attempts})</span>
                  </div>
                </div>

                <!-- Card Actions -->
                <div class="hsc-card-actions">
                  <button
                    type="button"
                    class="hsc-btn-practice"
                    data-subject={s.id}
                    data-subject-title={`${s.name} (${s.nameOdia})`}
                  >
                    Start {s.code} Practice Test →
                  </button>
                  <a href={`#blueprint-${s.id}`} class="hsc-btn-syllabus">
                    Syllabus
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 3. EXAM PATTERN & MARKING SCHEME ───────────────── -->
    <section class="hsc-section hsc-section-alt" id="pattern-section" aria-labelledby="pattern-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📋 BSE ODISHA BLUEPRINT</span>
            <h2 id="pattern-title">Class 10th HSC Exam Pattern & Marks Distribution</h2>
            <p>
              Under the latest BSE Odisha scheme, every core subject has a 100-mark paper divided equally into 50 marks OMR Objective and 50 marks Subjective.
            </p>
          </div>
        </div>

        <div class="hsc-table-wrapper">
          <table class="hsc-pattern-table">
            <thead>
              <tr>
                <th scope="col">Paper / Code</th>
                <th scope="col">Subject Name (ବିଷୟ)</th>
                <th scope="col">OMR Objective</th>
                <th scope="col">Subjective</th>
                <th scope="col">Total Marks</th>
                <th scope="col">Time Limit</th>
                <th scope="col">Pass Marks</th>
              </tr>
            </thead>
            <tbody>
              {ODISHA_10TH_SUBJECTS.map((s, idx) => (
                <tr>
                  <td>
                    <div class="hsc-table-code">
                      <span class="hsc-code-badge">{s.code}</span>
                      <small>Paper {idx + 1}</small>
                    </div>
                  </td>
                  <td>
                    <strong>{s.name}</strong>
                    <div class="hsc-odia-sm">{s.nameOdia}</div>
                  </td>
                  <td>
                    <span class="hsc-mark-highlight">50 MCQs (50 Marks)</span>
                  </td>
                  <td>50 Marks</td>
                  <td>
                    <strong>100 Marks</strong>
                  </td>
                  <td>{s.id === 'math' ? '2h 45m (Extra 15m)' : '2h 30m'}</td>
                  <td>
                    <span class="hsc-pass-tag">30 Marks</span>
                  </td>
                </tr>
              ))}
              <tr class="hsc-table-total-row">
                <td colspan="2"><strong>Total (6 Compulsory Subjects)</strong></td>
                <td><strong>300 MCQs</strong></td>
                <td><strong>300 Marks</strong></td>
                <td><strong class="hsc-total-marks">600 Marks</strong></td>
                <td>--</td>
                <td><strong>198 Marks (33%)</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Division Criteria Slabs -->
        <div class="hsc-division-cards">
          <div class="hsc-div-card hsc-div-first">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥇</span>
              <div>
                <h4>First Division (A1 & A2)</h4>
                <p>360 Marks & Above (60%+)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Grade A1 requires 90%+, Grade A2 requires 80%–89%.</div>
          </div>
          <div class="hsc-div-card hsc-div-second">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥈</span>
              <div>
                <h4>Second Division (B1 & B2)</h4>
                <p>270 to 359 Marks (45%–59%)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Grade B1 requires 70%–79%, Grade B2 requires 60%–69%.</div>
          </div>
          <div class="hsc-div-card hsc-div-third">
            <div class="hsc-div-header">
              <span class="hsc-div-medal">🥉</span>
              <div>
                <h4>Third Division (C & D)</h4>
                <p>198 to 269 Marks (33%–44%)</p>
              </div>
            </div>
            <div class="hsc-div-desc">Minimum aggregate required to receive passing certificate.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 4. COMPLETE CHAPTER BLUEPRINT & SYLLABUS ACCORDION ─ -->
    <section class="hsc-section" id="blueprint-section" aria-labelledby="blueprint-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">📖 UNIT-WISE CHAPTERS</span>
            <h2 id="blueprint-title">Detailed Subject-Wise Syllabus & Blueprints</h2>
            <p>
              Explore the exact units, chapter topics, and question weightage prescribed by the Board of Secondary Education, Odisha.
            </p>
          </div>
        </div>

        <div class="hsc-accordion-group">
          {ODISHA_10TH_SUBJECTS.map((s) => (
            <details class="hsc-details-card" id={`blueprint-${s.id}`} name="blueprint-acc">
              <summary class="hsc-details-summary">
                <div class="hsc-summary-left">
                  <span class="hsc-summary-icon">{s.icon}</span>
                  <div>
                    <h3 class="hsc-summary-title">
                      {s.name} – {s.nameOdia} ({s.code})
                    </h3>
                    <p class="hsc-summary-sub">{s.chapters.length} Units • 50 Marks MCQ • {s.subStreams.join(', ')}</p>
                  </div>
                </div>
                <span class="hsc-details-arrow" aria-hidden="true">+</span>
              </summary>

              <div class="hsc-details-content">
                <div class="hsc-units-grid">
                  {s.chapters.map((unit) => (
                    <div class="hsc-unit-box">
                      <div class="hsc-unit-head">
                        <div>
                          <h4>{unit.unit}</h4>
                          <span class="hsc-unit-odia">{unit.unitOdia}</span>
                        </div>
                        <span class="hsc-weightage-badge">{unit.weightageMarks} Marks</span>
                      </div>
                      <ul class="hsc-unit-topics">
                        {unit.topics.map((t) => (
                          <li>
                            <span class="hsc-bullet"></span>
                            <span>{t}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                <div class="hsc-details-cta">
                  <span>Ready to test your knowledge in {s.name}?</span>
                  <button
                    type="button"
                    class="hsc-btn hsc-btn-primary hsc-btn-sm"
                    data-subject={s.id}
                  >
                    Start {s.name} Mock Test 🎯
                  </button>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 5. OMR SHEET FILLING TIPS & STRATEGY ───────────── -->
    <section class="hsc-section hsc-section-alt" id="omr-tips-section" aria-labelledby="omr-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">✍️ OMR EXAM MASTERY</span>
            <h2 id="omr-title">BSE Odisha Matric OMR Sheet Filling Guide</h2>
            <p>
              In the 10th Board Exam, your objective marks are machine-read by optical scanners. Follow these proven strategies to prevent lost marks.
            </p>
          </div>
        </div>

        <div class="hsc-tips-grid">
          {OMR_TIPS.map((tip, i) => (
            <div class="hsc-tip-card">
              <div class="hsc-tip-top">
                <span class="hsc-tip-icon">{tip.icon}</span>
                <span class="hsc-tip-num">0{i + 1}</span>
              </div>
              <h3 class="hsc-tip-title">{tip.title}</h3>
              <div class="hsc-tip-odia">{tip.titleOdia}</div>
              <p class="hsc-tip-desc">{tip.desc}</p>
            </div>
          ))}
        </div>

        <div class="hsc-omr-callout">
          <div class="hsc-callout-icon">💡</div>
          <div class="hsc-callout-text">
            <strong>Golden Strategy for Odisha 10th Students:</strong>
            Because there is <em>no negative marking</em>, always solve the easiest 30–35 questions in the first 30 minutes,
            then spend 10 minutes on calculation-heavy problems, and use educated elimination on the remaining questions.
            <strong>Never leave any circle blank!</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 6. FAQS SECTION ────────────────────────────────── -->
    <section class="hsc-section" id="faq-section" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="hsc-section-header">
          <div class="hsc-header-left">
            <span class="hsc-tag-pill">❓ FREQUENTLY ASKED QUESTIONS</span>
            <h2 id="faq-title">Frequently Asked Questions</h2>
            <p>Everything you need to know about BSE Odisha Class 10th mock tests, scoring, and syllabus.</p>
          </div>
        </div>

        <div class="hsc-faq-list">
          {FAQS_ODISHA_10TH.map((faq) => (
            <details class="hsc-faq-item" name="hsc-faqs">
              <summary class="hsc-faq-summary">
                <div class="hsc-faq-q-wrap">
                  <span class="hsc-faq-q-text">{faq.q}</span>
                  <span class="hsc-faq-q-odia">{faq.qOdia}</span>
                </div>
                <span class="hsc-faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="hsc-faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 7. FINAL CALL TO ACTION ────────────────────────── -->
    <section class="hsc-final-cta" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="hsc-cta-inner">
          <div class="hsc-cta-badge">🌟 100% FREE PRACTICE</div>
          <h2 id="cta-title">Ready to Score 90%+ in BSE Odisha 10th Board?</h2>
          <p>
            Begin practicing high-yield objective MCQs across Mathematics, Science, Social Science, Odia, English, and Sanskrit/Hindi today.
          </p>
          <div class="hsc-cta-btn-wrap">
            <button
              type="button"
              class="hsc-btn hsc-btn-primary hsc-btn-lg"
              id="btn-final-start-grand"
              data-subject="all"
            >
              Start Full 10th Mock Test Now 🚀
            </button>
          </div>
          <p class="hsc-cta-disclaimer">
            Brinto is an independent educational initiative designed to empower Odisha matric students with free, high quality learning tools.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 8. INTERACTIVE TEST RUNNER MODAL ────────────────── -->
    <dialog class="hsc-test-modal" id="hsc-test-modal" aria-label="Odisha 10th Mock Test Player">
      <div class="hsc-modal-container">
        <!-- Modal Top Bar -->
        <header class="hsc-modal-header">
          <div class="hsc-modal-header-left">
            <span class="hsc-test-badge" id="modal-subject-badge">BSE Class 10</span>
            <h2 id="modal-test-title" class="hsc-modal-test-name">Odisha 10th Mock Test</h2>
          </div>

          <div class="hsc-modal-timer-box" aria-label="Timer">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="modal-timer">45:00</span>
          </div>

          <div class="hsc-modal-header-right">
            <button type="button" class="hsc-modal-btn-palette" id="btn-toggle-palette" aria-label="Toggle Question Palette">
              <span>📋 Palette</span>
            </button>
            <button type="button" class="hsc-modal-btn-close" id="btn-close-modal" aria-label="Close Test">
              &times;
            </button>
          </div>
        </header>

        <!-- Modal Body (Two columns when palette open) -->
        <div class="hsc-modal-body">
          <!-- Main Test Screen -->
          <div class="hsc-test-main-view" id="test-main-view">
            <!-- Progress Bar -->
            <div class="hsc-progress-track">
              <div class="hsc-progress-fill" id="modal-progress-fill" style="width: 10%;"></div>
            </div>

            <!-- Active Question Card -->
            <div class="hsc-question-card" id="question-card">
              <div class="hsc-q-meta-row">
                <span class="hsc-q-counter" id="q-counter">Question 1 of 10</span>
                <span class="hsc-q-section-tag" id="q-section-tag">Algebra</span>
                <button type="button" class="hsc-btn-mark-review" id="btn-mark-review">
                  <span id="mark-icon">🔖</span> <span id="mark-text">Mark for Review</span>
                </button>
              </div>

              <!-- Question Text -->
              <div class="hsc-q-text-wrap">
                <p class="hsc-q-text" id="q-text-en">Question loading...</p>
                <p class="hsc-q-text-odia" id="q-text-or"></p>
              </div>

              <!-- 4 Options -->
              <div class="hsc-options-grid" id="options-container" role="radiogroup" aria-label="Answer options">
                <!-- Injected via JavaScript -->
              </div>
            </div>

            <!-- Footer Controls -->
            <footer class="hsc-test-footer">
              <div class="hsc-footer-left">
                <button type="button" class="hsc-btn hsc-btn-secondary" id="btn-prev-q">
                  ← Previous
                </button>
                <button type="button" class="hsc-btn-text" id="btn-clear-q">
                  Clear Response
                </button>
              </div>

              <div class="hsc-footer-right">
                <button type="button" class="hsc-btn hsc-btn-secondary" id="btn-next-q">
                  Next →
                </button>
                <button type="button" class="hsc-btn hsc-btn-submit" id="btn-submit-test">
                  Submit Test ✓
                </button>
              </div>
            </footer>
          </div>

          <!-- Question Palette Sidebar -->
          <aside class="hsc-palette-sidebar" id="palette-sidebar">
            <div class="hsc-palette-header">
              <h3>Question Palette</h3>
              <span class="hsc-palette-legend">
                <span class="leg-item"><span class="leg-dot dot-ans"></span> Ans</span>
                <span class="leg-item"><span class="leg-dot dot-unans"></span> Left</span>
                <span class="leg-item"><span class="leg-dot dot-mark"></span> Rev</span>
              </span>
            </div>

            <div class="hsc-palette-bubbles" id="palette-bubbles">
              <!-- Injected via JS -->
            </div>

            <div class="hsc-palette-footer">
              <button type="button" class="hsc-btn hsc-btn-primary hsc-btn-full" id="btn-palette-submit">
                Submit Test ✓
              </button>
            </div>
          </aside>

          <!-- Result & Scorecard View (hidden until submission) -->
          <div class="hsc-result-view" id="test-result-view" hidden>
            <div class="hsc-scorecard">
              <div class="hsc-score-badge" id="res-badge">🎉 Test Completed!</div>
              <h3 class="hsc-score-title" id="res-title">BSE Odisha Class 10 Mock Test</h3>

              <div class="hsc-score-hero">
                <div class="hsc-score-circle">
                  <span class="hsc-score-big" id="res-score">0</span>
                  <span class="hsc-score-total" id="res-total">/ 0</span>
                </div>
                <div class="hsc-score-details">
                  <div class="hsc-score-metric">
                    <span>Percentage</span>
                    <strong id="res-percent">0%</strong>
                  </div>
                  <div class="hsc-score-metric">
                    <span>Performance</span>
                    <strong id="res-division" class="hsc-grade-text">Pass</strong>
                  </div>
                  <div class="hsc-score-metric">
                    <span>Time Taken</span>
                    <strong id="res-time-taken">0 mins</strong>
                  </div>
                </div>
              </div>

              <!-- Action Bar -->
              <div class="hsc-result-actions">
                <button type="button" class="hsc-btn hsc-btn-primary" id="btn-review-answers">
                  Review All Answers with Explanations 📖
                </button>
                <button type="button" class="hsc-btn hsc-btn-secondary" id="btn-retake-test">
                  Retake Test 🔄
                </button>
                <button type="button" class="hsc-btn hsc-btn-secondary" id="btn-exit-modal">
                  Back to All Subjects ✕
                </button>
              </div>
            </div>

            <!-- Detailed Question-by-Question Review List -->
            <div class="hsc-review-container" id="review-container" hidden>
              <div class="hsc-review-header">
                <h3>Detailed Answer Explanations (ସମାଧାନ ଓ ଉତ୍ତର)</h3>
                <p>Verify your responses with step-by-step logic in Odia & English.</p>
              </div>
              <div class="hsc-review-list" id="review-list">
                <!-- Injected via JS -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- ── 9. TEST MODE & CHAPTER SELECTOR MODAL ─────────── -->
    <dialog class="hsc-mode-modal" id="hsc-mode-modal" aria-label="Choose Test Mode">
      <div class="hsc-modal-container">
        <div class="hsc-sheet-handle" aria-hidden="true"></div>
        <header class="hsc-modal-header">
          <div class="hsc-modal-header-left">
            <span class="hsc-test-badge" id="mode-modal-badge">BSE Class 10</span>
            <h2 id="mode-modal-title" class="hsc-modal-test-name">Select Test or Chapter</h2>
          </div>
          <button type="button" class="hsc-modal-btn-close" id="btn-close-mode-modal" aria-label="Close">
            &times;
          </button>
        </header>
        <div class="hsc-modal-body" style="padding: 20px 24px; display: flex; flex-direction: column; gap: 14px;">
          <p style="color: var(--ink-soft); font-size: 0.9rem; margin: 0; line-height: 1.4;">
            Choose whether to attempt the full subject test or practice a specific chapter for <strong id="mode-subject-name" style="color: var(--ink);">Subject</strong>:
          </p>

          <!-- Option 1: Full Test -->
          <button type="button" class="hsc-full-test-option-btn" id="btn-mode-full">
            <div class="hsc-opt-left">
              <span class="hsc-opt-icon">🚀</span>
              <div>
                <strong>Full Subject Grand Test</strong>
                <span>50 MCQs • Complete Syllabus • Timed (45 Mins)</span>
              </div>
            </div>
            <span class="hsc-opt-cta">Start Full Test →</span>
          </button>

          <!-- Divider / Separator -->
          <div class="hsc-modal-divider">
            <hr />
            <span>OR CHOOSE CHAPTER</span>
            <hr />
          </div>

          <!-- Option 2: Chapters List -->
          <div id="chapters-list-container" class="hsc-chapters-modal-list">
            <!-- Injected via JS -->
          </div>
        </div>
      </div>
    </dialog>
  </div>
</BaseLayout>

<!-- Client-Side State & Test Runner Engine (100% Static, ZERO API Needed) -->
<script is:inline define:vars={{ questionsData: ODISHA_10TH_QUESTIONS, subjectsData: ODISHA_10TH_SUBJECTS }}>
  (function () {
    // --- Tab Filtering for Subjects ---
    const filterTabs = document.querySelectorAll('.hsc-filter-tab');
    const subjectCards = document.querySelectorAll('.hsc-subject-card');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filterVal = tab.getAttribute('data-filter');
        subjectCards.forEach((card) => {
          if (filterVal === 'all' || card.getAttribute('data-subject-id') === filterVal) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // --- Static Test Runner Engine ---
    const modal = document.getElementById('hsc-test-modal');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnExitModal = document.getElementById('btn-exit-modal');
    const btnTogglePalette = document.getElementById('btn-toggle-palette');
    const paletteSidebar = document.getElementById('palette-sidebar');

    const testMainView = document.getElementById('test-main-view');
    const testResultView = document.getElementById('test-result-view');
    const reviewContainer = document.getElementById('review-container');

    const modalTitle = document.getElementById('modal-test-title');
    const modalBadge = document.getElementById('modal-subject-badge');
    const modalTimer = document.getElementById('modal-timer');
    const modalProgress = document.getElementById('modal-progress-fill');

    const qCounter = document.getElementById('q-counter');
    const qSectionTag = document.getElementById('q-section-tag');
    const btnMarkReview = document.getElementById('btn-mark-review');
    const qTextEn = document.getElementById('q-text-en');
    const qTextOr = document.getElementById('q-text-or');
    const optionsContainer = document.getElementById('options-container');

    const btnPrevQ = document.getElementById('btn-prev-q');
    const btnNextQ = document.getElementById('btn-next-q');
    const btnClearQ = document.getElementById('btn-clear-q');
    const btnSubmitTest = document.getElementById('btn-submit-test');
    const btnPaletteSubmit = document.getElementById('btn-palette-submit');

    const paletteBubbles = document.getElementById('palette-bubbles');

    // Result elements
    const resScore = document.getElementById('res-score');
    const resTotal = document.getElementById('res-total');
    const resPercent = document.getElementById('res-percent');
    const resDivision = document.getElementById('res-division');
    const resTimeTaken = document.getElementById('res-time-taken');
    const btnReviewAnswers = document.getElementById('btn-review-answers');
    const btnRetakeTest = document.getElementById('btn-retake-test');
    const reviewList = document.getElementById('review-list');

    let activeQuestions = [];
    let currentIdx = 0;
    let userAnswers = {}; // { qIdx: selectedOptionIdx }
    let markedForReview = new Set();
    let timerSeconds = 45 * 60;
    let timerInterval = null;
    let testStartTime = 0;
    let currentSubjectId = 'all';

    function startTest(subjectId, mode = 'full', chapterIndex = null) {
      currentSubjectId = subjectId;
      if (subjectId === 'all') {
        activeQuestions = [...questionsData];
        modalTitle.textContent = 'BSE Class 10 Grand Mock Test (All Subjects)';
        modalBadge.textContent = 'Full Model Set';
      } else {
        const subj = subjectsData.find((s) => s.id === subjectId);
        let subjQuestions = questionsData.filter((q) => q.subjectId === subjectId);

        if (mode === 'chapter' && chapterIndex !== null && subj && subj.chapters[chapterIndex]) {
          const ch = subj.chapters[chapterIndex];
          const filtered = subjQuestions.filter((q) => {
            return (q.topic && (q.topic === ch.unit || ch.unit.includes(q.topic) || q.topic.includes(ch.unit))) ||
                   ch.topics.some((t) => q.topic && q.topic.toLowerCase().includes(t.toLowerCase()));
          });
          activeQuestions = filtered.length > 0 ? filtered : subjQuestions.slice(0, 5);
          modalTitle.textContent = `${subj.name}: ${ch.unit}`;
          modalBadge.textContent = 'Chapter Practice';
        } else {
          activeQuestions = subjQuestions.length > 0 ? subjQuestions : [...questionsData];
          modalTitle.textContent = subj ? `${subj.name} (${subj.nameOdia}) Full Mock Test` : '10th Mock Test';
          modalBadge.textContent = subj ? subj.code : 'BSE Class 10';
        }
      }

      currentIdx = 0;
      userAnswers = {};
      markedForReview.clear();
      timerSeconds = 45 * 60;
      testStartTime = Date.now();

      testMainView.hidden = false;
      testResultView.hidden = true;
      reviewContainer.hidden = true;

      renderPalette();
      loadQuestion(0);
      startTimer();

      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', 'true');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeTestModal() {
      if (timerInterval) clearInterval(timerInterval);
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
      document.body.style.overflow = '';
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        timerSeconds--;
        updateTimerDisplay();
        if (timerSeconds <= 0) {
          clearInterval(timerInterval);
          alert('Time is up! Submitting your mock test.');
          finishTest();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(timerSeconds / 60);
      const secs = timerSeconds % 60;
      modalTimer.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function loadQuestion(idx) {
      currentIdx = idx;
      const q = activeQuestions[idx];
      if (!q) return;

      qCounter.textContent = `Question ${idx + 1} of ${activeQuestions.length}`;
      qSectionTag.textContent = q.topic || q.section;
      qTextEn.textContent = q.text;
      qTextOr.textContent = q.textOdia || '';

      const percent = ((idx + 1) / activeQuestions.length) * 100;
      modalProgress.style.width = `${percent}%`;

      // Update Mark for review status
      const isMarked = markedForReview.has(idx);
      btnMarkReview.classList.toggle('marked', isMarked);
      document.getElementById('mark-text').textContent = isMarked ? 'Marked for Review' : 'Mark for Review';

      // Render options
      optionsContainer.innerHTML = '';
      q.options.forEach((optText, optIdx) => {
        const optCard = document.createElement('label');
        optCard.className = 'hsc-opt-card';
        if (userAnswers[idx] === optIdx) {
          optCard.classList.add('selected');
        }

        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = `opt_q_${idx}`;
        radio.value = optIdx;
        radio.checked = userAnswers[idx] === optIdx;

        const letters = ['A', 'B', 'C', 'D'];
        const letterBadge = document.createElement('span');
        letterBadge.className = 'hsc-opt-letter';
        letterBadge.textContent = letters[optIdx] || optIdx + 1;

        const labelSpan = document.createElement('span');
        labelSpan.className = 'hsc-opt-label';
        labelSpan.textContent = optText;

        optCard.appendChild(radio);
        optCard.appendChild(letterBadge);
        optCard.appendChild(labelSpan);

        optCard.addEventListener('click', (e) => {
          userAnswers[idx] = optIdx;
          document.querySelectorAll('.hsc-opt-card').forEach((c) => c.classList.remove('selected'));
          optCard.classList.add('selected');
          updatePaletteBubble(idx);
        });

        optionsContainer.appendChild(optCard);
      });

      // Update Prev / Next buttons
      btnPrevQ.disabled = idx === 0;
      btnNextQ.disabled = idx === activeQuestions.length - 1;

      updatePaletteBubble(idx);
    }

    function renderPalette() {
      paletteBubbles.innerHTML = '';
      activeQuestions.forEach((_, idx) => {
        const bubble = document.createElement('button');
        bubble.type = 'button';
        bubble.className = 'hsc-palette-bubble';
        bubble.id = `palette-b-${idx}`;
        bubble.textContent = (idx + 1).toString();
        bubble.setAttribute('aria-label', `Question ${idx + 1}`);

        bubble.addEventListener('click', () => {
          loadQuestion(idx);
          if (window.innerWidth < 768) {
            paletteSidebar.classList.remove('open');
          }
        });

        paletteBubbles.appendChild(bubble);
      });
    }

    function updatePaletteBubble(idx) {
      const bubble = document.getElementById(`palette-b-${idx}`);
      if (!bubble) return;

      bubble.classList.remove('ans', 'unans', 'marked', 'active');

      if (idx === currentIdx) {
        bubble.classList.add('active');
      }

      if (markedForReview.has(idx)) {
        bubble.classList.add('marked');
      } else if (userAnswers[idx] !== undefined) {
        bubble.classList.add('ans');
      } else {
        bubble.classList.add('unans');
      }
    }

    // Toggle Review
    btnMarkReview.addEventListener('click', () => {
      if (markedForReview.has(currentIdx)) {
        markedForReview.delete(currentIdx);
      } else {
        markedForReview.add(currentIdx);
      }
      loadQuestion(currentIdx);
    });

    // Clear response
    btnClearQ.addEventListener('click', () => {
      delete userAnswers[currentIdx];
      loadQuestion(currentIdx);
    });

    // Navigation
    btnPrevQ.addEventListener('click', () => {
      if (currentIdx > 0) loadQuestion(currentIdx - 1);
    });

    btnNextQ.addEventListener('click', () => {
      if (currentIdx < activeQuestions.length - 1) loadQuestion(currentIdx + 1);
    });

    // Palette toggle
    btnTogglePalette.addEventListener('click', () => {
      paletteSidebar.classList.toggle('open');
    });

    // Submit test handler
    function finishTest() {
      if (timerInterval) clearInterval(timerInterval);

      let correctCount = 0;
      activeQuestions.forEach((q, idx) => {
        if (userAnswers[idx] === q.correct) {
          correctCount++;
        }
      });

      const totalQs = activeQuestions.length;
      const percentage = Math.round((correctCount / totalQs) * 100);
      const timeSpentSecs = Math.round((Date.now() - testStartTime) / 1000);
      const timeSpentMins = Math.max(1, Math.round(timeSpentSecs / 60));

      resScore.textContent = correctCount;
      resTotal.textContent = `/ ${totalQs}`;
      resPercent.textContent = `${percentage}%`;
      resTimeTaken.textContent = `${timeSpentMins} min`;

      if (percentage >= 80) {
        resDivision.textContent = 'Grade A1 (Distinction) 🌟';
        resDivision.style.color = '#1B6B3A';
      } else if (percentage >= 60) {
        resDivision.textContent = '1st Division (Passed) 👍';
        resDivision.style.color = '#2563EB';
      } else if (percentage >= 45) {
        resDivision.textContent = '2nd Division (Qualified) 📘';
        resDivision.style.color = '#D97706';
      } else if (percentage >= 33) {
        resDivision.textContent = '3rd Division (Pass) 📙';
        resDivision.style.color = '#7C3AED';
      } else {
        resDivision.textContent = 'Needs More Practice ⚠️';
        resDivision.style.color = '#B00020';
      }

      testMainView.hidden = true;
      testResultView.hidden = false;
      reviewContainer.hidden = true;
    }

    btnSubmitTest.addEventListener('click', () => {
      const answeredCount = Object.keys(userAnswers).length;
      const total = activeQuestions.length;
      const confirmed = confirm(
        `You have answered ${answeredCount} of ${total} questions. Are you sure you want to submit your mock test?`
      );
      if (confirmed) finishTest();
    });

    btnPaletteSubmit.addEventListener('click', () => {
      btnSubmitTest.click();
    });

    // Review answer keys
    btnReviewAnswers.addEventListener('click', () => {
      reviewContainer.hidden = false;
      reviewList.innerHTML = '';

      activeQuestions.forEach((q, idx) => {
        const item = document.createElement('div');
        const userChoice = userAnswers[idx];
        const isCorrect = userChoice === q.correct;

        item.className = `hsc-rev-card ${isCorrect ? 'rev-correct' : 'rev-wrong'}`;

        const letters = ['A', 'B', 'C', 'D'];
        const userText = userChoice !== undefined ? `${letters[userChoice]}. ${q.options[userChoice]}` : 'Not Attempted';
        const correctText = `${letters[q.correct]}. ${q.options[q.correct]}`;

        item.innerHTML = `
          <div class="hsc-rev-num-bar">
            <span>Question ${idx + 1} • ${q.section}</span>
            <span class="hsc-rev-status-pill ${isCorrect ? 'pill-corr' : 'pill-wrn'}">
              ${isCorrect ? '✓ Correct (+1 Mark)' : '✗ Incorrect (0 Mark)'}
            </span>
          </div>
          <p class="hsc-rev-q">${q.text}</p>
          ${q.textOdia ? `<p class="hsc-rev-q-odia">${q.textOdia}</p>` : ''}
          <div class="hsc-rev-answers">
            <div class="hsc-ans-box ans-user ${isCorrect ? 'box-green' : 'box-red'}">
              <strong>Your Choice:</strong> ${userText}
            </div>
            <div class="hsc-ans-box ans-correct box-green">
              <strong>Correct Answer:</strong> ${correctText}
            </div>
          </div>
          <div class="hsc-rev-exp">
            <strong>Explanation (ସମାଧାନ):</strong>
            <p>${q.explanation}</p>
            ${q.explanationOdia ? `<p class="exp-odia">${q.explanationOdia}</p>` : ''}
          </div>
        `;
        reviewList.appendChild(item);
      });

      reviewContainer.scrollIntoView({ behavior: 'smooth' });
    });

    // Retake Test
    btnRetakeTest.addEventListener('click', () => {
      startTest(currentSubjectId);
    });

    // Mode Modal Logic
    const modeModal = document.getElementById('hsc-mode-modal');
    const btnCloseModeModal = document.getElementById('btn-close-mode-modal');
    const modeSubjectName = document.getElementById('mode-subject-name');
    const modeModalBadge = document.getElementById('mode-modal-badge');
    const btnModeFull = document.getElementById('btn-mode-full');
    const chaptersListContainer = document.getElementById('chapters-list-container');

    let selectedSubjectForMode = null;

    function openModeModal(subjectId) {
      if (subjectId === 'all') {
        startTest('all');
        return;
      }
      selectedSubjectForMode = subjectId;
      const subj = subjectsData.find((s) => s.id === subjectId);
      modeSubjectName.textContent = subj ? `${subj.name} (${subj.nameOdia})` : 'Subject';
      modeModalBadge.textContent = subj ? subj.code : 'BSE Class 10';

      renderChaptersList(subjectId);

      if (typeof modeModal.showModal === 'function') {
        modeModal.showModal();
      } else {
        modeModal.setAttribute('open', 'true');
      }
      document.body.style.overflow = 'hidden';
    }

    function closeModeModal() {
      if (typeof modeModal.close === 'function') {
        modeModal.close();
      } else {
        modeModal.removeAttribute('open');
      }
      document.body.style.overflow = '';
    }

    modeModal.addEventListener('cancel', () => {
      document.body.style.overflow = '';
    });

    if (btnCloseModeModal) {
      btnCloseModeModal.addEventListener('click', closeModeModal);
    }

    if (btnModeFull) {
      btnModeFull.addEventListener('click', () => {
        closeModeModal();
        startTest(selectedSubjectForMode, 'full');
      });
    }

    function renderChaptersList(subjectId) {
      if (!chaptersListContainer) return;
      chaptersListContainer.innerHTML = '';
      const subj = subjectsData.find((s) => s.id === subjectId);
      if (!subj || !subj.chapters) return;

      subj.chapters.forEach((ch, chIdx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.style.cssText = 'background: #ffffff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; text-align: left; width: 100%; transition: all 0.15s ease;';

        btn.onmouseover = () => {
          btn.style.borderColor = '#b00020';
          btn.style.background = '#fff5f6';
        };
        btn.onmouseout = () => {
          btn.style.borderColor = '#e5e7eb';
          btn.style.background = '#ffffff';
        };

        btn.innerHTML = `
          <div>
            <strong style="display: block; font-size: 0.9rem; color: #111827;">${ch.unit}</strong>
            <span style="font-size: 0.78rem; color: #4b5563;">${ch.unitOdia} • Weightage: ${ch.weightageMarks} Marks</span>
          </div>
          <span style="font-weight: 700; color: #b00020; font-size: 0.85rem;">Practice →</span>
        `;

        btn.addEventListener('click', () => {
          closeModeModal();
          startTest(subjectId, 'chapter', chIdx);
        });

        chaptersListContainer.appendChild(btn);
      });
    }

    // Modal Close
    btnCloseModal.addEventListener('click', closeTestModal);
    btnExitModal.addEventListener('click', closeTestModal);

    // Attach Launch Buttons from Page
    document.querySelectorAll('[data-subject]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const subjId = btn.getAttribute('data-subject') || 'all';
        openModeModal(subjId);
      });
    });
  })();
</script>

<style is:global>
  /* ── MODE SELECTOR MODAL / BOTTOM SHEET ─────────────── */
  .hsc-mode-modal {
    width: 94vw;
    max-width: 600px;
    height: auto;
    max-height: 90vh;
    border: none;
    border-radius: 20px;
    padding: 0;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }
  .hsc-mode-modal::backdrop {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }
  .hsc-sheet-handle {
    display: none;
    width: 40px;
    height: 4px;
    background: var(--rule);
    border-radius: 2px;
    margin: 10px auto 2px;
  }
  @media (max-width: 768px) {
    .hsc-mode-modal {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      top: auto;
      margin: 0;
      width: 100vw;
      max-width: 100vw;
      max-height: 85vh;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      border-top-left-radius: 24px;
      border-top-right-radius: 24px;
      animation: slideUpBottomsheet 0.25s ease-out;
    }
    .hsc-sheet-handle {
      display: block;
    }
    @keyframes slideUpBottomsheet {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
  }
  .hsc-modal-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 2px 0;
    color: var(--ink-muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hsc-modal-divider hr {
    flex: 1;
    border: none;
    border-top: 1px solid var(--rule);
  }
  .hsc-chapters-modal-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 400px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .hsc-full-test-option-btn {
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: all 0.2s ease;
  }
  .hsc-full-test-option-btn:hover {
    background: var(--brand);
    border-color: var(--brand);
  }
  .hsc-full-test-option-btn:hover strong,
  .hsc-full-test-option-btn:hover span {
    color: #ffffff !important;
  }
  .hsc-opt-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hsc-opt-icon {
    font-size: 1.6rem;
    background: #fff;
    padding: 6px 10px;
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }
  .hsc-full-test-option-btn strong {
    display: block;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .hsc-full-test-option-btn span {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  .hsc-opt-cta {
    font-weight: 700;
    color: var(--brand);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .hsc-chapter-item-btn {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: all 0.15s ease;
  }
  .hsc-chapter-item-btn:hover {
    border-color: var(--brand);
    background: #fff5f6;
  }

  @media (max-width: 640px) {
    .hsc-full-test-option-btn {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .hsc-opt-cta {
      align-self: flex-end;
    }
  }

  /* ── ROOT & LAYOUT ──────────────────────────────────── */
  .hsc-page {
    --brand: #b00020;
    --brand-dark: #7b0015;
    --brand-light: #fff0f2;
    --brand-mid: #f5c6ce;
    --gold: #d4830f;
    --gold-light: #fef3e2;
    --green: #1b6b3a;
    --green-light: #e8f5ee;
    --bg: #ffffff;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --ink: #111827;
    --ink-soft: #4b5563;
    --ink-muted: #9ca3af;
    --rule: #e5e7eb;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.03);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 12px 28px -4px rgba(176, 0, 32, 0.12), 0 4px 8px -2px rgba(0, 0, 0, 0.04);
    --font-display: 'Source Serif 4', Georgia, serif;
    --font-body: 'Inter', -apple-system, sans-serif;
  }

  /* ── HERO ───────────────────────────────────────────── */
  .hsc-hero {
    background: linear-gradient(180deg, #fff5f6 0%, #ffffff 100%);
    border-bottom: 1px solid var(--rule);
    padding: clamp(32px, 5vw, 64px) 0 40px;
  }

  .hsc-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .hsc-breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s;
  }

  .hsc-breadcrumb a:hover {
    color: var(--brand);
  }

  .hsc-breadcrumb li[aria-current='page'] {
    color: var(--brand);
    font-weight: 600;
  }

  .hsc-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--brand);
    background: #ffffff;
    border: 1px solid var(--brand-mid);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
    box-shadow: 0 2px 6px rgba(176, 0, 32, 0.06);
  }

  .hsc-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand);
    display: inline-block;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
  }

  .hsc-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    color: var(--ink);
    line-height: 1.18;
    margin-bottom: 12px;
  }

  .hsc-highlight {
    color: var(--brand);
    background: linear-gradient(120deg, var(--brand) 0%, #e11d48 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hsc-hero-sub-odia {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--brand-dark);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .hsc-hero-desc {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 820px;
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .hsc-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .hsc-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-badge svg {
    color: var(--green);
  }

  .hsc-badge-free {
    background: var(--green-light);
    color: var(--green);
    border-color: #a7f3d0;
    font-weight: 700;
  }

  .hsc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 40px;
  }

  .hsc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 14px 26px;
    border-radius: 999px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hsc-btn-primary {
    background: var(--brand);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(176, 0, 32, 0.25);
  }

  .hsc-btn-primary:hover {
    background: var(--brand-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(176, 0, 32, 0.35);
  }

  .hsc-btn-secondary {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-sm);
  }

  .hsc-btn-secondary:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-2px);
  }

  .hsc-btn-sm {
    padding: 8px 18px;
    font-size: 0.85rem;
  }

  .hsc-btn-lg {
    padding: 16px 36px;
    font-size: 1.05rem;
  }

  /* Metric Ribbon */
  .hsc-metrics-ribbon {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: var(--shadow-sm);
    gap: 16px;
  }

  .hsc-metric-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4px 8px;
  }

  .hsc-metric-val {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--brand);
    line-height: 1.1;
    font-family: var(--font-display);
  }

  .hsc-metric-lbl {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    margin-top: 4px;
  }

  .hsc-metric-sub {
    font-size: 0.74rem;
    color: var(--ink-muted);
    margin-top: 2px;
    line-height: 1.35;
  }

  .hsc-metric-divider {
    display: none;
  }

  /* ── GENERAL SECTIONS ───────────────────────────────── */
  .hsc-section {
    padding: clamp(48px, 6vw, 80px) 0;
  }

  .hsc-section-alt {
    background: #f8fafc;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .hsc-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    gap: 24px;
  }

  .hsc-header-left {
    max-width: 720px;
  }

  .hsc-tag-pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 8px;
  }

  .hsc-section-header h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    color: var(--ink);
    margin-bottom: 8px;
  }

  .hsc-section-header p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .hsc-quick-all-btn {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--brand);
    background: var(--surface);
    border: 1px solid var(--brand-mid);
    padding: 10px 20px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .hsc-quick-all-btn:hover {
    background: var(--brand);
    color: #ffffff;
  }

  /* ── FILTER TABS ────────────────────────────────────── */
  .hsc-filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .hsc-filter-tab {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hsc-filter-tab:hover {
    border-color: var(--brand-mid);
    color: var(--brand);
  }

  .hsc-filter-tab.active {
    background: var(--brand);
    color: #ffffff;
    border-color: var(--brand);
    box-shadow: 0 2px 8px rgba(176, 0, 32, 0.2);
  }

  /* ── SUBJECT CARDS GRID ─────────────────────────────── */
  .hsc-subjects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .hsc-subject-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .hsc-subject-card:hover {
    transform: translateY(-4px);
    border-color: var(--brand);
    box-shadow: var(--shadow-lg);
  }

  .hsc-card-top-bar {
    height: 5px;
    width: 100%;
  }

  .hsc-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
  }

  .hsc-card-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .hsc-card-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .hsc-card-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .hsc-code-badge {
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--ink);
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .hsc-paper-badge {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .hsc-popular-badge {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--gold);
    background: var(--gold-light);
    padding: 2px 6px;
    border-radius: 999px;
  }

  .hsc-card-title {
    font-size: 1.15rem;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1.25;
  }

  .hsc-card-title-odia {
    font-weight: 600;
    color: var(--brand);
  }

  .hsc-card-desc {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .hsc-card-desc-odia {
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .hsc-substreams {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .hsc-substream-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .hsc-substream-chip {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brand-dark);
    background: var(--brand-light);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* Chapters preview */
  .hsc-chapters-preview {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .hsc-chapters-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .hsc-view-all-link {
    font-size: 0.72rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
  }

  .hsc-view-all-link:hover {
    text-decoration: underline;
  }

  .hsc-chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hsc-chapter-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .hsc-chapter-list svg {
    color: var(--green);
    flex-shrink: 0;
  }

  .hsc-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .hsc-meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hsc-meta-item strong {
    color: var(--ink);
  }

  .hsc-meta-item svg {
    color: var(--ink-muted);
  }

  .hsc-card-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 6px;
  }

  .hsc-btn-practice {
    flex: 1;
    background: var(--brand);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 10px 16px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
  }

  .hsc-btn-practice:hover {
    background: var(--brand-dark);
    transform: translateY(-1px);
  }

  .hsc-btn-syllabus {
    background: var(--surface-2);
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.84rem;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .hsc-btn-syllabus:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  /* ── EXAM PATTERN TABLE ─────────────────────────────── */
  .hsc-table-wrapper {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-pattern-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .hsc-pattern-table th {
    background: var(--surface-2);
    color: var(--ink);
    font-weight: 700;
    padding: 16px 20px;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }

  .hsc-pattern-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    vertical-align: middle;
  }

  .hsc-table-code {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hsc-table-code small {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .hsc-odia-sm {
    font-size: 0.8rem;
    color: var(--brand);
  }

  .hsc-mark-highlight {
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.82rem;
    display: inline-block;
  }

  .hsc-pass-tag {
    font-weight: 700;
    color: var(--ink);
  }

  .hsc-table-total-row {
    background: #fff5f6;
  }

  .hsc-table-total-row td {
    color: var(--ink);
    font-weight: 700;
  }

  .hsc-total-marks {
    color: var(--brand);
    font-size: 1.05rem;
  }

  /* Division cards */
  .hsc-division-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .hsc-div-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 20px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-div-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .hsc-div-medal {
    font-size: 1.8rem;
  }

  .hsc-div-header h4 {
    font-size: 1rem;
    color: var(--ink);
    margin: 0;
  }

  .hsc-div-header p {
    font-size: 0.82rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .hsc-div-first .hsc-div-header p {
    color: var(--green);
  }

  .hsc-div-second .hsc-div-header p {
    color: #2563eb;
  }

  .hsc-div-third .hsc-div-header p {
    color: var(--gold);
  }

  .hsc-div-desc {
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  /* ── SYLLABUS & BLUEPRINT ACCORDION ─────────────────── */
  .hsc-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hsc-details-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .hsc-details-card[open] {
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
  }

  .hsc-details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    background: var(--surface);
  }

  .hsc-details-summary::-webkit-details-marker {
    display: none;
  }

  .hsc-summary-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hsc-summary-icon {
    font-size: 1.8rem;
    background: var(--surface-2);
    padding: 8px;
    border-radius: 10px;
    line-height: 1;
  }

  .hsc-summary-title {
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .hsc-summary-sub {
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .hsc-details-arrow {
    font-size: 1.4rem;
    color: var(--ink-muted);
    transition: transform 0.2s ease;
  }

  .hsc-details-card[open] .hsc-details-arrow {
    transform: rotate(45deg);
    color: var(--brand);
  }

  .hsc-details-content {
    padding: 0 24px 24px;
    border-top: 1px solid var(--rule);
    background: #f8fafc;
  }

  .hsc-units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .hsc-unit-box {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 18px;
  }

  .hsc-unit-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .hsc-unit-head h4 {
    font-size: 0.95rem;
    color: var(--ink);
    margin: 0;
  }

  .hsc-unit-odia {
    font-size: 0.78rem;
    color: var(--brand);
    font-weight: 600;
  }

  .hsc-weightage-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .hsc-unit-topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hsc-unit-topics li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .hsc-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .hsc-details-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px dashed var(--rule);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* ── OMR TIPS ───────────────────────────────────────── */
  .hsc-tips-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .hsc-tip-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }

  .hsc-tip-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .hsc-tip-icon {
    font-size: 1.8rem;
  }

  .hsc-tip-num {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--brand);
    opacity: 0.4;
    font-family: var(--font-display);
  }

  .hsc-tip-title {
    font-size: 1rem;
    color: var(--ink);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .hsc-tip-odia {
    font-size: 0.8rem;
    color: var(--brand);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .hsc-tip-desc {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .hsc-omr-callout {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 12px;
    padding: 18px 24px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    color: #92400e;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .hsc-callout-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  /* ── FAQS ───────────────────────────────────────────── */
  .hsc-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 900px;
  }

  .hsc-faq-item {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    overflow: hidden;
  }

  .hsc-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    gap: 16px;
  }

  .hsc-faq-summary::-webkit-details-marker {
    display: none;
  }

  .hsc-faq-q-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hsc-faq-q-text {
    font-weight: 700;
    color: var(--ink);
    font-size: 0.98rem;
  }

  .hsc-faq-q-odia {
    font-size: 0.84rem;
    color: var(--brand);
    font-weight: 600;
  }

  .hsc-faq-icon {
    font-size: 1.4rem;
    color: var(--ink-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .hsc-faq-item[open] .hsc-faq-icon {
    transform: rotate(45deg);
    color: var(--brand);
  }

  .hsc-faq-answer {
    padding: 0 22px 20px;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    border-top: 1px solid var(--surface-2);
  }

  /* ── FINAL CTA ──────────────────────────────────────── */
  .hsc-final-cta {
    background: linear-gradient(135deg, #7b0015 0%, #b00020 100%);
    color: #ffffff;
    padding: clamp(48px, 6vw, 80px) 0;
    text-align: center;
  }

  .hsc-cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hsc-cta-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .hsc-cta-inner h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: #ffffff;
    margin-bottom: 12px;
  }

  .hsc-cta-inner p {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .hsc-final-cta .hsc-btn-primary {
    background: #ffffff;
    color: var(--brand);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  .hsc-final-cta .hsc-btn-primary:hover {
    background: var(--surface-2);
    transform: translateY(-2px);
  }

  .hsc-cta-disclaimer {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.7) !important;
    margin-top: 24px;
  }

  /* ── INTERACTIVE TEST RUNNER MODAL ──────────────────── */
  .hsc-test-modal {
    width: 96vw;
    max-width: 1100px;
    height: 94vh;
    max-height: 900px;
    border: none;
    border-radius: 20px;
    padding: 0;
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .hsc-test-modal::backdrop {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }

  @media (max-width: 768px) {
    .hsc-test-modal {
      width: 100vw;
      height: 100vh;
      max-width: 100vw;
      max-height: 100vh;
      border-radius: 0;
    }
    .hsc-modal-header {
      padding: 10px 16px;
      gap: 10px;
    }
    .hsc-modal-test-name {
      font-size: 0.95rem;
    }
    .hsc-modal-timer-box {
      font-size: 0.9rem;
      padding: 4px 10px;
    }
    .hsc-test-main-view {
      padding: 16px;
    }
  }

  @media (max-width: 540px) {
    .hsc-modal-header-left {
      gap: 8px;
    }
    .hsc-test-badge {
      display: none;
    }
  }

  .hsc-modal-container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hsc-modal-header {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .hsc-modal-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hsc-test-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .hsc-modal-test-name {
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 700;
  }

  .hsc-modal-timer-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff1f2;
    color: #e11d48;
    border: 1px solid #fecdd3;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: monospace;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .hsc-modal-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hsc-modal-btn-palette {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .hsc-modal-btn-palette:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .hsc-modal-btn-close {
    background: transparent;
    border: none;
    font-size: 1.8rem;
    color: var(--ink-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
  }

  .hsc-modal-btn-close:hover {
    color: var(--brand);
  }

  .hsc-modal-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .hsc-test-main-view {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .hsc-progress-track {
    height: 4px;
    background: var(--rule);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .hsc-progress-fill {
    height: 100%;
    background: var(--brand);
    transition: width 0.3s ease;
  }

  /* Question card */
  .hsc-question-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 28px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
    flex: 1;
  }

  .hsc-q-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .hsc-q-counter {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--brand);
  }

  .hsc-q-section-tag {
    font-size: 0.78rem;
    background: var(--surface-2);
    color: var(--ink-soft);
    padding: 3px 10px;
    border-radius: 999px;
    font-weight: 600;
  }

  .hsc-btn-mark-review {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 4px 12px;
    cursor: pointer;
  }

  .hsc-btn-mark-review.marked {
    background: #f3e8ff;
    border-color: #d8b4fe;
    color: #7c3aed;
    font-weight: 700;
  }

  .hsc-q-text-wrap {
    margin-bottom: 24px;
  }

  .hsc-q-text {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .hsc-q-text-odia {
    font-size: 1.05rem;
    color: var(--brand-dark);
    line-height: 1.5;
    font-weight: 500;
  }

  /* Options Grid */
  .hsc-options-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hsc-opt-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface-2);
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 14px 18px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .hsc-opt-card:hover {
    background: #ffffff;
    border-color: var(--brand-mid);
  }

  .hsc-opt-card.selected {
    background: #ffffff;
    border-color: var(--brand);
    box-shadow: 0 4px 12px rgba(176, 0, 32, 0.1);
  }

  .hsc-opt-card input {
    display: none;
  }

  .hsc-opt-letter {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--ink);
    flex-shrink: 0;
  }

  .hsc-opt-card.selected .hsc-opt-letter {
    background: var(--brand);
    border-color: var(--brand);
    color: #ffffff;
  }

  .hsc-opt-label {
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.4;
  }

  /* Test Footer */
  .hsc-test-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    gap: 16px;
  }

  .hsc-footer-left,
  .hsc-footer-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hsc-btn-text {
    background: transparent;
    border: none;
    color: var(--ink-muted);
    font-size: 0.84rem;
    cursor: pointer;
    text-decoration: underline;
  }

  .hsc-btn-text:hover {
    color: var(--brand);
  }

  .hsc-btn-submit {
    background: var(--green);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(27, 107, 58, 0.25);
  }

  .hsc-btn-submit:hover {
    background: #14532d;
  }

  /* Palette Sidebar */
  .hsc-palette-sidebar {
    width: 300px;
    background: var(--surface);
    border-left: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    padding: 20px;
    overflow-y: auto;
  }

  .hsc-palette-header {
    margin-bottom: 16px;
  }

  .hsc-palette-header h3 {
    font-size: 1rem;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .hsc-palette-legend {
    display: flex;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }

  .leg-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .leg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-ans {
    background: var(--green);
  }

  .dot-unans {
    background: var(--rule);
  }

  .dot-mark {
    background: #7c3aed;
  }

  .hsc-palette-bubbles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin-bottom: auto;
  }

  .hsc-palette-bubble {
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: var(--surface-2);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hsc-palette-bubble.active {
    border: 2px solid var(--brand);
  }

  .hsc-palette-bubble.ans {
    background: var(--green);
    color: #ffffff;
    border-color: var(--green);
  }

  .hsc-palette-bubble.marked {
    background: #7c3aed;
    color: #ffffff;
    border-color: #7c3aed;
  }

  .hsc-palette-footer {
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    margin-top: 16px;
  }

  .hsc-btn-full {
    width: 100%;
  }

  /* ── RESULT & REVIEW VIEW ───────────────────────────── */
  .hsc-result-view {
    flex: 1;
    overflow-y: auto;
    padding: 32px;
  }

  .hsc-scorecard {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 20px;
    padding: 36px;
    max-width: 680px;
    margin: 0 auto 32px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .hsc-score-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .hsc-score-title {
    font-size: 1.5rem;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .hsc-score-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 36px;
    margin-bottom: 28px;
  }

  .hsc-score-circle {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fff0f2 0%, #ffe4e6 100%);
    border: 4px solid var(--brand);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(176, 0, 32, 0.15);
  }

  .hsc-score-big {
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--brand);
    line-height: 1;
    font-family: var(--font-display);
  }

  .hsc-score-total {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .hsc-score-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
  }

  .hsc-score-metric {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 0.92rem;
    border-bottom: 1px dashed var(--rule);
    padding-bottom: 6px;
  }

  .hsc-score-metric span {
    color: var(--ink-soft);
  }

  .hsc-result-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Review answers */
  .hsc-review-container {
    max-width: 860px;
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .hsc-review-header {
    margin-bottom: 24px;
  }

  .hsc-review-header h3 {
    font-size: 1.3rem;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .hsc-review-header p {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .hsc-review-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hsc-rev-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 22px;
    box-shadow: var(--shadow-sm);
  }

  .hsc-rev-card.rev-correct {
    border-left: 5px solid var(--green);
  }

  .hsc-rev-card.rev-wrong {
    border-left: 5px solid var(--brand);
  }

  .hsc-rev-num-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }

  .hsc-rev-status-pill {
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
  }

  .pill-corr {
    background: var(--green-light);
    color: var(--green);
  }

  .pill-wrn {
    background: var(--brand-light);
    color: var(--brand);
  }

  .hsc-rev-q {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
    line-height: 1.45;
  }

  .hsc-rev-q-odia {
    font-size: 0.98rem;
    color: var(--brand-dark);
    margin-bottom: 14px;
    line-height: 1.45;
  }

  .hsc-rev-answers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 14px;
  }

  .hsc-ans-box {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .box-green {
    background: var(--green-light);
    color: #14532d;
    border: 1px solid #bbf7d0;
  }

  .box-red {
    background: var(--brand-light);
    color: var(--brand-dark);
    border: 1px solid var(--brand-mid);
  }

  .hsc-rev-exp {
    background: var(--surface-2);
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .hsc-rev-exp strong {
    color: var(--ink);
    display: block;
    margin-bottom: 4px;
  }

  .exp-odia {
    margin-top: 6px;
    color: var(--brand-dark);
    font-weight: 500;
  }

  /* ── RESPONSIVE DESIGN ──────────────────────────────── */
  @media (max-width: 1024px) {
    .hsc-subjects-grid {
      grid-template-columns: repeat(2, 1fr);
