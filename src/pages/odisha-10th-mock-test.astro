</BaseLayout>

<!-- Client-Side State & Test Runner Engine (100% Static, ZERO API Needed) -->
<script is:inline define:vars={{ questionsData: ODISHA_10TH_QUESTIONS, subjectsData: ODISHA_10TH_SUBJECTS }}>
  (function () {
    // --- Tab Filtering for Subjects ---
    const filterTabs = document.querySelectorAll('.hsc-filter-tab');
    const subjectCards = document.querySelectorAll('.hsc-subject-row');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filterVal = tab.getAttribute('data-filter');
        subjectCards.forEach((card) => {
          if (filterVal === 'all' || card.getAttribute('data-subject-id') === filterVal) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // --- Static Test Runner Engine ---
    const modal = document.getElementById('hsc-test-modal');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnExitModal = document.getElementById('btn-exit-modal');
    const btnTogglePalette = document.getElementById('btn-toggle-palette');
    const paletteSidebar = document.getElementById('palette-sidebar');

    const testMainView = document.getElementById('test-main-view');
    const testResultView = document.getElementById('test-result-view');
    const reviewContainer = document.getElementById('review-container');

    const modalTitle = document.getElementById('modal-test-title');
    const modalBadge = document.getElementById('modal-subject-badge');
    const modalTimer = document.getElementById('modal-timer');
    const modalProgress = document.getElementById('modal-progress-fill');

    const qCounter = document.getElementById('q-counter');
    const qSectionTag = document.getElementById('q-section-tag');
    const btnMarkReview = document.getElementById('btn-mark-review');
    const qTextEn = document.getElementById('q-text-en');
    const qTextOr = document.getElementById('q-text-or');
    const optionsContainer = document.getElementById('options-container');

    const btnPrevQ = document.getElementById('btn-prev-q');
    const btnNextQ = document.getElementById('btn-next-q');
    const btnClearQ = document.getElementById('btn-clear-q');
    const btnSubmitTest = document.getElementById('btn-submit-test');
    const btnPaletteSubmit = document.getElementById('btn-palette-submit');

    const paletteBubbles = document.getElementById('palette-bubbles');

    // Result elements
    const resScore = document.getElementById('res-score');
    const resTotal = document.getElementById('res-total');
    const resPercent = document.getElementById('res-percent');
    const resDivision = document.getElementById('res-division');
    const resTimeTaken = document.getElementById('res-time-taken');
    const btnReviewAnswers = document.getElementById('btn-review-answers');
    const btnRetakeTest = document.getElementById('btn-retake-test');
    const reviewList = document.getElementById('review-list');

    let activeQuestions = [];
    let currentIdx = 0;
    let userAnswers = {}; // { qIdx: selectedOptionIdx }
    let markedForReview = new Set();
    let timerSeconds = 45 * 60;
    let timerInterval = null;
    let testStartTime = 0;
    let currentSubjectId = 'all';

    function blockScroll() {
      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    }

    function unblockScroll() {
      document.documentElement.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    }

    function startTest(subjectId, mode = 'full', chapterIndex = null, topic = null) {
      currentSubjectId = subjectId;
      if (subjectId === 'all') {
        activeQuestions = [...questionsData];
        modalTitle.textContent = 'BSE Class 10 Grand Mock Test (All Subjects)';
        modalBadge.textContent = 'Full Model Set';
      } else {
        const subj = subjectsData.find((s) => s.id === subjectId);
        let subjQuestions = questionsData.filter((q) => q.subjectId === subjectId);

        if (mode === 'topic' && topic) {
          activeQuestions = subjQuestions.filter((q) => (q.topic || '').includes(topic.key));
          modalTitle.textContent = topic.title;
          modalBadge.textContent = 'Chapter Test';
        } else if (mode === 'chapter' && chapterIndex !== null && subj && subj.chapters[chapterIndex]) {
          const ch = subj.chapters[chapterIndex];
          const filtered = ch.topicKey
            ? subjQuestions.filter((q) => q.topic && (q.topic.includes(ch.topicKey) || ch.topicKey.includes(q.topic)))
            : subjQuestions.filter((q) => {
            return (q.topic && (q.topic === ch.unit || ch.unit.includes(q.topic) || q.topic.includes(ch.unit))) ||
                   ch.topics.some((t) => q.topic && q.topic.toLowerCase().includes(t.toLowerCase()));
          });
          activeQuestions = filtered.length > 0 || ch.topicKey ? filtered : subjQuestions.slice(0, 5);
          modalTitle.textContent = `${subj.name}: ${ch.unit}`;
          modalBadge.textContent = 'Chapter Practice';
        } else {
          activeQuestions = subjQuestions.length > 0 ? subjQuestions : [...questionsData];
          modalTitle.textContent = subj ? `${subj.name} (${subj.nameOdia}) Full Mock Test` : '10th Mock Test';
          modalBadge.textContent = subj ? subj.code : 'BSE Class 10';
        }
      }

      if (!activeQuestions.length) {
        alert('This test is coming soon.');
        return;
      }

      currentIdx = 0;
      userAnswers = {};
      markedForReview.clear();
      timerSeconds = (topic && topic.minutes ? topic.minutes : 45) * 60;
      testStartTime = Date.now();

      testMainView.hidden = false;
      testResultView.hidden = true;
      reviewContainer.hidden = true;

      renderPalette();
      loadQuestion(0);
      startTimer();

      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', 'true');
      }
      blockScroll();
    }

    function closeTestModal() {
      if (timerInterval) clearInterval(timerInterval);
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
      unblockScroll();
    }

    modal.addEventListener('cancel', () => {
      unblockScroll();
    });

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        timerSeconds--;
        updateTimerDisplay();
        if (timerSeconds <= 0) {
          clearInterval(timerInterval);
          alert('Time is up! Submitting your mock test.');
          finishTest();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(timerSeconds / 60);
      const secs = timerSeconds % 60;
      modalTimer.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function loadQuestion(idx) {
      currentIdx = idx;
      const q = activeQuestions[idx];
      if (!q) return;

      qCounter.textContent = `Question ${idx + 1} of ${activeQuestions.length}`;
      qSectionTag.textContent = q.topic || q.section;
      qTextEn.textContent = q.text;
      qTextOr.textContent = q.textOdia || '';

      const percent = ((idx + 1) / activeQuestions.length) * 100;
      modalProgress.style.width = `${percent}%`;

      // Update Mark for review status
      const isMarked = markedForReview.has(idx);
      btnMarkReview.classList.toggle('marked', isMarked);
      document.getElementById('mark-text').textContent = isMarked ? 'Marked for Review' : 'Mark for Review';

      // Render options
      optionsContainer.innerHTML = '';
      q.options.forEach((optText, optIdx) => {
        const optCard = document.createElement('label');
        optCard.className = 'hsc-opt-card';
        if (userAnswers[idx] === optIdx) {
          optCard.classList.add('selected');
        }

        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = `opt_q_${idx}`;
        radio.value = optIdx;
        radio.checked = userAnswers[idx] === optIdx;

        const letters = ['A', 'B', 'C', 'D'];
        const letterBadge = document.createElement('span');
        letterBadge.className = 'hsc-opt-letter';
        letterBadge.textContent = letters[optIdx] || optIdx + 1;

        const labelSpan = document.createElement('span');
        labelSpan.className = 'hsc-opt-label';
        labelSpan.textContent = optText;

        optCard.appendChild(radio);
        optCard.appendChild(letterBadge);
        optCard.appendChild(labelSpan);

        optCard.addEventListener('click', (e) => {
          userAnswers[idx] = optIdx;
          document.querySelectorAll('.hsc-opt-card').forEach((c) => c.classList.remove('selected'));
          optCard.classList.add('selected');
          updatePaletteBubble(idx);
        });

        optionsContainer.appendChild(optCard);
      });

      // Update Prev / Next buttons
      btnPrevQ.disabled = idx === 0;
      btnNextQ.disabled = idx === activeQuestions.length - 1;

      updatePaletteBubble(idx);
    }

    function renderPalette() {
      paletteBubbles.innerHTML = '';
      activeQuestions.forEach((_, idx) => {
        const bubble = document.createElement('button');
        bubble.type = 'button';
        bubble.className = 'hsc-palette-bubble';
        bubble.id = `palette-b-${idx}`;
        bubble.textContent = (idx + 1).toString();
        bubble.setAttribute('aria-label', `Question ${idx + 1}`);

        bubble.addEventListener('click', () => {
          loadQuestion(idx);
          if (window.innerWidth < 768) {
            paletteSidebar.classList.remove('open');
          }
        });

        paletteBubbles.appendChild(bubble);
      });
    }

    function updatePaletteBubble(idx) {
      const bubble = document.getElementById(`palette-b-${idx}`);
      if (!bubble) return;

      bubble.classList.remove('ans', 'unans', 'marked', 'active');

      if (idx === currentIdx) {
        bubble.classList.add('active');
      }

      if (markedForReview.has(idx)) {
        bubble.classList.add('marked');
      } else if (userAnswers[idx] !== undefined) {
        bubble.classList.add('ans');
      } else {
        bubble.classList.add('unans');
      }
    }

    // Toggle Review
    btnMarkReview.addEventListener('click', () => {
      if (markedForReview.has(currentIdx)) {
        markedForReview.delete(currentIdx);
      } else {
        markedForReview.add(currentIdx);
      }
      loadQuestion(currentIdx);
    });

    // Clear response
    btnClearQ.addEventListener('click', () => {
      delete userAnswers[currentIdx];
      loadQuestion(currentIdx);
    });

    // Navigation
    btnPrevQ.addEventListener('click', () => {
      if (currentIdx > 0) loadQuestion(currentIdx - 1);
    });

    btnNextQ.addEventListener('click', () => {
      if (currentIdx < activeQuestions.length - 1) loadQuestion(currentIdx + 1);
    });

    // Palette toggle
    btnTogglePalette.addEventListener('click', () => {
      paletteSidebar.classList.toggle('open');
    });

    // Submit test handler
    function finishTest() {
      if (timerInterval) clearInterval(timerInterval);

      let correctCount = 0;
      activeQuestions.forEach((q, idx) => {
        if (userAnswers[idx] === q.correct) {
          correctCount++;
        }
      });

      const totalQs = activeQuestions.length;
      const percentage = Math.round((correctCount / totalQs) * 100);
      const timeSpentSecs = Math.round((Date.now() - testStartTime) / 1000);
      const timeSpentMins = Math.max(1, Math.round(timeSpentSecs / 60));

      resScore.textContent = correctCount;
      resTotal.textContent = `/ ${totalQs}`;
      resPercent.textContent = `${percentage}%`;
      resTimeTaken.textContent = `${timeSpentMins} min`;

      if (percentage >= 80) {
        resDivision.textContent = 'Grade A1 (Distinction) 🌟';
        resDivision.style.color = '#1B6B3A';
      } else if (percentage >= 60) {
        resDivision.textContent = '1st Division (Passed) 👍';
        resDivision.style.color = '#2563EB';
      } else if (percentage >= 45) {
        resDivision.textContent = '2nd Division (Qualified) 📘';
        resDivision.style.color = '#D97706';
      } else if (percentage >= 33) {
        resDivision.textContent = '3rd Division (Pass) 📙';
        resDivision.style.color = '#7C3AED';
      } else {
        resDivision.textContent = 'Needs More Practice ⚠️';
        resDivision.style.color = '#B00020';
      }

      testMainView.hidden = true;
      testResultView.hidden = false;
      reviewContainer.hidden = true;
    }

    btnSubmitTest.addEventListener('click', () => {
      const answeredCount = Object.keys(userAnswers).length;
      const total = activeQuestions.length;
      const confirmed = confirm(
        `You have answered ${answeredCount} of ${total} questions. Are you sure you want to submit your mock test?`
      );
      if (confirmed) finishTest();
    });

    btnPaletteSubmit.addEventListener('click', () => {
      btnSubmitTest.click();
    });

    // Review answer keys
    btnReviewAnswers.addEventListener('click', () => {
      reviewContainer.hidden = false;
      reviewList.innerHTML = '';

      activeQuestions.forEach((q, idx) => {
        const item = document.createElement('div');
        const userChoice = userAnswers[idx];
        const isCorrect = userChoice === q.correct;

        item.className = `hsc-rev-card ${isCorrect ? 'rev-correct' : 'rev-wrong'}`;

        const letters = ['A', 'B', 'C', 'D'];
        const userText = userChoice !== undefined ? `${letters[userChoice]}. ${q.options[userChoice]}` : 'Not Attempted';
        const correctText = `${letters[q.correct]}. ${q.options[q.correct]}`;

        item.innerHTML = `
          <div class="hsc-rev-num-bar">
            <span>Question ${idx + 1} • ${q.section}</span>
            <span class="hsc-rev-status-pill ${isCorrect ? 'pill-corr' : 'pill-wrn'}">
              ${isCorrect ? '✓ Correct (+1 Mark)' : '✗ Incorrect (0 Mark)'}
            </span>
          </div>
          <p class="hsc-rev-q">${q.text}</p>
          ${q.textOdia ? `<p class="hsc-rev-q-odia">${q.textOdia}</p>` : ''}
          <div class="hsc-rev-answers">
            <div class="hsc-ans-box ans-user ${isCorrect ? 'box-green' : 'box-red'}">
              <strong>Your Choice:</strong> ${userText}
            </div>
            <div class="hsc-ans-box ans-correct box-green">
              <strong>Correct Answer:</strong> ${correctText}
            </div>
          </div>
          <div class="hsc-rev-exp">
            <strong>Explanation (ସମାଧାନ):</strong>
            <p>${q.explanation}</p>
            ${q.explanationOdia ? `<p class="exp-odia">${q.explanationOdia}</p>` : ''}
          </div>
        `;
        reviewList.appendChild(item);
      });

      reviewContainer.scrollIntoView({ behavior: 'smooth' });
    });

    // Retake Test
    btnRetakeTest.addEventListener('click', () => {
      startTest(currentSubjectId);
    });

    // Mode Modal Logic
    const modeModal = document.getElementById('hsc-mode-modal');
    const btnCloseModeModal = document.getElementById('btn-close-mode-modal');
    const modeSubjectName = document.getElementById('mode-subject-name');
    const modeModalBadge = document.getElementById('mode-modal-badge');
    const btnModeFull = document.getElementById('btn-mode-full');
    const chaptersListContainer = document.getElementById('chapters-list-container');

    let selectedSubjectForMode = null;

    function openModeModal(subjectId) {
      if (subjectId === 'all') {
        startTest('all');
        return;
      }
      selectedSubjectForMode = subjectId;
      const subj = subjectsData.find((s) => s.id === subjectId);
      modeSubjectName.textContent = subj ? `${subj.name} (${subj.nameOdia})` : 'Subject';
      modeModalBadge.textContent = subj ? subj.code : 'BSE Class 10';

      renderChaptersList(subjectId);

      if (typeof modeModal.showModal === 'function') {
        modeModal.showModal();
      } else {
        modeModal.setAttribute('open', 'true');
      }
      blockScroll();
    }

    function closeModeModal() {
      if (typeof modeModal.close === 'function') {
        modeModal.close();
      } else {
        modeModal.removeAttribute('open');
      }
      unblockScroll();
    }

    modeModal.addEventListener('cancel', () => {
      unblockScroll();
    });

    modeModal.addEventListener('click', (e) => {
      const rect = modeModal.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        closeModeModal();
      }
    });

    if (btnCloseModeModal) {
      btnCloseModeModal.addEventListener('click', closeModeModal);
    }

    if (btnModeFull) {
      btnModeFull.addEventListener('click', () => {
        closeModeModal();
        startTest(selectedSubjectForMode, 'full');
      });
    }

    function renderChaptersList(subjectId) {
      if (!chaptersListContainer) return;
      chaptersListContainer.innerHTML = '';
      const subj = subjectsData.find((s) => s.id === subjectId);
      if (!subj || !subj.chapters) return;

      subj.chapters.forEach((ch, chIdx) => {
        // Skip chapters that are coming soon or have no questions yet
        const hasQuestions = !ch.topicKey || questionsData.some((q) => q.subjectId === subjectId && q.topic &&
          (q.topic.includes(ch.topicKey) || ch.topicKey.includes(q.topic)));
        if (ch.comingSoon || !hasQuestions) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'hsc-chapter-item-btn';

        btn.innerHTML = `
          <div class="hsc-ch-info">
            <strong class="hsc-ch-title">${ch.unit}</strong>
            <span class="hsc-ch-sub">${ch.unitOdia}${ch.weightageMarks ? ` • Weightage: ${ch.weightageMarks} Marks` : ''}</span>
          </div>
          <span class="hsc-ch-cta">
            <span class="hsc-ch-cta-text">Practice</span>
            <span class="hsc-ch-cta-icon" aria-hidden="true">→</span>
          </span>
        `;

        btn.addEventListener('click', () => {
          closeModeModal();
          startTest(subjectId, 'chapter', chIdx);
        });

        chaptersListContainer.appendChild(btn);
      });
    }

    // Modal Close
    btnCloseModal.addEventListener('click', closeTestModal);
    btnExitModal.addEventListener('click', closeTestModal);

    // Attach Launch Buttons from Page
    document.querySelectorAll('[data-subject]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const subjId = btn.getAttribute('data-subject') || 'all';
        openModeModal(subjId);
      });
    });

    // "Available now" topic tests
    document.querySelectorAll('[data-start-topic]').forEach((btn) => {
      btn.addEventListener('click', () => {
        startTest(btn.getAttribute('data-start-topic'), 'topic', null, {
          key: btn.getAttribute('data-topic-key'),
          title: btn.getAttribute('data-topic-title'),
          minutes: Number(btn.getAttribute('data-minutes')) || 5,
        });
      });
    });

    // Subject-row posters start the test directly (full or chapter)
    document.querySelectorAll('[data-start-test]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const subjId = btn.getAttribute('data-start-test');
        const ch = btn.getAttribute('data-chapter');
        const pace = { minutes: Number(btn.getAttribute('data-minutes')) || 45 };
        if (ch === null) startTest(subjId, 'full', null, pace);
        else startTest(subjId, 'chapter', Number(ch), pace);
      });
    });

    // Row arrows
    document.querySelectorAll('.sx-subject').forEach((sec) => {
      const row = sec.querySelector('.sx-row');
      const arrows = sec.querySelectorAll('.sx-arrow');
      if (!row || arrows.length < 2) return;
      const update = () => {
        const max = row.scrollWidth - row.clientWidth - 2;
        arrows[0].disabled = row.scrollLeft <= 2;
        arrows[1].disabled = row.scrollLeft >= max;
        sec.classList.toggle('sx-no-scroll', max <= 0);
      };
      arrows.forEach((a) => a.addEventListener('click', () => {
        row.scrollBy({ left: Number(a.dataset.dir) * row.clientWidth * 0.85, behavior: 'smooth' });
      }));
      row.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  })();
</script>

