---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchMockTests } from '../../lib/api/mockTestService';

const examTypes = ['All', 'OSSSC', 'OPSC', 'OSSC', 'SSC', 'Railway', 'Banking', 'Police', 'General'];

// ── Read filter params from URL for SSR-side filtering ──
const url = new URL(Astro.request.url);
const ssrDifficulty = url.searchParams.get('difficulty') || 'All';
const ssrExam      = url.searchParams.get('exam')       || 'All';
const ssrSearch    = url.searchParams.get('q')          || '';

// ── SSR: Fetch tests on the server with active filters applied ──
let ssrTests: any[] = [];
let ssrTotal = 0;
try {
  const { data: rows, pagination } = await fetchMockTests(1, 100, {
    difficulty: ssrDifficulty,
    exam: ssrExam,
    search: ssrSearch,
  });
  ssrTotal = pagination?.total ?? rows.length;
  ssrTests = (Array.isArray(rows) ? rows : []).map((t: any) => ({
    id: t.id,
    slug: String(t.id ?? t.slug ?? ""),
    title: t.title || t.name,
    exam: t.exam || t.category || "General",
    questions: Array.isArray(t.questions) ? t.questions.length : (t.questions || 0),
    duration: t.duration || 30,
    difficulty: t.difficulty || "Medium",
    attempts: t.attempts || 0,
    rating: t.rating || 5,
    isFree: !!(t.is_free || t.isFree),
    isNew: !!(t.is_new || t.isNew),
    tags: [t.exam || t.category || "General"]
  }));
} catch (err) {
  console.error("SSR: Failed to fetch mock tests:", err);
}
---

<BaseLayout
  title="All Mock Tests"
  description="Browse 280+ free mock tests for OSSSC, OPSC, OSSC, SSC, Railway, Banking and more. Filter by exam, difficulty, and topic."
>

<section class="page-hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <h1 id="hero-title">All Mock Tests</h1>
      <p id="hero-sub">280+ free tests across all major Odisha & central govt exams.</p>
    </div>
    <div class="search-box">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search tests, exams, topics…"
        autocomplete="off"
        aria-label="Search tests"
      />
    </div>
  </div>
</section>

<div class="wrap listing-layout">

  <!-- Filters sidebar -->
  <aside class="filters" aria-label="Filter tests">
    <div class="filter-group" id="exam-filter-group">
      <h3>Exam</h3>
      <ul class="filter-list" id="exam-filter">
        {examTypes.map((e, i) => (
          <li>
            <button
              class={`filter-btn ${i === 0 ? 'active' : ''}`}
              data-exam={e}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {e}
              <span class="filter-count" id={`cnt-${e.toLowerCase()}`}>0</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="filter-group">
      <h3>Difficulty</h3>
      <ul class="filter-list" id="diff-filter">
        {['All', 'Easy', 'Medium', 'Hard'].map((d, i) => (
          <li>
            <button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-diff={d} aria-pressed={i === 0 ? 'true' : 'false'}>
              {d}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="filter-group">
      <h3>Duration</h3>
      <ul class="filter-list" id="dur-filter">
        {['All', '30 min', '60 min', 'Over 60 min'].map((d, i) => (
          <li>
            <button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-dur={d} aria-pressed={i === 0 ? 'true' : 'false'}>
              {d}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- Main content -->
  <div class="tests-main">
    <div class="toolbar">
      <span class="result-count" id="result-count">{ssrTests.length > 0 ? `${ssrTests.length} test${ssrTests.length !== 1 ? 's' : ''}` : 'Loading tests...'}</span>
      <div class="toolbar-right">
        <button type="button" id="open-filter-sheet" class="mobile-filter-btn" aria-label="Open filter options">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          <span>Filters</span>
          <span class="filter-active-dot" id="filter-active-dot" style="display:none"></span>
        </button>
      </div>
    </div>

    <div class="tests-grid" id="tests-grid">
      {ssrTests.length > 0 ? (
        ssrTests.map(t => (
          <a href={`/mocktest/test/${t.slug}`} class="test-card">
            <div class="tc-top">
              <span class="exam-tag">{t.exam}</span>
              <div class="badges">
                {t.isNew && <span class="badge-new">New</span>}
                <span class="badge-free">Free</span>
              </div>
            </div>
            <h2 class="tc-title">{t.title}</h2>
            <div class="tc-tags">
              {t.tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
            <div class="tc-meta">
              <span class="meta-item">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                {t.questions} Questions
              </span>
              <span class="meta-item">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {t.duration} min
              </span>
              <span class={`diff-badge diff-${t.difficulty.toLowerCase()}`}>{t.difficulty}</span>
            </div>
            <div class="tc-footer">
              <div class="tc-stats">
                <span>
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  {(t.attempts || 0).toLocaleString('en-IN')}
                </span>
                <span class="star-rating">★ {t.rating}</span>
              </div>
              <span class="attempt-cta">Attempt →</span>
            </div>
          </a>
        ))
      ) : (
        <div class="tests-loading" id="tests-loading" style="grid-column: 1 / -1; text-align: center; padding: 60px 0; color: var(--ink-soft);">
          <div class="am-spinner" style="margin: 0 auto 12px; width: 32px; height: 32px; border: 3px solid var(--rule); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
          <p>Loading mock tests...</p>
        </div>
      )}
    </div>

    <p class="empty-msg" id="empty-msg" style="display:none">
      No tests match your filters. <button id="reset-filters">Reset filters</button>
    </p>
  </div>

</div>

<!-- Mobile Bottom Sheet Drawer -->
<div id="filter-sheet" class="filter-sheet" aria-hidden="true">
  <div class="sheet-backdrop" id="close-filter-sheet-bg"></div>
  <div class="sheet-content">
    <div class="sheet-handle-bar"><span class="sheet-handle"></span></div>
    <div class="sheet-header">
      <h2>Filters</h2>
      <button type="button" id="close-filter-sheet-btn" class="sheet-close-btn" aria-label="Close filters">✕</button>
    </div>
    <div class="sheet-body">
      <div class="filter-group" id="m-exam-filter-group">
        <h3>Exam</h3>
        <ul class="filter-list" id="m-exam-filter">
          {examTypes.map((e, i) => (
            <li>
              <button
                class={`filter-btn ${i === 0 ? 'active' : ''}`}
                data-exam={e}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {e}
                <span class="filter-count" id={`m-cnt-${e.toLowerCase()}`}>0</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="filter-group">
        <h3>Difficulty</h3>
        <ul class="filter-list" id="m-diff-filter">
          {['All', 'Easy', 'Medium', 'Hard'].map((d, i) => (
            <li>
              <button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-diff={d} aria-pressed={i === 0 ? 'true' : 'false'}>
                {d}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="filter-group">
        <h3>Duration</h3>
        <ul class="filter-list" id="m-dur-filter">
          {['All', '30 min', '60 min', 'Over 60 min'].map((d, i) => (
            <li>
              <button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-dur={d} aria-pressed={i === 0 ? 'true' : 'false'}>
                {d}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="sheet-footer">
      <button type="button" id="sheet-reset-btn" class="sheet-btn-secondary">Reset</button>
      <button type="button" id="sheet-apply-btn" class="sheet-btn-primary">Apply Filters</button>
    </div>
  </div>
</div>

<!-- Floating Bottom-Right Filter Button (shows on scroll) -->
<button type="button" id="floating-filter-btn" class="floating-filter-btn" aria-label="Open filter options" style="display: none;">
  <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
  <span>Filter</span>
  <span class="filter-active-dot" id="floating-active-dot" style="display:none"></span>
</button>

</BaseLayout>

<!-- SSR data for client hydration -->
<script is:inline define:vars={{
  ssrTestsJSON: JSON.stringify(ssrTests),
  ssrFilters: { difficulty: ssrDifficulty, exam: ssrExam, search: ssrSearch }
}}>
  window.__SSR_TESTS__   = JSON.parse(ssrTestsJSON);
  window.__SSR_FILTERS__ = ssrFilters;
</script>

<script is:inline>
function __initTestsPage() {
  // Guard: only init once per page instance (prevents duplicate listeners on ClientRouter nav)
  const gridEl = document.getElementById('tests-grid');
  if (!gridEl) return;
  if (gridEl.dataset.initialized === 'true') return;
  gridEl.dataset.initialized = 'true';

  // Restore filter state from SSR (server already applied difficulty/exam/search)
  const ssrFilters = window.__SSR_FILTERS__ || {};

  // Use SSR-fetched data as initial state (instant render, no loading spinner)
  let allTests = Array.isArray(window.__SSR_TESTS__) ? window.__SSR_TESTS__.slice() : [];
  let activeExam = ssrFilters.exam || 'All';
  let activeDiff = ssrFilters.difficulty || 'All';
  let activeDur = 'All'; // duration filter is client-side only (API doesn't support it)
  let searchQ = ssrFilters.search ? ssrFilters.search.toLowerCase() : '';
  let sortBy = 'popular';

  const urlParams = new URLSearchParams(window.location.search);
  // Sync URL params (may differ from SSR if JS navigated here)
  const paramExam = urlParams.get('exam');
  if (paramExam) activeExam = paramExam;
  const paramQ = urlParams.get('q');
  if (paramQ) searchQ = paramQ.trim().toLowerCase();
  const paramDiff = urlParams.get('difficulty');
  if (paramDiff) activeDiff = paramDiff;

  const paramTest = urlParams.get('test');

  /**
   * Fetch tests from the API, sending server-supported filters (difficulty, exam, search).
   * Duration is filtered client-side only.
   * @param {boolean} silent - if true, don't show loading spinner (background refresh)
   */
  async function loadTestsFromAPI(silent = false) {
    const grid = document.getElementById('tests-grid');
    const loadingEl = document.getElementById('tests-loading');
    const countEl = document.getElementById('result-count');
    const emptyEl = document.getElementById('empty-msg');
    const searchInput = document.getElementById('search-input');
    const examFilterGroup = document.getElementById('exam-filter-group');
    const heroTitle = document.getElementById('hero-title');
    const heroSub = document.getElementById('hero-sub');

    if (paramTest) {
      const titleText = paramTest.toLowerCase().endsWith('tests') || paramTest.toLowerCase().endsWith('test')
        ? paramTest
        : `${paramTest} Tests`;
      if (heroTitle) heroTitle.textContent = titleText;
      if (heroSub) heroSub.textContent = `Free tests and practice papers for ${paramTest}.`;
      if (examFilterGroup) examFilterGroup.style.display = 'none';
      const mExamFilterGroup = document.getElementById('m-exam-filter-group');
      if (mExamFilterGroup) mExamFilterGroup.style.display = 'none';
      document.title = `${titleText} | Brinto MockTest`;
    }

    if (searchInput && paramQ) {
      searchInput.value = paramQ;
    }

    try {
      // Build API URL with server-supported filters
      const apiParams = new URLSearchParams({ page: '1', limit: '100' });
      if (activeDiff && activeDiff !== 'All') apiParams.set('difficulty', activeDiff);
      if (activeExam && activeExam !== 'All') apiParams.set('exam', activeExam);
      if (searchQ && searchQ.trim()) apiParams.set('search', searchQ.trim());

      const res = await fetch(`https://brintoapi.brinto.in/api/mocktests?${apiParams.toString()}`, {
        headers: { "Accept": "application/json" }
      });
      if (!res.ok) throw new Error("API error: " + res.status);
      const json = await res.json();
      const items = json?.data || json?.tests || (Array.isArray(json) ? json : []);

      allTests = items.map(t => ({
        id: t.id,
        slug: String(t.id ?? t.slug ?? ""),
        title: t.title || t.name,
        exam: t.exam || t.category || "General",
        questions: Array.isArray(t.questions) ? t.questions.length : (t.questions || 0),
        duration: t.duration || 30,
        difficulty: t.difficulty || "Medium",
        attempts: t.attempts || 0,
        rating: t.rating || 5,
        isFree: !!(t.is_free || t.isFree),
        isNew: !!(t.is_new || t.isNew),
        tags: [t.exam || t.category || "General"]
      }));

      syncFilterUI();
      renderTests();
      updateExamCounts();
    } catch (err) {
      console.error("Failed to load tests client-side:", err);
      // Only show error if we have no data to display (not a silent background refresh)
      if (!silent && allTests.length === 0) {
        if (loadingEl) loadingEl.innerHTML = `<p style="color:var(--brand)">Failed to load tests. Please check your connection.</p>`;
      }
    }
  }

  function updateExamCounts() {
    const exams = ['All', 'OSSSC', 'OPSC', 'OSSC', 'SSC', 'Railway', 'Banking', 'Police', 'General'];
    exams.forEach(ex => {
      const cnt = ex === 'All' ? allTests.length : allTests.filter(t => t.exam.toLowerCase() === ex.toLowerCase()).length;
      document.querySelectorAll(`#cnt-${ex.toLowerCase()}, #m-cnt-${ex.toLowerCase()}`).forEach(btn => {
        if (btn) btn.textContent = cnt;
      });
    });
  }

  function durMatch(duration, filter) {
    if (filter === 'All') return true;
    if (filter === '30 min') return duration <= 30;
    if (filter === '60 min') return duration > 30 && duration <= 60;
    if (filter === 'Over 60 min') return duration > 60;
    return true;
  }

  function renderTests() {
    const grid = document.getElementById('tests-grid');
    const countEl = document.getElementById('result-count');
    const emptyEl = document.getElementById('empty-msg');

    const searchTerms = searchQ.split(/\s+/).filter(Boolean);

    let filtered = allTests.filter(t => {
      const matchesExam = activeExam === 'All' || t.exam.toLowerCase() === activeExam.toLowerCase();
      const matchesDiff = activeDiff === 'All' || t.difficulty.toLowerCase() === activeDiff.toLowerCase();
      const matchesDur = durMatch(t.duration, activeDur);

      let matchesSearch = true;
      if (searchTerms.length > 0) {
        matchesSearch = searchTerms.some(term =>
          t.title.toLowerCase().includes(term) ||
          t.exam.toLowerCase().includes(term) ||
          t.tags.some(tag => tag.toLowerCase().includes(term))
        );
      }
      return matchesExam && matchesDiff && matchesDur && matchesSearch;
    });

    if (filtered.length === 0 && searchQ !== '') {
      filtered = allTests.filter(t => {
        const matchesExam = activeExam === 'All' || t.exam.toLowerCase() === activeExam.toLowerCase();
        const matchesDiff = activeDiff === 'All' || t.difficulty.toLowerCase() === activeDiff.toLowerCase();
        const matchesDur = durMatch(t.duration, activeDur);
        return matchesExam && matchesDiff && matchesDur;
      });
      if (countEl) countEl.textContent = `No exact matches for "${paramQ || searchQ}". Showing ${filtered.length} available test${filtered.length !== 1 ? 's' : ''}:`;
      emptyEl.style.display = 'none';
    } else {
      if (countEl) countEl.textContent = `${filtered.length} test${filtered.length !== 1 ? 's' : ''}`;
      emptyEl.style.display = filtered.length === 0 ? '' : 'none';
    }

    // Sort
    filtered.sort((a, b) => {
      if (sortBy === 'popular') return b.attempts - a.attempts;
      if (sortBy === 'rating') return b.rating - a.rating;
      if (sortBy === 'newest') return (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0);
      if (sortBy === 'duration-asc') return a.duration - b.duration;
      return 0;
    });

    countEl.textContent = `${filtered.length} test${filtered.length !== 1 ? 's' : ''}`;
    emptyEl.style.display = filtered.length === 0 ? '' : 'none';

    if (filtered.length === 0) {
      grid.innerHTML = '';
      return;
    }

    grid.innerHTML = filtered.map(t => {
      const diffClass = `diff-${t.difficulty.toLowerCase()}`;
      const attemptsFormatted = (t.attempts || 0).toLocaleString('en-IN');
      const isNewHtml = t.isNew ? '<span class="badge-new">New</span>' : '';
      const isFreeHtml = '<span class="badge-free">Free</span>';

      return `
        <a href="/mocktest/test/${t.slug}" class="test-card">
          <div class="tc-top">
            <span class="exam-tag">${t.exam}</span>
            <div class="badges">
              ${isNewHtml}
              ${isFreeHtml}
            </div>
          </div>
          <h2 class="tc-title">${t.title}</h2>
          <div class="tc-tags">
            ${t.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
          </div>
          <div class="tc-meta">
            <span class="meta-item">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              ${t.questions} Questions
            </span>
            <span class="meta-item">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${t.duration} min
            </span>
            <span class="diff-badge ${diffClass}">${t.difficulty}</span>
          </div>
          <div class="tc-footer">
            <div class="tc-stats">
              <span>
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                ${attemptsFormatted}
              </span>
              <span class="star-rating">★ ${t.rating}</span>
            </div>
            <span class="attempt-cta">Attempt →</span>
          </div>
        </a>
      `;
    }).join('');
  }

  // Filter handlers
  function syncFilterUI() {
    ['exam', 'diff', 'dur'].forEach(prop => {
      const currentVal = prop === 'exam' ? activeExam : prop === 'diff' ? activeDiff : activeDur;
      const attr = `data-${prop}`;
      document.querySelectorAll(`[${attr}]`).forEach(b => {
        const isMatch = b.getAttribute(attr) === currentVal;
        b.classList.toggle('active', isMatch);
        b.setAttribute('aria-pressed', String(isMatch));
      });
    });

    const activeDot = document.getElementById('filter-active-dot');
    if (activeDot) {
      const hasActive = activeExam !== 'All' || activeDiff !== 'All' || activeDur !== 'All';
      activeDot.style.display = hasActive ? 'inline-block' : 'none';
    }
    window.updateFloatingDot?.();
  }

  function setupFloatingFilterButton() {
    const floatBtn = document.getElementById('floating-filter-btn');
    const sheet = document.getElementById('filter-sheet');
    const floatDot = document.getElementById('floating-active-dot');

    if (!floatBtn || !sheet) return;

    floatBtn.addEventListener('click', () => {
      sheet.classList.add('open');
      sheet.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        floatBtn.style.display = 'inline-flex';
      } else {
        floatBtn.style.display = 'none';
      }
    }, { passive: true });

    window.updateFloatingDot = () => {
      const hasActive = activeExam !== 'All' || activeDiff !== 'All' || activeDur !== 'All';
      if (floatDot) {
        floatDot.style.display = hasActive ? 'inline-block' : 'none';
      }
    };
  }

  setupFloatingFilterButton();

  function setupFilterGroup(groupId, prop) {
    const el = document.getElementById(groupId);
    if (!el) return;
    el.addEventListener('click', e => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      const val = btn.dataset[prop];
      if (prop === 'exam') activeExam = val;
      if (prop === 'diff') activeDiff = val;
      if (prop === 'dur') activeDur = val;
      syncFilterUI();
      // Update URL so the filter is reflected on hard refresh (SSR)
      const p = new URLSearchParams(window.location.search);
      if (prop === 'exam') { if (val === 'All') p.delete('exam'); else p.set('exam', val); }
      if (prop === 'diff') { if (val === 'All') p.delete('difficulty'); else p.set('difficulty', val); }
      const newUrl = `${window.location.pathname}${p.toString() ? '?' + p.toString() : ''}`;
      window.history.replaceState({}, '', newUrl);
      // Server-supported filters (exam, difficulty, search) → re-fetch from API
      // Client-only filter (duration) → just re-render local data
      if (prop === 'dur') {
        renderTests();
      } else {
        loadTestsFromAPI(false);
      }
    });
  }

  setupFilterGroup('exam-filter', 'exam');
  setupFilterGroup('diff-filter', 'diff');
  setupFilterGroup('dur-filter', 'dur');
  setupFilterGroup('m-exam-filter', 'exam');
  setupFilterGroup('m-diff-filter', 'diff');
  setupFilterGroup('m-dur-filter', 'dur');

  function setupBottomSheet() {
    const sheet = document.getElementById('filter-sheet');
    const openBtn = document.getElementById('open-filter-sheet');
    const closeBg = document.getElementById('close-filter-sheet-bg');
    const closeBtn = document.getElementById('close-filter-sheet-btn');
    const applyBtn = document.getElementById('sheet-apply-btn');
    const resetBtn = document.getElementById('sheet-reset-btn');

    function openSheet() {
      if (!sheet) return;
      sheet.classList.add('open');
      sheet.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeSheet() {
      if (!sheet) return;
      sheet.classList.remove('open');
      sheet.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openSheet);
    if (closeBg) closeBg.addEventListener('click', closeSheet);
    if (closeBtn) closeBtn.addEventListener('click', closeSheet);
    if (applyBtn) {
      applyBtn.addEventListener('click', () => {
        closeSheet();
        // Apply re-fetches from API since exam/diff may have changed
        loadTestsFromAPI(false);
      });
    }
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeExam = 'All'; activeDiff = 'All'; activeDur = 'All'; searchQ = '';
        const searchInput = document.getElementById('search-input');
        if (searchInput) searchInput.value = '';
        window.history.replaceState({}, '', window.location.pathname);
        syncFilterUI();
        closeSheet();
        loadTestsFromAPI(false);
      });
    }
  }

  setupBottomSheet();

  // Search: debounce 400ms then re-fetch from API (search is server-supported)
  let _searchTimer = null;
  document.getElementById('search-input').addEventListener('input', e => {
    searchQ = e.target.value.trim().toLowerCase();
    clearTimeout(_searchTimer);
    _searchTimer = setTimeout(() => {
      const p = new URLSearchParams(window.location.search);
      if (searchQ) p.set('q', searchQ); else p.delete('q');
      window.history.replaceState({}, '', `${window.location.pathname}${p.toString() ? '?' + p.toString() : ''}`);
      loadTestsFromAPI(false);
    }, 400);
  });

  document.getElementById('reset-filters').addEventListener('click', () => {
    activeExam = 'All'; activeDiff = 'All'; activeDur = 'All'; searchQ = '';
    document.getElementById('search-input').value = '';
    window.history.replaceState({}, '', window.location.pathname);
    syncFilterUI();
    loadTestsFromAPI(false);
  });

  // Apply URL-based search input display
  const searchInputEl = document.getElementById('search-input');
  if (searchInputEl && searchQ) searchInputEl.value = searchQ;

  // If SSR provided tests, render immediately; then do a silent background refresh
  if (allTests.length > 0) {
    syncFilterUI();
    renderTests();
    updateExamCounts();
    // Silent background refresh — picks up any new tests since SSR
    loadTestsFromAPI(true);
  } else {
    // No SSR data — fall back to full client fetch (shows spinner)
    loadTestsFromAPI(false);
  }
}
// Run on initial load
__initTestsPage();
// Re-run on Astro ClientRouter page transitions
document.addEventListener('astro:page-load', __initTestsPage);
</script>

