---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import TypingTest from "../../components/TypingTest.astro";
import GAd from "../../components/GAd.astro";
import GAdRails from "../../components/GAdRails.astro";

/**
 * /mocktest/tests/osssc-typing
 * OSSSC Typing Test page — uses the reusable TypingTest component.
 *
 * To change the passage: update the `passage` prop below.
 * Duration is 15 minutes (900s) as per OSSSC norms; wpmGoal = 40 WPM.
 */

const fallbackPassage = `The Odisha Sub-ordinate Staff Selection Commission conducts recruitment for various government posts in the state of Odisha. Candidates appearing for the typing test must demonstrate proficiency in English or Odia typewriting. The qualifying speed is generally forty words per minute for English and thirty words per minute for Odia. Regular practice is essential to achieve the desired speed and accuracy. Maintain a correct posture, keep your wrists relaxed, and use all ten fingers on the keyboard for efficient typing. Avoid looking at the keyboard while typing and focus on the text displayed on the screen. Speed will improve naturally with consistent daily practice sessions.`;

let passage = fallbackPassage;

try {
  const res = await fetch("https://brintoapi.brinto.in/api/mocktest-passages?test_name=Odisha%20RI%20Typing%20Test", {
    headers: { Accept: "*/*" },
  });
  if (res.ok) {
    const json = await res.json();
    if (json?.data?.passage_text) {
      passage = json.data.passage_text;
    }
  }
} catch (err) {
  console.error("Error fetching typing passage from API:", err);
}
---

<BaseLayout
  title="OSSSC Typing Test – Practice Online | Brinto MockTest"
  description="Practice OSSSC English typing test online. Get live WPM, accuracy, and error count. Works on desktop and mobile with OTG or Bluetooth keyboard."
>
  <!-- Sticky side-rail ads (wide screens only) -->
  <GAdRails />

  <!-- Page header -->
  <div class="page-header wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/mocktest">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/mocktest/osssc">OSSSC</a>
      <span aria-hidden="true">›</span>
      <span>Typing Test</span>
    </nav>
    <div class="page-meta">
      <div class="meta-chip">⏱ 15 minutes</div>
      <div class="meta-chip">🎯 40 WPM target</div>
      <div class="meta-chip">🆓 Free</div>
    </div>
  </div>

  <!-- Test + Sidebar Ads layout -->
  <div class="page-body wrap">
    <main class="main-column">
      <div class="test-wrap">
        <TypingTest
          testId="osssc-typing"
          title="OSSSC Typing Test"
          examName="OSSSC"
          passage={passage}
          duration={900}
          wpmGoal={40}
          showTips={true}
          apiUrl="https://brintoapi.brinto.in/api/mocktest-passages?test_name=Odisha%20RI%20Typing%20Test"
          trackBackspaces={true}
        />
      </div>

      <!-- In-flow ad: below test on mobile / tablet (hidden on desktop) -->
      <div class="ad-slot ad-slot-mid">
        <GAd sizes={{ mobile: "320x100", tablet: "728x90", desktop: null }} />
      </div>

      <!-- ── Info section below ── -->
      <section class="info-section">
        <div class="info-grid">
          <div class="info-card">
            <h3>📋 OSSSC Typing Norms</h3>
            <ul>
              <li>English: <strong>40 WPM</strong> minimum</li>
              <li>Odia: <strong>30 WPM</strong> minimum</li>
              <li>Duration: <strong>15 minutes</strong></li>
              <li>Accuracy must be <strong>≥ 80%</strong></li>
              <li>Errors reduce your effective WPM</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>💡 Tips to Improve</h3>
            <ul>
              <li>Use all 10 fingers (touch typing)</li>
              <li>Keep your eyes on the passage, not the keys</li>
              <li>Sit straight — wrists level with the keyboard</li>
              <li>Aim for accuracy first, speed follows</li>
              <li>Practice 20–30 min daily for 2 weeks</li>
            </ul>
          </div>

          <div class="info-card">
            <h3>📱 Mobile Setup</h3>
            <ul>
              <li><strong>OTG:</strong> USB keyboard + OTG adapter (Android)</li>
              <li><strong>Bluetooth:</strong> Pair any wireless keyboard</li>
              <li><strong>Landscape:</strong> Rotate phone for wider on-screen keys</li>
              <li>iOS: connect via USB-C or Lightning adapter</li>
              <li>Tap the typing area to bring up the keyboard</li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <!-- Sidebar with sticky 2nd ad on desktop -->
    <aside class="sidebar-column" aria-label="Sidebar Advertisements">
      <div class="sidebar-ad">
        <GAd size="300x250" />
      </div>
      <div class="sidebar-ad sidebar-ad-sticky">
        <GAd size="300x600" />
      </div>
    </aside>
  </div>

  <!-- Ad: end of page (all devices) -->
  <div class="ad-slot ad-slot-end wrap">
    <GAd sizes={{ mobile: "300x250", tablet: "728x90", desktop: "728x90" }} />
  </div>
</BaseLayout>

<style>
  /* ── Page header ── */
  .page-header {
    padding: 18px 24px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.82rem; color: var(--ink-soft);
  }
  .breadcrumb a { color: var(--brand); }
  .breadcrumb a:hover { text-decoration: underline; }
  .page-meta { display: flex; gap: 8px; flex-wrap: wrap; }
  .meta-chip {
    font-size: 0.75rem; font-weight: 600;
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 20px;
    padding: 4px 10px;
    color: var(--ink-soft);
  }

  /* Responsive body grid: test + sidebar */
  .page-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .main-column {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .test-wrap { padding: 14px 0 0; }

  /* Sidebar: hidden on mobile, block on desktop */
  .sidebar-column {
    display: none;
    width: 300px;
  }

  .sidebar-ad {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  /* 2nd ad is sticky — sticks to viewport as user scrolls */
  .sidebar-ad-sticky {
    position: sticky;
    top: 84px;
    z-index: 10;
    margin-bottom: 0;
  }

  /* Desktop layout with sidebar */
  @media (min-width: 1024px) {
    .page-body {
      grid-template-columns: 1fr 300px;
      gap: 28px;
    }
    .sidebar-column {
      display: block; /* block, NOT flex — so sticky works on children */
      align-self: stretch; /* stretch to full grid height so sticky has scroll room */
    }
  }

  @media (max-width: 480px) {
    .test-wrap { padding: 10px 0 0; }
    .page-header { padding: 12px 14px 0; }
  }

  @media (max-height: 500px) and (orientation: landscape) {
    .test-wrap { padding: 6px 0 0; }
    .page-header  { display: none; }
    .info-section { display: none; }
    .ad-slot      { display: none; }
    .sidebar-column { display: none !important; }
  }

  /* Ads */
  .ad-slot { padding: 8px 0 0; }
  .ad-slot-end { padding: 8px 24px 40px; }
  .ad-slot-mid {
    display: block;
  }
  @media (min-width: 1024px) {
    .ad-slot-mid {
      display: none;
    }
  }

  /* ── Info section ── */
  .info-section {
    padding: 8px 0 16px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .info-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .info-card h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .info-card ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 7px;
  }
  .info-card li {
    font-size: 0.84rem;
    color: var(--ink-soft);
    padding-left: 14px;
    position: relative;
    line-height: 1.4;
  }
  .info-card li::before {
    content: '›';
    position: absolute; left: 0;
    color: var(--brand);
    font-weight: 700;
  }
  .info-card strong { color: var(--ink); }

  @media (max-width: 768px) {
    .info-grid { grid-template-columns: 1fr; }
    .info-section { padding: 20px 14px 36px; }
  }
</style>
