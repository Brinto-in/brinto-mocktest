---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import StepCard from "../components/StepCard.astro";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import InstitutesSection from "../components/InstitutesSection.astro";
import Odisha10thSection from "../components/Odisha10thSection.astro";
import Odisha10thPosterRow from "../components/Odisha10thPosterRow.astro";
import SectionHeader from "../components/SectionHeader.astro";
import TrendingTests from "../components/TrendingTests.astro";
import BrowseByExam from "../components/BrowseByExam.astro";
import PosterRow from "../components/PosterRow.astro";

import { steps } from "../data/steps";
import { ossscItems, OSSSC_PAGE } from "../data/osssc";
---

<BaseLayout
  title="Free Online Mock Tests & Practice Papers for Govt Jobs & Competitive Exams"
  description="Practice free online mock tests for SSC, UPSC, Banking, Railway, Teaching, State & Central Government exams. Get instant scores, detailed solutions, sectional analysis, and national ranking."
>
  <Hero />
<!--  <StatsStrip />-->

  <!-- ── OSSSC SECTION ───────────────────────────── -->
  <PosterRow
    sectionId="osssc-row"
    title="OSSSC"
    seeAllHref={OSSSC_PAGE}
    items={ossscItems}
    cols={6}
  />

  <!-- ── TRENDING TESTS ─────────────────────────── -->
  <TrendingTests />

  <!-- ── INSTITUTES & TUITION TEACHERS SECTION ─────────── -->
  <!-- <InstitutesSection /> -->

  <!-- ── ODISHA 10TH STUDENTS SECTION ───────────────────── -->
  <!-- <Odisha10thSection /> -->
<!--  <Odisha10thPosterRow />-->

  <!-- ── CATEGORIES ─────────────────────────────── -->
  <BrowseByExam />

  <!-- ── HOW IT WORKS ───────────────────────────── -->
  <section class="section how-section">
    <div class="wrap">
      <SectionHeader
        title="How it works"
        subtitle="Three steps from zero to your exam rank."
        centered={true}
      />
      <div class="steps-row">
        {steps.map((step) => <StepCard step={step} />)}
      </div>
    </div>
  </section>

  <!-- ── CTA BANNER ────────────────────────────── -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Your exam is closer than you think.</h2>
        <p>
          Start with one free mock test today — no signup required to attempt.
        </p>
      </div>
      <div class="cta-btns">
        <a href="/mocktest/tests" class="cta-btn-primary">Start a free test</a>
        <a href="/mocktest/signup" class="cta-btn-ghost">Create account →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── SECTIONS ── */
  .section {
    padding: 16px 0 20px;
  }
  /* Follows the white Browse-by-exam row, which already supplies the gap */
  .how-section {
    padding-top: 0;
  }
  .section-alt {
    background: var(--surface-2);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
  }
  .section-head.centered {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .section-head h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--ink);
  }
  .see-all {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-mid);
    background: var(--brand-light);
    transition: background 0.15s;
  }
  .see-all:hover {
    background: var(--brand-mid);
  }
  .section-sub {
    color: var(--ink-soft);
    max-width: 48ch;
  }

  /* ── STEPS ── */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    position: relative;
  }
  .step-icon {
    color: var(--brand);
    margin-bottom: 14px;
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--rule);
    line-height: 1;
    position: absolute;
    top: 20px;
    right: 22px;
  }
  .step-card h3 {
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-weight: 700;
  }
  .step-card p {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* ── CTA BAND ── */
  .cta-band {
    background: var(--brand);
    padding: 48px 0;
    margin-top: 0;
    /* Cancel the footer's top margin so the band sits flush on the footer */
    margin-bottom: -40px;
  }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }
  .cta-band h2 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    color: #fff;
    margin-bottom: 8px;
  }
  .cta-band p {
    color: rgba(255, 255, 255, 0.8);
  }
  .cta-btns {
    display: flex;
    gap: 14px;
    flex-shrink: 0;
  }
  .cta-btn-primary {
    font-weight: 700;
    color: var(--brand);
    background: #fff;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: transform 0.1s;
  }
  .cta-btn-primary:hover {
    transform: translateY(-1px);
  }
  .cta-btn-ghost {
    font-weight: 600;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.5);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: border-color 0.15s;
  }
  .cta-btn-ghost:hover {
    border-color: #fff;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-card-col {
      display: none;
    }
  }
  @media (max-width: 768px) {
    .hero {
      padding: 48px 0 40px;
    }
    .steps-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
    .cta-btns {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 600px) {
    .section {
      padding: 12px 0;
    }
  }
</style>
