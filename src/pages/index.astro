---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TestCard from '../components/TestCard.astro';
import StepCard from '../components/StepCard.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';

import { db } from '../lib/db';
import type { Test } from '../lib/types';
import { categories } from '../data/categories';
import { steps } from '../data/steps';

const result = await db.execute({
  sql: "SELECT * FROM tests ORDER BY attempts DESC LIMIT 6",
  args: [],
});

const tests: Test[] = result.rows.map((row: any) => ({
  title: row.title,
  exam: row.exam,
  questions: row.questions,
  duration: row.duration,
  difficulty: row.difficulty,
  attempts: row.attempts,
  rating: row.rating,
  href: row.href,
  isNew: !!row.is_new,
  isFree: !!row.is_free,
}));
---

<BaseLayout
  title="Free Mock Tests for Odisha Govt Jobs"
  description="Practice free mock tests for OSSSC, OPSC, OSSC, SSC, Railway, Banking and more. Get instant results, section analysis, and rank on the leaderboard."
>

  <Hero />
  <StatsStrip />

  <!-- ── CATEGORIES ─────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by exam</h2>
        <a href="/tests" class="see-all">See all →</a>
      </div>
      <div class="cat-grid">
        {categories.map(cat => <CategoryCard category={cat} />)}
      </div>
    </div>
  </section>

  <!-- ── TRENDING TESTS ─────────────────────────── -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Trending tests</h2>
        <a href="/tests" class="see-all">View all →</a>
      </div>
      <div class="tests-grid">
        {tests.map((t) => <TestCard test={t} />)}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ───────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head centered">
        <h2>How it works</h2>
        <p class="section-sub">Three steps from zero to your exam rank.</p>
      </div>
      <div class="steps-row">
        {steps.map(step => <StepCard step={step} />)}
      </div>
    </div>
  </section>

  <!-- ── CTA BANNER ────────────────────────────── -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Your exam is closer than you think.</h2>
        <p>Start with one free mock test today — no signup required to attempt.</p>
      </div>
      <div class="cta-btns">
        <a href="/tests" class="cta-btn-primary">Start a free test</a>
        <a href="/signup" class="cta-btn-ghost">Create account →</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── SECTIONS ── */
  .section { padding: 72px 0; }
  .section-alt { background: var(--surface-2); }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
  }
  .section-head.centered { flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .section-head h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); color: var(--ink); }
  .see-all {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-mid);
    background: var(--brand-light);
    transition: background 0.15s;
  }
  .see-all:hover { background: var(--brand-mid); }
  .section-sub { color: var(--ink-soft); max-width: 48ch; }

  /* ── CATEGORIES ── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  /* ── TEST CARDS ── */
  .tests-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ── STEPS ── */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    position: relative;
  }
  .step-icon {
    color: var(--brand);
    margin-bottom: 14px;
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--rule);
    line-height: 1;
    position: absolute;
    top: 20px;
    right: 22px;
  }
  .step-card h3 {
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-weight: 700;
  }
  .step-card p { font-size: 0.9rem; color: var(--ink-soft); }

  /* ── CTA BAND ── */
  .cta-band {
    background: var(--brand);
    padding: 64px 0;
    margin-top: 0;
  }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }
  .cta-band h2 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    color: #fff;
    margin-bottom: 8px;
  }
  .cta-band p { color: rgba(255,255,255,0.8); }
  .cta-btns { display: flex; gap: 14px; flex-shrink: 0; }
  .cta-btn-primary {
    font-weight: 700;
    color: var(--brand);
    background: #fff;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: transform 0.1s;
  }
  .cta-btn-primary:hover { transform: translateY(-1px); }
  .cta-btn-ghost {
    font-weight: 600;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.5);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: border-color 0.15s;
  }
  .cta-btn-ghost:hover { border-color: #fff; }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-card-col { display: none; }
    .cat-grid { grid-template-columns: repeat(4, 1fr); }
    .tests-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { padding: 48px 0 40px; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .steps-row { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; text-align: center; }
    .cta-btns { justify-content: center; flex-wrap: wrap; }
  }
  @media (max-width: 600px) {
    .tests-grid { grid-template-columns: 1fr; }
    .section { padding: 48px 0; }
  }
  @media (max-width: 400px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
