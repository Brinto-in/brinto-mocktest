---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryCard from "../components/CategoryCard.astro";
import TestCard from "../components/TestCard.astro";
import StepCard from "../components/StepCard.astro";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import InstitutesSection from "../components/InstitutesSection.astro";
import Odisha10thSection from "../components/Odisha10thSection.astro";

import { fetchMockTests } from "../lib/api";
import type { Test } from "../lib/types";
import { categories } from "../data/categories";
import { steps } from "../data/steps";

let tests: Test[] = [];

try {
  const items = await fetchMockTests(1, 10);
  if (Array.isArray(items) && items.length > 0) {
    tests = items.map((row: any) => ({
      title: row.title || row.name,
      exam: row.exam || row.category || "General",
      questions: Array.isArray(row.questions) ? row.questions.length : (row.questions || 0),
      duration: row.duration || 30,
      difficulty: row.difficulty || "Medium",
      attempts: row.attempts || 0,
      rating: row.rating || 5,
      href: `/test/${row.id}`,
      isNew: !!(row.isNew || row.is_new),
      isFree: !!(row.isFree || row.is_free),
    }));
  }
} catch (err) {
  console.error("Error fetching trending tests from API service:", err);
}
---

<BaseLayout
  title="Free Online Mock Tests & Practice Papers for Govt Jobs & Competitive Exams"
  description="Practice free online mock tests for SSC, UPSC, Banking, Railway, Teaching, State & Central Government exams. Get instant scores, detailed solutions, sectional analysis, and national ranking."
>
  <Hero />
  <StatsStrip />

  <!-- ── INSTITUTES & TUITION TEACHERS SECTION ─────────── -->
  <InstitutesSection />

  <!-- ── ODISHA 10TH STUDENTS SECTION ───────────────────── -->
  <Odisha10thSection />

  <!-- ── TRENDING TESTS ─────────────────────────── -->
  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Trending tests</h2>
        <a href="/tests" class="see-all">View all →</a>
      </div>
      <div class="tests-grid" id="trending-tests-grid">
        {tests.map((t) => <TestCard test={t} />)}
      </div>
    </div>
  </section>

  <script is:inline>
    // Ensure trending tests load from API on client if edge subrequest returned empty
    (async function() {
      const grid = document.getElementById("trending-tests-grid");
      if (!grid) return;
      if (grid.children.length === 0) {
        try {
          const res = await fetch("https://brintoapi.brinto.in/api/mocktests?page=1&limit=10");
          if (!res.ok) return;
          const json = await res.json();
          const items = json?.data || json?.tests || (Array.isArray(json) ? json : []);
          if (Array.isArray(items) && items.length > 0) {
            grid.innerHTML = items.map(function(t) {
              const diff = t.difficulty || 'Medium';
              const diffStyles = {
                Easy: 'color:var(--green);background:var(--green-light)',
                Medium: 'color:var(--gold);background:var(--gold-light)',
                Hard: 'color:var(--brand);background:var(--brand-light)'
              };
              const diffStyle = diffStyles[diff] || diffStyles.Medium;
              const qCount = Array.isArray(t.questions) ? t.questions.length : (t.questions || 0);
              const duration = t.duration || 30;
              const attempts = (t.attempts || 0).toLocaleString('en-IN');
              const rating = t.rating || 5;
              const isNewBadge = (t.is_new || t.isNew) ? '<span class="badge-new">New</span>' : '';
              const isFreeBadge = (t.is_free || t.isFree) ? '<span class="badge-free">Free</span>' : '';

              return `
                <a href="/test/${t.id}" class="test-card">
                  <div class="tc-top">
                    <span class="tc-exam-tag">${t.exam || 'General'}</span>
                    <div class="tc-badges">
                      ${isNewBadge}
                      ${isFreeBadge}
                    </div>
                  </div>
                  <h3 class="tc-title">${t.title || t.name}</h3>
                  <div class="tc-meta">
                    <span>
                      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                      ${qCount} Qs
                    </span>
                    <span>
                      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      ${duration} min
                    </span>
                    <span class="tc-diff" style="${diffStyle}">${diff}</span>
                  </div>
                  <div class="tc-footer">
                    <span class="tc-attempts">
                      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      ${attempts}
                    </span>
                    <span class="tc-rating">★ ${rating}</span>
                    <span class="tc-cta">Attempt →</span>
                  </div>
                </a>
              `;
            }).join('');
          }
        } catch (e) {
          console.error("Client fallback fetch failed:", e);
        }
      }
    })();
  </script>

  <!-- ── CATEGORIES ─────────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Browse by exam</h2>
        <a href="/tests" class="see-all">See all →</a>
      </div>
      <div class="cat-grid">
        {categories.map((cat) => <CategoryCard category={cat} />)}
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ───────────────────────────── -->
  <section class="section">
    <div class="wrap">
      <div class="section-head centered">
        <h2>How it works</h2>
        <p class="section-sub">Three steps from zero to your exam rank.</p>
      </div>
      <div class="steps-row">
        {steps.map((step) => <StepCard step={step} />)}
      </div>
    </div>
  </section>

  <!-- ── CTA BANNER ────────────────────────────── -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <div>
        <h2>Your exam is closer than you think.</h2>
        <p>
          Start with one free mock test today — no signup required to attempt.
        </p>
      </div>
      <div class="cta-btns">
        <a href="/tests" class="cta-btn-primary">Start a free test</a>
        <a href="/signup" class="cta-btn-ghost">Create account →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── SECTIONS ── */
  .section {
    padding: 72px 0;
  }
  .section-alt {
    background: var(--surface-2);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
  }
  .section-head.centered {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .section-head h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--ink);
  }
  .see-all {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-mid);
    background: var(--brand-light);
    transition: background 0.15s;
  }
  .see-all:hover {
    background: var(--brand-mid);
  }
  .section-sub {
    color: var(--ink-soft);
    max-width: 48ch;
  }

  /* ── CATEGORIES ── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  /* ── TEST CARDS ── */
  .tests-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ── STEPS ── */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    position: relative;
  }
  .step-icon {
    color: var(--brand);
    margin-bottom: 14px;
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--rule);
    line-height: 1;
    position: absolute;
    top: 20px;
    right: 22px;
  }
  .step-card h3 {
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 10px;
    font-family: var(--font-body);
    font-weight: 700;
  }
  .step-card p {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* ── CTA BAND ── */
  .cta-band {
    background: var(--brand);
    padding: 64px 0;
    margin-top: 0;
  }
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }
  .cta-band h2 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    color: #fff;
    margin-bottom: 8px;
  }
  .cta-band p {
    color: rgba(255, 255, 255, 0.8);
  }
  .cta-btns {
    display: flex;
    gap: 14px;
    flex-shrink: 0;
  }
  .cta-btn-primary {
    font-weight: 700;
    color: var(--brand);
    background: #fff;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: transform 0.1s;
  }
  .cta-btn-primary:hover {
    transform: translateY(-1px);
  }
  .cta-btn-ghost {
    font-weight: 600;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.5);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-size: 0.98rem;
    transition: border-color 0.15s;
  }
  .cta-btn-ghost:hover {
    border-color: #fff;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-card-col {
      display: none;
    }
    .cat-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .tests-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .hero {
      padding: 48px 0 40px;
    }
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps-row {
      grid-template-columns: 1fr;
    }
    .cta-inner {
      flex-direction: column;
      text-align: center;
    }
    .cta-btns {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 600px) {
    .tests-grid {
      grid-template-columns: 1fr;
    }
    .section {
      padding: 48px 0;
    }
  }
  @media (max-width: 400px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
