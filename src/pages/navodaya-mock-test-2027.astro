---
import BaseLayout from "../layouts/BaseLayout.astro";

const MOCK_TEST_URL = "/mocktest/tests";

const canonicalPath = "/mocktest/navodaya-mock-test-2027";
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const ogImage = new URL("/logo.png", Astro.site).toString();

const pageTitle = "Navodaya Mock Test 2027 Free | JNVST Class 6 Online Test";
const pageDescription =
  "Take the free Navodaya Mock Test 2027 for JNVST Class 6. Practice Mental Ability, Arithmetic and Language online with instant results and ranking.";

const faqs = [
  {
    q: "Is the Navodaya Mock Test 2027 free?",
    a: "Yes. The Brinto JNVST Class 6 Mock Test 2027 is completely free. You can start the test without paying any fee.",
  },
  {
    q: "How can I take the JNVST Class 6 mock test online?",
    a: "Click the 'Start Free Mock Test' button on this page, enter your basic student details, and begin the online test. No installation is needed — it runs in your browser.",
  },
  {
    q: "How many questions are in the Navodaya mock test?",
    a: "The mock test contains 80 questions, which mirrors the pattern of the JNVST Class 6 entrance examination. The total time allowed is 120 minutes.",
  },
  {
    q: "Can I take the Navodaya mock test on mobile?",
    a: "Yes. The Brinto mock test is fully mobile-friendly. You can attempt it on any smartphone or tablet without any difficulty.",
  },
  {
    q: "Is this an official NVS mock test?",
    a: "No. This is not an official mock test by Navodaya Vidyalaya Samiti or any government body. Brinto is an independent educational platform. This test is designed to help students practise for the JNVST Class 6 exam.",
  },
  {
    q: "Which subjects are included in the JNVST Class 6 mock test?",
    a: "The mock test covers the three main sections of JNVST — Mental Ability Test, Arithmetic Test, and Language Test (English or Hindi).",
  },
  {
    q: "How can mock tests help in Navodaya preparation?",
    a: "Taking full-length mock tests helps you get familiar with the question format, manage your time better, and identify which topics need more revision. Analysing your score after each test is one of the most effective preparation strategies.",
  },
  {
    q: "Can I see my All India Rank after the test?",
    a: "Yes. After completing the test you will receive your score and an All India Rank, so you can compare your performance with other students preparing for JNVST 2027.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.brinto.in/" },
    { "@type": "ListItem", position: 2, name: "Mock Tests", item: "https://www.brinto.in/mocktest/" },
    { "@type": "ListItem", position: 3, name: "Navodaya Mock Test 2027", item: canonicalUrl },
  ],
};

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: "en-IN",
  publisher: { "@type": "Organization", name: "Brinto", url: "https://www.brinto.in", logo: ogImage },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  <meta slot="head" property="og:image" content={ogImage} />
  <meta slot="head" name="twitter:title" content={pageTitle} />
  <meta slot="head" name="twitter:description" content={pageDescription} />
  <meta slot="head" name="twitter:image" content={ogImage} />

  <main class="nmt-page">

    <!-- 1. HERO -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/mocktest/">Home</a></li>
            <li aria-hidden="true">›</li>
            <li>Navodaya Mock Test 2027</li>
          </ol>
        </nav>

        <h1 id="hero-heading" class="hero__title">
          Navodaya Mock Test 2027 –<br /> Free JNVST Class 6 Online Test
        </h1>

        <p class="hero__desc">
          Prepare for the Jawahar Navodaya Vidyalaya Selection Test (JNVST) Class 6 admission 2027 with a free online mock test.
          Practise Mental Ability, Arithmetic and Language questions in a real exam-style environment, get your instant score,
          and check your All India Rank — all at no cost.
        </p>

        <ul class="hero__badges" aria-label="Key highlights">
          <li class="badge badge--free"><span aria-hidden="true">✓</span> Free Mock Test</li>
          <li class="badge badge--instant"><span aria-hidden="true">⚡</span> Instant Result</li>
          <li class="badge badge--rank"><span aria-hidden="true">🏆</span> All India Rank</li>
          <li class="badge badge--mobile"><span aria-hidden="true">📱</span> Mobile Friendly</li>
        </ul>

        <div class="hero__ctas">
          <a href={MOCK_TEST_URL} class="btn btn--primary" id="hero-cta-primary" aria-label="Start free Navodaya Class 6 mock test 2027">
            Start Free Mock Test <span aria-hidden="true">→</span>
          </a>
          <a href="#mock-test-card" class="btn btn--secondary" id="hero-cta-secondary" aria-label="Scroll to view mock test details">
            View Mock Test Details
          </a>
        </div>

        <p class="hero__disclaimer">
          ⚠️ Brinto is an independent educational platform and is not affiliated with Navodaya Vidyalaya Samiti (NVS) or the Government of India.
        </p>
      </div>
      <div class="hero__bg" aria-hidden="true">
        <div class="hero__blob hero__blob--1"></div>
        <div class="hero__blob hero__blob--2"></div>
      </div>
    </section>

    <!-- 2. EXAM CARD -->
    <section class="section" id="mock-test-card" aria-labelledby="card-heading">
      <div class="container">
        <article class="exam-card" aria-label="JNVST Class 6 Mock Test 2027">
          <div class="exam-card__header">
            <div class="exam-card__badge-row">
              <span class="exam-card__tag">FREE</span>
              <span class="exam-card__tag exam-card__tag--outline">Online Test</span>
            </div>
            <h2 id="card-heading" class="exam-card__title">Navodaya Class 6 Mock Test 2027</h2>
            <p class="exam-card__subtitle">JNVST Class 6 Entrance Exam Practice Test</p>
          </div>
          <div class="exam-card__meta">
            <div class="exam-meta-item"><span aria-hidden="true">📝</span><div><div class="val">80</div><div class="lbl">Questions</div></div></div>
            <div class="exam-meta-item"><span aria-hidden="true">⏱️</span><div><div class="val">120</div><div class="lbl">Minutes</div></div></div>
            <div class="exam-meta-item"><span aria-hidden="true">🌐</span><div><div class="val">Online</div><div class="lbl">Mode</div></div></div>
            <div class="exam-meta-item"><span aria-hidden="true">⚡</span><div><div class="val">Instant</div><div class="lbl">Result</div></div></div>
            <div class="exam-meta-item"><span aria-hidden="true">🏆</span><div><div class="val">AIR</div><div class="lbl">All India Rank</div></div></div>
          </div>
          <a href={MOCK_TEST_URL} class="btn btn--primary btn--large btn--full" id="card-cta" aria-label="Start the free JNVST Class 6 mock test now">
            Start Test Now – FREE <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>

    <!-- 3. WHY BRINTO -->
    <section class="section section--alt" aria-labelledby="why-heading">
      <div class="container">
        <h2 id="why-heading" class="section__title">Why Take the Brinto Navodaya Mock Test?</h2>
        <p class="section__subtitle">Practising with a full-length mock test is one of the best ways to prepare for the JNVST Class 6 entrance exam.</p>
        <div class="benefits-grid">
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">🎯</div>
            <h3 class="benefit-card__title">Real Exam-Style Format</h3>
            <p class="benefit-card__desc">The mock test follows the same structure as the actual JNVST, with questions divided into Mental Ability, Arithmetic and Language sections. Practising in this format helps you get comfortable before the real exam day.</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">⏱️</div>
            <h3 class="benefit-card__title">Improve Time Management</h3>
            <p class="benefit-card__desc">With 80 questions to answer in 120 minutes, time management is critical. Taking timed mock tests trains you to pace yourself and avoid spending too long on any single question.</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">🔍</div>
            <h3 class="benefit-card__title">Identify Weak Topics</h3>
            <p class="benefit-card__desc">Your score report highlights which subjects and topics you need to revise more. Instead of guessing what to study, use your mock test results to focus your preparation where it matters most.</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">⚡</div>
            <h3 class="benefit-card__title">Get Instant Score</h3>
            <p class="benefit-card__desc">As soon as you submit the test, your score is calculated and displayed instantly. No waiting — you get your result right away and can begin reviewing your performance immediately.</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">🏆</div>
            <h3 class="benefit-card__title">All India Rank Comparison</h3>
            <p class="benefit-card__desc">Your result includes an All India Rank so you can see how your preparation compares with other students from across the country who are also preparing for JNVST 2027.</p>
          </div>
          <div class="benefit-card">
            <div class="benefit-card__icon" aria-hidden="true">📱</div>
            <h3 class="benefit-card__title">Practise on Any Device</h3>
            <p class="benefit-card__desc">The mock test works on mobile, tablet and desktop. You can practise at home, at school, or anywhere you have an internet connection — no special app or computer is needed.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. EXAM SECTIONS -->
    <section class="section" aria-labelledby="sections-heading">
      <div class="container">
        <h2 id="sections-heading" class="section__title">JNVST Class 6 Exam Sections Covered</h2>
        <p class="section__subtitle">The Navodaya Class 6 mock test on Brinto covers all three sections of the JNVST entrance exam pattern.</p>
        <div class="subject-cards">
          <article class="subject-card subject-card--mat">
            <div class="subject-card__icon-wrap" aria-hidden="true"><span class="subject-card__icon">🧠</span></div>
            <h3 class="subject-card__title">Mental Ability Test</h3>
            <p class="subject-card__weight">50% of total marks</p>
            <p class="subject-card__desc">The Mental Ability Test is the most important section of JNVST. Practise reasoning, pattern recognition, odd-one-out, figure completion, and other non-verbal logic questions. Regular practice sharpens your ability to spot patterns quickly and answer confidently.</p>
            <ul class="subject-card__list">
              <li>Figure-based reasoning</li>
              <li>Pattern recognition</li>
              <li>Odd one out</li>
              <li>Logical thinking</li>
            </ul>
          </article>
          <article class="subject-card subject-card--arith">
            <div class="subject-card__icon-wrap" aria-hidden="true"><span class="subject-card__icon">🔢</span></div>
            <h3 class="subject-card__title">Arithmetic Test</h3>
            <p class="subject-card__weight">25% of total marks</p>
            <p class="subject-card__desc">The Arithmetic section tests foundational mathematical skills. Practise numbers, fractions, decimals, simple equations, area and measurement, and other basic maths concepts from the Class 5 level. Speed and accuracy both matter in this section.</p>
            <ul class="subject-card__list">
              <li>Numbers and fractions</li>
              <li>Decimals and percentages</li>
              <li>Measurement and area</li>
              <li>Basic mathematical operations</li>
            </ul>
          </article>
          <article class="subject-card subject-card--lang">
            <div class="subject-card__icon-wrap" aria-hidden="true"><span class="subject-card__icon">📖</span></div>
            <h3 class="subject-card__title">Language Test</h3>
            <p class="subject-card__weight">25% of total marks</p>
            <p class="subject-card__desc">The Language Test checks reading comprehension and language-based understanding. The test is available in English or Hindi. Practise reading passages carefully and answering questions on their meaning, grammar, and vocabulary.</p>
            <ul class="subject-card__list">
              <li>Reading comprehension</li>
              <li>Passage-based questions</li>
              <li>Available in Hindi &amp; English</li>
              <li>Vocabulary and grammar</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 5. HOW IT WORKS -->
    <section class="section section--alt" aria-labelledby="how-heading">
      <div class="container">
        <h2 id="how-heading" class="section__title">How the Free Mock Test Works</h2>
        <p class="section__subtitle">Attempting the JNVST Class 6 mock test on Brinto is simple and takes just a few seconds to get started.</p>
        <ol class="steps" aria-label="Steps to take the mock test">
          <li class="step">
            <div class="step__number" aria-hidden="true">1</div>
            <div class="step__content">
              <h3 class="step__title">Click Start Free Mock Test</h3>
              <p class="step__desc">Tap the 'Start Free Mock Test' button on this page. You will be taken directly to the test platform — no account or payment is needed.</p>
            </div>
          </li>
          <li class="step">
            <div class="step__number" aria-hidden="true">2</div>
            <div class="step__content">
              <h3 class="step__title">Enter Basic Student Details</h3>
              <p class="step__desc">Enter your name, class, state and other basic information. This helps generate your personalised score report and All India Rank.</p>
            </div>
          </li>
          <li class="step">
            <div class="step__number" aria-hidden="true">3</div>
            <div class="step__content">
              <h3 class="step__title">Attempt the Online Test</h3>
              <p class="step__desc">Answer 80 questions within 120 minutes. Read each question carefully, manage your time well, and give your best attempt just as you would on the actual exam day.</p>
            </div>
          </li>
          <li class="step">
            <div class="step__number" aria-hidden="true">4</div>
            <div class="step__content">
              <h3 class="step__title">View Your Score and Rank Instantly</h3>
              <p class="step__desc">Once you submit, your score, section-wise performance, and All India Rank are shown immediately. Use this to plan your next round of revision.</p>
            </div>
          </li>
        </ol>
        <div class="section__cta-wrap">
          <a href={MOCK_TEST_URL} class="btn btn--primary btn--large" id="steps-cta" aria-label="Start free JNVST mock test now">
            Start Free Mock Test Now <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 6. WHO SHOULD TAKE -->
    <section class="section" aria-labelledby="who-heading">
      <div class="container">
        <h2 id="who-heading" class="section__title">Who Should Take This Mock Test?</h2>
        <p class="section__subtitle">This free JNVST Class 6 practice test is useful for a wide range of students and parents.</p>
        <div class="audience-grid">
          <div class="audience-card">
            <div class="audience-card__icon" aria-hidden="true">🎓</div>
            <h3 class="audience-card__title">JNVST 2027 Aspirants</h3>
            <p class="audience-card__desc">Students in Class 5 who are preparing for the Jawahar Navodaya Vidyalaya Selection Test Class 6 admission in 2027. This mock test helps you experience the real exam format and build confidence.</p>
          </div>
          <div class="audience-card">
            <div class="audience-card__icon" aria-hidden="true">👨‍👩‍👧</div>
            <h3 class="audience-card__title">Parents Seeking Practice Tests</h3>
            <p class="audience-card__desc">Parents who want a reliable and free online practice test for their child's Navodaya preparation. Start the test for your child in seconds and review the results together to guide their study plan.</p>
          </div>
          <div class="audience-card">
            <div class="audience-card__icon" aria-hidden="true">💻</div>
            <h3 class="audience-card__title">Online Test Practice Seekers</h3>
            <p class="audience-card__desc">Students who want to get comfortable with the online exam environment before the actual JNVST. Practising online helps reduce nerves and lets you focus fully on the questions on exam day.</p>
          </div>
          <div class="audience-card">
            <div class="audience-card__icon" aria-hidden="true">📚</div>
            <h3 class="audience-card__title">Coaching Centre Students</h3>
            <p class="audience-card__desc">Students attending Navodaya coaching classes who want additional full-length online tests to supplement their classroom practice. The All India Rank helps track progress over time.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. PREPARATION TIPS -->
    <section class="section section--alt" aria-labelledby="tips-heading">
      <div class="container">
        <h2 id="tips-heading" class="section__title">Navodaya Mock Test 2027 – Preparation Tips</h2>
        <p class="section__subtitle">These practical tips are based on the JNVST exam pattern and can help you make the most of your preparation time.</p>
        <div class="tips-grid">
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">01</div>
            <h3 class="tip-card__title">Practise Mental Ability Daily</h3>
            <p class="tip-card__desc">The Mental Ability Test carries 50% of the total marks and is often the most challenging section for students. Spend at least 20–30 minutes every day solving non-verbal reasoning and pattern questions. Over time, you will start recognising common question types quickly, which saves precious time during the actual exam.</p>
          </div>
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">02</div>
            <h3 class="tip-card__title">Revise Arithmetic Concepts</h3>
            <p class="tip-card__desc">Make sure you have a strong understanding of Class 4 and 5 maths topics — particularly fractions, decimals, LCM/HCF, simple measurements and basic geometry. Solve at least 10–15 arithmetic problems every day. Focus on accuracy first, then work on speed.</p>
          </div>
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">03</div>
            <h3 class="tip-card__title">Read Every Day for Language Practice</h3>
            <p class="tip-card__desc">Reading a short passage daily in the language you plan to attempt (English or Hindi) helps improve comprehension speed and accuracy. Try to answer questions about the passage without re-reading — a skill that will help you in the Language section of the JNVST.</p>
          </div>
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">04</div>
            <h3 class="tip-card__title">Practise Time Management</h3>
            <p class="tip-card__desc">During the JNVST you have 120 minutes for 80 questions — roughly 1.5 minutes per question. When taking a mock test, track how long you spend on each section. If you spend too long on one question, move on and return to it at the end. Practising this habit now will prevent panic on exam day.</p>
          </div>
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">05</div>
            <h3 class="tip-card__title">Take Full-Length Mock Tests</h3>
            <p class="tip-card__desc">Rather than only practising individual topics, attempt full-length mock tests at least once a week. Sitting through a complete 80-question test without interruptions builds the concentration and stamina you will need on exam day. It also helps you experience the realistic pressure of a timed test.</p>
          </div>
          <div class="tip-card">
            <div class="tip-card__num" aria-hidden="true">06</div>
            <h3 class="tip-card__title">Analyse Your Mistakes After Every Test</h3>
            <p class="tip-card__desc">After each mock test, go through every question you got wrong. Try to understand why you made the mistake — was it a concept gap, a careless error, or a time pressure issue? This step is just as important as taking the test itself. Students who analyse their mistakes improve much faster than those who simply retake tests without reviewing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. FAQ -->
    <section class="section" aria-labelledby="faq-heading">
      <div class="container">
        <h2 id="faq-heading" class="section__title">Frequently Asked Questions</h2>
        <p class="section__subtitle">Common questions about the Brinto JNVST Class 6 Mock Test 2027.</p>
        <div class="faq-list" role="list">
          {faqs.map((faq, i) => (
            <details class="faq-item" role="listitem" name="faq-group">
              <summary class="faq-item__question" id={`faq-q-${i}`}>
                {faq.q}
                <span class="faq-item__icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-item__answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. FINAL CTA -->
    <section class="final-cta" aria-labelledby="final-cta-heading">
      <div class="final-cta__inner">
        <div class="final-cta__bg" aria-hidden="true"><div class="final-cta__blob"></div></div>
        <h2 id="final-cta-heading" class="final-cta__title">Ready to Test Your Navodaya Preparation?</h2>
        <p class="final-cta__desc">Attempt the free JNVST Class 6 Mock Test 2027 and check your preparation level. Get your instant score and All India Rank — no fee, no registration hassle.</p>
        <a href={MOCK_TEST_URL} class="btn btn--primary btn--large btn--light" id="final-cta" aria-label="Start the free Navodaya mock test 2027">
          Start Free Navodaya Mock Test <span aria-hidden="true">→</span>
        </a>
        <p class="final-cta__note">Brinto is an independent educational platform and is not affiliated with Navodaya Vidyalaya Samiti (NVS).</p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .nmt-page {
    --page-max: 1140px;
    --section-pad: clamp(48px, 7vw, 88px);
  }
  .container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 40px);
  }

  /* BUTTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 28px;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: var(--transition-smooth);
    white-space: nowrap;
  }
  .btn--primary {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 4px 16px rgba(176, 8, 32, 0.22);
  }
  .btn--primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(176, 8, 32, 0.3);
  }
  .btn--primary:active { transform: translateY(0); }
  .btn--secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1.5px solid var(--border-strong);
  }
  .btn--secondary:hover {
    background: var(--surface-2);
    border-color: var(--text-muted);
    transform: translateY(-1px);
  }
  .btn--large { padding: 16px 36px; font-size: 16px; }
  .btn--full { width: 100%; justify-content: center; }
  .btn--light {
    background: #fff;
    color: var(--primary);
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  }
  .btn--light:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  }

  /* SECTION SHARED */
  .section { padding-block: var(--section-pad); }
  .section--alt { background: var(--surface-2); }
  .section__title {
    font-size: clamp(22px, 3.5vw, 34px);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.2;
  }
  .section__subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 40px;
    max-width: 640px;
    line-height: 1.65;
  }
  .section__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 100px);
    background: linear-gradient(135deg, #fff8f8 0%, #fff 40%, #fff5f0 100%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
