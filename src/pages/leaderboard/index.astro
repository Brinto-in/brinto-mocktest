---

<BaseLayout
    title="Leaderboard"
    description="See how you rank against thousands of Odisha govt exam aspirants on Brinto MockTest."
>
    <!-- ── HERO ── -->
    <section class="lb-hero">
        <div class="wrap lh-inner">
            <div class="lh-text">
                <p class="lh-eyebrow">Rankings</p>
                <h1>Leaderboard</h1>
                <p class="lh-sub">
                    Top performers across OSSSC, OPSC, SSC, Railway, and Police
                    mock tests.
                </p>
            </div>
            <div class="lh-meta">
                <div class="lm-item">
                    <span class="lm-n">2,80,000+</span>
                    <span class="lm-l">Students Ranked</span>
                </div>
                <div class="lm-divider"></div>
                <div class="lm-item">
                    <span class="lm-n">Live</span>
                    <span class="lm-l">Updated in real-time</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── YOUR RANK CARD (injected by JS if localStorage has data) ── -->
    <div class="wrap" id="your-rank-wrap" style="display:none">
        <div class="your-rank-card" id="your-rank-card">
            <div class="yr-badge">YOU</div>
            <div class="yr-info">
                <div class="yr-name">Your Position</div>
                <div class="yr-sub" id="yr-sub">
                    Based on your best test score
                </div>
            </div>
            <div class="yr-stats">
                <div class="yr-stat">
                    <span class="yr-n" id="yr-rank">#—</span>
                    <span class="yr-l">Rank</span>
                </div>
                <div class="yr-stat">
                    <span class="yr-n" id="yr-score">—%</span>
                    <span class="yr-l">Best Score</span>
                </div>
                <div class="yr-stat">
                    <span class="yr-n" id="yr-tests">—</span>
                    <span class="yr-l">Tests Done</span>
                </div>
            </div>
            <a href="/results" class="yr-cta">My Results →</a>
        </div>
    </div>

    <!-- ── PODIUM (top 3) ── -->
    <section class="wrap podium-section">
        <div class="podium" id="podium">
            <!-- Injected by JS -->
        </div>
    </section>

    <!-- ── FILTERS ── -->
    <div class="wrap lb-toolbar">
        <div class="exam-filters" id="exam-filters">
            {
                exams.map((e, i) => (
                    <button
                        class={`ef-btn ${i === 0 ? "active" : ""}`}
                        data-exam={e}
                    >
                        {e}
                    </button>
                ))
            }
        </div>
        <div class="period-filters" id="period-filters">
            <button class="pf-btn active" data-period="all">All Time</button>
            <button class="pf-btn" data-period="month">This Month</button>
            <button class="pf-btn" data-period="week">This Week</button>
        </div>
    </div>

    <!-- ── TABLE ── -->
    <div class="wrap lb-table-wrap">
        <table class="lb-table" id="lb-table">
            <thead>
                <tr>
                    <th class="th-rank">Rank</th>
                    <th class="th-name">Student</th>
                    <th class="th-exam">Top Exam</th>
                    <th class="th-score">Best Score</th>
                    <th class="th-tests">Tests</th>
                    <th class="th-acc">Accuracy</th>
                    <th class="th-streak">Streak</th>
                </tr>
            </thead>
            <tbody id="lb-body"></tbody>
        </table>
    </div>
</BaseLayout>

<script define:vars={{ LEADERBOARD, exams }}>
    // ─────────────────────────────────────────────
    //  STATE
    // ─────────────────────────────────────────────
    let activeExam = "All";
    let activePeriod = "all";

    // Period multipliers — simulate different time windows with same data
    const periodFactor = { all: 1, month: 0.7, week: 0.4 };

    // ─────────────────────────────────────────────
    //  USER FROM LOCALSTORAGE
    // ─────────────────────────────────────────────
    let userResults = [];
    try {
        userResults = JSON.parse(
            localStorage.getItem("brinto_test_results") || "[]",
        );
    } catch (e) {}

    if (userResults.length > 0) {
        const bestScore = Math.max(...userResults.map((r) => r.score));
        const totalTests = userResults.length;
        const avgAcc = Math.round(
            userResults.reduce((s, r) => s + r.score, 0) / totalTests,
        );

        // Compute rank: how many in full leaderboard beat user's best score
        const rank = LEADERBOARD.filter((p) => p.score > bestScore).length + 1;

        document.getElementById("your-rank-wrap").style.display = "block";
        document.getElementById("yr-rank").textContent = `#${rank}`;
        document.getElementById("yr-score").textContent = `${bestScore}%`;
        document.getElementById("yr-tests").textContent = totalTests;
        document.getElementById("yr-sub").textContent =
            `Based on ${totalTests} test${totalTests > 1 ? "s" : ""} · avg accuracy ${avgAcc}%`;
    }

    // ─────────────────────────────────────────────
    //  PODIUM
    // ─────────────────────────────────────────────
    function renderPodium(data) {
        const top3 = data.slice(0, 3);
        const podium = document.getElementById("podium");
        if (top3.length < 3) {
            podium.innerHTML = "";
            return;
        }

        const [first, second, third] = top3;
        const medals = ["🥇", "🥈", "🥉"];
        const heights = ["120px", "96px", "80px"];
        // Reorder for display: 2nd, 1st, 3rd
        const order = [second, first, third];
        const displayMedals = ["🥈", "🥇", "🥉"];
        const displayHeights = ["96px", "120px", "80px"];
        const displayRanks = [2, 1, 3];
        const displayClasses = ["pod-silver", "pod-gold", "pod-bronze"];

        podium.innerHTML = order
            .map(
                (p, i) => `
    <div class="pod-card ${displayClasses[i]}">
      <div class="pod-medal">${displayMedals[i]}</div>
      <div class="pod-avatar">${p.avatar}</div>
      <div class="pod-name">${p.name.split(" ")[0]} ${p.name.split(" ").pop()}</div>
      <div class="pod-exam-tag">${p.exam}</div>
      <div class="pod-score">${p.score}%</div>
      <div class="pod-platform" style="height:${displayHeights[i]}">
        <span class="pod-rank">#${displayRanks[i]}</span>
      </div>
    </div>
  `,
            )
            .join("");
    }

    // ─────────────────────────────────────────────
    //  TABLE
    // ─────────────────────────────────────────────
    const RANK_ICONS = { gold: "🥇", silver: "🥈", bronze: "🥉" };
    const STREAK_LABELS = (n) =>
        n >= 10 ? "🔥 " + n : n >= 5 ? "⚡ " + n : n > 0 ? "" + n : "—";

    function renderTable(data) {
        const tbody = document.getElementById("lb-body");
        if (data.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:48px;color:var(--ink-muted);">No results for this filter.</td></tr>`;
            return;
        }

        // Check if user is in this filtered list (by score proximity)
        const userBest = userResults.length
            ? Math.max(...userResults.map((r) => r.score))
            : null;

        tbody.innerHTML = data
            .map((p, idx) => {
                const rank = idx + 1;
                const isYou = false; // no auth yet
                const badgeHtml = p.badge
                    ? `<span class="medal-icon">${RANK_ICONS[p.badge]}</span>`
                    : "";
                const rankCell =
                    rank <= 3
                        ? `<td class="td-rank rank-${p.badge}">${badgeHtml}${rank}</td>`
                        : `<td class="td-rank">${rank}</td>`;

                const scoreBar = `
      <div class="score-bar-wrap">
        <div class="score-bar-track">
          <div class="score-bar-fill ${p.score >= 80 ? "bar-green" : p.score >= 60 ? "bar-gold" : "bar-red"}"
               style="width:${p.score}%"></div>
        </div>
        <span class="score-bar-pct">${p.score}%</span>
      </div>`;

                return `
      <tr class="lb-row ${rank <= 3 ? "top-row" : ""}">
        ${rankCell}
        <td class="td-name">
          <div class="student-cell">
            <div class="student-avatar">${p.avatar}</div>
            <div class="student-info">
              <span class="student-name">${p.name}</span>
            </div>
          </div>
        </td>
        <td class="td-exam"><span class="exam-chip">${p.exam}</span></td>
        <td class="td-score">${scoreBar}</td>
        <td class="td-tests">${p.tests}</td>
        <td class="td-acc">
          <span class="acc-badge ${p.accuracy >= 80 ? "acc-green" : p.accuracy >= 60 ? "acc-gold" : "acc-red"}">
            ${p.accuracy}%
          </span>
        </td>
        <td class="td-streak">${STREAK_LABELS(p.streak)}</td>
      </tr>`;
            })
            .join("");
    }

    // ─────────────────────────────────────────────
    //  FILTER + RENDER
    // ─────────────────────────────────────────────
    function applyFilters() {
        let data =
            activeExam === "All"
                ? [...LEADERBOARD]
                : LEADERBOARD.filter((p) => p.exam === activeExam);

        // Period: trim list size to simulate fewer participants in shorter windows
        const factor = periodFactor[activePeriod];
        data = data.slice(0, Math.max(3, Math.round(data.length * factor)));

        // Re-rank after filter
        data = data.map((p, i) => ({ ...p, displayRank: i + 1 }));

        renderPodium(data);
        renderTable(data);
    }

    // ─────────────────────────────────────────────
    //  FILTER BUTTON SETUP
    // ─────────────────────────────────────────────
    document.getElementById("exam-filters").addEventListener("click", (e) => {
        const btn = e.target.closest(".ef-btn");
        if (!btn) return;
        document
            .querySelectorAll(".ef-btn")
            .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeExam = btn.dataset.exam;
        applyFilters();
    });

    document.getElementById("period-filters").addEventListener("click", (e) => {
        const btn = e.target.closest(".pf-btn");
        if (!btn) return;
        document
            .querySelectorAll(".pf-btn")
            .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activePeriod = btn.dataset.period;
        applyFilters();
    });

    // ─────────────────────────────────────────────
    //  INIT
    // ─────────────────────────────────────────────
    applyFilters();

    // Animate score bars after render
    setTimeout(() => {
        document.querySelectorAll(".score-bar-fill").forEach((el) => {
            const w = el.style.width;
            el.style.width = "0%";
            requestAnimationFrame(() => {
                el.style.transition = "width 0.7s ease";
                el.style.width = w;
            });
        });
    }, 100);
</script>

<style is:global>
    /* ── HERO ── */
    .lb-hero {
        background: var(--surface);
        border-bottom: 1px solid var(--rule);
        padding: 48px 0 40px;
    }
    .lh-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }
    .lh-eyebrow {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand);
        margin: 0 0 10px;
    }
    .lh-inner h1 {
        font-size: clamp(1.8rem, 3.2vw, 2.4rem);
        color: var(--ink);
        margin-bottom: 8px;
    }
    .lh-sub {
        color: var(--ink-soft);
        margin: 0;
    }
    .lh-meta {
        display: flex;
        align-items: center;
        gap: 24px;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 20px 28px;
    }
    .lm-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }
    .lm-n {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--ink);
    }
    .lm-l {
        font-size: 0.72rem;
        color: var(--ink-muted);
        font-weight: 600;
    }
    .lm-divider {
        width: 1px;
        height: 40px;
        background: var(--rule);
    }

    /* ── YOUR RANK CARD ── */
    .your-rank-card {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        background: linear-gradient(135deg, #1a1410 0%, #2d1f14 100%);
        border-radius: var(--radius-md);
        padding: 20px 24px;
        margin: 24px 0 0;
        color: #fff;
    }
    .yr-badge {
        background: var(--brand);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        padding: 4px 10px;
