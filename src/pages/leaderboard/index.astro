        font-weight: 700;
        font-size: 0.96rem;
    }
    .yr-sub {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.55);
        margin-top: 2px;
    }
    .yr-stats {
        display: flex;
        gap: 24px;
    }
    .yr-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
    }
    .yr-n {
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 700;
    }
    .yr-l {
        font-size: 0.65rem;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .yr-cta {
        background: var(--brand);
        color: #fff;
        font-size: 0.86rem;
        font-weight: 700;
        padding: 9px 20px;
        border-radius: var(--radius-pill);
        flex-shrink: 0;
        transition:
            background 0.15s,
