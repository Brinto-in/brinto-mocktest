---

<BaseLayout
  title="All Partner Institutes & Tuition Teachers"
  description="Explore leading coaching institutes, tuition teachers, and subject masters in Odisha conducting online mock tests on Brinto."
>

<section class="page-hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <span class="hero-badge">🏫 PARTNER EDUCATORS</span>
      <h1>All Institutes & Tuition Teachers</h1>
      <p>Discover top coaching centers, subject masters, and tuition classes conducting tests across Odisha.</p>
    </div>
    <div class="search-box">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search teacher, institute, subject, city…"
        autocomplete="off"
        aria-label="Search institutes"
      />
    </div>
  </div>
</section>

<div class="wrap listing-layout">

  <!-- Filters Sidebar -->
  <aside class="filters" aria-label="Filter institutes">
    <div class="filter-group">
      <h3>Category Type</h3>
      <ul class="filter-list" id="type-filter">
        {categoryTypes.map((type, i) => (
          <li>
            <button
              class={`filter-btn ${i === 0 ? 'active' : ''}`}
              data-type={type}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {type}
              <span class="filter-count">
                {type === 'All' ? allInstitutes.length : allInstitutes.filter(item => item.type === type).length}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="filter-group">
      <h3>City / Location</h3>
      <ul class="filter-list" id="city-filter">
        {cities.map((city, i) => (
          <li>
            <button
              class={`filter-btn ${i === 0 ? 'active' : ''}`}
              data-city={city}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {city}
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="filter-group">
      <h3>Subject Focus</h3>
      <ul class="filter-list" id="subject-filter">
        {subjects.map((sub, i) => (
          <li>
            <button
              class={`filter-btn ${i === 0 ? 'active' : ''}`}
              data-subject={sub}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {sub}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="main-content">
    <div class="toolbar">
      <span class="result-count" id="result-count">{allInstitutes.length} institutes & teachers</span>
      <div class="sort-row">
        <label for="sort-select">Sort by:</label>
        <select id="sort-select" aria-label="Sort institutes">
          <option value="popular">Most Students</option>
          <option value="rating">Top Rated</option>
          <option value="tests">Most Tests</option>
          <option value="name">Name (A–Z)</option>
        </select>
      </div>
    </div>

    <div class="inst-grid" id="inst-grid">
      {allInstitutes.map((inst) => (
        <div
          class="inst-card"
          data-type={inst.type}
          data-city={inst.city}
          data-subjects={inst.subjects.join(',')}
          data-students={inst.studentsCount}
          data-rating={inst.rating}
          data-tests={inst.testsCount}
          data-name={inst.name}
        >
          <div class="ic-top">
            <div class="ic-avatar" style={`background:${inst.avatarBg}`}>
              {inst.avatarText}
            </div>
            <div class="ic-info">
              <div class="ic-badge">{inst.badge}</div>
              <h2 class="ic-name">{inst.name}</h2>
              <span class="ic-odia">({inst.odiaName})</span>
            </div>
          </div>

          <div class="ic-meta">
            <span class="ic-type">{inst.type}</span>
            <span class="ic-dot">•</span>
            <span class="ic-city">📍 {inst.city}</span>
          </div>

          <p class="ic-desc">{inst.description}</p>

          <div class="ic-subjects">
            {inst.subjects.map(s => <span class="subject-tag">{s}</span>)}
          </div>

          <div class="ic-footer">
            <div class="ic-stats">
              <span><strong>{inst.testsCount}</strong> Tests</span>
              <span class="ic-dot">•</span>
              <span><strong>{inst.studentsCount.toLocaleString('en-IN')}</strong> Students</span>
              <span class="ic-dot">•</span>
              <span class="ic-rating">★ {inst.rating}</span>
            </div>
            <a href={`/tests?search=${encodeURIComponent(inst.name)}`} class="ic-cta">View Tests →</a>
          </div>
        </div>
      ))}
    </div>

    <p class="empty-msg" id="empty-msg" style="display:none">
      No institutes match your search or filter. <button id="reset-filters">Reset filters</button>
    </p>

    <!-- Partner Banner CTA -->
    <div class="partner-banner">
      <div class="pb-text">
        <h2>Are you a tuition teacher or coaching institute in Odisha?</h2>
        <p>Conduct your online mock tests, manage students, and share instant result keys on Brinto for free.</p>
      </div>
      <a href="https://outsource.brinto.in" target="_blank" rel="noopener" class="pb-btn">
        Become a Test Partner →
      </a>
    </div>
  </div>

</div>

</BaseLayout>

<script is:inline>
  let activeType = 'All';
  let activeCity = 'All Cities';
  let activeSubject = 'All Subjects';
  let searchQ = '';
  let sortBy = 'popular';

  const grid = document.getElementById('inst-grid');
  const cards = Array.from(grid.querySelectorAll('.inst-card'));
  const countEl = document.getElementById('result-count');
  const emptyEl = document.getElementById('empty-msg');

  function applyFilters() {
    let visible = [];
    cards.forEach(card => {
      const type = card.dataset.type;
      const city = card.dataset.city;
      const subs = card.dataset.subjects.split(',');
      const name = card.dataset.name.toLowerCase();
      const desc = card.querySelector('.ic-desc').textContent.toLowerCase();

      const matchesType = activeType === 'All' || type === activeType;
      const matchesCity = activeCity === 'All Cities' || city === activeCity;
      const matchesSubject = activeSubject === 'All Subjects' || subs.includes(activeSubject);
      const matchesSearch = searchQ === '' || name.includes(searchQ) || desc.includes(searchQ) || city.toLowerCase().includes(searchQ);

      const isMatch = matchesType && matchesCity && matchesSubject && matchesSearch;
      card.style.display = isMatch ? '' : 'none';
      if (isMatch) visible.push(card);
    });

    // Sort visible cards
    visible.sort((a, b) => {
      if (sortBy === 'popular') return parseInt(b.dataset.students) - parseInt(a.dataset.students);
      if (sortBy === 'rating') return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
      if (sortBy === 'tests') return parseInt(b.dataset.tests) - parseInt(a.dataset.tests);
      if (sortBy === 'name') return a.dataset.name.localeCompare(b.dataset.name);
      return 0;
    });

    visible.forEach(card => grid.appendChild(card));

    countEl.textContent = `${visible.length} institute${visible.length !== 1 ? 's & teachers' : ' & teacher'}`;
    emptyEl.style.display = visible.length === 0 ? '' : 'none';
  }

  function setupFilterGroup(groupId, prop) {
    document.getElementById(groupId).addEventListener('click', e => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      document.querySelectorAll(`#${groupId} .filter-btn`).forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      if (prop === 'type') activeType = btn.dataset.type;
      if (prop === 'city') activeCity = btn.dataset.city;
      if (prop === 'subject') activeSubject = btn.dataset.subject;
      applyFilters();
    });
  }

  setupFilterGroup('type-filter', 'type');
  setupFilterGroup('city-filter', 'city');
  setupFilterGroup('subject-filter', 'subject');

  document.getElementById('search-input').addEventListener('input', e => {
    searchQ = e.target.value.trim().toLowerCase();
    applyFilters();
  });

  document.getElementById('sort-select').addEventListener('change', e => {
    sortBy = e.target.value;
    applyFilters();
  });

  document.getElementById('reset-filters').addEventListener('click', () => {
    activeType = 'All'; activeCity = 'All Cities'; activeSubject = 'All Subjects'; searchQ = '';
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-pressed', 'false');
    });
    document.querySelectorAll('.filter-btn:first-child').forEach(b => {
      b.classList.add('active');
      b.setAttribute('aria-pressed', 'true');
    });
    document.getElementById('search-input').value = '';
    applyFilters();
  });
</script>

<style>
  .page-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 48px 0 36px;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 10px;
  }
  .hero-text h1 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--ink);
    margin-bottom: 6px;
  }
  .hero-text p { color: var(--ink-soft); max-width: 540px; }
  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1.5px solid var(--rule);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
    min-width: 340px;
    color: var(--ink-muted);
    transition: border-color 0.15s;
  }
  .search-box:focus-within {
    border-color: var(--brand);
    color: var(--ink);
  }
  .search-box input {
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.95rem;
    font-family: var(--font-body);
    color: var(--ink);
    width: 100%;
  }
  .search-box input::placeholder { color: var(--ink-muted); }

  /* Layout */
  .listing-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    padding-top: 36px;
    padding-bottom: 72px;
    align-items: start;
  }

  /* Sidebar */
  .filters {
    position: sticky;
    top: 88px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .filter-group h3 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .filter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .filter-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    color: var(--ink-soft);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .filter-btn:hover { background: var(--surface-2); color: var(--ink); }
  .filter-btn.active { background: var(--brand-light); color: var(--brand-dark); font-weight: 700; }
  .filter-count {
    font-size: 0.75rem;
    color: var(--ink-muted);
    background: var(--surface-2);
    padding: 1px 7px;
    border-radius: 99px;
  }
  .filter-btn.active .filter-count { background: var(--brand-mid); color: var(--brand-dark); }

  /* Toolbar */
  .main-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .result-count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .sort-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  select {
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 6px 10px;
    cursor: pointer;
  }

  /* Grid */
  .inst-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .inst-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .inst-card:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(176,0,32,0.08);
  }
  .ic-top {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .ic-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ic-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ic-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ic-name {
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.25;
  }
  .ic-odia {
    font-size: 0.85rem;
    color: var(--brand);
    font-weight: 600;
  }
  .ic-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .ic-dot { color: var(--ink-muted); }
  .ic-desc {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0;
  }
  .ic-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
