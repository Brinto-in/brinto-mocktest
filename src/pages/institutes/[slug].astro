---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInstituteBySlug, getAllInstitutes, type Institute } from '../../data/institutes';

const { slug } = Astro.params;
const inst = slug ? getInstituteBySlug(slug) : undefined;

if (!inst) {
  return Astro.redirect('/mocktest/institutes');
}

// Stats & Helpers
const totalFreeTests = inst.mockTests.filter(t => t.isFree).length;
const totalQuestionsInBank = inst.mockTests.reduce((acc, t) => acc + t.questions, 0);

// Difficulty color mapping
const diffColorMap: Record<string, { bg: string; text: string; border: string }> = {
  Easy: { bg: '#E8F5EE', text: '#1B6B3A', border: '#A3D9B5' },
  Medium: { bg: '#FEF3E2', text: '#B86A00', border: '#FCD79B' },
  Hard: { bg: '#FFF0F2', text: '#B00020', border: '#F5C6CE' },
};

function starsStr(n: number) {
  return '★'.repeat(n) + '☆'.repeat(Math.max(0, 5 - n));
}
---

<BaseLayout
  title={`${inst.name} (${inst.odiaName}) — ${inst.yearsExp}+ Years Experience | Brinto MockTest`}
  description={`Practice online mock tests by ${inst.name} (${inst.odiaName}), senior faculty with ${inst.yearsExp}+ years of experience in ${inst.city}, Odisha. ${inst.testsCount} tests, ${inst.studentsCount.toLocaleString('en-IN')}+ students.`}
>
  <!-- Schema.org for Education Organization / Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": inst.type === 'Tuition Teacher' ? 'Person' : 'EducationalOrganization',
    "name": inst.name,
    "alternateName": inst.odiaName,
    "description": inst.description,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": inst.city,
      "addressRegion": inst.state,
      "addressCountry": "IN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": inst.rating,
      "reviewCount": inst.reviewCount,
      "bestRating": 5,
      "worstRating": 1
    }
  })} />

  <!-- ═══════════════════════════════════════════════ TOP BREADCRUMB & HERO ══ -->
  <section class="profile-hero-section">
    <div class="wrap">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/mocktest">Home</a>
        <span class="bc-sep">/</span>
        <a href="/mocktest/institutes">Institutes</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">{inst.name}</span>
      </nav>

      <!-- Main Profile Banner Card -->
      <div class="profile-hero-card">
        <div class="phc-left">
          <!-- Avatar + Experience Medal -->
          <div class="phc-avatar-wrap">
            <div class="phc-avatar" style={`background:${inst.avatarBg}`}>
              {inst.avatarText}
            </div>
            <!-- Prominent 15+ Yrs Exp Ribbon -->
            <div class="exp-ribbon">
              <span class="exp-medal">🎖️</span>
              <span class="exp-text"><strong>{inst.yearsExp}+ Years</strong> Experience</span>
            </div>
          </div>

          <!-- Profile Details -->
          <div class="phc-main-info">
            <div class="phc-badge-row">
              <span class="partner-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5zm-2 16l-4-4 1.41-1.41L10 15.17l6.59-6.59L18 10l-8 8z"/>
                </svg>
                {inst.badge}
              </span>
              <span class="status-live">
                <span class="live-dot"></span> Active Educator
              </span>
            </div>

            <h1 class="phc-name">{inst.name}</h1>
            <p class="phc-odia-title">{inst.odiaName}</p>

            {/*
            <div class="phc-meta-chips">
              <span class="meta-chip chip-role">🎓 {inst.role}</span>
              <span class="meta-chip chip-city">📍 {inst.city}, {inst.state}</span>
              <span class="meta-chip chip-type">🏛️ {inst.type}</span>
              <span class="meta-chip chip-lang">🗣️ Odia & English</span>
              {inst.subjects.map(s => (
                <span class="meta-chip chip-subj">📚 {s}</span>
              ))}
            </div>
            */}

            <p class="phc-highlight">
              <span class="highlight-quote">“</span>
              {inst.experienceHighlight}
              <span class="highlight-quote">”</span>
            </p>

            <div class="phc-action-buttons">
              <a href="#mock-tests" class="btn-primary-action">
                <span>🚀 Explore Mock Tests</span>
                <span class="btn-count">({inst.mockTests.length})</span>
              </a>
              <a href={`tel:${inst.contactPhone.replace(/\s+/g, '')}`} class="btn-secondary-action">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                </svg>
                <span>{inst.contactPhone}</span>
              </a>
              <a
                href={`https://wa.me/919437012845?text=${encodeURIComponent(`Hello, I saw ${inst.name}'s profile on Brinto MockTest and want to know more about the test series.`)}`}
                target="_blank"
                rel="noopener"
                class="btn-whatsapp-action"
                aria-label="Ask on WhatsApp"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.04 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.67 20.16 9.32 19.8 8.14 19.11L7.85 18.94L4.72 19.76L5.56 16.71L5.38 16.41C4.61 15.18 4.2 13.57 4.2 11.91C4.2 7.37 7.9 3.67 12.04 3.67ZM8.83 7.37C8.61 7.37 8.24 7.45 7.93 7.79C7.62 8.12 6.74 8.94 6.74 10.62C6.74 12.3 7.97 13.92 8.14 14.15C8.31 14.37 10.51 17.77 13.88 19.22C14.68 19.57 15.31 19.78 15.79 19.93C16.6 20.19 17.33 20.15 17.91 20.07C18.56 19.97 19.9 19.25 20.18 18.47C20.46 17.68 20.46 17.01 20.37 16.86C20.29 16.72 20.07 16.63 19.74 16.47C19.41 16.3 17.78 15.5 17.48 15.39C17.18 15.28 16.96 15.23 16.74 15.56C16.52 15.89 15.89 16.63 15.7 16.85C15.51 17.07 15.33 17.1 15 16.93C14.67 16.77 13.61 16.42 12.35 15.3C11.37 14.43 10.71 13.35 10.52 13.02C10.33 12.69 10.5 12.51 10.67 12.35C10.82 12.2 11 11.97 11.17 11.78C11.34 11.58 11.4 11.44 11.51 11.22C11.62 11 11.57 10.81 11.48 10.64C11.4 10.48 10.74 8.84 10.46 8.18C10.19 7.53 9.92 7.62 9.71 7.61C9.52 7.6 9.3 7.6 9.08 7.6C8.86 7.6 8.83 7.37 8.83 7.37Z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ── 5-Metric Experience Impact Bar (Single Line) ── -->
      <div class="impact-metrics-bar" role="region" aria-label="Key Educator Impact Statistics">
        <div class="im-card highlight-card">
          <div class="im-icon">🎖️</div>
          <div class="im-data">
            <span class="im-value gold-text">{inst.yearsExp}+ Years</span>
            <span class="im-label">Teaching Legacy</span>
          </div>
        </div>

        <div class="im-card">
          <div class="im-icon">📝</div>
          <div class="im-data">
            <span class="im-value">{inst.testsCount}</span>
            <span class="im-label">Active Mock Tests</span>
          </div>
        </div>

        <div class="im-card">
          <div class="im-icon">👥</div>
          <div class="im-data">
            <span class="im-value">{inst.studentsCount.toLocaleString('en-IN')}+</span>
            <span class="im-label">Students Mentored</span>
          </div>
        </div>

        <div class="im-card">
          <div class="im-icon">★</div>
          <div class="im-data">
            <span class="im-value gold-text">{inst.rating} / 5.0</span>
            <span class="im-label">{inst.reviewCount} Verified Reviews</span>
          </div>
        </div>

        <div class="im-card">
          <div class="im-icon">🎯</div>
          <div class="im-data">
            <span class="im-value green-text">{inst.passRate}%</span>
            <span class="im-label">Board Pass Rate</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ MAIN CONTENT BODY ═════ -->
  <main class="wrap profile-body-container">
    <div class="layout-grid">

      <!-- LEFT COLUMN: ABOUT + MOCK TESTS + REVIEWS -->
      <div class="main-column">

        <!-- ── SECTION 1: ABOUT & PEDAGOGY ── -->
        <section class="content-card" id="about">
          <div class="card-header">
            <div class="ch-left">
              <span class="ch-icon">👨‍🏫</span>
              <div>
                <h2 class="ch-title">About Faculty & Pedagogy</h2>
                <p class="ch-subtitle">15+ years of board exam mentorship, methodology, and student success</p>
              </div>
            </div>
          </div>

          <div class="about-text-content">
            <p>{inst.description}</p>
          </div>

          {/*
          <!-- 4 Achievements Cards -->
          <div class="achievements-section">
            <h3 class="subsection-title">Key Distinctions & Milestones</h3>
            <div class="achievements-grid">
              {inst.achievements.map((ach, idx) => (
                <div class="achieve-card">
                  <div class="achieve-badge-num">0{idx + 1}</div>
                  <div class="achieve-info">
                    <span class="achieve-check-icon">✓</span>
                    <span class="achieve-text">{ach}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          */}

          {/*
          <!-- Syllabus Topics Covered -->
          <div class="syllabus-section">
            <h3 class="subsection-title">Chapters & Units Covered in Test Series</h3>
            <div class="syllabus-tags-grid">
              {inst.syllabusTopics.map(topic => (
                <div class="syllabus-topic-chip">
                  <span class="stc-bullet">🔹</span>
                  <span>{topic}</span>
                </div>
              ))}
            </div>
          </div>
          */}
        </section>

        <!-- ── SECTION 2: PROPERLY STRUCTURED MOCK TESTS ── -->
        <section class="content-card tests-section-card" id="mock-tests">
          <div class="card-header tests-header">
            <div class="ch-left">
              <span class="ch-icon">📝</span>
              <div>
                <div class="title-with-pill">
                  <h2 class="ch-title">Institute Mock Tests & Model Papers</h2>
                  <span class="badge-counter">{inst.mockTests.length} Available</span>
                </div>
                <p class="ch-subtitle">
                  Strictly aligned with BSE Odisha Matriculation exam blueprint with instant solutions & state ranking.
                </p>
              </div>
            </div>
          </div>

          <!-- Controls: Category Filter Tabs + Search + Difficulty -->
          <div class="tests-controls-bar">
            <!-- Tabs -->
            <div class="category-tabs" role="tablist" aria-label="Test categories">
              <button class="cat-tab active" data-category="All" role="tab" aria-selected="true">
                All Tests ({inst.mockTests.length})
              </button>
              <button class="cat-tab" data-category="Chapter-wise" role="tab" aria-selected="false">
                Chapter-wise
              </button>
              <button class="cat-tab" data-category="Model Paper" role="tab" aria-selected="false">
                Model Papers
              </button>
              <button class="cat-tab" data-category="Full Syllabus" role="tab" aria-selected="false">
                Full Syllabus
              </button>
              <button class="cat-tab" data-category="High-Yield" role="tab" aria-selected="false">
                High-Yield
              </button>
            </div>

            <!-- Second row: Search & Filters -->
            <div class="filters-subrow">
              <div class="search-input-wrap">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                </svg>
                <input
                  type="text"
                  id="test-search-input"
                  placeholder="Search tests by title or chapter..."
                  aria-label="Search mock tests"
                />
              </div>

              <div class="filter-controls-group">
                <select id="diff-filter-select" aria-label="Filter by difficulty">
                  <option value="All">All Difficulties</option>
                  <option value="Easy">Easy Level</option>
                  <option value="Medium">Medium Level</option>
                  <option value="Hard">Hard Level</option>
                </select>

                <label class="free-only-toggle" for="free-only-checkbox">
                  <input type="checkbox" id="free-only-checkbox" />
                  <span>Free Only</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Structured Mock Test Cards List -->
          <div class="structured-tests-list" id="tests-list-container">
            {inst.mockTests.map((test, index) => {
              const diffColors = diffColorMap[test.difficulty] || diffColorMap['Medium'];
              return (
                <article
                  class="mock-test-item-card"
                  data-category={test.category}
                  data-difficulty={test.difficulty}
                  data-free={test.isFree ? 'true' : 'false'}
                  data-title={test.title.toLowerCase()}
                  data-syllabus={test.syllabus.join(' ').toLowerCase()}
                >
                  <div class="mti-top-row">
                    <div class="mti-index-badge">#{String(index + 1).padStart(2, '0')}</div>

                    <div class="mti-meta-pill-group">
                      <span class="mti-cat-badge">{test.category}</span>
                      {test.isFree ? (
                        <span class="mti-free-badge">🎉 FREE TEST</span>
                      ) : (
                        <span class="mti-pro-badge">🔒 VERIFIED SET</span>
                      )}
                      <span
                        class="mti-diff-badge"
                        style={`background:${diffColors.bg}; color:${diffColors.text}; border:1px solid ${diffColors.border};`}
                      >
                        ● {test.difficulty}
                      </span>
                    </div>

                    <div class="mti-attempts-meta">
                      👥 {test.attempts.toLocaleString('en-IN')} attempts
                    </div>
                  </div>

                  <div class="mti-body-row">
                    <div class="mti-titles">
                      <h3 class="mti-title">{test.title}</h3>
                      {test.odiaTitle && (
                        <p class="mti-odia-title">{test.odiaTitle}</p>
                      )}
                      {test.description && (
                        <p class="mti-desc">{test.description}</p>
                      )}
                    </div>

                    <div class="mti-cta-wrap">
                      <a
                        href={`/mocktest/test/${test.id}`}
                        class="btn-start-test"
                        aria-label={`Start test: ${test.title}`}
                      >
                        <span>Start Test</span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                      </a>
                    </div>
                  </div>

                  <!-- Structured Specifications Strip -->
                  <div class="mti-specs-strip">
                    <div class="spec-item">
                      <span class="spec-icon">⏱️</span>
                      <span class="spec-value">{test.duration} Minutes</span>
                    </div>
                    <div class="spec-bullet">•</div>
                    <div class="spec-item">
                      <span class="spec-icon">📝</span>
                      <span class="spec-value">{test.questions} MCQs</span>
                    </div>
                    <div class="spec-bullet">•</div>
                    <div class="spec-item">
                      <span class="spec-icon">🎯</span>
                      <span class="spec-value">{test.marks} Marks</span>
                    </div>
                    <div class="spec-bullet">•</div>
                    <div class="spec-item">
                      <span class="spec-icon">🌐</span>
                      <span class="spec-value">{test.language}</span>
                    </div>
                    <div class="spec-bullet">•</div>
                    <div class="spec-item">
                      <span class="spec-icon">⚡</span>
                      <span class="spec-value">Instant Solutions</span>
                    </div>
                  </div>

                  <!-- Chapters / Topics included -->
                  {test.syllabus && test.syllabus.length > 0 && (
                    <div class="mti-syllabus-bar">
                      <span class="syl-label">Topics:</span>
                      <div class="syl-tags">
                        {test.syllabus.map(s => (
                          <span class="syl-pill">{s}</span>
                        ))}
                      </div>
                    </div>
                  )}
                </article>
              );
            })}
          </div>

          <!-- Empty state when filters return nothing -->
          <div class="empty-search-state" id="empty-tests-state" style="display:none;">
            <div class="empty-icon">🔍</div>
            <h3>No mock tests match your filter</h3>
            <p>Try switching category tabs, clearing search query, or checking another difficulty level.</p>
            <button id="reset-test-filters" class="btn-reset-filters">Reset All Filters</button>
          </div>
        </section>

        <!-- ── SECTION 3: REVIEWS & TESTIMONIALS ── -->
        <section class="content-card" id="reviews">
          <div class="card-header">
            <div class="ch-left">
              <span class="ch-icon">⭐</span>
              <div>
                <h2 class="ch-title">Student Reviews & Board Results</h2>
                <p class="ch-subtitle">Authentic feedback from Class 10th matriculation candidates across Odisha</p>
              </div>
            </div>
          </div>

          <!-- Rating summary overview -->
          <div class="rating-overview-card">
            <div class="ro-left">
              <div class="ro-score">{inst.rating}</div>
              <div class="ro-stars">
                {starsStr(Math.round(inst.rating))}
              </div>
              <div class="ro-count">Based on {inst.reviewCount} student ratings</div>
              <div class="ro-verified-tag">✓ 100% Verified Candidates</div>
            </div>

            <div class="ro-right-bars">
              <div class="bar-row">
                <span class="bar-label">5 Stars</span>
                <div class="bar-track"><div class="bar-fill" style="width: 86%;"></div></div>
                <span class="bar-pct">86%</span>
              </div>
              <div class="bar-row">
                <span class="bar-label">4 Stars</span>
                <div class="bar-track"><div class="bar-fill" style="width: 11%;"></div></div>
                <span class="bar-pct">11%</span>
              </div>
              <div class="bar-row">
                <span class="bar-label">3 Stars</span>
                <div class="bar-track"><div class="bar-fill" style="width: 3%;"></div></div>
                <span class="bar-pct">3%</span>
              </div>
              <div class="bar-row">
                <span class="bar-label">2 Stars</span>
                <div class="bar-track"><div class="bar-fill" style="width: 0%;"></div></div>
                <span class="bar-pct">0%</span>
              </div>
              <div class="bar-row">
                <span class="bar-label">1 Star</span>
                <div class="bar-track"><div class="bar-fill" style="width: 0%;"></div></div>
                <span class="bar-pct">0%</span>
              </div>
            </div>
          </div>

          <!-- Reviews Cards Grid -->
          <div class="reviews-grid">
            {inst.reviews.map(rev => (
              <div class="review-item-card">
                <div class="ric-top">
                  <div class="ric-avatar">{rev.name.charAt(0)}</div>
                  <div class="ric-user-meta">
                    <h4 class="ric-name">{rev.name}</h4>
                    <p class="ric-location">{rev.schoolOrCity}</p>
                  </div>
                  <div class="ric-stars">{starsStr(rev.rating)}</div>
                </div>

                {rev.scoreHighlight && (
                  <div class="ric-score-badge">
                    🏆 {rev.scoreHighlight}
                  </div>
                )}

                <p class="ric-text">“{rev.text}”</p>
                <div class="ric-date">Verified Board Student • {rev.date}</div>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: STICKY FACULTY SIDEBAR -->
      <aside class="sidebar-column">

        <!-- 1. Faculty Overview Card -->
        <div class="sidebar-card">
          <h3 class="sc-heading">Educator Profile</h3>

          <ul class="sc-details-list">
            <li>
              <span class="sc-label">Experience</span>
              <span class="sc-value gold-text"><strong>{inst.yearsExp}+ Years</strong></span>
            </li>
            <li>
              <span class="sc-label">Type</span>
              <span class="sc-value">{inst.type}</span>
            </li>
            <li>
              <span class="sc-label">Location</span>
              <span class="sc-value">{inst.city}, Odisha</span>
            </li>
            <li>
              <span class="sc-label">Board</span>
              <span class="sc-value">BSE Odisha 10th</span>
            </li>
            <li>
              <span class="sc-label">Active Tests</span>
              <span class="sc-value"><strong>{inst.testsCount} Tests</strong></span>
            </li>
            <li>
              <span class="sc-label">Students Guided</span>
              <span class="sc-value">{inst.studentsCount.toLocaleString('en-IN')}+</span>
            </li>
            <li>
              <span class="sc-label">Success Rate</span>
              <span class="sc-value green-text"><strong>{inst.passRate}% Pass</strong></span>
            </li>
            <li>
              <span class="sc-label">Average Rating</span>
              <span class="sc-value gold-text">★ {inst.rating} / 5.0</span>
            </li>
          </ul>
        </div>

        <!-- 2. Test Bank Overview Card -->
        <div class="sidebar-card bank-overview-card">
          <h3 class="sc-heading">Test Series Bank</h3>
          <div class="bank-stats-grid">
            <div class="bs-stat">
              <span class="bs-val">{totalQuestionsInBank}+</span>
              <span class="bs-lbl">Total MCQs</span>
            </div>
            <div class="bs-stat">
              <span class="bs-val">{totalFreeTests}</span>
              <span class="bs-lbl">Free Mocks</span>
            </div>
            <div class="bs-stat">
              <span class="bs-val">100%</span>
              <span class="bs-lbl">Board Blueprint</span>
            </div>
          </div>
          <a href="#mock-tests" class="btn-sidebar-cta">
            Attempt Free Mocks Now →
          </a>
        </div>

        <!-- 3. Direct Inquiries & Contact Card -->
        <div class="sidebar-card contact-card">
          <div class="cc-badge">ADMISSIONS & DOUBTS</div>
          <h3 class="cc-title">Need Guidance?</h3>
          <p class="cc-desc">
            Directly connect with {inst.name}'s academic support for batch timings, model test papers, and offline tuition schedules.
          </p>

          <a href={`tel:${inst.contactPhone.replace(/\s+/g, '')}`} class="btn-contact-call">
