<script>
  // Interactive client-side filtering for Mock Tests
  function initMockTestsFilter() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
    const searchInput = document.getElementById('test-search-input') as HTMLInputElement | null;
    const diffSelect = document.getElementById('diff-filter-select') as HTMLSelectElement | null;
    const freeOnlyCheckbox = document.getElementById('free-only-checkbox') as HTMLInputElement | null;
    const testCards = document.querySelectorAll<HTMLElement>('.mock-test-item-card');
    const emptyState = document.getElementById('empty-tests-state');
    const resetBtn = document.getElementById('reset-test-filters');

    if (!testCards.length) return;

    let activeCategory = 'All';
    let searchQuery = '';
    let activeDiff = 'All';
    let freeOnly = false;

    function applyFilters() {
      let visibleCount = 0;

      testCards.forEach(card => {
        const cardCat = card.dataset.category || '';
        const cardDiff = card.dataset.difficulty || '';
        const cardFree = card.dataset.free === 'true';
        const cardTitle = card.dataset.title || '';
        const cardSyllabus = card.dataset.syllabus || '';

        const matchesCat = activeCategory === 'All' || cardCat === activeCategory;
        const matchesDiff = activeDiff === 'All' || cardDiff === activeDiff;
        const matchesFree = !freeOnly || cardFree;
        const matchesSearch = !searchQuery || cardTitle.includes(searchQuery) || cardSyllabus.includes(searchQuery);

        if (matchesCat && matchesDiff && matchesFree && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Category Tabs click
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        activeCategory = tab.dataset.category || 'All';
        applyFilters();
      });
    });

    // Search input
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      applyFilters();
    });

    // Difficulty filter
    diffSelect?.addEventListener('change', (e) => {
      activeDiff = (e.target as HTMLSelectElement).value;
      applyFilters();
    });

    // Free only toggle
    freeOnlyCheckbox?.addEventListener('change', (e) => {
      freeOnly = (e.target as HTMLInputElement).checked;
      applyFilters();
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      activeCategory = 'All';
      searchQuery = '';
      activeDiff = 'All';
      freeOnly = false;

      tabs.forEach(t => {
        t.classList.toggle('active', t.dataset.category === 'All');
        t.setAttribute('aria-selected', t.dataset.category === 'All' ? 'true' : 'false');
      });

      if (searchInput) searchInput.value = '';
      if (diffSelect) diffSelect.value = 'All';
      if (freeOnlyCheckbox) freeOnlyCheckbox.checked = false;

      applyFilters();
    });
  }

  // Initialize on DOM load and Astro page load
  document.addEventListener('DOMContentLoaded', initMockTestsFilter);
  document.addEventListener('astro:page-load', initMockTestsFilter);
</script>

