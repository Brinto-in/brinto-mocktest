---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Tests" section="tests">
    <a
        slot="topbar-actions"
        href="/mocktest/nexusctl/tests/new"
        class="btn btn-primary btn-sm"
    >
        + New Test
    </a>

    <div id="alert-container"></div>

    <!-- Stats -->
    <div class="stats-strip">
        <div class="stat-box">
            <div class="sn" id="stat-total" style="color:var(--brand)">0</div>
            <div class="sl">Total Tests</div>
        </div>
        <div class="stat-box">
            <div class="sn" id="stat-free" style="color:var(--green)">0</div>
            <div class="sl">Free Tests</div>
        </div>
        <div class="stat-box">
            <div class="sn" id="stat-qs" style="color:var(--gold)">0</div>
            <div class="sl">Total Questions</div>
        </div>
        <div class="stat-box">
            <div class="sn" id="stat-attempts" style="color:var(--ink)">0</div>
            <div class="sl">Total Attempts</div>
        </div>
    </div>

    <!-- Tests Table -->
    <div class="card" style="padding:0;overflow:hidden">
        <div
            class="card-header"
            style="padding:18px 20px;border-bottom:1px solid var(--rule);margin:0"
        >
            <div>
                <div class="card-title">All Tests</div>
                <div class="card-sub" id="table-sub">Loading tests from API...</div>
            </div>
        </div>

        <div id="tests-container">
            <div class="empty-state" style="padding: 60px 0;">
                <div class="am-spinner" style="margin: 0 auto 12px; width: 32px; height: 32px; border: 3px solid var(--rule); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                <p>Loading admin mock tests...</p>
            </div>
        </div>
    </div>
</AdminLayout>

<script is:inline>
  async function loadAdminTests() {
    const container = document.getElementById("tests-container");
    const subEl = document.getElementById("table-sub");
    const statTotal = document.getElementById("stat-total");
    const statFree = document.getElementById("stat-free");
    const statQs = document.getElementById("stat-qs");
    const statAttempts = document.getElementById("stat-attempts");

    const token = localStorage.getItem("brinto_token") || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhMmQxMDQwZThkM2U0MTdhNjcwYjhjYSIsInVzZXJfaWQiOiJCNjQzIiwidXNlcl9uYW1lIjoibmxocmJwdHIiLCJyb2xlIjpbIkFETUlOIl0sIm1vYmlsZSI6IjkxNzg0NjkwNDacheIsImlhdCI6MTc5MjUwNDQ1NCwiZXhwIjoxNzkzMTA5MjU0f0.fLKmw6EsvA760i_elckhKWD22RKvA0cmEHr5PRcX760";

    try {
      const res = await fetch("https://brintoapi.brinto.in/api/admin/mocktests?page=1&limit=50", {
        headers: {
          "Accept": "application/json",
          "Authorization": `Bearer ${token}`
        }
      });

      if (!res.ok) throw new Error("API error: " + res.status);
      const json = await res.json();
      const tests = json?.data || json?.tests || (Array.isArray(json) ? json : []);

      // Update stats
      statTotal.textContent = tests.length;
      statFree.textContent = tests.filter(t => t.is_free || t.isFree).length;
      statQs.textContent = tests.reduce((s, t) => s + (Array.isArray(t.questions) ? t.questions.length : (Number(t.questions) || 0)), 0);
      statAttempts.textContent = tests.reduce((s, t) => s + (Number(t.attempts) || 0), 0).toLocaleString("en-IN");
      subEl.textContent = `${tests.length} test${tests.length !== 1 ? 's' : ''} loaded`;

      if (tests.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
              <div class="empty-icon">📋</div>
              <p>No tests yet. Create your first test using the button above.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div style="overflow-x:auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Exam</th>
                        <th>Qs</th>
                        <th>Duration</th>
                        <th>Difficulty</th>
                        <th>Attempts</th>
                        <th>Flags</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    ${tests.map((t, i) => {
                      const qCount = Array.isArray(t.questions) ? t.questions.length : (t.questions || 0);
                      const isFree = t.is_free || t.isFree;
                      const isNew = t.is_new || t.isNew;
                      const diff = t.difficulty || 'Medium';

                      return `
                        <tr>
                            <td style="color:var(--ink-muted);font-weight:600">${i + 1}</td>
                            <td>
                                <div style="font-weight:600;color:var(--ink);margin-bottom:2px">${t.title || t.name}</div>
                                <div style="font-size:0.74rem;color:var(--ink-muted);font-family:monospace">${t.slug || t.id}</div>
                            </td>
                            <td><span class="badge badge-exam">${t.exam || 'General'}</span></td>
                            <td style="font-weight:700;text-align:center">${qCount}</td>
                            <td style="color:var(--ink-soft)">${t.duration || 30}m</td>
                            <td><span class="badge badge-${diff.toLowerCase()}">${diff}</span></td>
                            <td style="text-align:center">${Number(t.attempts || 0).toLocaleString("en-IN")}</td>
                            <td>
                                <div style="display:flex;gap:4px;flex-wrap:wrap">
                                    ${isFree ? '<span class="badge badge-free">Free</span>' : ''}
                                    ${isNew ? '<span class="badge badge-new">New</span>' : ''}
                                </div>
                            </td>
                            <td>
                                <div style="display:flex;gap:6px;align-items:center">
                                    <a href="/mocktest/nexusctl/tests/${t.id}" class="btn btn-secondary btn-sm">+ Questions</a>
                                    <a href="/mocktest/test/${t.slug || t.id}" target="_blank" class="btn btn-ghost btn-sm" title="Preview">↗</a>
                                </div>
                            </td>
                        </tr>
                      `;
                    }).join('')}
                </tbody>
            </table>
        </div>
      `;
    } catch (err) {
      console.error("Error loading admin tests:", err);
      container.innerHTML = `<div class="empty-state" style="padding: 40px; color: var(--brand);">Failed to load admin mock tests. Please check your token or connection.</div>`;
      subEl.textContent = "Error loading data";
    }
  }

  loadAdminTests();
</script>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
