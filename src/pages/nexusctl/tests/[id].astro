---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";

const { id } = Astro.params;
const testId = id || "11";
---

<AdminLayout title="Manage Questions" section="tests">
    <div slot="topbar-actions" style="display:flex;gap:8px">
        <button type="button" class="btn btn-primary btn-sm" id="open-add-sheet-btn">+ Add Question</button>
        <a href="/mocktest/nexusctl" class="btn btn-secondary btn-sm">← All Tests</a>
    </div>

    <div id="alert-container"></div>

    <!-- Test meta card -->
    <div class="card" id="test-meta-card" style="margin-bottom:24px; display:none;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <span class="badge badge-exam" id="meta-exam">Exam</span>
                    <span class="badge badge-medium" id="meta-diff">Medium</span>
                </div>
                <h2 style="font-size:1.15rem;color:var(--ink);margin-bottom:4px" id="meta-title">Loading Test...</h2>
                <div style="font-size:0.8rem;color:var(--ink-muted);font-family:monospace" id="meta-slug">/test/slug</div>
            </div>
            <div style="display:flex;gap:20px;text-align:center">
                <div>
                    <div style="font-size:1.5rem;font-weight:800;color:var(--brand)" id="stat-q-len">0</div>
                    <div style="font-size:0.7rem;color:var(--ink-muted);text-transform:uppercase;letter-spacing:0.04em">Questions</div>
                </div>
                <div>
                    <div style="font-size:1.5rem;font-weight:800;color:var(--ink)" id="stat-duration">30m</div>
                    <div style="font-size:0.7rem;color:var(--ink-muted);text-transform:uppercase;letter-spacing:0.04em">Duration</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions list (Full width) -->
    <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <h3 style="font-size:0.9rem;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;color:var(--ink-muted)" id="q-header-title">
                Questions (0)
            </h3>
        </div>

        <div id="questions-container">
            <div class="card" style="padding: 40px; text-align: center;">
                <div class="am-spinner" style="margin: 0 auto 12px; width: 32px; height: 32px; border: 3px solid var(--rule); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                <p style="color: var(--ink-soft);">Loading questions from API...</p>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div id="pagination-controls" style="display:flex;align-items:center;justify-content:space-between;margin-top:20px;padding:12px 16px;background:var(--surface);border:1px solid var(--rule);border-radius:var(--r-sm);display:none;">
            <button id="prev-page-btn" class="btn btn-secondary btn-sm" disabled>← Previous</button>
            <span id="page-info" style="font-size:0.85rem;color:var(--ink-soft);font-weight:600;">Page 1</span>
            <button id="next-page-btn" class="btn btn-secondary btn-sm" disabled>Next →</button>
        </div>
    </div>

    <!-- Right Sheet Drawer Backdrop -->
    <div class="q-sheet-backdrop" id="q-sheet-backdrop" aria-hidden="true"></div>

    <!-- Right Sheet Drawer Panel (Add Question Form) -->
    <div class="q-sheet-panel" id="q-sheet-panel" aria-hidden="true">
        <div class="q-sheet-header">
            <div>
                <div class="q-sheet-title">Add Questions</div>
                <div style="font-size: 0.8rem; color: var(--ink-muted); margin-top: 2px;">Add single or multiple questions</div>
            </div>
            <button type="button" class="q-sheet-close" id="q-sheet-close" aria-label="Close drawer">&times;</button>
        </div>
        <div class="q-sheet-body">
            <!-- Mode Switcher Tabs -->
            <div style="display:flex;gap:8px;margin-bottom:4px;background:var(--surface-2);padding:4px;border-radius:var(--r-sm);">
                <button type="button" class="btn btn-secondary btn-sm" id="tab-single-btn" style="flex:1;background:var(--surface);font-weight:700;">Single Question</button>
                <button type="button" class="btn btn-ghost btn-sm" id="tab-bulk-btn" style="flex:1;">Bulk JSON (Multi)</button>
            </div>

            <!-- Single Form -->
            <form id="add-q-form">
                <div class="form-grid" style="gap:14px">
                    <div class="form-group">
                        <label class="form-label" for="section">Section <span class="required">*</span></label>
                        <select id="section" name="section" required>
                            <option value="">Select section…</option>
                            <option value="General Knowledge">General Knowledge</option>
                            <option value="Reasoning">Reasoning</option>
                            <option value="Mathematics">Mathematics</option>
                            <option value="English">English</option>
                            <option value="Current Affairs">Current Affairs</option>
                            <option value="Odisha GK">Odisha GK</option>
                            <option value="Science">Science</option>
                            <option value="Computer">Computer</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="q-text">Question <span class="required">*</span></label>
                        <textarea id="q-text" name="text" rows={3} required placeholder="Enter the question text…"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Options <span class="required">*</span> — mark the correct one</label>
                        <div style="display:flex;flex-direction:column;gap:8px;margin-top:4px">
                            {[0, 1, 2, 3].map((i) => {
                                const KEYS = ["A", "B", "C", "D"];
                                return (
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <input type="radio" name="correct" value={i} required title="Mark as correct" />
                                        <input type="text" name={`option_${i}`} required placeholder={`Option ${KEYS[i]}`} style="flex:1" />
                                    </div>
                                );
                            })}
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="explanation">Explanation (optional)</label>
                        <textarea id="explanation" name="explanation" rows={2} placeholder="Explanation for correct answer…"></textarea>
                    </div>

                    <!-- Question Metadata (Optional) -->
                    <div class="metadata-fieldset">
                        <div class="metadata-fieldset-header">
                            <span class="metadata-fieldset-title">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                Question Metadata
                            </span>
                            <span class="metadata-fieldset-sub">Subject, exam, conductor info</span>
                        </div>
                        <div class="form-grid form-grid-2" style="gap:10px;">
                            <div class="form-group">
                                <label class="form-label" for="meta-subject" style="font-size:0.72rem;">Subject</label>
                                <input type="text" id="meta-subject" name="meta_subject" placeholder="e.g. Mathematics" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="meta-chapter" style="font-size:0.72rem;">Chapter</label>
                                <input type="text" id="meta-chapter" name="meta_chapter" placeholder="e.g. Percentages" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="meta-conductor" style="font-size:0.72rem;">Conductor</label>
                                <input type="text" id="meta-conductor" name="meta_conductor" placeholder="e.g. TCS" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="meta-exam-for" style="font-size:0.72rem;">Exam For</label>
                                <input type="text" id="meta-exam-for" name="meta_exam_for" placeholder="e.g. OSSSC Forester CRE" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="meta-exam-year" style="font-size:0.72rem;">Exam Year</label>
                                <input type="text" id="meta-exam-year" name="meta_exam_year" placeholder="e.g. 2025-26" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="meta-shift" style="font-size:0.72rem;">Shift</label>
                                <input type="number" id="meta-shift" name="meta_shift" placeholder="e.g. 1" min="1" max="10" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top: 8px;">
                        Save Question
                    </button>
                </div>
            </form>

            <!-- Bulk JSON Form -->
            <form id="add-bulk-form" style="display:none;">
                <div class="form-grid" style="gap:14px">
                    <div class="form-group">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                            <label class="form-label" for="bulk-json" style="margin-bottom:0">Questions JSON Array <span class="required">*</span></label>
                            <div style="display:flex;gap:6px">
                                <button type="button" class="btn btn-ghost btn-sm" id="copy-sample-btn" style="padding:3px 9px;font-size:0.75rem;">
                                    <span id="copy-sample-text">📋 Copy Template</span>
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" id="load-sample-btn" style="padding:3px 9px;font-size:0.75rem;">
                                    ⚡ Fill Template
                                </button>
                            </div>
                        </div>
                        <textarea id="bulk-json" name="json" rows={13} required placeholder="Paste questions JSON array here..." style="font-family:monospace;font-size:0.84rem;"></textarea>
                        <span class="form-hint" style="margin-top:4px;display:block;">Paste a valid JSON array matching the API format including optional <code>metadata</code>.</span>
                    </div>

                    <!-- Sample preview card with Copy button -->
                    <div style="background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--r-sm);padding:12px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                            <span style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.04em;color:var(--ink-soft);">
                                💡 Sample JSON Format
                            </span>
                            <button type="button" class="btn btn-ghost btn-sm" id="copy-preview-btn" style="padding:2px 8px;font-size:0.72rem;">
                                <span id="copy-preview-text">📋 Copy</span>
                            </button>
                        </div>
                        <pre id="sample-json-preview" style="margin:0;font-size:0.75rem;background:#fff;border:1px solid var(--rule);border-radius:6px;padding:10px;overflow-x:auto;max-height:180px;font-family:monospace;color:var(--ink);line-height:1.45;"></pre>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top: 4px;">
                        Upload Multiple Questions
                    </button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<script is:inline define:vars={{ testId }}>
  let currentPage = 1;
  const limit = 20;

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function loadTestAndQuestions() {
    const token = localStorage.getItem("brinto_token") || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhMmQxMDQwZThkM2U0MTdhNjcwYjhjYSIsInVzZXJfaWQiOiJCNjQzIiwidXNlcl9uYW1lIjoibmxocmJwdHIiLCJyb2xlIjpbIkFETUlNIl0sIm1vYmlsZSI6IjkxNzg0NjkwNDacheIsImlhdCI6MTc5MjUwNDQ1NCwiZXhwIjoxNzkzMTA5MjU0f0.fLKmw6EsvA760i_elckhKWD22RKvA0cmEHr5PRcX760";
    const qContainer = document.getElementById("questions-container");
    const metaCard = document.getElementById("test-meta-card");
    const qHeaderTitle = document.getElementById("q-header-title");
    const prevBtn = document.getElementById("prev-page-btn");
    const nextBtn = document.getElementById("next-page-btn");
    const pageInfo = document.getElementById("page-info");
    const paginationWrap = document.getElementById("pagination-controls");

    try {
      const res = await fetch(`https://brintoapi.brinto.in/api/admin/mocktests/${testId}/questions?page=${currentPage}&limit=${limit}`, {
        headers: {
          "Accept": "application/json",
          "Authorization": `Bearer ${token}`
        }
      });

      if (!res.ok) {
        const errorText = await res.text();
        throw new Error(`API error ${res.status}: ${errorText}`);
      }
      const json = await res.json();

      let questions = [];
      if (Array.isArray(json)) {
        questions = json;
      } else if (Array.isArray(json?.questions)) {
        questions = json.questions;
      } else if (Array.isArray(json?.data)) {
        questions = json.data;
      } else if (Array.isArray(json?.data?.questions)) {
        questions = json.data.questions;
      } else if (json?.data && Array.isArray(json.data.data)) {
        questions = json.data.data;
      } else {
        const foundArrayKey = Object.keys(json || {}).find(k => Array.isArray(json[k]));
        if (foundArrayKey) {
          questions = json[foundArrayKey];
        } else if (json?.data && typeof json.data === 'object') {
          const foundInData = Object.keys(json.data || {}).find(k => Array.isArray(json.data[k]));
          if (foundInData) {
            questions = json.data[foundInData];
          }
        }
      }

      if (!Array.isArray(questions)) {
        questions = [];
      }

      const testInfo = json?.test || json?.data?.test || json;

      metaCard.style.display = "block";
      document.getElementById("meta-title").textContent = testInfo?.title || testInfo?.name || `Test #${testId}`;
      document.getElementById("meta-exam").textContent = testInfo?.exam || testInfo?.category || "General";
      document.getElementById("meta-slug").textContent = `/test/${testInfo?.slug || testId}`;
      document.getElementById("stat-q-len").textContent = questions.length;
      document.getElementById("stat-duration").textContent = (testInfo?.duration || 30) + "m";
      qHeaderTitle.textContent = `Questions (Page ${currentPage})`;

      if (paginationWrap) {
        paginationWrap.style.display = "flex";
        pageInfo.textContent = `Page ${currentPage}`;
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = questions.length < limit;
      }

      if (questions.length === 0) {
        qContainer.innerHTML = `
          <div class="card">
              <div class="empty-state">
                  <div class="empty-icon">💬</div>
                  <p>No questions found on this page.</p>
              </div>
          </div>
        `;
        return;
      }

      const OPTION_KEYS = ["A", "B", "C", "D"];
      qContainer.innerHTML = questions.map((q, idx) => {
        const options = Array.isArray(q.options) ? q.options : [];
        const qNum = (currentPage - 1) * limit + (idx + 1);

        let meta = null;
        if (q.metadata) {
          if (typeof q.metadata === 'object') {
            meta = q.metadata;
          } else if (typeof q.metadata === 'string') {
            try {
              meta = JSON.parse(q.metadata);
            } catch (e) {
              meta = null;
            }
          }
        }

        const hasMetadata = meta && typeof meta === 'object' && Object.keys(meta).length > 0;

        let metaBoxHtml = '';
        if (hasMetadata) {
          metaBoxHtml = `
            <div class="q-meta-card">
              <div class="q-meta-card-header">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                <span>Question Metadata</span>
              </div>
              <div class="q-meta-chips">
                ${meta.subject ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Subject</span>
                    <span class="q-meta-chip-val">${escapeHtml(meta.subject)}</span>
                  </div>
                ` : ''}
                ${meta.chapter ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Chapter</span>
                    <span class="q-meta-chip-val">${escapeHtml(meta.chapter)}</span>
                  </div>
                ` : ''}
                ${meta.exam_for ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Exam For</span>
                    <span class="q-meta-chip-val">${escapeHtml(meta.exam_for)}</span>
                  </div>
                ` : ''}
                ${meta.conductor ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Conductor</span>
                    <span class="q-meta-chip-val">${escapeHtml(meta.conductor)}</span>
                  </div>
                ` : ''}
                ${meta.exam_year ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Year</span>
                    <span class="q-meta-chip-val">${escapeHtml(meta.exam_year)}</span>
                  </div>
                ` : ''}
                ${meta.shift !== undefined && meta.shift !== null && meta.shift !== '' ? `
                  <div class="q-meta-chip">
                    <span class="q-meta-chip-label">Shift</span>
                    <span class="q-meta-chip-val">Shift ${escapeHtml(meta.shift)}</span>
                  </div>
                ` : ''}
                ${Object.entries(meta)
                  .filter(([k]) => !['subject', 'chapter', 'exam_for', 'conductor', 'exam_year', 'shift'].includes(k))
                  .map(([k, v]) => `
                    <div class="q-meta-chip">
                      <span class="q-meta-chip-label">${escapeHtml(k.replace(/_/g, ' '))}</span>
                      <span class="q-meta-chip-val">${escapeHtml(typeof v === 'object' ? JSON.stringify(v) : v)}</span>
                    </div>
                  `).join('')}
              </div>
            </div>
          `;
        }

        return `
          <div class="q-card">
              <div class="q-card-header">
                  <div class="q-num">${qNum}</div>
                  <div class="q-card-text">${escapeHtml(q.text || q.question)}</div>
                  <div class="q-card-tags">
                      <span class="q-section-tag">${escapeHtml(q.section || 'General')}</span>
                      ${meta?.subject ? `<span class="q-tag-badge q-tag-subject" title="Subject: ${escapeHtml(meta.subject)}">${escapeHtml(meta.subject)}</span>` : ''}
                      ${meta?.exam_for ? `<span class="q-tag-badge q-tag-exam" title="Exam: ${escapeHtml(meta.exam_for)}">${escapeHtml(meta.exam_for)}</span>` : ''}
                      ${meta?.exam_year ? `<span class="q-tag-badge q-tag-year" title="Year: ${escapeHtml(meta.exam_year)}">${escapeHtml(meta.exam_year)}</span>` : ''}
                      ${meta?.shift !== undefined && meta?.shift !== null && meta?.shift !== '' ? `<span class="q-tag-badge q-tag-shift" title="Shift: ${escapeHtml(meta.shift)}">Shift ${escapeHtml(meta.shift)}</span>` : ''}
                  </div>
                  <svg class="q-chevron" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="q-card-body">
                  ${metaBoxHtml}
                  <div class="q-options">
                      ${options.map((opt, oi) => {
                          const optText = typeof opt === 'object' && opt !== null ? (opt.text || opt.option) : opt;
                          const isCorrect = typeof opt === 'object' && opt !== null ? (opt.is_correct || opt.isCorrect) : false;
                          return `
                              <div class="q-opt${isCorrect ? ' correct' : ''}">
                                  <span class="q-opt-key">${OPTION_KEYS[oi] || (oi + 1)}.</span>
                                  <span style="flex:1">${escapeHtml(optText)}</span>
                                  ${isCorrect ? '<span style="margin-left:auto;font-size:0.72rem;font-weight:700">✓ Correct</span>' : ''}
                              </div>
                          `;
                      }).join('')}
                  </div>
                  ${q.explanation ? `<div class="q-explanation"><strong>Explanation:</strong> ${escapeHtml(q.explanation)}</div>` : ''}
              </div>
          </div>
        `;
      }).join('');
    } catch (err) {
      console.error("Failed to load questions:", err);
      qContainer.innerHTML = `<div class="card" style="padding: 40px; text-align: center; color: var(--brand);">Failed to load questions from API: ${err.message}</div>`;
      if (paginationWrap) paginationWrap.style.display = "none";
    }
  }

  // Right sheet drawer interactions
  function openAddSheet() {
      document.getElementById("q-sheet-panel")?.classList.add("open");
      document.getElementById("q-sheet-backdrop")?.classList.add("open");
      document.body.style.overflow = "hidden";
  }

  function closeAddSheet() {
      document.getElementById("q-sheet-panel")?.classList.remove("open");
      document.getElementById("q-sheet-backdrop")?.classList.remove("open");
      document.body.style.overflow = "";
  }

  document.getElementById("open-add-sheet-btn")?.addEventListener("click", openAddSheet);
  document.getElementById("q-sheet-close")?.addEventListener("click", closeAddSheet);
  document.getElementById("q-sheet-backdrop")?.addEventListener("click", closeAddSheet);

  // Tabs for Single vs Bulk JSON
  const tabSingleBtn = document.getElementById("tab-single-btn");
  const tabBulkBtn = document.getElementById("tab-bulk-btn");
  const formSingle = document.getElementById("add-q-form");
  const formBulk = document.getElementById("add-bulk-form");

  tabSingleBtn?.addEventListener("click", () => {
    formSingle.style.display = "block";
    formBulk.style.display = "none";
    tabSingleBtn.style.background = "var(--surface)";
    tabSingleBtn.style.fontWeight = "700";
    tabBulkBtn.style.background = "transparent";
    tabBulkBtn.style.fontWeight = "500";
  });

  tabBulkBtn?.addEventListener("click", () => {
    formSingle.style.display = "none";
    formBulk.style.display = "block";
    tabBulkBtn.style.background = "var(--surface)";
    tabBulkBtn.style.fontWeight = "700";
    tabSingleBtn.style.background = "transparent";
    tabSingleBtn.style.fontWeight = "500";
  });

  document.getElementById("prev-page-btn")?.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      loadTestAndQuestions();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  document.getElementById("next-page-btn")?.addEventListener("click", () => {
    currentPage++;
    loadTestAndQuestions();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Single Question submit
  document.getElementById("add-q-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const alertContainer = document.getElementById("alert-container");
    const token = localStorage.getItem("brinto_token") || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhMmQxMDQwZThkM2U0MTdhNjcwYjhjYSIsInVzZXJfaWQiOiJCNjQzIiwidXNlcl9uYW1lIjoibmxocmJwdHIiLCJyb2xlIjpbIkFETUlNIl0sIm1vYmlsZSI6IjkxNzg0NjkwNDacheIsImlhdCI6MTc5MjUwNDQ1NCwiZXhwIjoxNzkzMTA5MjU0f0.fLKmw6EsvA760i_elckhKWD22RKvA0cmEHr5PRcX760";

    const formData = new FormData(e.target);
    const section = formData.get("section");
    const text = formData.get("text");
    const explanation = formData.get("explanation")?.trim() || undefined;
    const correctIndex = parseInt(formData.get("correct"), 10);

    const options = [0, 1, 2, 3].map(i => ({
      text: formData.get(`option_${i}`),
      is_correct: i === correctIndex
    }));

    const metaSubject = formData.get("meta_subject")?.trim();
    const metaChapter = formData.get("meta_chapter")?.trim();
    const metaConductor = formData.get("meta_conductor")?.trim();
    const metaExamFor = formData.get("meta_exam_for")?.trim();
    const metaExamYear = formData.get("meta_exam_year")?.trim();
    const metaShift = formData.get("meta_shift")?.trim();

    const metadata = {};
    if (metaSubject) metadata.subject = metaSubject;
    if (metaChapter) metadata.chapter = metaChapter;
    if (metaConductor) metadata.conductor = metaConductor;
    if (metaExamFor) metadata.exam_for = metaExamFor;
    if (metaExamYear) metadata.exam_year = metaExamYear;
    if (metaShift !== undefined && metaShift !== null && metaShift !== '') {
      metadata.shift = isNaN(Number(metaShift)) ? metaShift : Number(metaShift);
    }

    const questionObj = {
      section,
      text,
      explanation,
      options
    };

    if (Object.keys(metadata).length > 0) {
      questionObj.metadata = metadata;
    }

    try {
      const res = await fetch(`https://brintoapi.brinto.in/api/admin/mocktests/${testId}/questions`, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": `Bearer ${token}`
        },
        body: JSON.stringify({ questions: [questionObj] })
      });

      if (!res.ok) {
        const errText = await res.text();
        throw new Error(`Failed to add question (${res.status}): ${errText}`);
      }

      alertContainer.innerHTML = `<div class="alert alert-success">✓ Question added successfully!</div>`;
      e.target.reset();
      closeAddSheet();
      loadTestAndQuestions();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      console.error("Error adding question:", err);
      alertContainer.innerHTML = `<div class="alert alert-error">✗ ${err.message}</div>`;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Bulk JSON submit
  document.getElementById("add-bulk-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const alertContainer = document.getElementById("alert-container");
    const token = localStorage.getItem("brinto_token") || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhMmQxMDQwZThkM2U0MTdhNjcwYjhjYSIsInVzZXJfaWQiOiJCNjQzIiwidXNlcl9uYW1lIjoibmxocmJwdHIiLCJyb2xlIjpbIkFETUlNIl0sIm1vYmlsZSI6IjkxNzg0NjkwNDacheIsImlhdCI6MTc5MjUwNDQ1NCwiZXhwIjoxNzkzMTA5MjU0f0.fLKmw6EsvA760i_elckhKWD22RKvA0cmEHr5PRcX760";

    const jsonText = document.getElementById("bulk-json").value;
    let questionsArray;
    try {
      questionsArray = JSON.parse(jsonText);
      if (!Array.isArray(questionsArray)) {
        throw new Error("JSON must be a valid array of questions.");
      }
    } catch (parseErr) {
      alertContainer.innerHTML = `<div class="alert alert-error">✗ Invalid JSON format: ${parseErr.message}</div>`;
      return;
    }

    try {
      const res = await fetch(`https://brintoapi.brinto.in/api/admin/mocktests/${testId}/questions`, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
          "Authorization": `Bearer ${token}`
        },
        body: JSON.stringify({ questions: questionsArray })
      });

      if (!res.ok) {
        const errText = await res.text();
        throw new Error(`Failed to add bulk questions (${res.status}): ${errText}`);
      }

      alertContainer.innerHTML = `<div class="alert alert-success">✓ Multiple questions added successfully!</div>`;
      e.target.reset();
      closeAddSheet();
      loadTestAndQuestions();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      console.error("Error adding bulk questions:", err);
      alertContainer.innerHTML = `<div class="alert alert-error">✗ ${err.message}</div>`;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Sample Bulk JSON template helper
  const SAMPLE_BULK_JSON = JSON.stringify([
    {
      "section": "General Knowledge",
      "text": "What is the capital of India?",
      "explanation": "New Delhi is the capital of India.",
      "metadata": {
        "subject": "Mathematics",
        "chapter": "Percentages",
        "conductor": "TCS",
        "exam_for": "OSSSC Forester CRE",
        "exam_year": "2025-26",
        "shift": 1
      },
      "options": [
        { "text": "New Delhi", "is_correct": true },
        { "text": "Mumbai", "is_correct": false },
        { "text": "Kolkata", "is_correct": false },
        { "text": "Chennai", "is_correct": false }
      ]
    }
  ], null, 2);

  const samplePreviewEl = document.getElementById("sample-json-preview");
  if (samplePreviewEl) {
    samplePreviewEl.textContent = SAMPLE_BULK_JSON;
  }

  function copyTextToClipboard(text, targetSpanId) {
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(() => {
        const target = document.getElementById(targetSpanId);
        if (target) {
          const orig = target.textContent;
          target.textContent = "✓ Copied!";
          setTimeout(() => { target.textContent = orig; }, 2000);
        }
      }).catch(err => {
        fallbackCopyText(text, targetSpanId);
      });
    } else {
      fallbackCopyText(text, targetSpanId);
    }
  }

  function fallbackCopyText(text, targetSpanId) {
    const tempInput = document.createElement("textarea");
    tempInput.value = text;
    tempInput.style.position = "fixed";
    tempInput.style.left = "-9999px";
    document.body.appendChild(tempInput);
    tempInput.focus();
    tempInput.select();
    try {
      document.execCommand("copy");
      const target = document.getElementById(targetSpanId);
      if (target) {
        const orig = target.textContent;
        target.textContent = "✓ Copied!";
        setTimeout(() => { target.textContent = orig; }, 2000);
      }
    } catch (err) {
      console.error("Fallback copy failed:", err);
    }
    document.body.removeChild(tempInput);
  }

  document.getElementById("copy-sample-btn")?.addEventListener("click", () => {
    copyTextToClipboard(SAMPLE_BULK_JSON, "copy-sample-text");
  });

  document.getElementById("copy-preview-btn")?.addEventListener("click", () => {
    copyTextToClipboard(SAMPLE_BULK_JSON, "copy-preview-text");
  });

  document.getElementById("load-sample-btn")?.addEventListener("click", () => {
    const textarea = document.getElementById("bulk-json");
    if (textarea) {
      textarea.value = SAMPLE_BULK_JSON;
      textarea.focus();
    }
  });

  loadTestAndQuestions();
</script>

