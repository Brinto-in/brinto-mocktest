---
// src/components/TestResultsView.astro
---
<div id="results-view">
  <div class="results-hero">
    <p id="res-test-name" style="font-size:0.9rem;margin-bottom:8px;"></p>
    <h1>Test Submitted!</h1>
    <p>Here's how you performed.</p>
    <div class="score-ring-wrap">
      <svg viewBox="0 0 140 140" width="140" height="140">
        <circle
          cx="70"
          cy="70"
          r="60"
          fill="none"
          stroke="rgba(255,255,255,0.1)"
          stroke-width="12"></circle>
        <circle
          id="score-ring-circle"
          cx="70"
          cy="70"
          r="60"
          fill="none"
          stroke="#B00020"
          stroke-width="12"
          stroke-dasharray="376.99"
          stroke-dashoffset="376.99"
          stroke-linecap="round"
          transform="rotate(-90 70 70)"></circle>
      </svg>
      <span class="score-pct" id="score-pct-text">0%</span>
    </div>
    <div class="result-cards">
      <div class="rc rc-correct">
        <div class="rc-n" id="rc-correct">0</div><div class="rc-l">
          Correct
        </div>
      </div>
      <div class="rc rc-wrong">
        <div class="rc-n" id="rc-wrong">0</div>
        <div class="rc-l">Wrong</div>
      </div>
      <div class="rc rc-skipped">
        <div class="rc-n" id="rc-skipped">0</div><div class="rc-l">
          Skipped
        </div>
      </div>
      <div class="rc rc-marked">
        <div class="rc-n" id="rc-marked">0</div>
        <div class="rc-l">Marked</div>
      </div>
    </div>
  </div>
  <div class="results-body">
    <div class="res-section-title">Section-wise Analysis</div>
    <table class="section-table" id="section-table">
      <thead>
        <tr>
          <th>Section</th><th>Total</th>
          <th>Correct</th><th>Wrong</th><th>Score</th>
        </tr>
      </thead>
      <tbody id="section-table-body"></tbody>
    </table>
    <div class="res-section-title">Review Answers</div>
    <div class="review-list" id="review-list"></div>
    <div style="text-align:center;padding-bottom:48px;">
      <a
        href="/mocktest/tests"
        style="display:inline-block;background:var(--brand);color:#fff;font-weight:700;padding:14px 32px;border-radius:999px;font-size:1rem;"
        >← Back to All Tests</a
      >
    </div>
  </div>
</div>

<style is:global>
  #results-view {
    display: none;
    flex: 1;
    overflow-y: auto;
  }
  #results-view.show {
    display: block;
  }
  .results-hero {
    background: var(--ink);
    color: #fff;
    padding: 48px 32px;
    text-align: center;
  }
  .results-hero h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #fff;
    margin-bottom: 6px;
  }
  .results-hero p {
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 32px;
  }
  .score-ring-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 140px;
    height: 140px;
    margin-bottom: 24px;
  }
  .score-ring-wrap svg {
    position: absolute;
    inset: 0;
  }
  .score-pct {
    font-size: 2rem;
    font-weight: 700;
    font-family: var(--font-display);
  }
  .result-cards {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .rc {
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    text-align: center;
    min-width: 100px;
  }
  .rc-n {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .rc-l {
    font-size: 0.72rem;
    opacity: 0.6;
    margin-top: 2px;
  }
  .rc-correct .rc-n {
    color: #6ee7b7;
  }
  .rc-wrong .rc-n {
    color: #fca5a5;
  }
  .rc-skipped .rc-n {
    color: #fcd34d;
  }
  .rc-marked .rc-n {
    color: #c4b5fd;
  }

  .results-body {
    padding: 36px 32px;
    max-width: 840px;
    margin: 0 auto;
  }
  .res-section-title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-bottom: 14px;
  }
  .section-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 32px;
    font-size: 0.88rem;
  }
  .section-table th {
    background: var(--surface-2);
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
  }
  .section-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .section-table tr:last-child td {
    border-bottom: none;
  }
  .td-correct {
    color: var(--green);
    font-weight: 700;
  }
  .td-wrong {
    color: var(--brand);
    font-weight: 700;
  }

  /* Review answers */
  .review-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
  }
  .review-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .review-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 1px solid transparent;
  }
  .review-header:hover {
    background: var(--surface-2);
  }
  .rh-open .review-header {
    border-bottom-color: var(--rule);
  }
  .review-status {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: #fff;
    font-weight: 700;
  }
  .rs-correct {
    background: var(--green);
  }
  .rs-wrong {
    background: var(--brand);
  }
  .rs-skipped {
    background: var(--ink-muted);
  }
  .rh-qnum {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-muted);
  }
  .rh-text {
    font-size: 0.9rem;
    color: var(--ink);
    font-weight: 500;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rh-chevron {
    color: var(--ink-muted);
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .rh-open .rh-chevron {
    transform: rotate(180deg);
  }
  .review-body {
    display: none;
    padding: 16px;
  }
  .rh-open .review-body {
    display: block;
  }
  .review-q-text {
    font-size: 0.96rem;
    color: var(--ink);
    margin-bottom: 12px;
    line-height: 1.6;
  }
  .review-options {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 12px;
  }
  .rev-opt {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    border: 1px solid var(--rule);
    background: var(--surface-2);
    color: var(--ink-soft);
  }
  .rev-opt.rev-correct {
    background: var(--green-light);
    border-color: var(--green);
    color: var(--green);
  }
  .rev-opt.rev-wrong {
    background: var(--brand-light);
    border-color: var(--brand);
    color: var(--brand);
  }
  .rev-key {
    font-weight: 700;
    flex-shrink: 0;
  }
  .review-expl {
    background: var(--gold-light);
    border: 1px solid var(--gold);
    border-radius: var(--radius-sm);
    padding: 12px;
    font-size: 0.86rem;
    color: var(--ink);
    line-height: 1.6;
  }
</style>
