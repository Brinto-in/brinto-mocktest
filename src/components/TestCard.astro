---
import type { Test } from '../lib/types';

interface Props {
  test: Test;
}

const { test } = Astro.props;

const diffColor: Record<string, string> = {
  Easy: 'var(--green)',
  Medium: 'var(--gold)',
  Hard: 'var(--brand)',
};
const diffBg: Record<string, string> = {
  Easy: 'var(--green-light)',
  Medium: 'var(--gold-light)',
  Hard: 'var(--brand-light)',
};
---

<a href={test.href} class="test-card">
  <div class="tc-top">
    <span class="tc-exam-tag">{test.exam}</span>
    <div class="tc-badges">
      {test.isNew && <span class="badge-new">New</span>}
      {test.isFree && <span class="badge-free">Free</span>}
    </div>
  </div>
  <h3 class="tc-title">{test.title}</h3>
  <div class="tc-meta">
    <span>
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      {test.questions} Qs
    </span>
    <span>
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      {test.duration} min
    </span>
    <span class="tc-diff" style={`color:${diffColor[test.difficulty]};background:${diffBg[test.difficulty]}`}>
      {test.difficulty}
    </span>
  </div>
  <div class="tc-footer">
    <span class="tc-attempts">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      {test.attempts.toLocaleString('en-IN')}
    </span>
    <span class="tc-rating">★ {test.rating}</span>
    <span class="tc-cta">Attempt →</span>
  </div>
</a>

<style>
  .test-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .test-card:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(176,0,32,0.08);
  }
  .tc-top { display: flex; justify-content: space-between; align-items: center; }
  .tc-exam-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand);
    background: var(--brand-light);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }
  .tc-badges { display: flex; gap: 6px; }
  .badge-new {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .badge-free {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--gold);
    background: var(--gold-light);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .tc-title {
    font-size: 0.98rem;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .tc-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .tc-meta span { display: flex; align-items: center; gap: 4px; }
  .tc-diff {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.76rem !important;
  }
  .tc-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  .tc-attempts { display: flex; align-items: center; gap: 4px; }
  .tc-rating { color: var(--gold); font-weight: 600; margin-right: auto; }
  .tc-cta {
    font-weight: 700;
    color: var(--brand);
    font-size: 0.84rem;
    margin-left: auto;
    transition: gap 0.15s;
  }
</style>