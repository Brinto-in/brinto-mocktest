---
import type { Test } from "../lib/types";
import TestResultsView from "./TestResultsView.astro";
import TypingResultsView from "./TypingResultsView.astro";
import InstructionModal from "./osssc/osssc_combo/InstructionModal.astro";
import ExamHeader from "./osssc/osssc_combo/ExamHeader.astro";
import McqPanel from "./osssc/osssc_combo/McqPanel.astro";
import TypingStagePanel from "./osssc/osssc_combo/TypingStagePanel.astro";
import ConfirmationModal from "./osssc/osssc_combo/ConfirmationModal.astro";

interface Props {
  slug?: string;
  test?: Test;
  questionsData?: any[];
}

const { slug = "11", test } = Astro.props;

// Passages are NOT fetched here anymore. They are fetched in the browser:
//   Passage 1 -> right after the MCQ is submitted
//   Passage 2 -> right after Passage 1 is submitted (with exclude_ids=<passage 1 id>)
const passageTestName = "Odisha RI Typing Test";
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-KLNSK7T02S';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title id="page-title">{test?.title ? `${test.title} | Brinto MockTest` : "OSSSC MCQ + Typing Combo Test | Brinto MockTest"}</title>
    <meta name="robots" content="noindex" />

    <!-- Google Analytics (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '${gaId}');
    `} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --brand: #b00020;
        --brand-dark: #7b0015;
        --brand-light: #fff0f2;
        --brand-mid: #f5c6ce;
        --combo-purple: #7c3aed;
        --combo-purple-dark: #5b21b6;
        --combo-purple-light: #f5f3ff;
        --purple: #6b21a8;
        --purple-light: #f3e8ff;
        --gold: #d4830f;
        --gold-light: #fef3e2;
        --green: #1b6b3a;
        --green-light: #e8f5ee;
        --bg: #f8fafc;
        --surface: #ffffff;
        --surface-2: #f1f5f9;
        --ink: #0f172a;
        --ink-soft: #475569;
        --ink-muted: #94a3b8;
        --rule: #e2e8f0;
        --font-display: "Source Serif 4", Georgia, serif;
        --font-body: "Inter", -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", monospace;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;
        --radius-pill: 999px;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        height: 100%;
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 15px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      a { color: inherit; text-decoration: none; }
      button { cursor: pointer; font-family: inherit; }

      /* ── INSTRUCTION / START MODAL ── */
      .instr-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(26, 20, 16, 0.72);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overscroll-behavior: contain;
      }
      .instr-modal {
        background: var(--surface);
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: hidden;
        box-shadow: 0 32px 80px rgba(26, 20, 16, 0.28);
        display: flex;
        flex-direction: column;
      }
      .instr-header {
        background: var(--ink);
        color: #fff;
        padding: 24px 28px 20px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        flex-shrink: 0;
      }
      .instr-exam-name {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 6px;
      }
      .instr-test-title {
        font-size: 1.18rem;
        font-family: var(--font-display);
        color: #fff;
        line-height: 1.25;
        margin-bottom: 14px;
      }
      .instr-meta-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .instr-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: var(--radius-pill);
      }
      .instr-body {
        padding: 22px 28px;
        overflow-y: auto;
        flex: 1;
      }
      .instr-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-muted);
        margin-bottom: 12px;
      }
      .instr-rules {
        list-style: none;
        margin: 0 0 20px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
      }
      .instr-rule {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        font-size: 0.88rem;
        color: var(--ink);
        line-height: 1.5;
      }
      .rule-warn {
        background: var(--brand-light);
        border-color: var(--brand-mid);
      }
      .rule-info {
        background: var(--gold-light);
        border-color: #f6d8a0;
      }
      .rule-ok {
        background: var(--green-light);
        border-color: #a7d7b8;
      }
      .rule-combo {
        background: var(--combo-purple-light);
        border-color: #ddd6fe;
      }
      .rule-combo-enhanced {
        background: linear-gradient(135deg, var(--combo-purple-light) 0%, #ffffff 100%);
        border: 1.5px solid #ddd6fe;
        border-radius: var(--radius-md);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .combo-flow-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-direction: column;
        gap: 4px;
      }
      .combo-flow-badge {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--combo-purple-dark);
        background: rgba(124, 58, 237, 0.12);
        padding: 4px 10px;
        border-radius: var(--radius-pill);
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .combo-flow-sub {
        font-size: 0.75rem;
        color: var(--ink-muted);
        font-weight: 600;
      }
      .combo-stages-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        gap: 6px;
      }
      .combo-stage-card {
        background: var(--surface);
        border: 1px solid #ddd6fe;
        border-radius: var(--radius-sm);
        padding: 10px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        box-shadow: 0 2px 6px rgba(124, 58, 237, 0.04);
        transition: transform 0.15s ease, border-color 0.15s ease;
        height: 100%;
      }
      .combo-stage-card:hover {
        transform: translateY(-1px);
        border-color: var(--combo-purple);
      }
      .csc-number {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--combo-purple);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
      }
      .csc-content {
        min-width: 0;
        flex: 1;
      }
      .csc-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.25;
      }
      .csc-desc {
        font-size: 0.72rem;
        color: var(--ink-soft);
        margin-top: 3px;
        line-height: 1.4;
        white-space: normal;
      }
      .combo-stage-connector {
        color: var(--combo-purple);
        font-weight: 800;
        font-size: 0.9rem;
        text-align: center;
        padding: 0 2px;
      }
      .combo-flow-footer {
        font-size: 0.76rem;
        color: var(--ink-soft);
        background: rgba(124, 58, 237, 0.06);
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        border-left: 3px solid var(--combo-purple);
        line-height: 1.4;
      }
      @media (max-width: 768px) {
        .combo-stages-grid {
          grid-template-columns: 1fr;
          gap: 8px;
        }
        .combo-stage-connector {
          display: none;
        }
        .combo-stage-card {
          align-items: center;
        }
        .csc-number {
          margin-top: 0;
        }
      }
      .instr-rule-icon {
        flex-shrink: 0;
        font-size: 1.1rem;
        margin-top: 1px;
      }
      .instr-rule-text strong {
        display: block;
        font-weight: 700;
        margin-bottom: 1px;
      }
      .instr-marking {
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 16px;
        margin-bottom: 20px;
      }
      .marking-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 12px;
      }
      .mg-item {
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 10px 8px;
      }
      .mg-val {
        font-size: 1.2rem;
        font-weight: 700;
        font-family: var(--font-display);
      }
      .mg-label {
        font-size: 0.72rem;
        color: var(--ink-muted);
        margin-top: 2px;
      }
      .mg-correct .mg-val { color: var(--green); }
      .mg-wrong .mg-val { color: var(--brand); }
      .mg-skip .mg-val { color: var(--ink-muted); }

      .instr-footer {
        padding: 18px 28px 24px;
        border-top: 1px solid var(--rule);
        background: var(--surface);
        flex-shrink: 0;
        z-index: 10;
      }
      .instr-agree {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
        cursor: pointer;
      }
      .instr-agree input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-top: 3px;
        accent-color: var(--brand);
        cursor: pointer;
        flex-shrink: 0;
      }
      .instr-agree-text {
        font-size: 0.9rem;
        color: var(--ink-soft);
        line-height: 1.5;
      }
      .btn-start-test {
        width: 100%;
        padding: 14px;
        border: none;
        background: var(--brand);
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
        border-radius: var(--radius-pill);
        transition: background 0.15s, opacity 0.15s, transform 0.1s;
      }
      .btn-start-test:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }
      .btn-start-test:not(:disabled):hover {
        background: var(--brand-dark);
        transform: translateY(-1px);
      }

      /* ── HEADER ── */
      .exam-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--surface);
        border-bottom: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
      }
      .eh-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        height: 52px;
        gap: 12px;
      }
      .eh-left {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        min-width: 0;
      }
      .eh-brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }
      .logo-desktop {
        display: block;
        height: 28px;
        width: auto;
        object-fit: contain;
      }
      .logo-mobile {
        display: none;
        height: 28px;
        width: 28px;
        object-fit: contain;
      }
      @media (max-width: 640px) {
        .logo-desktop {
          display: none !important;
        }
        .logo-mobile {
          display: block !important;
        }
      }
      .eh-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--ink);
        white-space: nowrap;
      }
      .eh-badge {
        font-size: 0.65rem;
        font-weight: 800;
        color: #fff;
        background: var(--combo-purple);
        padding: 2px 8px;
        border-radius: var(--radius-pill);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .eh-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
      }
      .timer-box {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 5px 12px;
        font-size: 0.92rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
      }
      .timer-box svg { color: var(--ink-muted); flex-shrink: 0; }
      .btn-fullscreen {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 6px;
        color: var(--ink-soft);
        transition: all 0.15s ease;
      }
      .btn-fullscreen:hover {
        background: var(--surface);
        border-color: var(--brand);
        color: var(--brand);
      }
      .btn-submit-header {
        background: var(--brand);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 7px 16px;
        border: none;
        border-radius: var(--radius-pill);
        transition: background 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .btn-submit-header:hover {
        background: var(--brand-dark);
      }

      /* ── COMBO STEP PROGRESS BAR (2nd row) ── */
      .combo-tabs-row {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px 8px;
        gap: 0;
      }
      .combo-tabs {
        display: flex;
        align-items: center;
        background: var(--surface-2);
        padding: 3px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--rule);
        gap: 2px;
        user-select: none;
        position: relative;
      }
      .combo-step {
        border: none;
        background: transparent;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ink-muted);
        padding: 5px 16px;
        border-radius: var(--radius-pill);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: default;
        pointer-events: none;
        transition: all 0.25s ease;
        position: relative;
      }
      .combo-step.active {
        background: #fff;
        color: var(--combo-purple-dark);
        box-shadow: 0 1px 6px rgba(124, 58, 237, 0.15);
        font-weight: 700;
      }
      .combo-step.completed {
        background: rgba(27, 107, 58, 0.1);
        color: var(--green);
        font-weight: 700;
      }
      .combo-step .step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        font-size: 0.68rem;
        font-weight: 800;
        background: var(--rule);
        color: var(--ink-muted);
        flex-shrink: 0;
      }
      .combo-step.active .step-num {
        background: var(--combo-purple);
        color: #fff;
      }
      .combo-step.completed .step-num {
        background: var(--green);
        color: #fff;
      }
      .combo-step .step-short {
        display: none;
      }
      /* Connector lines between steps */
      .step-connector {
        width: 24px;
        height: 2px;
        background: var(--rule);
        flex-shrink: 0;
        border-radius: 1px;
      }
      .step-connector.done {
        background: var(--green);
      }
      @media (max-width: 640px) {
        .combo-step .step-full {
          display: none;
        }
        .combo-step .step-short {
          display: inline;
        }
        .step-connector {
          width: 16px;
        }
      }

      /* ── PANELS CONTAINER ── */
      .test-panel {
        display: none;
        flex: 1;
        min-height: 0;
      }
      .test-panel.active {
        display: flex;
      }

      /* ── MCQ EXAM BODY ── */
      #mcq-panel {
        display: none;
        grid-template-columns: 1fr 300px;
        flex: 1;
        min-height: 0;
      }
      #mcq-panel.active {
        display: grid;
      }
      .question-panel {
        padding: 28px 32px 96px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 22px;
        user-select: none;
        -webkit-user-select: none;
      }
      .q-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .q-section-tag {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--brand);
        background: var(--brand-light);
        padding: 4px 10px;
        border-radius: var(--radius-pill);
      }
      .q-progress-text {
        font-size: 0.82rem;
        color: var(--ink-soft);
        font-weight: 600;
      }
      .q-progress-bar {
        height: 4px;
        background: var(--rule);
        border-radius: 2px;
        overflow: hidden;
      }
      .q-progress-fill {
        height: 100%;
        background: var(--brand);
        border-radius: 2px;
        transition: width 0.3s ease;
      }

      .q-num {
        font-size: 0.8rem;
        color: var(--ink-muted);
        font-weight: 600;
        margin-bottom: 4px;
      }
      .q-text {
        font-size: 1.08rem;
        color: var(--ink);
        line-height: 1.7;
        font-weight: 500;
        font-family: var(--font-body);
      }

      .options-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .option-btn {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: var(--surface);
        border: 1.5px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        font-size: 0.96rem;
        color: var(--ink);
        text-align: left;
        width: 100%;
        transition:
          border-color 0.15s,
          background 0.15s;
      }
      .option-btn:hover:not(:disabled) {
        border-color: var(--brand);
        background: var(--brand-light);
      }
      .option-btn.selected {
        border-color: var(--brand);
        background: var(--brand-light);
      }
      .opt-key {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--surface-2);
        font-weight: 700;
        font-size: 0.8rem;
        border: 1.5px solid var(--rule);
        color: var(--ink-soft);
        transition:
          background 0.15s,
          border-color 0.15s,
          color 0.15s;
      }
      .option-btn.selected .opt-key {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
      }
      .opt-text {
        line-height: 1.5;
        padding-top: 2px;
      }

      .action-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        position: fixed;
        left: 0;
        right: 300px;
        bottom: 0;
        z-index: 20;
        padding: 14px 32px;
        background: var(--surface);
        border-top: 1px solid var(--rule);
        box-shadow: 0 -6px 16px rgba(26, 20, 16, 0.05);
      }
      .btn-mark {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--purple-light);
        color: var(--purple);
        border: 1.5px solid var(--purple-light);
        border-radius: var(--radius-pill);
        padding: 8px 16px;
        font-size: 0.86rem;
        font-weight: 700;
        transition: all 0.15s ease;
      }
      .btn-mark:hover {
        border-color: var(--purple);
      }
      .btn-mark.marked {
        background: var(--purple);
        color: #fff;
      }
      .btn-clear {
        background: none;
        color: var(--ink-soft);
        border: 1.5px solid var(--rule);
        border-radius: var(--radius-pill);
        padding: 8px 16px;
        font-size: 0.86rem;
        font-weight: 600;
        transition: all 0.15s ease;
      }
      .btn-clear:hover {
        border-color: var(--ink-soft);
        color: var(--ink);
      }
      .nav-row {
        display: flex;
        gap: 10px;
        margin-left: auto;
      }
      .btn-prev,
      .btn-next {
        padding: 8px 20px;
        border-radius: var(--radius-pill);
        font-size: 0.88rem;
        font-weight: 700;
        border: none;
        transition: background 0.15s ease;
      }
      .btn-prev {
        background: var(--surface-2);
        color: var(--ink);
      }
      .btn-prev:hover {
        background: var(--rule);
      }
      .btn-next {
        background: var(--brand);
        color: #fff;
      }
      .btn-next:hover {
        background: var(--brand-dark);
      }

      .palette-toggle {
        display: none;
        position: fixed;
        bottom: 74px;
        right: 16px;
        z-index: 30;
        background: var(--ink);
        color: #fff;
        border: none;
        border-radius: var(--radius-pill);
        padding: 10px 18px;
        font-size: 0.86rem;
        font-weight: 700;
        box-shadow: 0 4px 16px rgba(26, 20, 16, 0.25);
        align-items: center;
        gap: 6px;
      }
      .mobile-nav-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 30;
        background: var(--surface);
        border-top: 1px solid var(--rule);
        padding: 10px 16px;
        gap: 8px;
      }

      .sidebar {
        border-left: 1px solid var(--rule);
        background: var(--surface);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .sidebar-header {
        padding: 16px 18px 12px;
        border-bottom: 1px solid var(--rule);
        flex-shrink: 0;
      }
      .sidebar-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }
      .sidebar-header h3 {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-muted);
        margin: 0;
      }
      .sidebar-close-btn {
        display: none;
        background: none;
        border: none;
        font-size: 1.4rem;
        cursor: pointer;
        color: var(--ink-muted);
        line-height: 1;
        padding: 4px;
      }
      .sidebar-backdrop {
        display: none;
      }
      .section-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .sec-tab {
        border: 1px solid var(--rule);
        background: var(--surface-2);
        font-size: 0.76rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: var(--radius-pill);
        color: var(--ink-soft);
      }
      .sec-tab.active {
        background: var(--brand);
        color: #fff;
        border-color: var(--brand);
      }
      .palette-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 16px 18px;
      }
      .palette-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
      }
      .pq-btn {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: transform 0.1s;
      }
      .pq-btn:hover {
        transform: scale(1.08);
      }
      .pq-btn.current {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }
      .pq-btn.not-visited {
        background: var(--surface-2);
        color: var(--ink-soft);
        border: 1px solid var(--rule);
      }
      .pq-btn.not-answered {
        background: #dc2626;
        color: #ffffff;
      }
      .pq-btn.answered {
        background: #16a34a;
        color: #ffffff;
      }
      .pq-btn.marked {
        background: #f3e8ff;
        color: #6b21a8;
        border: 1.5px solid #a855f7;
      }
      .pq-btn.ans-marked {
        background: var(--purple);
        color: #fff;
      }
      .legend {
        padding: 14px 18px;
        border-top: 1px solid var(--rule);
        font-size: 0.74rem;
        background: var(--surface-2);
      }
      .legend-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 10px;
        margin-top: 6px;
      }
      .leg-item { display: flex; align-items: center; gap: 6px; color: var(--ink-soft); }
      .leg-dot { width: 10px; height: 10px; border-radius: 50%; }
      .ld-nv { background: var(--surface-2); border: 1.5px solid var(--rule); }
      .ld-na { background: #dc2626; }
      .ld-an { background: #16a34a; }
      .ld-mr { background: #6b21a8; }

      /* ── TYPING TEST PANELS ── */
      .typing-panel-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px;
        width: 100%;
        min-height: 0;
      }
      .tt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        flex-wrap: wrap;
        gap: 10px;
      }
      .tt-header-left h2 {
        font-size: 1.3rem;
        font-weight: 800;
        margin: 0 0 2px;
      }
      .tt-header-left p {
        font-size: 0.85rem;
        color: var(--ink-soft);
        margin: 0;
      }
      .tt-stats {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .stat-pill {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 6px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 60px;
      }
      .stat-val {
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.1;
      }
      .stat-lbl {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--ink-muted);
        letter-spacing: 0.05em;
      }
      .stat-val.wpm { color: var(--combo-purple); }
      .stat-val.acc { color: var(--green); }
      .stat-val.err { color: var(--brand); }
      .stat-val.ok { color: var(--green); }
      .stat-val.bs { color: var(--ink-soft); }
      .stat-val.prg { color: var(--combo-purple-dark); }

      .typing-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        flex: 1;
        min-height: 380px;
      }
      .stage-start-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(4px);
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        border-radius: var(--radius-md);
      }
      .sso-card {
        text-align: center;
        max-width: 440px;
        background: var(--surface);
        border: 1px solid var(--rule);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
        padding: 28px 24px;
        border-radius: var(--radius-md);
      }
      .sso-card h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0 0 8px;
      }
      .sso-card p {
        font-size: 0.9rem;
        color: var(--ink-soft);
        margin: 0 0 10px;
      }
      .sso-sub {
        font-size: 0.82rem !important;
        color: var(--ink-muted) !important;
        margin-bottom: 18px !important;
        line-height: 1.4;
      }
      .sso-btn {
        font-weight: 700;
        color: #ffffff;
        background: var(--brand);
        border: none;
        padding: 12px 26px;
        border-radius: var(--radius-pill);
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(176, 0, 32, 0.22);
        transition: transform 0.15s ease, background 0.15s ease;
      }
      .sso-btn:hover {
        transform: translateY(-1px);
        background: var(--brand-dark);
      }
      .passage-wrap {
        position: relative;
        flex-shrink: 0;
        border-bottom: 1.5px solid var(--rule);
      }
      .passage-box {
        position: relative; /* needed so offsetTop-based auto scroll works */
        padding: 20px 40px 20px 24px; /* right padding leaves room for the custom scrollbar */
        background: #fafafc;
        font-family: var(--font-mono);
        font-size: 1.05rem;
        line-height: 1.9;
        color: var(--ink-soft);
        height: 200px;
        overflow-y: scroll;
        overscroll-behavior: contain;
        user-select: none;
        -webkit-user-select: none;
        /* hide the native scrollbar; a custom draggable one is rendered instead */
        scrollbar-width: none;
      }
      .passage-box::-webkit-scrollbar {
        display: none;
      }
      /* ── CUSTOM DRAGGABLE PASSAGE SCROLLBAR ── */
      .passage-scrollbar {
        position: absolute;
        top: 6px;
        right: 6px;
        bottom: 6px;
        width: 14px;
        background: #eef2f7;
        border: 1px solid var(--rule);
        border-radius: 7px;
        cursor: pointer;
        touch-action: none;
        z-index: 5;
      }
      .passage-scrollbar.hidden {
        display: none;
      }
      .passage-thumb {
        position: absolute;
        left: 1px;
        right: 1px;
        top: 0;
        min-height: 32px;
        background: #a5b4c8;
        border-radius: 6px;
        cursor: grab;
        touch-action: none;
        transition: background 0.15s ease;
      }
      .passage-thumb:hover {
        background: #7c8aa3;
      }
      .passage-thumb.dragging {
        background: var(--combo-purple);
        cursor: grabbing;
      }
      .tt-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 100%;
        font-family: var(--font-body);
        font-size: 0.95rem;
        color: var(--ink-soft);
        text-align: center;
      }
      .tt-status.error { color: var(--brand); }
      .tt-retry {
        border: none;
        background: var(--brand);
        color: #fff;
        font-weight: 700;
        padding: 8px 18px;
        border-radius: var(--radius-pill);
      }
      .tt-ch { position: relative; }
      .tt-ch.correct { }
      .tt-ch.wrong { }
      .tt-ch.current { }
      .tt-word { display: inline-block; white-space: nowrap; }

      .input-area-wrap {
        padding: 16px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
      }
      .typing-input {
        flex: 1;
        width: 100%;
        border: none;
        outline: none;
        font-family: var(--font-mono);
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--ink);
        resize: none;
        background: transparent;
      }
      .typing-input {
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
      }
      .typing-input::selection {
        background: transparent;
      }
      .typing-input:disabled {
        cursor: not-allowed;
      }
      .typing-input::placeholder {
        color: var(--ink-muted);
        font-size: 0.95rem;
      }
      .typing-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 10px;
        border-top: 1px solid var(--rule);
        flex-wrap: wrap;
        gap: 10px;
      }
      .typing-instructions {
        font-size: 0.8rem;
        color: var(--ink-muted);
      }
      .btn-restart {
        border: 1px solid var(--rule);
        background: var(--surface-2);
        color: var(--ink);
        padding: 7px 14px;
        border-radius: var(--radius-pill);
        font-size: 0.82rem;
        font-weight: 600;
      }
      .btn-step-submit {
        background: var(--brand);
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: var(--radius-pill);
        font-size: 0.86rem;
        font-weight: 700;
        transition: background 0.15s ease;
      }
      .btn-step-submit:hover {
        background: var(--brand-dark);
      }

      /* ── CONFIRMATION MODALS ── */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 100;
        display: none;
        place-items: center;
        padding: 16px;
      }
      .modal-box {
        background: #fff;
        border-radius: var(--radius-md);
        max-width: 520px;
        width: 100%;
        padding: 24px 28px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      }
      .modal-box h2 {
        font-size: 1.3rem;
        font-weight: 800;
        margin: 0 0 8px;
      }
      .modal-box p {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin: 0 0 20px;
      }
      .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 24px;
      }
      .summary-card {
        background: var(--surface-2);
        padding: 12px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--rule);
      }
      .summary-card-hd {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--ink-muted);
        text-transform: uppercase;
        margin-bottom: 4px;
      }
      .summary-card-val {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--ink);
      }
      .modal-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 24px;
        flex-wrap: wrap;
      }
      .btn-cancel,
      .btn-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 24px;
        border-radius: var(--radius-pill);
        font-size: 0.92rem;
        cursor: pointer;
        text-align: center;
        white-space: normal;
        line-height: 1.35;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }
      .btn-cancel {
        border: 1.5px solid var(--rule);
        background: var(--surface);
        color: var(--ink-soft);
        font-weight: 600;
        flex: 1 1 0;
        min-width: 140px;
      }
      .btn-cancel:hover {
        background: var(--surface-2);
        color: var(--ink);
      }
      .btn-confirm {
        border: 1.5px solid var(--brand);
        background: var(--brand);
        color: #ffffff;
        font-weight: 700;
        box-shadow: 0 4px 14px rgba(176, 0, 32, 0.22);
        flex: 1 1 0;
        min-width: 180px;
      }
      .btn-confirm:hover {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(176, 0, 32, 0.28);
      }
      .btn-confirm:disabled,
      .btn-cancel:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      /* ── RESULT TABS ── */
      #combo-results {
        display: none;
        flex: 1;
      }
      #combo-results.show {
        display: block;
      }
      .result-tabs[hidden] {
        display: none !important;
      }
      .result-tabs {
        display: flex;
        gap: 2px;
        padding: 3px;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-pill);
      }
      .result-tab {
        border: none;
        background: transparent;
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--ink-soft);
        padding: 5px 14px;
        border-radius: var(--radius-pill);
        white-space: nowrap;
        transition: all 0.2s ease;
      }
      @media (max-width: 600px) {
        .result-tab { padding: 4px 10px; font-size: 0.78rem; }
      }
      .result-tab.active {
        background: #fff;
        color: var(--combo-purple-dark);
        font-weight: 700;
        box-shadow: 0 1px 6px rgba(124, 58, 237, 0.15);
      }
      @media (max-width: 380px) {
        .result-tab { padding: 6px 12px; font-size: 0.8rem; }
      }

      /* ── TOAST (tab-switch warning etc.) ── */
      .toast {
        position: fixed;
        top: 70px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--brand);
        color: #fff;
        padding: 10px 18px;
        border-radius: var(--radius-pill);
        font-size: 0.85rem;
        font-weight: 600;
        z-index: 300;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        display: none;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 900px) {
        #mcq-panel {
          grid-template-columns: 1fr;
        }
        .sidebar {
          position: fixed;
          right: 0;
          top: 0;
          bottom: 0;
          height: 100vh;
          width: 300px;
          max-width: 85vw;
          transform: translateX(100%);
          transition: transform 0.25s ease;
          z-index: 1000;
          box-shadow: -8px 0 24px rgba(26, 20, 16, 0.2);
        }
        .sidebar.open {
          transform: translateX(0);
        }
        .sidebar-close-btn {
          display: block;
        }
        .sidebar-backdrop {
          position: fixed;
          inset: 0;
          background: rgba(0, 0, 0, 0.5);
          z-index: 999;
          display: none;
        }
        .sidebar-backdrop.open {
          display: block;
        }
        .palette-toggle {
          display: flex;
        }
        .mobile-nav-bar {
          display: flex;
        }
        .question-panel {
          padding: 20px 16px 120px;
        }
        .action-row {
          display: none;
        }
        .eh-title {
          display: none;
        }
      }

      @media (max-width: 600px) {
        .eh-top-row {
          padding: 0 10px;
          height: 46px;
          gap: 8px;
        }
        .combo-tabs-row {
          padding: 0 10px 6px;
        }
        .combo-tabs {
          padding: 2px;
          gap: 1px;
        }
        .combo-step {
          padding: 4px 10px;
          font-size: 0.72rem;
          gap: 3px;
        }
        .combo-step .step-num {
          width: 16px;
          height: 16px;
          font-size: 0.62rem;
        }
        .step-connector {
          width: 12px;
        }
        .btn-submit-header {
          padding: 6px 10px;
          font-size: 0.78rem;
        }
        .timer-box {
          padding: 5px 8px;
          font-size: 0.84rem;
        }
        .tt-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
        }
        .tt-stats {
          width: 100%;
          justify-content: space-between;
        }
        .typing-footer {
          flex-direction: column;
          align-items: stretch;
          gap: 10px;
        }
        .btn-step-submit {
          width: 100%;
          text-align: center;
          padding: 10px;
        }
      }

      @media (max-width: 480px) {
        .eh-top-row {
          padding: 0 8px;
        }
        .eh-badge {
          display: none;
        }
        .combo-tabs-row {
          padding: 0 8px 6px;
        }
      }

      /* ── BUTTON LABEL VARIANTS + SMALL-DEVICE FIXES ── */
      .lbl-short { display: none; }
      .typing-footer-left {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }
      .btn-submit-header, .btn-step-submit, .btn-restart,
      .btn-prev, .btn-next, .btn-mark, .btn-clear { white-space: nowrap; }
      .btn-confirm, .btn-cancel { white-space: normal; text-align: center; }
      .modal-actions { flex-wrap: wrap; }

      @media (max-width: 900px) {
        .mobile-nav-bar {
          padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px));
        }
        .mobile-nav-bar button {
          flex: 1 1 0;
          min-width: 0;
          padding: 10px 6px;
          font-size: 0.82rem;
          justify-content: center;
          text-align: center;
        }
      }
      @media (max-width: 640px) {
        .lbl-full { display: none; }
        .lbl-short { display: inline; }
        .btn-submit-header { padding: 7px 12px; font-size: 0.78rem; }
        .timer-box svg { display: none; }
        .typing-panel-content { padding: 16px 12px; }
        .tt-header-left h2 { font-size: 1.05rem; }
        .tt-header-left p { font-size: 0.78rem; }
        .stat-pill { flex: 1; min-width: 0; padding: 6px 8px; }
        .typing-card { min-height: 340px; }
        .passage-box { height: 170px; padding: 14px 32px 14px 14px; font-size: 0.95rem; }
        .input-area-wrap { padding: 12px 14px; }
        .typing-input { font-size: 1rem; }
        .typing-footer-left { width: 100%; justify-content: space-between; }
        .btn-step-submit { width: 100%; }
        .instr-header { padding: 18px; }
        .instr-body { padding: 16px 18px; }
        .instr-footer { padding: 14px 18px 18px; }
        .instr-test-title { font-size: 1.05rem; }
        .instr-pill { font-size: 0.72rem; padding: 4px 10px; }
        .instr-rule { padding: 10px 12px; font-size: 0.84rem; }
        .marking-grid { gap: 6px; }
        .modal-box { padding: 18px; }
        .modal-actions { flex-direction: column-reverse; }
        .modal-actions button { width: 100%; padding: 12px; }
        .summary-grid { gap: 8px; }
        .summary-card-val { font-size: 1.05rem; }
        .q-text { font-size: 1rem; }
        .option-btn { padding: 12px; font-size: 0.92rem; gap: 10px; }
      }
      @media (max-width: 380px) {
        .summary-grid { grid-template-columns: 1fr; }
        .combo-step { padding: 4px 7px; }
        .timer-box { padding: 4px 6px; font-size: 0.78rem; }
        .btn-submit-header { padding: 6px 10px; }
      }
    </style>
  </head>
  <body>
    <div
      id="combo-config"
      data-test-id-raw={slug}
      data-passage-test-name={passageTestName}
      data-test-title={test?.title || ""}
      style="display:none"
    ></div>

    <!-- ── INSTRUCTION / START MODAL ── -->
    <InstructionModal test={test} />

    <div class="toast" id="toast" role="alert"></div>

    <!-- ── EXAM HEADER ── -->
    <ExamHeader />

    <!-- 1. MCQ TEST PANEL (STAGE 1) -->
    <McqPanel />

    <!-- 2. PASSAGE 1 PANEL (STAGE 2) -->
    <TypingStagePanel
      panelId="typing-panel-1"
      prefix="tt1"
