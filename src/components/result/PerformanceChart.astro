---
/**
 * PerformanceChart — score trend + answer breakdown card for test attempts.
 *
 * The data usually loads in the browser, so this renders the empty card and you fill it from a script:
 *
 *   <PerformanceChart id="perf-chart" />
 *
 *   <script>
 *     import { renderPerformanceChart } from "../../components/result/performanceChart";
 *     renderPerformanceChart(document.getElementById("perf-chart")!, attempts);
 *   </script>
 *
 * `attempts`: [{ score (0–100), correct, wrong, skipped, totalQuestions, timeTaken?, submittedAt }].
 * Call it again with new data (e.g. after a filter) to redraw. Hidden while there is no data.
 *
 * Typing results use the same card: renderTypingChart(el, results) with
 *   <PerformanceChart id="typing-chart" trendTitle="Speed per passage" bands={["40+ WPM", "25–39", "<25"]} … />
 */
interface Props {
  id: string;
  title?: string;
  trendTitle?: string;
  donutTitle?: string;
  bands?: [string, string, string]; // legend for green / amber / red points
  class?: string;
}

const {
  id,
  title = "Performance trend",
  trendTitle = "Score per attempt",
  donutTitle = "Answer breakdown",
  bands = ["70%+", "40–69%", "<40%"],
  class: className,
} = Astro.props;
---

<section id={id} class:list={["pc", className]} aria-label={title} hidden>
  <header class="pc-head">
    <div>
      <h2 class="pc-title">{title}</h2>
      <p class="pc-sub" data-pc-sub></p>
    </div>
    <div class="pc-kpis" data-pc-kpis></div>
  </header>

  <div class="pc-body">
    <div class="pc-panel pc-panel-trend">
      <div class="pc-panel-head">
        <span class="pc-panel-title">{trendTitle}</span>
        <span class="pc-legend-inline">
          <i class="pc-key pc-key-good"></i>{bands[0]}
          <i class="pc-key pc-key-avg"></i>{bands[1]}
          <i class="pc-key pc-key-low"></i>{bands[2]}
        </span>
      </div>
      <div class="pc-trend" data-pc-trend></div>
      <div class="pc-tip" data-pc-tip hidden></div>
    </div>

    <div class="pc-panel pc-panel-donut">
      <div class="pc-panel-head">
        <span class="pc-panel-title">{donutTitle}</span>
      </div>
      <div class="pc-donut-wrap">
        <div class="pc-donut" data-pc-donut></div>
        <ul class="pc-legend" data-pc-legend></ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .pc {
    --pc-good: #16a34a;
    --pc-avg: #d97706;
    --pc-low: var(--brand, #b00020);
    --pc-wrong: #dc2626;
    --pc-skip: #cbd5e1;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 20px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .pc[hidden] {
    display: none;
  }

  /* Header */
  .pc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .pc-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }

  .pc-sub {
    margin: 2px 0 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .pc-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    gap: 8px;
  }

  .pc-kpi {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    min-width: 110px;
  }

  .pc-kpi-l {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pc-kpi-v {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.15;
  }

  .pc-kpi-v {
    white-space: nowrap;
  }

  .pc-kpi-u {
    margin-left: 3px;
    font-family: var(--font-body);
    font-size: 0.62em;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .pc-kpi-n {
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  .pc-kpi-n.is-up {
    color: var(--pc-good);
    font-weight: 600;
  }

  .pc-kpi-n.is-down {
    color: var(--pc-low);
    font-weight: 600;
  }

  /* Body */
  .pc-body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 16px;
  }

  .pc-panel {
    position: relative;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 14px 14px 8px;
    min-width: 0;
  }

  .pc-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .pc-panel-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .pc-legend-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: var(--ink-muted);
  }

  .pc-key {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-left: 4px;
  }

  .pc-key-good { background: var(--pc-good); }
  .pc-key-avg { background: var(--pc-avg); }
  .pc-key-low { background: var(--pc-low); }

  /* Trend chart */
  .pc-trend {
    width: 100%;
    touch-action: pan-y;
  }

  .pc-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pc-grid {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .pc-axis {
    font-size: 11px;
    fill: var(--ink-muted);
    font-family: var(--font-body);
  }

  .pc-avg {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .pc-avg-label {
    font-size: 10.5px;
    font-weight: 700;
    fill: var(--ink-soft);
    font-family: var(--font-body);
    /* white halo keeps the label readable over the line */
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .pc-grad-top { stop-color: var(--brand, #b00020); stop-opacity: 0.18; }
  .pc-grad-bottom { stop-color: var(--brand, #b00020); stop-opacity: 0; }

  .pc-line {
    fill: none;
    stroke: var(--brand, #b00020);
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .pc-guide {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
  }

  .pc-guide.is-on {
    opacity: 1;
  }

  .pc-dot {
    stroke: var(--surface);
    stroke-width: 2;
    transition: r 0.15s ease;
    cursor: pointer;
  }

  .pc-dot-good { fill: var(--pc-good); }
  .pc-dot-avg { fill: var(--pc-avg); }
  .pc-dot-low { fill: var(--pc-low); }

  .pc-dot.is-active {
    r: 7;
  }

  /* Tooltip */
  .pc-tip {
    position: absolute;
    z-index: 2;
    min-width: 170px;
    padding: 10px 12px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.22);
    pointer-events: none;
    font-size: 0.75rem;
  }

  .pc-tip[hidden] {
    display: none;
  }

  .pc-tip-head {
    opacity: 0.75;
    font-size: 0.7rem;
  }

  .pc-tip-score {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pc-band-good { color: #4ade80; }
  .pc-band-avg { color: #fbbf24; }
  .pc-band-low { color: #fb7185; }

  .pc-tip-row {
    display: flex;
    gap: 10px;
    margin: 2px 0;
  }

  .pc-tip-row .c { color: #4ade80; }
  .pc-tip-row .w { color: #fb7185; }
  .pc-tip-row .s { color: #cbd5e1; }

  .pc-tip-time {
    opacity: 0.75;
    font-size: 0.7rem;
  }

  /* Donut */
  .pc-donut-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 6px 0 8px;
  }

  .pc-donut {
    width: 150px;
    max-width: 100%;
  }

  .pc-donut-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .pc-donut-track {
    fill: none;
    stroke: var(--surface-2);
    stroke-width: 16;
  }

  .pc-donut-seg {
    fill: none;
    stroke-width: 16;
  }

  .pc-seg-correct { stroke: var(--pc-good); }
  .pc-seg-wrong { stroke: var(--pc-wrong); }
  .pc-seg-skipped { stroke: var(--pc-skip); }

  .pc-donut-v {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    fill: var(--ink);
  }

  .pc-donut-l {
    font-size: 10px;
    font-weight: 600;
    fill: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .pc-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pc-leg {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .pc-leg span::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 8px;
    vertical-align: -1px;
  }

  .pc-leg b {
    color: var(--ink);
    font-weight: 700;
  }

  .pc-leg-correct span::before { background: var(--pc-good); }
  .pc-leg-wrong span::before { background: var(--pc-wrong); }
  .pc-leg-skipped span::before { background: var(--pc-skip); }

  /* Responsive */
  @media (max-width: 900px) {
    .pc-body {
      grid-template-columns: 1fr;
    }
    .pc-donut-wrap {
      flex-direction: row;
      justify-content: center;
      gap: 24px;
    }
    .pc-donut {
      width: 130px;
      flex-shrink: 0;
    }
    .pc-legend {
      width: auto;
      min-width: 170px;
    }
  }

  @media (max-width: 640px) {
    .pc {
      padding: 14px;
    }
    .pc-kpis {
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pc-kpi {
      min-width: 0;
      padding: 8px 10px;
    }
    .pc-kpi-v {
      font-size: 1.1rem;
    }
    .pc-kpi-n {
      display: none;
    }
    .pc-legend-inline {
      display: none;
    }
    .pc-panel {
      padding: 12px 10px 6px;
    }
  }

  @media (max-width: 420px) {
    .pc-donut-wrap {
      flex-direction: column;
    }
    .pc-legend {
      width: 100%;
    }
  }
</style>
