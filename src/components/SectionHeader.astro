---
interface Props {
  title: string;
  seeAllHref?: string;
  seeAllText?: string;
  centered?: boolean;
  subtitle?: string;
  pill?: string;
}

const { title, seeAllHref, seeAllText = "See all →", centered = false, subtitle, pill } = Astro.props;
---

<div class={`section-head ${centered ? 'centered' : ''}`}>
  <div class="section-head-info">
    {pill && (
      <span class="section-pill">
        <span class="section-pill-dot"></span>
        {pill}
      </span>
    )}
    <h2 class="display-heading">{title}</h2>
    {subtitle && <p class="section-sub">{subtitle}</p>}
  </div>
  {seeAllHref && (
    <a href={seeAllHref} class="see-all">{seeAllText}</a>
  )}
</div>

<style>
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    gap: 24px;
  }
  .section-head.centered {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }
  .section-head-info {
    max-width: 680px;
  }
  .section-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 8px;
  }
  .section-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    display: inline-block;
  }
  .display-heading {
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 2.1vw, 1.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 6px 0;
  }
  .see-all {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--brand);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-mid);
    background: var(--brand-light);
    transition: background 0.15s;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(176, 0, 32, 0.05);
  }
  .see-all:hover {
    background: var(--brand);
    color: #ffffff;
    border-color: var(--brand);
  }
  .section-sub {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
    margin: 0;
  }
</style>
