---
/**
 * ExamPage — full recruitment exam page built from one Exam data object.
 * Order follows the OSSSC hub: mock tests first (the main thing we offer), then what to
 * study (syllabus, pattern), then the recruitment details. Sections only render when the
 * exam has data for them, and the sticky jump links follow automatically.
 * A new exam page is just:
 *
 *   ---
 *   import ExamPage from "../../components/odisha/ssb-odisha/ExamPage.astro";
 *   import { someExam } from "../../data/exams/odisha/some-exam";
 *   ---
 *   <ExamPage exam={someExam} />
 *
 * Shared building blocks (Bi, Section, DataTable, Tabs …) live in components/exam/ui.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Bi from "../../exam/ui/Bi.astro";
import LangBar from "./LangBar.astro";
import ExamHero from "./ExamHero.astro";
import KeyDates from "./KeyDates.astro";
import Vacancies from "./Vacancies.astro";
import PostsPay from "./PostsPay.astro";
import Eligibility from "./Eligibility.astro";
import ExamPattern from "./ExamPattern.astro";
import SelectionProcess from "./SelectionProcess.astro";
import Syllabus from "./Syllabus.astro";
import FeeAndApply from "./FeeAndApply.astro";
import Documents from "./Documents.astro";
import SubjectTests from "./SubjectTests.astro";
import ExamFaq from "./ExamFaq.astro";
import type { Exam, L } from "../../../data/exams/types";

interface Props {
  exam: Exam;
}

const { exam } = Astro.props;

// Sections in page order: [id, jump-link label, has data]
const sections: { id: string; label: L; show: boolean }[] = [
  { id: "tests", label: { en: "Mock tests", or: "ମକ୍ ଟେଷ୍ଟ" }, show: !!exam.tests?.subjects.length },
  { id: "syllabus", label: { en: "Syllabus", or: "ପାଠ୍ୟକ୍ରମ" }, show: !!exam.syllabus?.length },
  { id: "pattern", label: { en: "Exam pattern", or: "ପରୀକ୍ଷା ଢାଞ୍ଚା" }, show: !!exam.pattern },
  { id: "dates", label: { en: "Dates", or: "ତାରିଖ" }, show: exam.dates.length > 0 },
  { id: "vacancy", label: { en: "Vacancy", or: "ପଦବୀ" }, show: !!exam.vacancy },
  { id: "eligibility", label: { en: "Eligibility", or: "ଯୋଗ୍ୟତା" }, show: !!exam.eligibility?.length },
  { id: "selection", label: { en: "Selection", or: "ଚୟନ" }, show: !!exam.selection },
  { id: "posts", label: { en: "Posts & pay", or: "ପଦ ଓ ଦରମା" }, show: !!exam.postsTable },
  { id: "apply", label: { en: "Fee & apply", or: "ଫି ଓ ଆବେଦନ" }, show: !!(exam.fee || exam.howToApply) },
  { id: "documents", label: { en: "Documents", or: "ପ୍ରମାଣପତ୍ର" }, show: !!exam.documents?.length },
  { id: "faq", label: { en: "FAQ", or: "ପ୍ରଶ୍ନୋତ୍ତର" }, show: !!exam.faq?.length },
];
const has = (id: string) => sections.some((s) => s.id === id && s.show);
const links = sections.filter((s) => s.show).map(({ id, label }) => ({ id, label }));
---

<BaseLayout title={exam.seo.title} description={exam.seo.description} image={exam.seo.image}>
  <Fragment slot="head">
    <!-- Apply the saved language before first paint (no flash of English) -->
    <script is:inline>
      try {
        if (localStorage.getItem("brinto:lang") === "or") document.documentElement.dataset.lang = "or";
      } catch (e) {}
    </script>
  </Fragment>

  <ExamHero exam={exam} />
  <LangBar links={links} />

  <!-- 1. Practice -->
  {has("tests") && <SubjectTests exam={exam} />}

  <!-- 2. What to study -->
  {has("syllabus") && <Syllabus exam={exam} />}
  {has("pattern") && <ExamPattern exam={exam} />}

  <!-- 3. Recruitment details -->
  {has("dates") && <KeyDates exam={exam} />}
  {has("vacancy") && <Vacancies exam={exam} />}
  {has("eligibility") && <Eligibility exam={exam} />}
  {has("selection") && <SelectionProcess exam={exam} />}
  {has("posts") && <PostsPay exam={exam} />}
  {has("apply") && <FeeAndApply exam={exam} />}
  {has("documents") && <Documents exam={exam} />}
  {has("faq") && <ExamFaq exam={exam} />}
</BaseLayout>
