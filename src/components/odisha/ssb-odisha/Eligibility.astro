---
// Eligibility — one card per rule (age, qualification, language, domicile …).
import Section from "../../exam/ui/Section.astro";
import Bi from "../../exam/ui/Bi.astro";
import type { Exam } from "../../../data/exams/types";

interface Props {
  exam: Exam;
  id?: string;
}

const { exam, id = "eligibility" } = Astro.props;
---

<Section id={id} tone="alt" title={{ en: "Eligibility", or: "ଯୋଗ୍ୟତା" }} sub={{ en: "Check all of these before you prepare.", or: "ପ୍ରସ୍ତୁତି ପୂର୍ବରୁ ଏସବୁ ଯାଞ୍ଚ କରନ୍ତୁ।" }}>
  <div class="el-grid">
    {exam.eligibility!.map((e) => (
      <article class="el-card">
        <div class="el-top">
          <span class="el-icon" aria-hidden="true">{e.icon}</span>
          <h3 class="el-title"><Bi t={e.title} /></h3>
        </div>
        <p class="el-value"><Bi t={e.value} /></p>
        {e.points && (
          <ul class="el-points">
            {e.points.map((p) => <li><Bi t={p} /></li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</Section>

<style>
  .el-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .el-card {
    padding: 18px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .el-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .el-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--brand);
    background: var(--brand-light);
  }

  .el-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  .el-value {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 10px;
  }

  .el-points {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 5px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .el-points li::marker {
    color: var(--brand);
  }

  @media (max-width: 720px) {
    .el-grid { grid-template-columns: 1fr; }
    .el-card { padding: 16px; }
  }
</style>
