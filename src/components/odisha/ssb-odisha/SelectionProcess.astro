---
// SelectionProcess — numbered stages from exam to final merit, plus exam centres/zones.
import Section from "../../exam/ui/Section.astro";
import Bi from "../../exam/ui/Bi.astro";
import type { Exam } from "../../../data/exams/types";

interface Props {
  exam: Exam;
  id?: string;
}

const { exam, id = "selection" } = Astro.props;
const { steps, centres } = exam.selection!;
---

<Section id={id} title={{ en: "Selection process", or: "ଚୟନ ପ୍ରକ୍ରିୟା" }}>
  <ol class="sp-steps" style={`--sp-count:${steps.length};`}>
    {steps.map((s, i) => (
      <li class="sp-step">
        <span class="sp-num" aria-hidden="true">{i + 1}</span>
        <h3 class="sp-title"><Bi t={s.title} /></h3>
        <p class="sp-body"><Bi t={s.body} /></p>
      </li>
    ))}
  </ol>

  {centres && (
    <div class="sp-centres">
      <h3 class="sp-centres-title"><Bi t={centres.title} /></h3>
      <ul class="sp-places">
        {centres.places.map((p) => (
          <li>
            <span aria-hidden="true">📍</span> <Bi t={p} />
          </li>
        ))}
      </ul>
      {centres.note && <p class="sp-centres-note"><Bi t={centres.note} /></p>}
    </div>
  )}
</Section>

<style>
  .sp-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--sp-count), minmax(0, 1fr));
    gap: 14px;
    counter-reset: step;
  }

  .sp-step {
    position: relative;
    padding: 18px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  /* Arrow between cards on wide screens */
  .sp-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 30px;
    right: -11px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--brand-mid);
    border-right: 2px solid var(--brand-mid);
    transform: rotate(45deg);
  }

  .sp-num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--brand);
    background: var(--brand-light);
    margin-bottom: 10px;
  }

  .sp-title {
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .sp-body {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }

  .sp-centres {
    margin-top: 18px;
    padding: 18px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px dashed var(--brand-mid);
  }

  .sp-centres-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 10px;
  }

  .sp-places {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sp-places li {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--brand-light);
  }

  .sp-centres-note {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0;
  }

  @media (max-width: 900px) {
    .sp-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sp-step::after { display: none; }
  }

  @media (max-width: 520px) {
    .sp-steps { grid-template-columns: 1fr; }
    .sp-step { padding: 16px; display: grid; grid-template-columns: auto 1fr; gap: 0 12px; }
    .sp-num { grid-row: span 2; margin: 0; }
  }
</style>
