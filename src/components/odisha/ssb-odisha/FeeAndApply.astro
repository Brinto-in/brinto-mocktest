---
// FeeAndApply — application fee by category next to the how-to-apply steps.
import Section from "../../exam/ui/Section.astro";
import Bi from "../../exam/ui/Bi.astro";
import CheckList from "../../exam/ui/CheckList.astro";
import type { Exam } from "../../../data/exams/types";

interface Props {
  exam: Exam;
  id?: string;
}

const { exam, id = "apply" } = Astro.props;
const { fee, howToApply } = exam;
---

<Section id={id} title={{ en: "Application fee & how to apply", or: "ଆବେଦନ ଫି ଓ ଆବେଦନ ପ୍ରଣାଳୀ" }}>
  <div class="fa">
    {fee && (
      <div class="fa-fee">
        <h3 class="fa-title"><Bi t={{ en: "Application fee", or: "ଆବେଦନ ଫି" }} /></h3>
        <ul class="fa-amounts">
          {fee.items.map((f) => (
            <li>
              <span class="fa-amount">{f.amount}</span>
              <span class="fa-cat"><Bi t={f.category} /></span>
            </li>
          ))}
        </ul>
        {fee.notes && (
          <ul class="fa-notes">
            {fee.notes.map((n) => <li><Bi t={n} /></li>)}
          </ul>
        )}
      </div>
    )}

    {howToApply && (
      <div class="fa-steps">
        <h3 class="fa-title"><Bi t={{ en: "How to apply", or: "କିପରି ଆବେଦନ କରିବେ" }} /></h3>
        <CheckList items={howToApply} ordered />
        <a href={exam.board.website} class="fa-link" target="_blank" rel="noopener">
          <Bi t={{ en: `Go to ${exam.board.website.replace(/^https?:\/\//, "")} ↗`, or: `${exam.board.website.replace(/^https?:\/\//, "")} କୁ ଯାଆନ୍ତୁ ↗` }} />
        </a>
      </div>
    )}
  </div>
</Section>

<style>
  .fa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 16px;
    align-items: start;
  }

  .fa-fee,
  .fa-steps {
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .fa-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 14px;
  }

  .fa-amounts {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .fa-amounts li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--brand-light);
  }

  .fa-amount {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brand);
    font-variant-numeric: tabular-nums;
  }

  .fa-cat {
    font-weight: 700;
    color: var(--ink);
  }

  .fa-notes {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .fa-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand);
  }

  @media (max-width: 820px) {
    .fa { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .fa-fee,
    .fa-steps { padding: 16px; }
  }
</style>
