/* Loading spinner animation on action button */
.tt-btn-loading {
  position: relative;
  pointer-events: none;
  color: transparent !important;
}
.tt-btn-loading::after {
  content: '';
  position: absolute;
  width: 14px;
  height: 14px;
  top: calc(50% - 7px);
  left: calc(50% - 7px);
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: tt-btn-spin 0.65s linear infinite;
}
.tt-restart-btn.tt-btn-loading::after {
  border-color: rgba(75, 85, 99, 0.3);
  border-top-color: var(--tt-sub);
}
@keyframes tt-btn-spin {
  to { transform: rotate(360deg); }
}

/* ── Progress track ── */
.tt-progress-track { height: 3px; background: var(--tt-border); flex-shrink: 0; }
.tt-progress-fill  {
  height: 100%; width: 0%;
  background: linear-gradient(90deg, var(--tt-brand), #f87171);
  transition: width .25s ease;
  border-radius: 0 2px 2px 0;
}

/* ── Arena ── */
.tt-arena {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  cursor: text;
  min-height: 220px;
}

/* Initially compact while idle, then expands to full height when test starts */
.tt-root:not(.tt-running) .tt-passage-wrap {
  max-height: 250px;
}
.tt-root.tt-running .tt-passage-wrap {
  max-height: 480px;
}

/* Idle overlay */
.tt-idle {
  position: absolute; inset: 0; z-index: 10;
  background: rgba(255,255,255,.92);
  backdrop-filter: blur(3px);
  display: flex; align-items: center; justify-content: center;
  transition: opacity .25s, visibility .25s;
}
.tt-idle.tt-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.tt-idle-body { text-align: center; padding: 16px; }
.tt-idle-icon { font-size: 2.6rem; margin-bottom: 10px; }
