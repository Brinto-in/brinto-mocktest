/* Timer */
.tt-timer {
  display: flex; align-items: center; gap: 5px;
  font-size: .85rem; font-weight: 700;
  color: var(--tt-sub);
  font-family: 'Courier New', monospace;
  min-width: 54px;
}
.tt-timer svg { flex-shrink: 0; }
.tt-warn   { color: #d97706; }
.tt-danger { color: var(--tt-ng); animation: tt-pulse 1s infinite; }
@keyframes tt-pulse { 0%,100% { opacity:1; } 50% { opacity:.55; } }

/* Action buttons */
.tt-action-btn {
  font-size: .82rem; font-weight: 700;
  padding: 7px 16px; border-radius: 8px; border: none; cursor: pointer;
  transition: transform .1s, opacity .15s;
  font-family: var(--font-body, sans-serif);
}
.tt-start-btn   { background: var(--tt-brand); color: #fff; }
.tt-restart-btn { background: var(--tt-surf2); color: var(--tt-sub); border: 1px solid var(--tt-border); }
