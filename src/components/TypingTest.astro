  word-break: normal;
  overflow-wrap: normal;
  user-select: none;
}

/* Word wrappers to prevent splitting across lines */
:global(.tt-word) {
  display: inline-block;
  white-space: nowrap;
}

/* Characters */
:global(.tt-ch)     { position: relative; transition: color .06s; }
:global(.tt-ch.tt-ok)  { color: var(--tt-ok); }
:global(.tt-ch.tt-err) { color: var(--tt-ng); background: var(--tt-ng-bg); border-radius: 2px; }
:global(.tt-ch.tt-cur) { color: var(--tt-ink); }
:global(.tt-ch.tt-cur::before) {
  content: '';
  position: absolute; left: 0; top: 15%; bottom: 15%;
  width: 2px; background: var(--tt-brand); border-radius: 2px;
  animation: tt-blink 1s step-end infinite;
}
@keyframes tt-blink { 0%,100%{opacity:1;} 50%{opacity:0;} }

/* Hidden input */
.tt-input {
  position: absolute; opacity: 0; width: 1px; height: 1px;
  top: 0; left: 0; resize: none; border: none; outline: none;
  padding: 0; margin: 0; font-size: 16px; pointer-events: none;
}
.tt-running .tt-input { pointer-events: auto; }

