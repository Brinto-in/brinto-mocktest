---
import type { Category } from '../lib/types';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const active = category.active;
---

<a
  href={active ? category.href : '#'}
  class={`cat-card ${!active ? 'inactive' : 'active'}`}
  style={!active ? 'pointer-events: none; opacity: 0.65; cursor: default;' : ''}
  aria-disabled={!active ? 'true' : undefined}
>
  <span class="cat-icon">{category.icon}</span>
  {active ? (
    <span class="cat-arrow">→</span>
  ) : (
    <span class="cat-badge">Soon</span>
  )}
  <span class="cat-label">{category.label}</span>
  <span class="cat-count">{category.count} {category.count === 1 ? 'test' : 'tests'}</span>
</a>

<style>
  .cat-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 20px 18px;
    display: grid;
    grid-template-areas:
      'icon action'
      'label label'
      'count count';
    grid-template-columns: 1fr auto;
    gap: 6px 0;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .cat-card.active:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(176, 0, 32, 0.1);
  }
  .cat-icon { grid-area: icon; font-size: 1.5rem; }
  .cat-arrow {
    grid-area: action;
    align-self: start;
    font-size: 1rem;
    color: var(--ink-muted);
    transition: transform 0.15s;
  }
  .cat-card.active:hover .cat-arrow { transform: translateX(3px); color: var(--brand); }
  .cat-badge {
    grid-area: action;
    align-self: start;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--surface-2);
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.03em;
  }
  .cat-label { grid-area: label; font-weight: 700; font-size: 1rem; color: var(--ink); margin-top: 8px; }
  .cat-count { grid-area: count; font-size: 0.78rem; color: var(--ink-muted); }
</style>
