---
import type { Test } from "../lib/types";
import TestResultsView from "./TestResultsView.astro";

interface Props {
  slug?: string;
  test?: Test;
  questionsData?: any[];
}

const { slug = "", test, questionsData = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title id="page-title">Online Mock Test | Brinto MockTest</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --brand: #b00020;
        --brand-dark: #7b0015;
        --brand-light: #fff0f2;
        --brand-mid: #f5c6ce;
        --gold: #d4830f;
        --gold-light: #fef3e2;
        --green: #1b6b3a;
        --green-light: #e8f5ee;
        --purple: #6b21a8;
        --purple-light: #f3e8ff;
        --bg: #f8fafc;
        --surface: #ffffff;
        --surface-2: #f1f5f9;
        --ink: #0f172a;
        --ink-soft: #475569;
        --ink-muted: #94a3b8;
        --rule: #e2e8f0;
        --font-display: "Source Serif 4", Georgia, serif;
        --font-body: "Inter", -apple-system, sans-serif;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;
        --radius-pill: 999px;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        height: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      img,
      svg,
      .eh-brand svg {
        display: block;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      button {
        cursor: pointer;
        font-family: inherit;
      }
      h1,
      h2,
      h3 {
        margin: 0;
        font-family: var(--font-display);
        line-height: 1.15;
      }
      p {
        margin: 0;
      }

      /* ── EXAM HEADER ── */
      .exam-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--surface);
        border-bottom: 1px solid var(--rule);
        padding: 0 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        height: 60px;
        flex-shrink: 0;
      }
      .eh-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--ink);
        flex-shrink: 0;
      }
      .eh-brand svg rect {
        rx: 6;
      }
      .eh-title {
        flex: 1;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .timer-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 6px 14px;
        flex-shrink: 0;
      }
      .btn-fullscreen {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 8px;
        color: var(--ink-soft);
        transition: all 0.15s ease;
      }
      .btn-fullscreen:hover {
        background: var(--surface);
        border-color: var(--brand);
        color: var(--brand);
      }
      .timer-box svg {
        color: var(--ink-muted);
      }
      #timer {
        font-size: 1rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
        min-width: 52px;
      }
      #timer.warning {
        color: var(--gold);
      }
      #timer.danger {
        color: var(--brand);
        animation: blink 1s step-end infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0.4;
        }
      }
      .btn-submit-header {
        background: var(--brand);
        color: #fff;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 8px 18px;
        border: none;
        border-radius: var(--radius-pill);
        flex-shrink: 0;
        transition: background 0.15s;
      }
      .btn-submit-header:hover {
        background: var(--brand-dark);
      }

      /* ── MAIN LAYOUT ── */
      .exam-body {
        display: grid;
        grid-template-columns: 1fr 300px;
        flex: 1;
        min-height: 0;
      }

      /* ── QUESTION PANEL ── */
      .question-panel {
        /* bottom space so the fixed action bar never covers the last option */
        padding: 28px 32px 96px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
        user-select: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
      }
      .q-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
      }
      .q-section-tag {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--brand);
        background: var(--brand-light);
        padding: 4px 12px;
        border-radius: var(--radius-pill);
      }
      .q-progress-text {
        font-size: 0.84rem;
        color: var(--ink-muted);
        font-weight: 600;
      }
      .q-progress-bar {
        height: 4px;
        background: var(--rule);
        border-radius: 2px;
        overflow: hidden;
      }
      .q-progress-fill {
        height: 100%;
        background: var(--brand);
        border-radius: 2px;
        transition: width 0.3s;
      }
      .q-num {
        font-size: 0.8rem;
        color: var(--ink-muted);
        font-weight: 600;
        margin-bottom: 4px;
      }
      .q-text {
        font-size: 1.08rem;
        color: var(--ink);
        line-height: 1.7;
        font-weight: 500;
      }

      /* Options */
      .options {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .option-btn {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: var(--surface);
        border: 1.5px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        font-size: 0.96rem;
        color: var(--ink);
        text-align: left;
        width: 100%;
        transition:
          border-color 0.15s,
          background 0.15s;
      }
      .option-btn:hover:not(:disabled) {
        border-color: var(--brand);
        background: var(--brand-light);
      }
      .option-btn.selected {
        border-color: var(--brand);
        background: var(--brand-light);
      }
      .option-btn.correct {
        border-color: var(--green) !important;
        background: var(--green-light) !important;
      }
      .option-btn.wrong {
        border-color: var(--brand) !important;
        background: var(--brand-light) !important;
      }
      .opt-key {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--surface-2);
        font-weight: 700;
        font-size: 0.8rem;
        border: 1.5px solid var(--rule);
        color: var(--ink-soft);
        transition:
          background 0.15s,
          border-color 0.15s,
          color 0.15s;
      }
      .selected .opt-key {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
      }
      .correct .opt-key {
        background: var(--green);
        border-color: var(--green);
        color: #fff;
      }
      .wrong .opt-key {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
      }
      .opt-text {
        line-height: 1.5;
        padding-top: 2px;
      }

      /* Explanation (shown after submit) */
      .explanation {
        display: none;
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 14px 16px;
        font-size: 0.88rem;
        color: var(--ink-soft);
        line-height: 1.6;
      }
      .explanation strong {
        color: var(--ink);
      }
      .explanation.visible {
        display: block;
      }

      /* Action row — fixed to the bottom of the screen like the mobile bar,
         spanning the question column only (the palette sidebar is 300px wide). */
      .action-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        position: fixed;
        left: 0;
        right: 300px;
        bottom: 0;
        z-index: 20;
        padding: 14px 32px;
        background: var(--surface);
        border-top: 1px solid var(--rule);
        box-shadow: 0 -6px 16px rgba(26, 20, 16, 0.05);
      }
      .btn-mark {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--purple-light);
        color: var(--purple);
        border: 1.5px solid var(--purple-light);
        border-radius: var(--radius-pill);
        padding: 8px 16px;
        font-size: 0.86rem;
        font-weight: 700;
      }
      .btn-mark:hover {
        border-color: var(--purple);
      }
      .btn-mark.marked {
        background: var(--purple);
        color: #fff;
      }
      .btn-clear {
        background: none;
        color: var(--ink-soft);
        border: 1.5px solid var(--rule);
        border-radius: var(--radius-pill);
        padding: 8px 16px;
        font-size: 0.86rem;
        font-weight: 600;
      }
      .btn-clear:hover {
        border-color: var(--ink-soft);
        color: var(--ink);
      }
      .nav-row {
        display: flex;
        gap: 10px;
        margin-left: auto;
      }
      .btn-prev,
      .btn-next {
        padding: 8px 20px;
        border-radius: var(--radius-pill);
        font-size: 0.88rem;
        font-weight: 700;
        border: none;
      }
      .btn-prev {
        background: var(--surface-2);
        color: var(--ink);
      }
      .btn-prev:hover {
        background: var(--rule);
      }
      .btn-next {
        background: var(--brand);
        color: #fff;
      }
      .btn-next:hover {
        background: var(--brand-dark);
      }

      /* ── SIDEBAR ── */
      .sidebar {
        background: var(--surface);
        border-left: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .sidebar-header {
        padding: 16px 18px 12px;
        border-bottom: 1px solid var(--rule);
        flex-shrink: 0;
      }
      .sidebar-header h3 {
        font-family: var(--font-body);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-muted);
        margin-bottom: 10px;
      }
      .section-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .sec-tab {
        font-size: 0.76rem;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: var(--radius-pill);
        background: var(--surface-2);
        color: var(--ink-soft);
        border: 1px solid var(--rule);
        cursor: pointer;
      }
      .sec-tab.active {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
      }

      .palette-scroll {
        overflow-y: auto;
        padding: 16px 18px;
        flex: 1;
      }
      .palette-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 7px;
        margin-bottom: 20px;
      }
      .pq-btn {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-sm);
        font-size: 0.8rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: transform 0.1s;
      }
      .pq-btn:hover {
        transform: scale(1.08);
      }
      .pq-btn.current {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }
      /* States */
      .pq-btn.not-visited {
        background: var(--surface-2);
        color: var(--ink-soft);
        border: 1px solid var(--rule);
      }
      .pq-btn.not-answered {
        background: #dc2626;
        color: #ffffff;
      }
      .pq-btn.answered {
        background: #16a34a;
        color: #ffffff;
      }
      .pq-btn.marked {
        background: #f3e8ff;
        color: #6b21a8;
        border: 1.5px solid #a855f7;
      }
      .pq-btn.ans-marked {
        background: var(--purple);
        color: #fff;
      }

      /* Legend */
      .legend {
        padding: 14px 18px;
        border-top: 1px solid var(--rule);
        flex-shrink: 0;
      }
      .legend-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-muted);
        margin-bottom: 10px;
      }
      .legend-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
      }
      .leg-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 0.76rem;
        color: var(--ink-soft);
        font-weight: 500;
      }
      .leg-dot {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .ld-nv {
        background: var(--surface-2);
        border: 1px solid var(--rule);
      }
      .ld-na {
        background: #dc2626;
      }
      .ld-an {
        background: #16a34a;
      }
      .ld-mk {
        background: #f3e8ff;
        border: 1.5px solid #a855f7;
      }
      .ld-am {
        background: var(--purple);
      }

      /* ── INSTRUCTION MODAL ── */
      .instr-overlay {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(26, 20, 16, 0.72);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overscroll-behavior: contain;
      }
      .instr-modal {
        background: var(--surface);
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: hidden;
        box-shadow: 0 32px 80px rgba(26, 20, 16, 0.28);
        display: flex;
        flex-direction: column;
      }
      .instr-header {
        background: var(--ink);
        color: #fff;
        padding: 24px 28px 20px;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        flex-shrink: 0;
      }
      .instr-exam-name {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 6px;
      }
      .instr-test-title {
        font-size: 1.15rem;
        font-family: var(--font-display);
        color: #fff;
        line-height: 1.25;
        margin-bottom: 14px;
      }
      .instr-meta-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .instr-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: var(--radius-pill);
      }
      .instr-body {
        padding: 24px 28px;
        overflow-y: auto;
        flex: 1;
      }
      .instr-section-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-muted);
        margin-bottom: 12px;
      }
      .instr-rules {
        list-style: none;
        margin: 0 0 24px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
      }
      .instr-rule {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        font-size: 0.88rem;
        color: var(--ink);
        line-height: 1.5;
      }
      .rule-warn {
        background: var(--brand-light);
        border-color: var(--brand-mid);
      }
      .rule-info {
        background: var(--gold-light);
        border-color: #f6d8a0;
      }
      .rule-ok {
        background: var(--green-light);
        border-color: #a7d7b8;
      }
      .rule-note {
        background: #eff6ff;
        border-color: #bfdbfe;
      }
      .instr-rule-icon {
        flex-shrink: 0;
        font-size: 1.1rem;
        margin-top: 1px;
      }
      .instr-rule-text strong {
        display: block;
        font-weight: 700;
        margin-bottom: 1px;
      }
      .instr-marking {
        background: var(--surface-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        padding: 16px;
        margin-bottom: 24px;
      }
      .marking-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 12px;
      }
      .mg-item {
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 10px 8px;
      }
      .mg-val {
        font-size: 1.2rem;
        font-weight: 700;
        font-family: var(--font-display);
      }
      .mg-label {
        font-size: 0.72rem;
        color: var(--ink-muted);
        margin-top: 2px;
      }
      .mg-correct .mg-val {
        color: var(--green);
      }
      .mg-wrong .mg-val {
        color: var(--brand);
      }
      .mg-skip .mg-val {
        color: var(--ink-muted);
      }
      .instr-footer {
        padding: 18px 28px 24px;
        border-top: 1px solid var(--rule);
        background: var(--surface);
        flex-shrink: 0;
        z-index: 10;
      }
      .instr-agree {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 16px;
        cursor: pointer;
      }
      .instr-agree input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-top: 3px;
        accent-color: var(--brand);
        cursor: pointer;
        flex-shrink: 0;
      }
      .instr-agree-text {
        font-size: 0.9rem;
        color: var(--ink-soft);
        line-height: 1.5;
      }
      .instr-agree-text strong {
        color: var(--ink);
      }
      .btn-start-test {
        width: 100%;
        padding: 14px;
        border: none;
        background: var(--brand);
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
        border-radius: var(--radius-pill);
        transition:
          background 0.15s,
          opacity 0.15s,
          transform 0.1s;
      }
      .btn-start-test:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .btn-start-test:not(:disabled):hover {
        background: var(--brand-dark);
        transform: translateY(-1px);
      }

      /* ── TAB SWITCH WARNING TOAST ── */
      .tab-toast {
        position: fixed;
        top: 68px;
        left: 50%;
        transform: translateX(-50%) translateY(-16px);
        z-index: 180;
        background: var(--ink);
        color: #fff;
        border-radius: var(--radius-md);
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 8px 32px rgba(26, 20, 16, 0.3);
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.2s,
          transform 0.2s;
        max-width: min(440px, calc(100vw - 32px));
        border-left: 4px solid var(--brand);
      }
      .tab-toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      .toast-icon-wrap {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--brand);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .toast-content {
        flex: 1;
        min-width: 0;
      }
      .toast-title {
        font-weight: 700;
        font-size: 0.88rem;
      }
      .toast-sub {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.65);
        margin-top: 2px;
      }
      .toast-badge {
        background: var(--brand);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: var(--radius-pill);
        flex-shrink: 0;
      }

      /* ── SUBMIT MODAL ── */
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(26, 20, 16, 0.6);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 24px;
        overscroll-behavior: contain;
      }
      .modal-overlay.open {
        display: flex;
      }
      .modal {
        background: var(--surface);
        border-radius: var(--radius-lg);
        padding: 32px;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 24px 60px rgba(26, 20, 16, 0.2);
      }
      .modal h2 {
        font-size: 1.4rem;
        color: var(--ink);
        margin-bottom: 10px;
      }
      .modal p {
        color: var(--ink-soft);
        margin-bottom: 20px;
        font-size: 0.95rem;
      }
      .modal-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 24px;
      }
      .ms-item {
        background: var(--surface-2);
        border-radius: var(--radius-sm);
        padding: 12px 10px;
        text-align: center;
      }
      .ms-n {
        font-size: 1.4rem;
        font-weight: 700;
        font-family: var(--font-display);
      }
      .ms-l {
        font-size: 0.72rem;
        color: var(--ink-muted);
        margin-top: 2px;
      }
      .ms-answered .ms-n {
        color: var(--green);
      }
      .ms-not-answered .ms-n {
        color: var(--brand);
      }
      .ms-marked .ms-n {
        color: var(--purple);
      }
      .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
      }
      .btn-cancel {
        background: none;
        border: 1.5px solid var(--rule);
        padding: 10px 20px;
        border-radius: var(--radius-pill);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink-soft);
      }
      .btn-cancel:hover {
        border-color: var(--ink-soft);
      }
      .btn-confirm-submit {
        background: var(--brand);
        color: #fff;
        border: none;
        padding: 10px 24px;
        border-radius: var(--radius-pill);
        font-size: 0.9rem;
        font-weight: 700;
      }
      .btn-confirm-submit:hover {
        background: var(--brand-dark);
      }

      /* ── RESULTS ── */
      #results-view {
        display: none;
        flex: 1;
        overflow-y: auto;
      }
      #results-view.show {
        display: block;
      }
      .results-hero {
        background: var(--ink);
        color: #fff;
        padding: 48px 32px;
        text-align: center;
      }
      .results-hero h1 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        color: #fff;
        margin-bottom: 6px;
      }
      .results-hero p {
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 32px;
      }
      .score-ring-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        width: 140px;
        height: 140px;
        margin-bottom: 24px;
      }
      .score-ring-wrap svg {
        position: absolute;
        inset: 0;
      }
      .score-pct {
        font-size: 2rem;
        font-weight: 700;
        font-family: var(--font-display);
      }
      .result-cards {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 12px;
      }
      .rc {
        background: rgba(255, 255, 255, 0.1);
        border-radius: var(--radius-md);
        padding: 14px 20px;
        text-align: center;
        min-width: 100px;
      }
      .rc-n {
        font-size: 1.4rem;
        font-weight: 700;
      }
      .rc-l {
        font-size: 0.72rem;
        opacity: 0.6;
        margin-top: 2px;
      }
      .rc-correct .rc-n {
        color: #6ee7b7;
      }
      .rc-wrong .rc-n {
        color: #fca5a5;
      }
      .rc-skipped .rc-n {
        color: #fcd34d;
      }
      .rc-marked .rc-n {
        color: #c4b5fd;
      }

      .results-body {
        padding: 36px 32px;
        max-width: 840px;
        margin: 0 auto;
      }
      .res-section-title {
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-muted);
        margin-bottom: 14px;
      }
      .section-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        overflow: hidden;
        margin-bottom: 32px;
        font-size: 0.88rem;
      }
      .section-table th {
        background: var(--surface-2);
        padding: 10px 14px;
        text-align: left;
        font-weight: 600;
        color: var(--ink-soft);
        border-bottom: 1px solid var(--rule);
      }
      .section-table td {
        padding: 10px 14px;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
      }
      .section-table tr:last-child td {
        border-bottom: none;
      }
      .td-correct {
        color: var(--green);
        font-weight: 700;
      }
      .td-wrong {
        color: var(--brand);
        font-weight: 700;
      }

      /* Review answers */
      .review-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 40px;
      }
      .review-card {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-md);
        overflow: hidden;
      }
      .review-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        cursor: pointer;
        border-bottom: 1px solid transparent;
      }
      .review-header:hover {
        background: var(--surface-2);
      }
      .rh-open .review-header {
        border-bottom-color: var(--rule);
      }
      .review-status {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        color: #fff;
        font-weight: 700;
      }
      .rs-correct {
        background: var(--green);
      }
      .rs-wrong {
        background: var(--brand);
      }
      .rs-skipped {
        background: var(--ink-muted);
      }
      .rh-qnum {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--ink-muted);
      }
      .rh-text {
        font-size: 0.9rem;
        color: var(--ink);
        font-weight: 500;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .rh-chevron {
        color: var(--ink-muted);
        flex-shrink: 0;
        transition: transform 0.2s;
      }
      .rh-open .rh-chevron {
        transform: rotate(180deg);
      }
      .review-body {
        display: none;
        padding: 16px;
      }
      .rh-open .review-body {
        display: block;
      }
      .review-q-text {
        font-size: 0.96rem;
        color: var(--ink);
        margin-bottom: 12px;
        line-height: 1.6;
      }
      .review-options {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-bottom: 12px;
      }
      .rev-opt {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        font-size: 0.88rem;
        border: 1px solid var(--rule);
        background: var(--surface-2);
        color: var(--ink-soft);
      }
      .rev-opt.rev-correct {
        background: var(--green-light);
        border-color: var(--green);
        color: var(--green);
      }
      .rev-opt.rev-wrong {
        background: var(--brand-light);
        border-color: var(--brand);
        color: var(--brand);
      }
      .rev-key {
        font-weight: 700;
        flex-shrink: 0;
      }
      .review-expl {
        background: var(--gold-light);
        border-radius: var(--radius-sm);
        padding: 10px 14px;
        font-size: 0.84rem;
        color: var(--ink-soft);
        line-height: 1.6;
      }
      .review-expl strong {
        color: var(--ink);
      }

      /* Mobile sidebar backdrop & toggle */
      .sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      .sidebar-backdrop.open {
        opacity: 1;
        pointer-events: auto;
      }
      .sidebar-close-btn {
        display: none;
        background: none;
        border: none;
        font-size: 1.4rem;
        line-height: 1;
        color: var(--ink-muted);
        padding: 0 4px;
        cursor: pointer;
      }
      .sidebar-close-btn:hover {
        color: var(--ink);
      }
      .palette-toggle {
        display: none;
        position: fixed;
        bottom: 80px;
        right: 16px;
        z-index: 30;
        background: var(--ink);
        color: #fff;
        border: none;
        border-radius: var(--radius-pill);
        padding: 10px 18px;
        font-size: 0.86rem;
        font-weight: 700;
        box-shadow: 0 4px 16px rgba(26, 20, 16, 0.25);
      }
      .mobile-nav-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 30;
        background: var(--surface);
        border-top: 1px solid var(--rule);
        padding: 10px 20px;
        gap: 10px;
      }

      @media (max-width: 900px) {
        .exam-body {
          grid-template-columns: 1fr;
        }
        .sidebar {
          position: fixed;
          right: 0;
          top: 0;
          bottom: 0;
          height: 100vh;
          width: 300px;
          max-width: 85vw;
          transform: translateX(100%);
          transition: transform 0.25s ease;
          z-index: 1000;
          box-shadow: -8px 0 24px rgba(26, 20, 16, 0.2);
        }
        .sidebar.open {
          transform: translateX(0);
        }
        .sidebar-close-btn {
          display: block;
        }
        .palette-toggle {
          display: flex;
        }
        .mobile-nav-bar {
          display: flex;
        }
        .question-panel {
          padding: 20px 16px 120px;
        }
        .action-row {
          display: none;
        }
        .eh-title {
          display: none;
        }
      }
      @media (max-width: 480px) {
        .exam-header {
          padding: 0 12px;
          gap: 10px;
        }
        .eh-brand span {
          display: none;
        }
        .btn-submit-header {
          padding: 7px 12px;
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body>
    <div
      id="exam-config"
      data-test-meta={JSON.stringify(test || {})}
      data-questions-data={JSON.stringify(questionsData || [])}
      data-slug={slug || ""}
      style="display:none"
    ></div>
    <!-- ── EXAM HEADER ── -->
    <header class="exam-header" id="exam-header">
      <a href="/mocktest" class="eh-brand">
        <img src="/logo.png" alt="Brinto logo" height="28" style="height:28px; width:auto; object-fit:contain;" onerror="this.onerror=null;this.src='/mocktest/logo.png';" />
      </a>
      <div class="eh-title" id="eh-title">Online Mock Test</div>
      <button class="btn-fullscreen" id="btn-fullscreen" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
      <div class="timer-box">
        <svg
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          ><circle cx="12" cy="12" r="10"></circle><polyline
            points="12 6 12 12 16 14"></polyline></svg
        >
        <span id="timer">--:--</span>
      </div>
      <button class="btn-submit-header" id="btn-submit-header"
        >Submit Test</button
      >
    </header>

    <!-- ── EXAM BODY ── -->
    <div class="exam-body" id="exam-body">
      <!-- Question panel -->
      <div class="question-panel" id="question-panel">
        <div class="q-header">
          <span class="q-section-tag" id="q-section-tag">Section</span>
          <span class="q-progress-text" id="q-progress-text">Q 1 of 15</span>
        </div>
        <div class="q-progress-bar">
          <div class="q-progress-fill" id="q-progress-fill" style="width:0%">
          </div>
        </div>

        <div>
          <div class="q-num" id="q-num">Question 1</div>
          <div class="q-text" id="q-text">Loading…</div>
        </div>

        <div class="options" id="options-container"></div>

        <!-- This template will be cloned by the script to create styled option buttons -->
        <template id="option-template">
          <button class="option-btn">
            <span class="opt-key"></span><span class="opt-text"></span>
          </button>
        </template>

        <div class="explanation" id="explanation"></div>

        <div class="action-row">
          <button class="btn-mark" id="btn-mark">
            <svg
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon></svg
            >
            Mark for Review
          </button>
          <button class="btn-clear" id="btn-clear">Clear Response</button>
          <div class="nav-row">
            <button class="btn-prev" id="btn-prev">← Prev</button>
            <button class="btn-next" id="btn-next">Save & Next →</button>
          </div>
        </div>
      </div>

      <!-- Sidebar Backdrop -->
      <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <h3 style="margin:0;">Question Palette</h3>
            <button class="sidebar-close-btn" id="sidebar-close-btn" aria-label="Close palette">&times;</button>
          </div>
          <div class="section-tabs" id="section-tabs"></div>
          <template id="section-tab-template">
            <button class="sec-tab"></button>
          </template>
        </div>
        <div class="palette-scroll">
          <div class="palette-grid" id="palette-grid"></div>
          <template id="palette-button-template">
            <button class="pq-btn"></button>
          </template>
        </div>
        <div class="legend">
          <div class="legend-title">Legend</div>
          <div class="legend-grid">
            <div class="leg-item">
              <div class="leg-dot ld-nv"></div>Not Visited
            </div>
            <div class="leg-item">
              <div class="leg-dot ld-na"></div>Not Answered
            </div>
            <div class="leg-item">
              <div class="leg-dot ld-an"></div>Answered
            </div>
            <div class="leg-item"><div class="leg-dot ld-mk"></div>Marked</div>
            <div class="leg-item">
              <div class="leg-dot ld-am"></div>Ans+Marked
            </div>
          </div>
        </div>
      </aside>
    </div><!-- end exam-body -->

    <!-- ── RESULTS VIEW ── -->
    <TestResultsView />

    <!-- ── ERROR / NO DATA UI ── -->
    <div class="exam-error-view" id="exam-error-view" style="display:none;position:fixed;inset:0;background:var(--bg);z-index:99999;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;">
      <div style="width:72px;height:72px;border-radius:50%;background:var(--brand-light);color:var(--brand);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
        <svg width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h2 style="font-size:1.6rem;color:var(--ink);margin-bottom:8px;font-family:var(--font-display);">Test Data Not Available</h2>
      <p id="exam-error-msg" style="color:var(--ink-soft);max-width:440px;margin-bottom:28px;line-height:1.5;">
        Unable to load the questions for this test. Please try again or explore other tests.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
        <button onclick="window.location.reload()" style="background:var(--brand);color:#fff;font-weight:600;padding:12px 26px;border-radius:999px;border:none;">Retry</button>
        <a href="/mocktest/tests" style="background:var(--surface);border:1px solid var(--rule);color:var(--ink);font-weight:600;padding:12px 26px;border-radius:999px;">Browse Other Tests</a>
      </div>
    </div>

    <!-- ── SUBMIT MODAL ── -->
    <div
      class="modal-overlay"
      id="submit-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
    >
      <div class="modal">
        <h2 id="modal-title">Submit Test?</h2>
        <p>Once submitted, you cannot change your answers.</p>
        <div class="modal-stats">
          <div class="ms-item ms-answered">
            <div class="ms-n" id="ms-answered">0</div>
            <div class="ms-l">Answered</div>
          </div>
          <div class="ms-item ms-not-answered">
            <div class="ms-n" id="ms-not-answered">0</div>
            <div class="ms-l">Not Answered</div>
          </div>
          <div class="ms-item ms-marked">
            <div class="ms-n" id="ms-marked">0</div>
            <div class="ms-l">Marked</div>
          </div>
        </div>
        <div class="modal-actions">
          <button class="btn-cancel" id="btn-cancel-modal">Go back</button>
          <button class="btn-confirm-submit" id="btn-confirm-submit"
            >Yes, Submit</button
          >
        </div>
      </div>
    </div>

    <!-- ── INSTRUCTION MODAL ── -->
    <div
      class="instr-overlay"
      id="instr-overlay"
      role="dialog"
      aria-modal="true"
      aria-labelledby="instr-title"
    >
      <div class="instr-modal">
        <div class="instr-header">
          <div class="instr-exam-name" id="instr-exam-name">
            {test?.exam ? `${test.exam} · Mock Test` : "OSSSC · Mock Test"}
          </div>
          <div class="instr-test-title" id="instr-title">
            {test?.title || "Mock Test"}
          </div>
          <div class="instr-meta-pills">
            <span class="instr-pill">
              <svg
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 16 14"></polyline></svg
              >
              <span id="instr-duration">{test?.duration || 30}</span> Minutes
            </span>
            <span class="instr-pill">
              <svg
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path d="M9 11l3 3L22 4"></path><path
                  d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
                ></path></svg
              >
              <span id="instr-questions">{test?.questions || 20}</span> Questions
            </span>
            <span class="instr-pill">
              <svg
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                ></path></svg
              >
              <span id="instr-marks">
                {
                  test?.total_marks !== undefined
                    ? test.total_marks
                    : (test?.questions || 20) * (test?.correct_marks !== undefined ? test.correct_marks : 1)
                }
              </span> Marks Total
            </span>
            <span
              class="instr-pill"
              id="instr-neg-pill"
              style={
                test?.wrong_penalty && test.wrong_penalty > 0
                  ? "background:rgba(176,0,32,0.3)"
                  : "background:rgba(27,107,58,0.2); color:#1b6b3a;"
              }
            >
              <svg
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                  x1="12"
                  y1="17"
                  x2="12.01"
                  y2="17"></line></svg
              >
              <span id="instr-neg-text">
                {
                  test?.wrong_penalty !== undefined
                    ? test.wrong_penalty > 0
                      ? `Negative Marking (-${test.wrong_penalty})`
                      : "No Negative Marking"
                    : "Negative Marking"
                }
              </span>
            </span>
            {
              (() => {
                const diff = test?.difficulty;
                let bg = "rgba(255, 255, 255, 0.12)";
                let color = "rgba(255, 255, 255, 0.85)";
                let border = "1px solid transparent";
                if (diff) {
                  const d = String(diff).toLowerCase().trim();
                  if (d === "easy") {
                    bg = "rgba(34, 197, 94, 0.2)";
                    color = "#4ade80";
                    border = "1px solid rgba(74, 222, 128, 0.3)";
                  } else if (d === "hard") {
                    bg = "rgba(239, 68, 68, 0.22)";
                    color = "#f87171";
                    border = "1px solid rgba(248, 113, 113, 0.3)";
                  } else {
                    bg = "rgba(245, 158, 11, 0.2)";
                    color = "#fbbf24";
                    border = "1px solid rgba(251, 191, 36, 0.3)";
                  }
                }
                return (
                  <span
                    class="instr-pill"
                    id="instr-diff-pill"
                    style={`background: ${bg}; color: ${color}; border: ${border}; ${diff ? "display:inline-flex;" : "display:none;"}`}
                  >
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                    </svg>
                    <span id="instr-difficulty">{diff || ""}</span>
                  </span>
                );
              })()
            }
          </div>
        </div>

        <div class="instr-body">
          <div class="instr-section-label">General Instructions</div>
          <ul class="instr-rules">
            <li class="instr-rule rule-warn">
              <span class="instr-rule-icon">🚫</span>
              <div class="instr-rule-text">
                <strong>Do not switch tabs or windows</strong>
                Switching to another browser tab or window will be recorded as a violation.
                Multiple violations may result in auto-submission of your test.
              </div>
            </li>
            <li class="instr-rule rule-warn">
              <span class="instr-rule-icon">📵</span>
              <div class="instr-rule-text">
                <strong>Do not switch apps (mobile)</strong>
                On mobile devices, minimising the browser or switching to another
                app will trigger a warning. Keep this tab open and active.
              </div>
            </li>
            <li class="instr-rule rule-warn">
              <span class="instr-rule-icon">🔄</span>
              <div class="instr-rule-text">
                <strong>Do not refresh or press Back</strong>
                Refreshing the page or using the browser's back button will end your
                test session and your answers will not be saved.
              </div>
            </li>
            <li class="instr-rule rule-info">
              <span class="instr-rule-icon">⏱️</span>
              <div class="instr-rule-text">
                <strong>Timer starts immediately</strong>
                The countdown begins the moment you click "Start Test" and cannot
                be paused. The test will auto-submit when time runs out.
              </div>
            </li>
            <li class="instr-rule rule-info">
              <span class="instr-rule-icon">🖱️</span>
              <div class="instr-rule-text">
                <strong>One question at a time</strong>
                Use the Next / Prev buttons or the Question Palette to navigate. You
                can change your answer any time before submission.
              </div>
            </li>
            <li class="instr-rule rule-ok">
              <span class="instr-rule-icon">⭐</span>
              <div class="instr-rule-text">
                <strong>Mark for Review</strong>
                You can mark any question for review and come back to it. Marked questions
                that are answered will still be evaluated.
              </div>
            </li>
            <li class="instr-rule rule-note">
              <span class="instr-rule-icon">💡</span>
              <div class="instr-rule-text">
                <strong>Stable internet recommended</strong>
                This test runs entirely in your browser. Your answers are saved locally
                even if connectivity drops — but do not close the tab.
              </div>
            </li>
          </ul>

          <div class="instr-section-label">Marking Scheme</div>
          <div class="instr-marking">
            <div style="font-size:0.88rem;color:var(--ink-soft);" id="instr-marking-desc">
              Each question carries <strong style="color:var(--ink)" id="instr-correct-text">
                {test?.correct_marks !== undefined ? `${test.correct_marks} mark${test.correct_marks === 1 ? '' : 's'}` : "1 mark"}
              </strong>. <span id="instr-penalty-desc">
                {test?.wrong_penalty !== undefined ? (test.wrong_penalty > 0 ? "Wrong answers attract a penalty." : "No penalty for wrong answers.") : "Wrong answers attract a penalty."}
              </span>
            </div>
            <div class="marking-grid">
              <div class="mg-item mg-correct">
                <div class="mg-val" id="instr-mg-correct">
                  {test?.correct_marks !== undefined ? `+${test.correct_marks}` : "+1"}
                </div>
                <div class="mg-label">
                  Correct Answer
                </div>
              </div>
              <div class="mg-item mg-wrong">
                <div class="mg-val" id="instr-mg-wrong">
                  {test?.wrong_penalty !== undefined ? (test.wrong_penalty > 0 ? `-${test.wrong_penalty}` : "0") : "−¼"}
                </div>
                <div class="mg-label">
                  Wrong Answer
                </div>
              </div>
              <div class="mg-item mg-skip">
                <div class="mg-val" id="instr-mg-skip">
                  {test?.skipped_marks !== undefined ? `${test.skipped_marks}` : "0"}
                </div>
                <div class="mg-label">Skipped</div>
              </div>
            </div>
          </div>
        </div>

        <div class="instr-footer">
          <label class="instr-agree">
            <input type="checkbox" id="instr-agree-cb" />
            <span class="instr-agree-text">
              I have read all instructions carefully and agree to follow all test rules.
            </span>
          </label>
          <button class="btn-start-test" id="btn-start-test" disabled>
            Start Test →
          </button>
        </div>
      </div>
    </div>

    <!-- ── TAB SWITCH WARNING TOAST ── -->
    <div class="tab-toast" id="tab-toast" role="alert" aria-live="assertive">
      <div class="toast-icon-wrap">
        <svg
          width="18"
          height="18"
          fill="none"
          stroke="#fff"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path
            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
          ></path>
          <line x1="12" y1="9" x2="12" y2="13"></line><line
            x1="12"
            y1="17"
            x2="12.01"
            y2="17"></line>
        </svg>
      </div>
      <div class="toast-content">
        <div class="toast-title" id="toast-title">Tab switch detected!</div>
        <div class="toast-sub" id="toast-sub">
          Please stay on this tab during the test.
        </div>
      </div>
      <span class="toast-badge" id="toast-badge">1 warning</span>
    </div>

    <!-- Mobile controls -->
    <button
      class="palette-toggle"
      id="palette-toggle"
      aria-label="Toggle question palette"
    >
      📋 Palette
    </button>
    <div class="mobile-nav-bar">
      <button class="btn-prev" id="btn-prev-mob" style="flex:1">← Prev</button>
      <button
        class="btn-mark"
        id="btn-mark-mob"
        style="flex:1;justify-content:center">★ Review</button
      >
      <button class="btn-next" id="btn-next-mob" style="flex:1">Next →</button>
    </div>
    <script>
      import {
        createMockTestSession,
        submitMockTestAttempt,
        fetchTestDetails,
        fetchAttemptDetailsBySession,
        fetchTestWithSession
      } from "../lib/api/mockTestService";
      import { apiClient } from "../lib/api/client";

      const configEl = document.getElementById("exam-config");
      const testMeta = configEl?.dataset.testMeta ? JSON.parse(configEl.dataset.testMeta) : null;
      const questionsData = configEl?.dataset.questionsData ? JSON.parse(configEl.dataset.questionsData) : [];
      const slug = configEl?.dataset.slug || "";

      // ─────────────────────────────────────────────
      //  QUESTION BANK  (15 questions × 3 sections)
      // ─────────────────────────────────────────────
      let questions = [];
      let sections = [];

      // ─────────────────────────────────────────────
      //  STATE
      // ─────────────────────────────────────────────
      const state = {
        current: 0,
        answers: {}, // { qIndex: optionIndex }
        marked: new Set(),
        visited: new Set(),
        submitted: false,
        timeLeft: (testMeta?.duration || 30) * 60,
        totalDuration: (testMeta?.duration || 30) * 60,
        sessionId: "",
        activeSection: "all",
      };

      // ─────────────────────────────────────────────
      //  HELPERS
      // ─────────────────────────────────────────────
      function getQState(i) {
        const answered = state.answers[i] !== undefined;
        const marked = state.marked.has(i);
        if (!state.visited.has(i)) return "not-visited";
        if (answered && marked) return "ans-marked";
        if (marked) return "marked";
        if (answered) return "answered";
        return "not-answered";
      }

      function fmt(secs) {
        const m = String(Math.floor(secs / 60)).padStart(2, "0");
        const s = String(secs % 60).padStart(2, "0");
        return `${m}:${s}`;
      }

      // ─────────────────────────────────────────────
      //  RENDER
      // ─────────────────────────────────────────────
      function renderQuestion() {
        const q = questions[state.current];
        const i = state.current;

        document.getElementById("q-section-tag").textContent = q.section;
        document.getElementById("q-num").textContent = `Question ${i + 1}`;
        document.getElementById("q-text").textContent = q.text;
        document.getElementById("q-progress-text").textContent =
          `Q ${i + 1} of ${questions.length}`;
        document.getElementById("q-progress-fill").style.width =
          `${((i + 1) / questions.length) * 100}%`;

        const expl = document.getElementById("explanation");
        expl.classList.remove("visible");

        // Options
        const container = document.getElementById("options-container");
        container.innerHTML = "";
        const template = document.getElementById("option-template");
        const keys = ["A", "B", "C", "D"];
        q.options.forEach((opt, oi) => {
          const clone = template.content.cloneNode(true);
          const btn = clone.querySelector(".option-btn");
          btn.querySelector(".opt-key").textContent = keys[oi];
          btn.querySelector(".opt-text").textContent = opt;
          if (state.answers[i] === oi) btn.classList.add("selected");
          btn.addEventListener("click", () => selectOption(oi));
          container.appendChild(btn);
        });

        // Mark button state
        const btnMark = document.getElementById("btn-mark");
        const btnMarkMob = document.getElementById("btn-mark-mob");
        [btnMark, btnMarkMob].forEach((b) => {
          if (!b) return;
          if (state.marked.has(i)) {
            b.classList.add("marked");
          } else b.classList.remove("marked");
        });

        // Next/Submit & Prev button state
        const isFirst = i === 0;
        const isLast = i === questions.length - 1;
        const btnPrev = document.getElementById("btn-prev");
        const btnPrevMob = document.getElementById("btn-prev-mob");
        if (btnPrev) {
          btnPrev.disabled = isFirst;
          btnPrev.style.opacity = isFirst ? "0.4" : "1";
          btnPrev.style.pointerEvents = isFirst ? "none" : "auto";
        }
        if (btnPrevMob) {
          btnPrevMob.disabled = isFirst;
          btnPrevMob.style.opacity = isFirst ? "0.4" : "1";
          btnPrevMob.style.pointerEvents = isFirst ? "none" : "auto";
        }

        const btnNext = document.getElementById("btn-next");
        const btnNextMob = document.getElementById("btn-next-mob");
        if (btnNext) btnNext.textContent = isLast ? "Submit →" : "Save & Next →";
        if (btnNextMob) btnNextMob.textContent = isLast ? "Submit →" : "Next →";

        renderPalette();
      }

      function renderPalette() {
        const grid = document.getElementById("palette-grid");
        const template = document.getElementById("palette-button-template");
        grid.innerHTML = "";
        const filtered =
          state.activeSection === "all"
            ? questions
            : questions.filter((q) => q.section === state.activeSection);

        filtered.forEach((q) => {
          const i = questions.indexOf(q);
          const clone = template.content.cloneNode(true);
          const btn = clone.querySelector(".pq-btn");
          btn.className = `pq-btn ${getQState(i)}`;
          if (i === state.current) btn.classList.add("current");
          btn.textContent = i + 1;
          btn.setAttribute("aria-label", `Question ${i + 1}`);
          btn.addEventListener("click", () => jumpTo(i));
          grid.appendChild(btn);
        });
      }

      function renderSectionTabs() {
        const tabs = document.getElementById("section-tabs");
        const template = document.getElementById("section-tab-template");
        tabs.innerHTML = "";
        ["all", ...sections].forEach((sec) => {
          const clone = template.content.cloneNode(true);
          const btn = clone.querySelector(".sec-tab");
          btn.className =
            "sec-tab" + (state.activeSection === sec ? " active" : "");
          btn.textContent = sec === "all" ? "All" : sec;
          btn.addEventListener("click", () => {
            state.activeSection = sec;
            renderSectionTabs();
            renderPalette();
          });
          tabs.appendChild(btn);
        });
      }

      // ─────────────────────────────────────────────
      //  ACTIONS
      // ─────────────────────────────────────────────
      function selectOption(oi) {
        if (state.submitted) return;
        state.answers[state.current] = oi;
        renderQuestion();
      }

      function jumpTo(i) {
        state.visited.add(i);
        state.current = i;
        renderQuestion();
        // Close sidebar on mobile
        closeSidebar();
      }

      function markForReview() {
        const i = state.current;
        if (state.marked.has(i)) state.marked.delete(i);
        else state.marked.add(i);
        renderQuestion();
      }

      function clearResponse() {
        delete state.answers[state.current];
        renderQuestion();
      }

      function prevQ() {
        if (state.current > 0) jumpTo(state.current - 1);
      }
      function nextQ() {
        if (state.current < questions.length - 1) {
          jumpTo(state.current + 1);
        } else {
          openSubmitModal();
        }
      }

      // ─────────────────────────────────────────────
      //  SUBMIT MODAL
      // ─────────────────────────────────────────────
      function openSubmitModal() {
        const answered = Object.keys(state.answers).length;
        const marked = state.marked.size;
        const notAnswered = questions.length - answered;
        document.getElementById("ms-answered").textContent = answered;
        document.getElementById("ms-not-answered").textContent = notAnswered;
        document.getElementById("ms-marked").textContent = marked;
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
        document.getElementById("submit-modal").classList.add("open");
      }
      function closeSubmitModal() {
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";
        document.getElementById("submit-modal").classList.remove("open");
      }

      // ─────────────────────────────────────────────
      //  RESULTS
      // ─────────────────────────────────────────────
      async function showResults() {
        if (state.submitted) return;
        state.submitted = true;
        clearInterval(timerInterval);
        closeSubmitModal();

        const timeTaken = Math.max(0, state.totalDuration - state.timeLeft);

        // Build answers payload for attempt submission
        const answersPayload = questions.map((q, i) => {
          const userOptIdx = state.answers[i];
          let selectedOptionId = null;
          if (userOptIdx !== undefined && q.optionsObjects && q.optionsObjects[userOptIdx]) {
            const optObj = q.optionsObjects[userOptIdx];
            selectedOptionId = typeof optObj === 'object' && optObj !== null ? (optObj.id ?? optObj) : optObj;
          }
          return {
            questionId: q.id,
            selectedOptionId: selectedOptionId,
            isMarked: state.marked.has(i)
          };
        });

        let serverData = null;
        if (state.sessionId) {
          try {
            const attemptResult = await submitMockTestAttempt({
              sessionId: state.sessionId,
              timeTaken: timeTaken,
              answers: answersPayload
            });
            if (attemptResult) {
              serverData = attemptResult;
            }

            // Fetch GET /api/mocktests/attempts/{sessionId} for complete results analysis
            const fullAttempt = await fetchAttemptDetailsBySession(state.sessionId);
            if (fullAttempt) {
              serverData = fullAttempt;
            }
          } catch (err) {
            console.error("Error submitting mock test attempt to API:", err);
          }
        }

        document.getElementById("exam-body").style.display = "none";
        document.getElementById("palette-toggle").style.display = "none";
        const mobNav = document.querySelector(".mobile-nav-bar");
        if (mobNav) mobNav.style.display = "none";
        document.getElementById("btn-submit-header").style.display = "none";
        exitFullscreen();
        document.getElementById("results-view").classList.add("show");
        document.getElementById("res-test-name").textContent = testMeta?.title || document.getElementById("eh-title")?.textContent || "Online Mock Test";

        // Compute stats
        let correct = serverData?.correct;
        let wrong = serverData?.wrong;
        let skipped = serverData?.skipped;
        let marked = serverData?.marked ?? state.marked.size;

        if (correct === undefined || wrong === undefined || skipped === undefined) {
          correct = 0; wrong = 0; skipped = 0;
          questions.forEach((q, i) => {
            if (state.answers[i] === undefined) skipped++;
            else if (state.answers[i] === q.correct) correct++;
            else wrong++;
          });
        }

        const total = serverData?.totalQuestions || questions.length;
        const pct = total > 0 ? Math.round((correct / total) * 100) : 0;

        document.getElementById("rc-correct").textContent = correct;
        document.getElementById("rc-wrong").textContent = wrong;
        document.getElementById("rc-skipped").textContent = skipped;
        document.getElementById("rc-marked").textContent = marked;
        document.getElementById("score-pct-text").textContent = pct + "%";

        // Animate ring
        const circ = document.getElementById("score-ring-circle");
        const circumference = 376.99;
        setTimeout(() => {
          circ.style.transition = "stroke-dashoffset 1.2s ease";
          circ.style.stroke =
            pct >= 60 ? "#6EE7B7" : pct >= 40 ? "#FCD34D" : "#FCA5A5";
          circ.style.strokeDashoffset =
            circumference - (circumference * pct) / 100;
        }, 100);

        // Section table
        const tbody = document.getElementById("section-table-body");
        tbody.innerHTML = "";

        if (Array.isArray(serverData?.sections) && serverData.sections.length > 0) {
          serverData.sections.forEach((sec) => {
            const secTotal = sec.total || 0;
            const secCorrect = sec.correct || 0;
            const secWrong = sec.wrong !== undefined ? sec.wrong : Math.max(0, secTotal - secCorrect);
            const secPct = secTotal > 0 ? Math.round((secCorrect / secTotal) * 100) : 0;
            tbody.innerHTML += `
        <tr>
          <td><strong>${sec.name || sec.sectionName || sec.section || "General"}</strong></td>
          <td>${secTotal}</td>
          <td class="td-correct">${secCorrect}</td>
          <td class="td-wrong">${secWrong}</td>
          <td><strong>${secPct}%</strong></td>
        </tr>`;
          });
        } else {
          sections.forEach((sec) => {
            const qs = questions.filter((q) => q.section === sec);
            let sc = 0,
              sw = 0;
            qs.forEach((q) => {
              const i = questions.indexOf(q);
              if (state.answers[i] !== undefined && state.answers[i] === q.correct) sc++;
              else if (state.answers[i] !== undefined) sw++;
            });
            const secTotal = qs.length;
            const secPct = secTotal > 0 ? Math.round((sc / secTotal) * 100) : 0;
            tbody.innerHTML += `
        <tr>
          <td><strong>${sec}</strong></td>
          <td>${secTotal}</td>
          <td class="td-correct">${sc}</td>
          <td class="td-wrong">${sw}</td>
          <td><strong>${secPct}%</strong></td>
        </tr>`;
          });
        }

        // Build map from server response questions array
        const resQuestionMap = new Map();
        if (Array.isArray(serverData?.questions)) {
          serverData.questions.forEach((sq) => {
            resQuestionMap.set(Number(sq.questionId), sq);
          });
        }

        // Review list
        const reviewList = document.getElementById("review-list");
        if (reviewList) {
          reviewList.innerHTML = "";
          const keys = ["A", "B", "C", "D"];
          const qList = Array.isArray(serverData?.questions) && serverData.questions.length > 0 ? serverData.questions : questions;

          qList.forEach((q, i) => {
            const sq = resQuestionMap.get(Number(q.questionId || q.id));
            const userAns = state.answers[i];
            const isCorrect = q.isCorrect !== undefined ? q.isCorrect : (sq ? sq.isCorrect : (userAns !== undefined && userAns === q.correct));
            const isSkipped = q.isSkipped !== undefined ? q.isSkipped : (sq ? (sq.selectedOptionId === null || sq.selectedOptionId === undefined) : (userAns === undefined));

            const statusClass = isSkipped ? "rs-skipped" : isCorrect ? "rs-correct" : "rs-wrong";
            const statusIcon = isSkipped ? "–" : isCorrect ? "✓" : "✗";

            const optionsList = q.options || [];
            const optionsHtml = optionsList
              .map((opt, oi) => {
                let cls = "";
                if (opt.isCorrect !== undefined || opt.isSelected !== undefined) {
                  if (opt.isCorrect) cls = "rev-correct";
                  else if (opt.isSelected) cls = "rev-wrong";
                } else {
                  const optObj = q.optionsObjects && q.optionsObjects[oi];
                  const optId = typeof optObj === 'object' && optObj !== null ? (optObj.id ?? optObj) : optObj;
                  const correctAnsId = sq ? sq.answer : q.correct;
                  const selectedOptId = sq ? sq.selectedOptionId : (userAns !== undefined && q.optionsObjects && q.optionsObjects[userAns] ? (q.optionsObjects[userAns].id ?? q.optionsObjects[userAns]) : null);

                  if (correctAnsId !== null && correctAnsId !== undefined) {
                    if (optId === correctAnsId) cls = "rev-correct";
                    else if (optId === selectedOptId) cls = "rev-wrong";
                  } else {
                    if (oi === q.correct) cls = "rev-correct";
                    else if (oi === userAns) cls = "rev-wrong";
                  }
                }
                return `<div class="rev-opt ${cls}"><span class="rev-key">${keys[oi] || (oi + 1)}.</span> ${opt.text || opt}</div>`;
              })
              .join("");

            const card = document.createElement("div");
            card.className = "review-card";
            card.innerHTML = `
              <div class="review-header" onclick="this.parentElement.classList.toggle('rh-open')">
                <div class="review-status ${statusClass}">${statusIcon}</div>
                <span class="rh-qnum">Q${q.questionNumber || (i + 1)}</span>
                <span class="rh-text">${q.text}</span>
                <svg class="rh-chevron" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </div>
              <div class="review-body">
                <div class="review-q-text">${q.text}</div>
                <div class="review-options">${optionsHtml}</div>
                <div class="review-expl"><strong>Explanation:</strong> ${q.explanation || "No explanation provided."}</div>
              </div>`;
            reviewList.appendChild(card);
          });
        }
      }

      // ─────────────────────────────────────────────
      //  FULLSCREEN HANDLERS & ICON TOGGLE
      // ─────────────────────────────────────────────
      const ENTER_FS_SVG = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>`;
      const EXIT_FS_SVG = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/></svg>`;

      function isFullscreen() {
        return !!(document.fullscreenElement || (document).webkitFullscreenElement || (document).msFullscreenElement);
      }

      function updateFullscreenIcon() {
        const btn = document.getElementById("btn-fullscreen");
        if (!btn) return;
        if (isFullscreen()) {
          btn.innerHTML = EXIT_FS_SVG;
          btn.title = "Exit Fullscreen";
          btn.setAttribute("aria-label", "Exit Fullscreen");
        } else {
          btn.innerHTML = ENTER_FS_SVG;
          btn.title = "Enter Fullscreen";
          btn.setAttribute("aria-label", "Enter Fullscreen");
        }
      }

      function enterFullscreen() {
        const elem = document.documentElement;
        if (elem.requestFullscreen) {
          elem.requestFullscreen().catch(() => {});
        } else if (elem.webkitRequestFullscreen) {
          elem.webkitRequestFullscreen();
        } else if (elem.msRequestFullscreen) {
          elem.msRequestFullscreen();
        }
      }

      function exitFullscreen() {
        if (!isFullscreen()) return;
        if (document.exitFullscreen) {
          document.exitFullscreen().catch(() => {});
        } else if (document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) {
          document.msExitFullscreen();
        }
      }

      function toggleFullscreen() {
        if (!isFullscreen()) {
          enterFullscreen();
        } else {
          exitFullscreen();
        }
      }

      document.getElementById("btn-fullscreen")?.addEventListener("click", toggleFullscreen);
      document.addEventListener("fullscreenchange", updateFullscreenIcon);
      document.addEventListener("webkitfullscreenchange", updateFullscreenIcon);
      document.addEventListener("msfullscreenchange", updateFullscreenIcon);

      // ─────────────────────────────────────────────
      //  INSTRUCTION MODAL & START TEST SESSION
      // ─────────────────────────────────────────────
      const instrOverlay = document.getElementById("instr-overlay");
      const instrCb = document.getElementById("instr-agree-cb");
      const btnStart = document.getElementById("btn-start-test");

      if (instrOverlay) {
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
      }

      function applyDetailsToModal(d) {
        if (!d) return;

        const examName = d.exam ? `${d.exam} · Mock Test` : (testMeta?.exam ? `${testMeta.exam} · Mock Test` : "OSSSC · Mock Test");
        const title = d.title || testMeta?.title || "Online Mock Test";
        const duration = d.duration ?? testMeta?.duration ?? 30;
        const questionsCount = d.questions ?? testMeta?.questions ?? 20;
        const correctMarks = d.correct_marks ?? 1;
        const wrongPenalty = d.wrong_penalty ?? 0;
        const skippedMarks = d.skipped_marks ?? 0;
        const totalMarks = d.total_marks ?? (questionsCount * correctMarks);

        const instrExamEl = document.getElementById("instr-exam-name");
        if (instrExamEl) instrExamEl.textContent = examName;

        const instrTitleEl = document.getElementById("instr-title");
        if (instrTitleEl) instrTitleEl.textContent = title;

        const instrDurEl = document.getElementById("instr-duration");
        if (instrDurEl) instrDurEl.textContent = duration;

        const instrQEl = document.getElementById("instr-questions");
        if (instrQEl) instrQEl.textContent = questionsCount;

        const instrMarksEl = document.getElementById("instr-marks");
        if (instrMarksEl) instrMarksEl.textContent = totalMarks;

        // Negative marking pill
        const negPill = document.getElementById("instr-neg-pill");
        const negText = document.getElementById("instr-neg-text");
        if (negPill && negText) {
          if (wrongPenalty > 0) {
            negText.textContent = `Negative Marking (-${wrongPenalty})`;
            negPill.style.background = "rgba(176,0,32,0.3)";
            negPill.style.color = "inherit";
          } else {
            negText.textContent = "No Negative Marking";
            negPill.style.background = "rgba(27,107,58,0.2)";
            negPill.style.color = "#1b6b3a";
          }
        }

        // Difficulty pill with interactive colors (Easy, Medium, Hard)
        if (d.difficulty) {
          const diffPill = document.getElementById("instr-diff-pill");
          const diffText = document.getElementById("instr-difficulty");
          if (diffPill && diffText) {
            diffText.textContent = d.difficulty;
            const diffLower = String(d.difficulty).toLowerCase().trim();
            if (diffLower === "easy") {
              diffPill.style.background = "rgba(34, 197, 94, 0.2)";
              diffPill.style.color = "#4ade80";
              diffPill.style.border = "1px solid rgba(74, 222, 128, 0.3)";
            } else if (diffLower === "hard") {
              diffPill.style.background = "rgba(239, 68, 68, 0.22)";
              diffPill.style.color = "#f87171";
              diffPill.style.border = "1px solid rgba(248, 113, 113, 0.3)";
            } else {
              // Medium or default
              diffPill.style.background = "rgba(245, 158, 11, 0.2)";
              diffPill.style.color = "#fbbf24";
              diffPill.style.border = "1px solid rgba(251, 191, 36, 0.3)";
            }
            diffPill.style.display = "inline-flex";
          }
        }

        // Marking grid
        const mgCorrect = document.getElementById("instr-mg-correct");
        if (mgCorrect) mgCorrect.textContent = `+${correctMarks}`;

        const mgWrong = document.getElementById("instr-mg-wrong");
        if (mgWrong) mgWrong.textContent = wrongPenalty > 0 ? `-${wrongPenalty}` : "0";

        const mgSkip = document.getElementById("instr-mg-skip");
        if (mgSkip) mgSkip.textContent = `${skippedMarks}`;

        const correctText = document.getElementById("instr-correct-text");
        if (correctText) correctText.textContent = `${correctMarks} mark${correctMarks === 1 ? '' : 's'}`;

        const penaltyDesc = document.getElementById("instr-penalty-desc");
        if (penaltyDesc) {
          penaltyDesc.textContent = wrongPenalty > 0 ? "Wrong answers attract a penalty." : "No penalty for wrong answers.";
        }

        // Header and Document title
        const ehTitle = document.getElementById("eh-title");
        if (ehTitle) ehTitle.textContent = title;
        document.title = `${title} | Brinto MockTest`;

        // Update timer state
        state.totalDuration = duration * 60;
        state.timeLeft = duration * 60;
      }

      // Initial apply if testMeta exists
      if (testMeta) {
        applyDetailsToModal(testMeta);
      }

      // Fetch details from API on client load
      const testIdRaw = slug || testMeta?.id;
      if (testIdRaw) {
        fetchTestDetails(String(testIdRaw))
          .then((data) => {
            if (data) {
              applyDetailsToModal(data);
            }
          })
          .catch((err) => console.warn("Failed to fetch test details in modal:", err));
      }

      instrCb.addEventListener("change", () => {
        btnStart.disabled = !instrCb.checked;
      });

      let timerInterval;

      btnStart.addEventListener("click", async () => {
        btnStart.disabled = true;
        btnStart.textContent = "Starting Test...";

        try {
          if (Array.isArray(questionsData) && questionsData.length > 0) {
            questions = questionsData;
          } else {
            const testIdRaw = slug || testMeta?.id;
            if (!testIdRaw) {
              throw new Error("Test ID is required to start the test.");
            }
            const parsedTestId = typeof testIdRaw === "number" ? testIdRaw : parseInt(testIdRaw, 10);
            if (!parsedTestId || isNaN(parsedTestId)) {
              throw new Error("Invalid Test ID.");
            }

            // Step 1: Create session via POST /api/mocktests/sessions
            const sessionId = await createMockTestSession(parsedTestId);
            if (!sessionId) {
              throw new Error("Failed to create test session.");
            }
            state.sessionId = sessionId;

            // Step 2: Fetch questions using returned session_id
            const qData = await fetchTestWithSession(testIdRaw, sessionId);

            if (!qData || !Array.isArray(qData.questions)) {
              throw new Error("Failed to load test questions.");
            }

            const raw = qData.questions;
            questions = raw.map((q) => ({
              ...q,
              optionsObjects: Array.isArray(q.options) ? q.options : [],
              options: Array.isArray(q.options)
                ? q.options.map((opt) => (typeof opt === 'object' && opt !== null ? opt.text : opt))
                : []
            }));

            const testTitle = qData.title || initialTitle;
            const duration = qData.duration || initialDuration;

            // Update Header and Page title
            document.title = `${testTitle} | Brinto MockTest`;
            const ehTitle = document.getElementById("eh-title");
            if (ehTitle) ehTitle.textContent = testTitle;

            // Update timer state
            state.totalDuration = duration * 60;
            state.timeLeft = duration * 60;
          }

          if (!questions || questions.length === 0) {
            throw new Error("No questions available for this test.");
          }

          sections = [...new Set(questions.map((q) => q.section))];
          state.visited.add(0);

          // Render UI components
          renderSectionTabs();
          renderQuestion();

          // Request Fullscreen Mode
          enterFullscreen();

          // Animate out instruction overlay & restore scrolling
          document.body.style.overflow = "";
          document.documentElement.style.overflow = "";
          instrOverlay.style.transition = "opacity 0.3s";
          instrOverlay.style.opacity = "0";
          setTimeout(() => {
            instrOverlay.style.display = "none";
          }, 300);

          // Start timer NOW
          timerEl.textContent = fmt(state.timeLeft);
          timerInterval = setInterval(() => {
            if (state.submitted) return;
            state.timeLeft--;
            timerEl.textContent = fmt(state.timeLeft);
            if (state.timeLeft <= 300) timerEl.className = "warning";
            if (state.timeLeft <= 60) timerEl.className = "danger";
            if (state.timeLeft <= 0) {
              clearInterval(timerInterval);
              showResults();
            }
          }, 1000);

          // Start tab-switch detection
          startTabDetection();
        } catch (err) {
          console.error("Error starting test session:", err);
          alert("Unable to start test session: " + (err.message || "Network error. Please try again."));
          btnStart.disabled = !instrCb.checked;
          btnStart.textContent = "Start Test →";
        }
      });

      // ─────────────────────────────────────────────
      //  TAB / APP SWITCH DETECTION
      // ─────────────────────────────────────────────
      const tabToast = document.getElementById("tab-toast");
      const toastTitle = document.getElementById("toast-title");
      const toastSub = document.getElementById("toast-sub");
      const toastBadge = document.getElementById("toast-badge");
      const MAX_WARNINGS = 3;
      let violations = 0;
      let toastTimer;

      function showTabWarning() {
        if (state.submitted) return;
        violations++;
        const remaining = MAX_WARNINGS - violations;

        toastTitle.textContent =
          violations === 1
            ? "Tab switch detected!"
            : `Warning ${violations} of ${MAX_WARNINGS}`;

        toastSub.textContent =
          remaining > 0
            ? `Please stay on this tab. ${remaining} more violation${remaining > 1 ? "s" : ""} will auto-submit your test.`
            : "Test is being auto-submitted due to repeated violations.";

        toastBadge.textContent = `${violations} warning${violations > 1 ? "s" : ""}`;
        toastBadge.style.background =
          violations >= MAX_WARNINGS ? "#7B0015" : "var(--brand)";

        // Show toast
        clearTimeout(toastTimer);
        tabToast.classList.add("show");

        // Auto-hide after 4s (unless final warning)
        if (violations < MAX_WARNINGS) {
          toastTimer = setTimeout(
            () => tabToast.classList.remove("show"),
            4000,
          );
        }

        // Auto-submit after max violations
        if (violations >= MAX_WARNINGS) {
          setTimeout(() => {
            tabToast.classList.remove("show");
            showResults();
          }, 2500);
        }
      }

      function startTabDetection() {
        // Page Visibility API — handles tab switch + app switch on mobile
        document.addEventListener("visibilitychange", () => {
          if (document.hidden && !state.submitted) {
            showTabWarning();
          }
        });

        // Window blur — handles switching to another window/app on desktop
        window.addEventListener("blur", () => {
          if (!state.submitted && !document.hidden) {
            showTabWarning();
          }
        });

        // Warn before unload (refresh / back)
        window.addEventListener("beforeunload", (e) => {
          if (!state.submitted) {
            e.preventDefault();
            e.returnValue =
              "Your test is in progress. Leaving will end your session. Are you sure?";
          }
        });
      }

      // ─────────────────────────────────────────────
      //  ANTI-INSPECT & ANTI-COPY SECURITY
      // ─────────────────────────────────────────────
      // Block right click (context menu)
      document.addEventListener("contextmenu", (e) => {
        if (!state.submitted) {
          e.preventDefault();
          return false;
        }
      });

      // Block Developer Tools & Inspect Keyboard Shortcuts
      document.addEventListener("keydown", (e) => {
        if (state.submitted) return;

        // F12
        if (e.key === "F12" || e.keyCode === 123) {
          e.preventDefault();
          return false;
        }

        // Ctrl+Shift+I / J / C (DevTools), Ctrl+U (View Source), Ctrl+S, Ctrl+P
        const isCmdOrCtrl = e.ctrlKey || e.metaKey;
        if (isCmdOrCtrl) {
          const key = e.key.toLowerCase();
          if (
            (e.shiftKey && (key === "i" || key === "j" || key === "c")) ||
            (e.altKey && (key === "i" || key === "j" || key === "c" || key === "u")) ||
            key === "u" ||
            key === "s" ||
            key === "p"
          ) {
            e.preventDefault();
            return false;
          }
        }
      });

      // Block copying & text selection during test
      document.addEventListener("copy", (e) => {
        if (!state.submitted) {
          e.preventDefault();
          return false;
        }
      });

      document.addEventListener("selectstart", (e) => {
        if (!state.submitted) {
          const qPanel = document.getElementById("question-panel");
          if (qPanel && qPanel.contains(e.target)) {
            e.preventDefault();
            return false;
          }
        }
      });

      // ─────────────────────────────────────────────
      //  TIMER ELEMENT (declared early, started on modal close)
      // ─────────────────────────────────────────────
      const timerEl = document.getElementById("timer");
      timerEl.textContent = fmt(state.timeLeft);

      // ─────────────────────────────────────────────
      //  WIRE UP
      // ─────────────────────────────────────────────
      document.getElementById("btn-prev").addEventListener("click", prevQ);
      document.getElementById("btn-next").addEventListener("click", nextQ);
      document.getElementById("btn-prev-mob").addEventListener("click", prevQ);
      document.getElementById("btn-next-mob").addEventListener("click", nextQ);
      document
        .getElementById("btn-mark")
        .addEventListener("click", markForReview);
      document
        .getElementById("btn-mark-mob")
        .addEventListener("click", markForReview);
      document
        .getElementById("btn-clear")
        .addEventListener("click", clearResponse);
      document
        .getElementById("btn-submit-header")
        .addEventListener("click", openSubmitModal);
      document
        .getElementById("btn-cancel-modal")
        .addEventListener("click", closeSubmitModal);
      document
        .getElementById("btn-confirm-submit")
        .addEventListener("click", showResults);
      document.getElementById("submit-modal").addEventListener("click", (e) => {
        if (e.target === e.currentTarget) closeSubmitModal();
      });
      function openSidebar() {
        document.getElementById("sidebar")?.classList.add("open");
        document.getElementById("sidebar-backdrop")?.classList.add("open");
      }

      function closeSidebar() {
        document.getElementById("sidebar")?.classList.remove("open");
        document.getElementById("sidebar-backdrop")?.classList.remove("open");
      }

      function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");
        if (sidebar?.classList.contains("open")) {
          closeSidebar();
        } else {
          openSidebar();
        }
      }

      document
        .getElementById("palette-toggle")
        ?.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleSidebar();
        });

      document
        .getElementById("sidebar-close-btn")
        ?.addEventListener("click", () => {
          closeSidebar();
        });

      document
        .getElementById("sidebar-backdrop")
        ?.addEventListener("click", () => {
          closeSidebar();
        });

      document.addEventListener("click", (e) => {
        const sidebar = document.getElementById("sidebar");
        const paletteToggle = document.getElementById("palette-toggle");
        if (!sidebar || !sidebar.classList.contains("open")) return;
        const target = e.target;
        if (!sidebar.contains(target) && (!paletteToggle || !paletteToggle.contains(target))) {
          closeSidebar();
        }
      });
    </script>
  </body>
</html>
