---
/**
 * GAdRails — sticky ad rails in the empty space beside the page content, with a banner fallback.
 *
 * Usage (anywhere inside the page, e.g. right after the opening <BaseLayout>):
 *   <GAdRails />                                   both sides, 300×600 if it fits, else 160×600
 *   <GAdRails side="right" />                      right rail only
 *   <GAdRails sizes={["160x600"]} />               only the narrow skyscraper
 *   <GAdRails banner={[]} />                       no banner fallback on small screens
 *
 * On load it measures the gap beside the content (.wrap max width) and picks the first size that
 * fits with breathing room. On laptops (~1200–1580px) where the gap is too small, it switches to
 * compact mode: the page content is pushed in to make room (right rail only if two would squeeze
 * the content below 1000px). Where no rail fits — tablets, phones — a banner (728×90, else
 * 320×100) is shown in-flow where <GAdRails /> is placed instead.
 * Rails stay in view while scrolling (below the header) and stop at the end of the page content,
 * so they never cover the footer. In `npm run dev` they show the same dashed placeholder as <GAd>.
 */
import { AD_CLIENT, AD_UNITS, type AdSizeKey } from "../lib/ads";

interface Props {
  side?: "both" | "left" | "right";
  sizes?: AdSizeKey[]; // tried in order, widest first
  banner?: AdSizeKey[]; // fallback when no rail fits, tried in order, widest first
  top?: number; // distance from the top of the screen while scrolling (px)
  label?: boolean;
}

const {
  side = "both",
  sizes = ["300x600", "160x600"],
  banner = ["728x90", "320x100"],
  top = 96,
  label = true,
} = Astro.props;

const toUnits = (keys: AdSizeKey[]) =>
  keys.map((key) => ({ key, ...AD_UNITS[key] })).filter((u) => u.slot);
const units = toUnits(sizes);
const bannerUnits = toUnits(banner);
const sides = side === "both" ? (["left", "right"] as const) : ([side] as const);
const isDev = import.meta.env.DEV;
---

{(units.length > 0 || bannerUnits.length > 0) && (
  <div
    class:list={["gad-rails", { "gad-dev": isDev }]}
    style={`--rail-top:${top}px;`}
    data-units={JSON.stringify(units)}
    data-banner={JSON.stringify(bannerUnits)}
    data-client={AD_CLIENT}
    data-test={isDev ? "on" : undefined}
  >
    {sides.map((s) => (
      <aside class={`gad-rail gad-rail-${s}`} data-side={s} aria-label="Advertisement">
        <div class="gad-rail-inner">
          {(label || isDev) && <span class="gad-label">Advertisement</span>}
          <div class="gad-box">
            {isDev && <span class="gad-dev-info"></span>}
          </div>
        </div>
      </aside>
    ))}
  </div>
  <!-- In-flow banner, shown only where no rail fits -->
  <div class:list={["gad-rails-banner", { "gad-dev": isDev }]} aria-label="Advertisement" hidden>
    {(label || isDev) && <span class="gad-label">Advertisement</span>}
    <div class="gad-box">
      {isDev && <span class="gad-dev-info"></span>}
    </div>
  </div>
)}

<script>
  import { renderAd } from "../lib/adsClient";

  type Unit = { key: string; slot: string; width: number; height: number };
  type Side = "left" | "right";
  type Layout = { sides: Side[]; reserve: number }; // reserve: px of content pushed in on each rail side
  const GAP = 16; // space between the rail and the content, and the screen edge
  const MIN_CONTENT = 1000; // compact mode never squeezes the content narrower than this

  // Viewport width without the scrollbar
  const viewW = () => document.documentElement.clientWidth;

  function maxContent() {
    return parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--maxw")) || 1180;
  }

  // How the rails fit at the current width:
  //  1. in the empty gutters beside the content (wide screens)
  //  2. compact: push the content in to make room on the rail sides (laptops ~1200–1580px)
  //  3. compact, right rail only, when two rails would squeeze the content too much
  function fit(unit: Unit, sides: Side[]): Layout | null {
    const w = viewW();
    const need = unit.width + GAP * 2;
    if ((w - Math.min(w, maxContent())) / 2 >= need) return { sides, reserve: 0 };

    const options = sides.length > 1 ? [sides, ["right"] as Side[]] : [sides];
    for (const s of options) {
      if (w - need * s.length >= MIN_CONTENT) return { sides: s, reserve: need };
    }
    return null;
  }

  function show(box: HTMLElement, unit: Unit, root: HTMLElement) {
    const info = box.querySelector<HTMLElement>(".gad-dev-info");
    if (info) info.textContent = `${unit.width} × ${unit.height} · slot ${unit.slot}`;
    box.style.setProperty("--box-w", `${unit.width}px`);
    box.style.setProperty("--box-h", `${unit.height}px`);
    renderAd(box, unit, root.dataset.client!, root.dataset.test);
  }

  function setup(root: HTMLElement) {
    const units = JSON.parse(root.dataset.units || "[]") as Unit[];
    const bannerUnits = JSON.parse(root.dataset.banner || "[]") as Unit[];
    const banner = root.nextElementSibling as HTMLElement | null;
    const top = parseFloat(getComputedStyle(root).getPropertyValue("--rail-top")) || 96;
    const rails = [...root.querySelectorAll<HTMLElement>(".gad-rail")];
    const sides = rails.map((r) => r.dataset.side as Side);
    const tallEnough = (u: Unit) => u.height + top + 16 <= window.innerHeight;

    // First rail size that fits (widest first); undefined → banner only
    const unit = units.find((u) => tallEnough(u) && fit(u, sides));

    // Rails span the page content so sticky stops before the footer
    const host = root.parentElement;
    if (unit && host && getComputedStyle(host).position === "static") host.style.position = "relative";

    if (unit) {
      root.style.setProperty("--rail-w", `${unit.width}px`);
      root.style.setProperty("--rail-h", `${unit.height}px`);
    }

    const rendered = new Set<HTMLElement>();

    // Re-fit on resize: rails or banner, reserve room for compact mode, centre each rail in its gutter.
    // Each ad is requested only once its slot is first shown.
    const place = () => {
      const layout = unit && tallEnough(unit) ? fit(unit, sides) : null;
      root.classList.toggle("is-on", !!layout);

      for (const rail of rails) {
        const side = rail.dataset.side as Side;
        const on = !!layout && layout.sides.includes(side);
        rail.hidden = !on;
        if (host && unit) host.style.setProperty(`padding-${side}`, on && layout!.reserve ? `${layout!.reserve}px` : "");

        if (on && !rendered.has(rail)) {
          rendered.add(rail);
          show(rail.querySelector<HTMLElement>(".gad-box")!, unit!, root);
        }
      }

      if (banner?.classList.contains("gad-rails-banner")) {
        // Widest banner that fits the screen (with the page's side padding)
        const b = layout ? null : bannerUnits.find((u) => u.width + 32 <= viewW());
        banner.hidden = !b;
        if (b && !rendered.has(banner)) {
          rendered.add(banner);
          show(banner.querySelector<HTMLElement>(".gad-box")!, b, root);
        }
      }

      if (!layout) return;
      const gutter = layout.reserve || (viewW() - Math.min(viewW(), maxContent())) / 2;
      root.style.setProperty("--rail-x", `${Math.max(GAP, (gutter - unit!.width) / 2)}px`);
    };

    place();
    window.addEventListener("resize", place, { passive: true });
  }

  document.querySelectorAll<HTMLElement>(".gad-rails").forEach(setup);
</script>

<style>
  .gad-rails {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .gad-rails.is-on {
    display: block;
  }

  /* Full-height columns; the inner block sticks while scrolling */
  .gad-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--rail-w);
  }

  .gad-rail-left {
    left: var(--rail-x);
  }

  .gad-rail-right {
    right: var(--rail-x);
  }

  .gad-rail-inner {
    position: sticky;
    top: var(--rail-top);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-top: 24px;
    pointer-events: auto;
  }

  /* In-flow banner fallback (tablets, phones) */
  .gad-rails-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin: 16px auto 0;
    padding: 0 16px;
    max-width: 100%;
  }

  .gad-rails-banner[hidden] {
    display: none;
  }

  .gad-label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted, #9ca3af);
  }

  .gad-box {
    width: var(--box-w);
    height: var(--box-h);
    max-width: 100%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    background: var(--surface-2, #f8fafc);
    border-radius: 4px;
  }

  /* Production: hide an ad AdSense couldn't fill */
  .gad-rails:not(.gad-dev) .gad-rail:has(ins[data-ad-status="unfilled"]),
  .gad-rails-banner:not(.gad-dev):has(ins[data-ad-status="unfilled"]) {
    display: none;
  }

  /* Dev placeholder — same look as <GAd> */
  .gad-dev .gad-box {
    position: relative;
    height: var(--box-h) !important;
    border: 1.5px dashed #f59e0b;
    background: repeating-linear-gradient(45deg, #fffbeb, #fffbeb 10px, #fef3c7 10px, #fef3c7 20px);
  }

  .gad-dev .gad-box :global(ins) {
    position: relative;
    z-index: 1;
  }

  .gad-dev-info {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #92400e;
    text-align: center;
  }

  .gad-dev .gad-label {
    color: #b45309;
  }
</style>
