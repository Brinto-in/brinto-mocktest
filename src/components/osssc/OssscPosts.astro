---
// "Posts covered" row — same wide colour tiles as BrowseByExam on the home page.
import { ossscPosts } from "../../data/osssc";
---

<section class="op-section" aria-labelledby="op-title">
  <div class="wrap">
    <div class="op-head">
      <h2 id="op-title" class="op-title">Posts covered</h2>
      <p class="op-note">One combined mock test covers all these posts</p>
    </div>

    <ul class="op-row">
      {ossscPosts.map((p) => (
        <li>
          <a href={p.href} class="op-tile" style={`--tone:${p.color};`}>
            <span class="op-icon" aria-hidden="true">{p.icon}</span>
            <div class="op-text">
              <span class="op-short">{p.short}</span>
              <span class="op-name">{p.name}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .op-section {
    background: var(--surface);
    padding: 16px 0 24px;
  }

  .op-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .op-title {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .op-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .op-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .op-tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-sm);
    overflow: hidden;
    color: #ffffff;
    background:
      radial-gradient(circle at 85% 40%, rgba(255, 255, 255, 0.22), transparent 50%),
      linear-gradient(120deg, color-mix(in srgb, var(--tone) 75%, #000) 0%, var(--tone) 100%);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .op-tile:hover,
  .op-tile:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.18);
  }

  .op-tile:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .op-icon {
    position: absolute;
    right: 4%;
    bottom: -12%;
    font-size: clamp(3rem, 5.5vw, 4.4rem);
    line-height: 1;
    transform: rotate(-8deg);
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.35));
    transition: transform 0.35s ease;
  }

  .op-tile:hover .op-icon {
    transform: rotate(-4deg) scale(1.06);
  }

  .op-text {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    max-width: 68%;
    padding-left: 7%;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .op-short {
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.05;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
  }

  .op-name {
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    font-weight: 500;
    opacity: 0.88;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .op-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .op-row {
      gap: 8px;
    }
    .op-tile {
      aspect-ratio: 16 / 10;
    }
    .op-icon {
      font-size: 2.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .op-tile,
    .op-icon {
      transition: none;
    }
  }
</style>
