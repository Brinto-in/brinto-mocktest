---
// Exam pattern table. Becomes stacked cards on phones.
import Bi from "./Bi.astro";
import V2Head from "./V2Head.astro";
import { v2Stages } from "../../../data/osssc-v2";

interface Props {
  id?: string;
}

const { id = "pattern" } = Astro.props;

const COLS = {
  stage: { en: "Stage", or: "ପର୍ଯ୍ୟାୟ" },
  mode: { en: "Mode", or: "ପ୍ରକାର" },
  questions: { en: "Questions", or: "ପ୍ରଶ୍ନ" },
  marks: { en: "Marks", or: "ମାର୍କ" },
  time: { en: "Time", or: "ସମୟ" },
  negative: { en: "Negative marking", or: "ନେଗେଟିଭ ମାର୍କିଂ" },
};
---

<section id={id} class="ep-section" aria-labelledby="ep-title" data-v2-section>
  <div class="wrap">
    <V2Head
      id="ep-title"
      title={{ en: "Exam pattern – RI, ARI & Amin", or: "ପରୀକ୍ଷା ଢାଞ୍ଚା – RI, ARI ଓ ଆମିନ" }}
      sub={{ en: "How each stage is marked.", or: "ପ୍ରତ୍ୟେକ ପର୍ଯ୍ୟାୟରେ ମାର୍କ କିପରି ଦିଆଯାଏ।" }}
    />

    <div class="ep-table-wrap">
      <table class="ep-table">
        <thead>
          <tr>
            <th scope="col"><Bi t={COLS.stage} /></th>
            <th scope="col"><Bi t={COLS.mode} /></th>
            <th scope="col"><Bi t={COLS.questions} /></th>
            <th scope="col"><Bi t={COLS.marks} /></th>
            <th scope="col"><Bi t={COLS.time} /></th>
            <th scope="col"><Bi t={COLS.negative} /></th>
          </tr>
        </thead>
        <tbody>
          {v2Stages.map((s) => (
            <tr>
              <th scope="row">
                <span class="ep-stage"><Bi t={s.name} /></span>
                <span class="ep-note"><Bi t={s.note} /></span>
              </th>
              <td data-label-en={COLS.mode.en} data-label-or={COLS.mode.or}><Bi t={s.mode} /></td>
              <td data-label-en={COLS.questions.en} data-label-or={COLS.questions.or}>{s.questions}</td>
              <td data-label-en={COLS.marks.en} data-label-or={COLS.marks.or}>{s.marks}</td>
              <td data-label-en={COLS.time.en} data-label-or={COLS.time.or}><Bi t={s.duration} /></td>
              <td data-label-en={COLS.negative.en} data-label-or={COLS.negative.or}><Bi t={s.negative} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="ep-foot">
      <Bi
        t={{
          en: "Based on the last notification. Always confirm with the official OSSSC notification.",
          or: "ଶେଷ ବିଜ୍ଞପ୍ତି ଆଧାରରେ। ସର୍ବଦା ସରକାରୀ OSSSC ବିଜ୍ଞପ୍ତି ସହ ମିଳାଇ ନିଅନ୍ତୁ।",
        }}
      />
    </p>
  </div>
</section>

<style>
  .ep-section {
    padding: 28px 0 12px;
  }

  .ep-table-wrap {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .ep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .ep-table thead th {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-muted);
    background: var(--surface-2, #f9fafb);
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
  }

  .ep-table td,
  .ep-table tbody th {
    text-align: left;
    vertical-align: top;
    padding: 14px 16px;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
  }

  .ep-table tbody tr:last-child > * {
    border-bottom: 0;
  }

  .ep-table td:nth-child(3),
  .ep-table td:nth-child(4) {
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .ep-stage {
    display: block;
    font-weight: 800;
    color: var(--ink);
  }

  .ep-note {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-muted);
    margin-top: 2px;
  }

  .ep-foot {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin: 10px 0 0;
  }

  /* ── Phones: each row becomes a card with labelled values ── */
  @media (max-width: 680px) {
    .ep-section { padding: 20px 0 8px; }

    .ep-table-wrap {
      border: 0;
      border-radius: 0;
      overflow: visible;
    }

    .ep-table thead {
      display: none;
    }

    .ep-table,
    .ep-table tbody,
    .ep-table tr {
      display: block;
    }

    .ep-table tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 12px;
      border: 1px solid var(--rule);
      border-radius: var(--radius-sm);
      padding: 4px 14px 12px;
      margin-bottom: 10px;
    }

    .ep-table tbody th {
      grid-column: 1 / -1;
      padding: 10px 0;
      margin-bottom: 4px;
      border-bottom: 1px solid var(--rule) !important;
    }

    .ep-table td {
      padding: 6px 0;
      border: 0;
    }

    .ep-table td::before {
      display: block;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-bottom: 2px;
    }

    :global(html:not([data-lang="or"])) .ep-table td::before {
      content: attr(data-label-en);
    }

    :global(html[data-lang="or"]) .ep-table td::before {
      content: attr(data-label-or);
      text-transform: none;
    }
  }
</style>
