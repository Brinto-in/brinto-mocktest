---
// OSSSC landing hero: same type and buttons as the home Hero, with a fanned
// stack of the OSSSC posters on the right.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posters = [
  { src: "/images/typing-beginner.png", alt: "OSSSC typing practice for beginners" },
  { src: "/images/osssc-typing.png", alt: "OSSSC typing test" },
  { src: "/images/osssc.png", alt: "OSSSC RI, ICDS, VAW, JA, ARI, Amin mock test 2026" },
];
---

<section class="ox-hero">
  <nav class="wrap ox-crumb" aria-label="Breadcrumb">
    <a href="/mocktest">Home</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">OSSSC</span>
  </nav>

  <div class="wrap ox-hero-inner">
    <div class="ox-hero-text">
      <span class="ox-pill">
        <span class="ox-pill-dot"></span>
        Odisha Sub-ordinate Staff Selection Commission
      </span>

      <h1>
        OSSSC exam prep,<br />
        <em>all in one place.</em>
      </h1>

      <p class="ox-sub">
        Free MCQ mock tests and typing practice for the OSSSC combined recruitment —
        Revenue Inspector, ARI, Amin, ICDS Supervisor, VAW, Junior Assistant and more.
      </p>

      <div class="ox-actions">
        <a href="/mocktest/test/11" class="ox-btn-outline">Computer MCQ →</a>
        <a href="/mocktest/tests/osssc-typing" class="ox-btn-outline">Typing Test</a>
        <a href="/mocktest/osssc/test/11" class="ox-btn-primary">Computer skill test for OSSSC 2026 →</a>
      </div>

      <div class="ox-trust">
        <span>✓ 100% Free</span>
        <span>✓ MCQ + Typing</span>
        <span>✓ Instant results</span>
        <span>✓ Odia + English</span>
      </div>
    </div>

    <div class="ox-stack" aria-hidden="true">
      {posters.map((p, i) => (
        <img
          class={`ox-poster ox-poster-${i}`}
          src={`${base}${p.src}`}
          alt=""
          loading={i === 2 ? "eager" : "lazy"}
          decoding="async"
          onerror="this.remove()"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .ox-hero {
    background:
      radial-gradient(circle at 85% 20%, rgba(176, 0, 32, 0.07), transparent 45%),
      var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 40px 0 48px;
    overflow: hidden;
  }

  .ox-hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: center;
  }

  /* Breadcrumb */
  .ox-crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin-bottom: 18px;
  }

  .ox-crumb a {
    color: var(--ink-soft);
  }

  .ox-crumb a:hover {
    color: var(--brand);
  }

  .ox-crumb [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Pill */
  .ox-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
  }

  .ox-pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand);
  }

  h1 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    color: var(--ink);
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  h1 em {
    color: var(--brand);
  }

  .ox-sub {
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 0 24px;
  }

  /* Buttons — same as home hero */
  .ox-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-bottom: 20px;
  }

  .ox-btn-primary,
  .ox-btn-outline,
  .ox-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    line-height: 1.3;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .ox-btn-primary {
    font-weight: 700;
    color: #ffffff;
    background: var(--brand);
    border: 1.5px solid var(--brand);
    box-shadow: 0 6px 18px rgba(176, 0, 32, 0.2);
  }

  .ox-btn-primary:hover {
    transform: translateY(-1px);
    background: var(--brand-dark);
    border-color: var(--brand-dark);
    box-shadow: 0 10px 24px rgba(176, 0, 32, 0.28);
  }

  .ox-btn-outline,
  .ox-btn-ghost {
    font-weight: 600;
    color: var(--brand);
    background: transparent;
    border: 1.5px solid var(--brand);
  }

  .ox-btn-outline:hover,
  .ox-btn-ghost:hover {
    border-color: var(--brand-dark);
    background: var(--brand-light);
    color: var(--brand-dark);
    transform: translateY(-1px);
  }

  .ox-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  /* Fanned poster stack */
  .ox-stack {
    --w: clamp(150px, 15vw, 210px);
    position: relative;
    height: calc(var(--w) * 1.5 + 40px);
    display: grid;
    place-items: center;
  }

  .ox-poster {
    position: absolute;
    width: var(--w);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.22);
    transition: transform 0.35s ease;
  }

  .ox-poster-0 {
    transform: translateX(-62%) rotate(-10deg) scale(0.9);
  }

  .ox-poster-1 {
    transform: translateX(62%) rotate(10deg) scale(0.9);
  }

  .ox-poster-2 {
    z-index: 2;
    transform: translateY(-6px);
  }

  .ox-stack:hover .ox-poster-0 {
    transform: translateX(-72%) rotate(-13deg) scale(0.9);
  }

  .ox-stack:hover .ox-poster-1 {
    transform: translateX(72%) rotate(13deg) scale(0.9);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .ox-hero {
      padding: 28px 0 36px;
    }
    .ox-hero-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .ox-stack {
      --w: clamp(120px, 32vw, 170px);
      order: -1;
    }
    .ox-crumb {
      margin-bottom: 12px;
    }
  }

  @media (max-width: 640px) {
    .ox-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .ox-btn-primary,
    .ox-btn-outline,
    .ox-btn-ghost {
      width: 100%;
      padding: 13px 20px;
      font-size: 0.92rem;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ox-poster {
      transition: none;
    }
  }
</style>
