---
---

<header class="exam-header">
  <div class="eh-top-row">
    <div class="eh-left">
      <a href="/mocktest" class="eh-brand">
        <img class="logo-desktop" src="/logo.png" alt="Brinto logo" height="28" onerror="this.onerror=null;this.src='/mocktest/logo.png';" />
        <img class="logo-mobile" src="/favicon.png" alt="Brinto icon" height="28" width="28" onerror="this.onerror=null;this.src='/mocktest/favicon.png';" />
      </a>
      <a href="/mocktest/osssc" class="eh-title" id="eh-title">OSSSC Combo</a>
      <span class="eh-badge">MCQ + Typing</span>
    </div>
    <div class="eh-right">
      <button type="button" class="btn-fullscreen" id="btn-fullscreen" title="Enter Fullscreen" aria-label="Enter Fullscreen">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
      <div class="timer-box" title="Remaining time">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="combo-timer">120:00</span>
      </div>
      <button type="button" class="btn-submit-header" id="btn-header-submit">
        <span class="lbl-full">Submit MCQ & Next →</span><span class="lbl-short">Submit →</span>
      </button>
    </div>
  </div>
  <div class="combo-tabs-row">
    <nav class="combo-tabs" aria-label="Combo test progress" id="combo-step-nav">
      <div class="combo-step active" id="step-1">
        <span class="step-num">1</span>
        <span class="step-full">MCQ Test</span>
        <span class="step-short">MCQ</span>
      </div>
      <div class="step-connector" id="conn-1-2"></div>
      <div class="combo-step" id="step-2">
        <span class="step-num">2</span>
        <span class="step-full">Passage 1</span>
        <span class="step-short">P1</span>
      </div>
      <div class="step-connector" id="conn-2-3"></div>
      <div class="combo-step" id="step-3">
        <span class="step-num">3</span>
        <span class="step-full">Passage 2</span>
        <span class="step-short">P2</span>
      </div>
    </nav>
    <div class="result-tabs" id="result-tabs" role="tablist" hidden>
      <button type="button" class="result-tab active" role="tab" data-target="results-view" aria-selected="true">
        <span class="lbl-full">📝 MCQ Result</span><span class="lbl-short">MCQ</span>
      </button>
      <button type="button" class="result-tab" role="tab" data-target="typing-results-view" aria-selected="false">
        <span class="lbl-full">⌨️ Typing Result</span><span class="lbl-short">Typing</span>
      </button>
    </div>
  </div>
</header>
