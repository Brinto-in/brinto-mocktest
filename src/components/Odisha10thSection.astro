---
import SectionHeader from "./SectionHeader.astro";
// Simple static UI component for Odisha 10th Board Students
const subjects = [
  {
    id: 'math',
    icon: '📐',
    badge: 'BSE Class 10',
    title: 'Mathematics (ଗଣିତ)',
    subTitle: 'Quadratic Equations, Trigonometry, Circles, Statistics & Geometry MCQs.',
    tags: ['Algebra', 'Geometry', 'Mensuration'],
    questions: 50,
    duration: 45,
    attempts: '18.4k',
    rating: '4.9',
    href: '/mocktest/odisha-10th-mock-test#subject-math',
    isNew: true,
  },
  {
    id: 'science',
    icon: '🔬',
    badge: 'BSE Class 10',
    title: 'Science (ବିଜ୍ଞାନ)',
    subTitle: 'Physical Science (ଭୌତିକ) & Life Science (ଜୀବ ବିଜ୍ଞାନ) Objective MCQs.',
    tags: ['Physics', 'Chemistry', 'Biology'],
    questions: 50,
    duration: 45,
    attempts: '16.8k',
    rating: '4.8',
    href: '/mocktest/odisha-10th-mock-test#subject-science',
    isNew: false,
  },
  {
    id: 'social',
    icon: '📜',
    badge: 'BSE Class 10',
    title: 'Social Science (ସାମାଜିକ ବିଜ୍ଞାନ)',
    subTitle: 'Indian Freedom Movement, Geography, Constitution & Economics.',
    tags: ['History', 'Geography', 'Civics'],
    questions: 50,
    duration: 40,
    attempts: '14.2k',
    rating: '4.8',
    href: '/mocktest/odisha-10th-mock-test#subject-social',
    isNew: false,
  },
  {
    id: 'odia',
    icon: '📖',
    badge: 'BSE Class 10',
    title: 'Odia Sahitya (ସାହିତ୍ୟ)',
    subTitle: 'Sahitya, Padya, Gadya & Vyakarana (ବ୍ୟାକରଣ) Objective MCQ Practice.',
    tags: ['Sahitya', 'Vyakarana', 'Literature'],
    questions: 50,
    duration: 40,
    attempts: '19.1k',
    rating: '4.9',
    href: '/mocktest/odisha-10th-mock-test#subject-odia',
    isNew: true,
  },
  {
    id: 'english',
    icon: '🇬🇧',
    badge: 'BSE Class 10',
    title: 'English (Second Language)',
    subTitle: 'Grammar, Tenses, Voice Change, Prepositions & Prose Practice.',
    tags: ['Grammar', 'Prose', 'Vocabulary'],
    questions: 50,
    duration: 40,
    attempts: '15.6k',
    rating: '4.7',
    href: '/mocktest/odisha-10th-mock-test#subject-english',
    isNew: false,
  },
  {
    id: 'sanskrit-hindi',
    icon: '🕉️',
    badge: 'BSE Class 10',
    title: 'Sanskrit / Hindi (Third Language)',
    subTitle: 'Sanskrit & Hindi Grammar, Translation & Literature Objective Set.',
    tags: ['Sanskrit', 'Hindi', 'Grammar'],
    questions: 50,
    duration: 40,
    attempts: '11.3k',
    rating: '4.8',
    href: '/mocktest/odisha-10th-mock-test#subject-sanskrit-hindi',
    isNew: false,
  },
];
---

<section class="section odisha-10th-section">
  <div class="wrap">
    <!-- Header -->
    <SectionHeader
      pill="🎓 BSE ODISHA CLASS 10TH (MATRIC)"
      title="Odisha 10th Board Exam Preparation"
      subtitle="Subject-wise objective practice sets, chapter MCQs & model papers tailored for BSE Odisha Class 10th Matriculation Board exams."
      seeAllHref="/mocktest/odisha-10th-mock-test"
      seeAllText="View all 10th tests →"
    />

    <!-- Subject Grid -->
    <div class="o10-grid">
      {subjects.slice(0, 3).map((s) => (
        <a href={s.href} class="o10-card">
          <div class="o10-card-top">
            <div class="o10-card-icon-title">
              <span class="o10-icon">{s.icon}</span>
              <div>
                <span class="o10-badge">{s.badge}</span>
                <h3 class="o10-card-title">{s.title}</h3>
              </div>
            </div>
            {s.isNew && <span class="o10-tag-new">New</span>}
          </div>

          <p class="o10-card-desc">{s.subTitle}</p>

          <div class="o10-tags">
            {s.tags.map((tag) => (
              <span class="o10-tag">{tag}</span>
            ))}
          </div>

          <div class="o10-card-footer">
            <span class="o10-free-badge">100% Free</span>
            <span class="o10-cta">Start Practice →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Feature Highlight Banner -->
    <div class="o10-feature-banner">
      <div class="o10-feature-item">
        <span class="o10-feat-icon">🎯</span>
        <div>
          <strong>50% MCQ Pattern</strong>
          <p>Strictly based on latest BSE Odisha 50-mark objective exam format.</p>
        </div>
      </div>
      <div class="o10-feature-divider"></div>
      <div class="o10-feature-item">
        <span class="o10-feat-icon">⚡</span>
        <div>
          <strong>Instant Score & Rank</strong>
          <p>Get immediate answer key with complete explanations in Odia & English.</p>
        </div>
      </div>
      <div class="o10-feature-divider"></div>
      <div class="o10-feature-item">
        <span class="o10-feat-icon">📚</span>
        <div>
          <strong>Complete Syllabus Covered</strong>
          <p>All 6 compulsory subjects with chapter-wise objective sets.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .odisha-10th-section {
    background: #ffffff;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 48px 0;
  }

  /* Header */
  .o10-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    gap: 24px;
  }

  .o10-header-info {
    max-width: 680px;
  }

  .o10-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--brand);
    background: var(--brand-light);
    border: 1px solid var(--brand-mid);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    margin-bottom: 8px;
  }

  .o10-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    display: inline-block;
  }

  .o10-header h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    color: var(--ink);
    margin-bottom: 6px;
  }

  .o10-sub {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .o10-see-all {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--brand);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--brand-mid);
    background: var(--surface);
    transition: all 0.15s ease;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(176, 0, 32, 0.05);
  }

  .o10-see-all:hover {
    background: var(--brand);
    color: #ffffff;
    border-color: var(--brand);
  }

  /* Grid */
  .o10-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .o10-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.2s ease;
    position: relative;
  }

  .o10-card:hover {
    border-color: var(--brand);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(176, 0, 32, 0.1);
  }

  .o10-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .o10-card-icon-title {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .o10-icon {
    font-size: 1.5rem;
    line-height: 1;
    background: #fff5f6;
    padding: 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--brand-mid);
    flex-shrink: 0;
  }

  .o10-badge {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 2px;
  }

  .o10-card-title {
    font-size: 1rem;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1.3;
  }

  .o10-tag-new {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .o10-card-desc {
    font-size: 0.84rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .o10-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .o10-tag {
    font-size: 0.7rem;
    color: var(--ink-soft);
    background: #f8fafc;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
  }


  .o10-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }

  .o10-free-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    background: var(--gold-light);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .o10-cta {
    font-weight: 700;
    color: var(--brand);
    font-size: 0.85rem;
    transition: transform 0.15s ease;
  }

  .o10-card:hover .o10-cta {
    transform: translateX(3px);
  }

  /* Feature Banner */
  .o10-feature-banner {
    background: var(--surface);
    border: 1px solid var(--brand-mid);
    border-radius: var(--radius-md);
    padding: 16px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 4px 16px rgba(176, 0, 32, 0.04);
  }

  .o10-feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .o10-feat-icon {
    font-size: 1.4rem;
    background: var(--brand-light);
    padding: 8px;
    border-radius: 50%;
    line-height: 1;
    flex-shrink: 0;
  }

  .o10-feature-item strong {
    display: block;
    font-size: 0.88rem;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .o10-feature-item p {
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .o10-feature-divider {
    width: 1px;
    height: 32px;
    background: var(--rule);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .o10-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .o10-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .o10-feature-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px;
    }

    .o10-feature-divider {
      width: 100%;
      height: 1px;
    }
  }

  @media (max-width: 600px) {
    .o10-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
