---
const year = new Date().getFullYear();
const links = {
  'Tests': [
    { href: '/mocktest/osssc', label: 'OSSSC' },
    { href: '/mocktest/tests/opsc', label: 'OPSC', comingSoon: true },
    { href: '/mocktest/tests/ssc', label: 'SSC', comingSoon: true },
    { href: '/mocktest/tests/railway', label: 'Railway', comingSoon: true },
    { href: '/mocktest/tests/banking', label: 'Banking', comingSoon: true },
  ],
  'Platform': [
    { href: '/mocktest/results', label: 'My Results' },
  ],
  'Brinto': [
    { href: 'https://brinto.in', label: 'Main Site' },
    { href: 'https://blogs.brinto.in', label: 'Blog' },
    { href: 'https://www.brinto.in/contact', label: 'Contact' },
  ],
};
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a href="/mocktest" class="brand" aria-label="Brinto MockTest home">
        <img
          src="/logo.png"
          alt="Brinto MockTest logo"
          height="36"
          class="logo-mark"
          onerror="this.onerror=null;this.src='/mocktest/logo.png';"
        />
      </a>
      <p>Free mock tests for government job aspirants. Prepare smarter with timed tests, instant analysis, and rank tracking.</p>
    </div>

    {Object.entries(links).map(([group, items]) => (
      <div class="footer-col">
        <h3>{group}</h3>
        <ul>
          {items.map(item => (
            <li>
              <a
                href={item.comingSoon ? undefined : item.href}
                style={item.comingSoon ? 'pointer-events: none; opacity: 0.6;' : undefined}
              >
                {item.label}
                {item.comingSoon && <span class="footer-soon-badge">Soon</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom wrap">
    <span>© {year} Novagenix Lab. All rights reserved.</span>
    <span class="footer-bottom-links">
      <a href="https://www.brinto.in/privacy">Privacy</a>
      <a href="https://www.brinto.in/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255,255,255,0.7);
    margin-top: 40px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding: 56px 24px 40px;
  }
  .brand {
    display: inline-block;
    margin-bottom: 14px;
  }
  .logo-mark {
    height: 36px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    display: block;
  }
  .footer-brand p {
    font-size: 0.88rem;
    line-height: 1.7;
    max-width: 28ch;
    color: rgba(255,255,255,0.55);
  }
  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 14px;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  a { font-size: 0.9rem; color: rgba(255,255,255,0.65); transition: color 0.15s; }
  a:hover { color: #fff; }
  .footer-soon-badge {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 1px 5px;
    border-radius: 999px;
    margin-left: 6px;
    vertical-align: middle;
    letter-spacing: 0.03em;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }
  .footer-bottom-links { display: flex; gap: 20px; }
  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
  }
</style>
