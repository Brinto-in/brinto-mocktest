---
/**
 * BeginnerTypingTest — keybr-style adaptive typing practice.
 * Words are generated in the browser from the letters you've unlocked,
 * weighted toward your weakest key. Progress is saved in localStorage.
 */
interface Props {
  title?: string;
  wpmGoal?: number;
  lessonLength?: number;
}
const {
  title = "Beginner Typing Practice",
  wpmGoal = 20,
  lessonLength = 25,
} = Astro.props;
---

<div class="btt" data-goal={wpmGoal} data-len={lessonLength}>
  <header class="btt-hd">
    <div class="btt-hd-l">
      <span class="btt-badge">🌱 Adaptive</span>
      <h1>{title}</h1>
    </div>
    <div class="btt-chip"><b data-r="wpm">0</b><small>WPM</small></div>
  </header>

  <div class="btt-prog">
    <div class="btt-bar"><i data-r="bar"></i></div>
    <span data-r="count">0 / {lessonLength}</span>
  </div>

  <section class="btt-keys-wrap" aria-label="Your keys">
    <div class="btt-keys" data-r="keys"></div>
    <p class="btt-keys-note">
      Colour = your speed per key. The outlined key is your weakest — practised
      most.
      <button type="button" data-r="forget">Reset progress</button>
    </p>
  </section>

  <div class="btt-body">
    <p class="btt-hint">Type this word ↓</p>
    <div class="btt-word" data-r="word">–</div>
    <input
      class="btt-input"
      data-r="input"
      type="text"
      placeholder="Start typing…"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Type the word shown above"
      disabled
    />

    <div class="btt-overlay" data-r="idle">
      <div class="btt-card">
        <div class="btt-emoji">⌨️</div>
        <h2>Ready to practise?</h2>
        <p>
          Type each word. It advances automatically when it's correct — fix
          mistakes with Backspace.
        </p>
        <button type="button" class="btt-btn" data-r="start"
          >Start Lesson</button
        >
      </div>
    </div>
  </div>

  <footer class="btt-ft">
    <div class="btt-stats">
      <span><b class="btt-err" data-r="errors">0</b> Errors</span>
      <span><b data-r="acc">100%</b> Accuracy</span>
    </div>
    <p class="btt-tip">💡 <span data-r="tip"></span></p>
  </footer>

  <div class="btt-overlay btt-result" data-r="result" hidden role="dialog">
    <div class="btt-card">
      <div class="btt-emoji" data-r="emoji">🎉</div>
      <h2 data-r="title">Lesson complete!</h2>
      <p data-r="sub"></p>
      <div class="btt-res">
        <div class="btt-res-main">
          <b data-r="r-wpm">0</b><small>WPM</small>
        </div>
        <div><b data-r="r-acc">100%</b><small>Accuracy</small></div>
        <div><b data-r="r-err">0</b><small>Errors</small></div>
      </div>
      <div class="btt-actions">
        <button type="button" class="btt-btn" data-r="next"
          >Next Lesson →</button
        >
        <a href="/mocktest/tests/osssc-typing" class="btt-btn btt-ghost"
          >Full Test</a
        >
      </div>
    </div>
  </div>
</div>

<script>
  import {
    ORDER,
    fresh,
    load,
    save,
    record,
    makeWords,
    maybeUnlock,
    confidence,
    focusLetter,
  } from "../lib/adaptive";
  import dict from "../data/words.json";

  const TIPS = [
    "Keep all 10 fingers on the keyboard.",
    "Look at the screen, not your hands.",
    "Home row: A S D F — J K L ;",
    "Accuracy first, speed follows.",
    "Sit straight; relax your shoulders.",
    "Short daily sessions beat long ones.",
  ];

  const root = document.querySelector<HTMLElement>(".btt")!;
  const goal = +root.dataset.goal!;
  const len = +root.dataset.len!;
  const $ = <T extends HTMLElement = HTMLElement>(n: string) =>
    root.querySelector<T>(`[data-r="${n}"]`)!;

  const input = $<HTMLInputElement>("input");
  const wordEl = $("word");
  const keysEl = $("keys");
  const idleEl = $("idle");
  const resultEl = $("result");

  let store = load();
  let words: string[] = [];
  let idx = 0,
    typed = 0,
    errors = 0,
    t0 = 0,
    last = 0,
    prevLen = 0,
    tip = 0,
    running = false;

  const wpm = () =>
    t0
      ? Math.round(
          (typed - errors) /
            5 /
            (Math.max(performance.now() - t0, 2000) / 60000),
        )
      : 0;
  const acc = () =>
    typed ? Math.round(((typed - errors) / typed) * 100) : 100;

  function paintWord(v: string) {
    wordEl.innerHTML = [...words[idx]]
      .map(
        (c, i) =>
          `<span${i < v.length ? ` class="${v[i] === c ? "ok" : "bad"}"` : ""}>${c}</span>`,
      )
      .join("");
  }

  function paintKeys() {
    const focus = focusLetter(store, goal);
    keysEl.innerHTML = ORDER.map((c, i) => {
      const q = confidence(store, c, goal);
      const open = i < store.unlocked;
      const cls = !open ? "off" : q === null ? "new" : "";
      const hue = q === null ? 0 : Math.round(Math.min(q, 1) * 120);
      return `<span class="k ${cls}${open && c === focus ? " focus" : ""}" style="--c:${hue}">${c}</span>`;
    }).join("");
  }

  function draw() {
    $("wpm").textContent = String(wpm());
    $("errors").textContent = String(errors);
    $("acc").textContent = `${acc()}%`;
    $("count").textContent = `${idx} / ${len}`;
    $("bar").style.width = `${(idx / len) * 100}%`;
  }

  function begin() {
    words = makeWords(store, dict, goal, len);
    idx = typed = errors = t0 = last = prevLen = 0;
    input.value = "";
    input.disabled = false;
    idleEl.hidden = resultEl.hidden = true;
    $("tip").textContent = TIPS[tip++ % TIPS.length];
    running = true;
    paintWord("");
    paintKeys();
    draw();
    input.focus();
  }

  function finish() {
    running = false;
    input.disabled = true;
    draw();
    const w = wpm(),
      a = acc();
    const unlocked = maybeUnlock(store, goal);
    save(store);
    paintKeys();
    const pass = w >= goal && a >= 90;
    $("emoji").textContent = unlocked ? "🔓" : pass ? "🏆" : "💪";
    $("title").textContent = unlocked
      ? `Letter "${unlocked.toUpperCase()}" unlocked!`
      : pass
        ? "On target!"
        : "Keep going!";
    $("sub").textContent = unlocked
      ? "Every key reached your goal speed. A new letter joins the next lesson."
      : `Next lesson focuses on "${focusLetter(store, goal).toUpperCase()}". Reach ${goal} WPM on every key to unlock more letters.`;
    $("r-wpm").textContent = String(w);
    $("r-acc").textContent = `${a}%`;
    $("r-err").textContent = String(errors);
    resultEl.hidden = false;
    $("next").focus();
  }

  input.addEventListener("input", () => {
    if (!running) return;
    const v = (input.value = input.value.replace(/\s/g, ""));
    const target = words[idx];

    if (v.length > prevLen) {
      const i = v.length - 1;
      const now = performance.now();
      const ok = v[i] === target[i];
      t0 ||= now;
      if (target[i]) record(store, target[i], last ? now - last : null, ok);
      typed++;
      if (!ok) errors++;
      last = now;
    }
    prevLen = v.length;

    if (v === target) {
      input.value = "";
      prevLen = 0;
      if (++idx === words.length) return finish();
    }
    paintWord(input.value);
    draw();
  });

  input.addEventListener("paste", (e) => e.preventDefault());
  $("start").addEventListener("click", begin);
  $("next").addEventListener("click", begin);
  $("forget").addEventListener("click", () => {
    store = fresh();
    save(store);
    paintKeys();
  });

  $("tip").textContent = TIPS[0];
  paintKeys();
  draw();
</script>

<style>
  .btt {
    --g: #16a34a;
    --r: #dc2626;
    --brand: #16a34a;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    overflow: hidden;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md, 14px);
    font-family: var(--font-body, sans-serif);
  }
  .btt [hidden] {
    display: none !important;
  }

  /* Header */
  .btt-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--rule);
  }
  .btt-hd-l {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .btt-hd h1 {
    margin: 0;
    font-size: clamp(0.9rem, 1.8vw, 1.1rem);
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .btt-badge {
    flex-shrink: 0;
    padding: 3px 9px;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .btt-chip {
    display: flex;
    align-items: baseline;
    gap: 4px;
    flex-shrink: 0;
    padding: 4px 12px;
    border-radius: 20px;
    background: var(--surface-2);
    border: 1px solid var(--rule);
  }
  .btt-chip b {
    font-size: 0.95rem;
  }
  .btt small {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* Progress */
  .btt-prog {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .btt-bar {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--rule);
  }
  .btt-bar i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--g);
    transition: width 0.25s ease;
  }

  /* Key grid */
  .btt-keys-wrap {
    padding: 14px 16px 4px;
    text-align: center;
  }
  .btt-keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
  }
  .btt-keys :global(.k) {
    width: 30px;
    line-height: 30px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    background: hsl(var(--c) 70% 88%);
    color: hsl(var(--c) 60% 25%);
    border: 1px solid hsl(var(--c) 50% 75%);
  }
  .btt-keys :global(.new) {
    background: var(--surface-2);
    color: var(--ink);
    border-color: var(--rule);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .btt-keys :global(.off) {
    background: var(--surface-2);
    color: var(--ink-soft);
    opacity: 0.35;
    border-color: transparent;
  }
  .btt-keys :global(.focus) {
    outline: 2px solid #16a34a;
    outline-offset: 1px;
    box-shadow: 0 0 0 3px color-mix(in srgb, #16a34a 22%, transparent);
  }
  .btt-keys-note {
    margin: 8px 0 0;
    font-size: 0.72rem;
    color: var(--ink-soft);
  }
  .btt-keys-note button {
    margin-left: 6px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    color: #16a34a;
    text-decoration: underline;
  }

  /* Body */
  .btt-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 20px 24px;
  }
  .btt-hint {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .btt-word {
    min-width: 160px;
    padding: 14px 34px;
    text-align: center;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    background: var(--surface-2);
    border: 2px solid var(--rule);
    border-radius: 12px;
    color: var(--ink);
  }
  .btt-word :global(.ok) {
    color: var(--g);
  }
  .btt-word :global(.bad) {
    color: var(--r);
    background: rgba(220, 38, 38, 0.12);
    border-radius: 4px;
  }
  .btt-input {
    width: 100%;
    max-width: 380px;
    padding: 15px 20px;
    box-sizing: border-box;
    text-align: center;
    font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, Monaco, Consolas, monospace;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0f172a;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    outline: none;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btt-input::placeholder {
    color: #94a3b8;
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }
  .btt-input:focus {
    border-color: #16a34a;
    background: #ffffff;
    color: #0f172a;
    box-shadow:
      0 0 20px rgba(22, 163, 74, 0.2),
      0 0 0 3px rgba(22, 163, 74, 0.12);
    transform: translateY(-1px);
  }
  .btt-input:disabled {
    background: var(--surface-2);
    color: var(--ink-soft);
    border-color: var(--rule);
    box-shadow: none;
    cursor: not-allowed;
  }

  /* Overlays (start + result) */
  .btt-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    backdrop-filter: blur(4px);
  }
  .btt-card {
    width: 100%;
    max-width: 380px;
    text-align: center;
  }
  .btt-card h2 {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 800;
  }
  .btt-card p {
    margin: 0 0 18px;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .btt-emoji {
    margin-bottom: 8px;
    font-size: 3rem;
  }
  .btt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 12px 24px;
    border: 1px solid transparent;
    border-radius: 10px;
    cursor: pointer;
    font: 700 0.95rem var(--font-body, sans-serif);
    text-decoration: none;
    background: var(--g);
    color: #fff;
    transition:
      transform 0.1s,
      opacity 0.15s;
  }
  .btt-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }
  .btt-ghost {
    background: var(--surface-2);
    color: var(--ink-soft);
    border-color: var(--rule);
  }
  .btt-actions {
    display: flex;
    gap: 10px;
  }

  .btt-res {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 18px;
  }
  .btt-res div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 12px 6px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--rule);
  }
  .btt-res b {
    font-size: 1.3rem;
    line-height: 1;
  }
  .btt-res-main {
    background: #f0fdf4 !important;
    border-color: #86efac !important;
  }
  .btt-res-main b {
    color: var(--g);
  }

  /* Footer */
  .btt-ft {
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
  }
  .btt-stats {
    display: flex;
    justify-content: center;
    gap: 28px;
    padding: 8px 20px;
    font-size: 0.7rem;
    color: var(--ink-soft);
  }
  .btt-stats b {
    margin-right: 3px;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .btt-stats .btt-err {
    color: var(--r);
  }
  .btt-tip {
    margin: 0;
    padding: 8px 20px;
    font-size: 0.78rem;
    background: #fffbeb;
    border-top: 1px solid #fde68a;
    color: #92400e;
  }

  @media (max-width: 480px) {
    .btt {
      min-height: 480px;
      border-radius: 8px;
    }
    .btt-hd {
      padding: 11px 14px;
    }
    .btt-prog {
      padding: 8px 14px;
    }
    .btt-body {
      padding: 14px 12px;
    }
    .btt-keys :global(.k) {
      width: 26px;
      line-height: 26px;
      font-size: 0.78rem;
    }
    .btt-actions {
      flex-direction: column;
    }
  }
  @media (max-height: 500px) and (orientation: landscape) {
    .btt {
      min-height: 100dvh;
      border-radius: 0;
    }
    .btt-keys-wrap,
    .btt-tip,
    .btt-hint {
      display: none;
    }
  }
</style>
