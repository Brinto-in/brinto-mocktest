---
/**
 * BeginnerTypingTest — word-by-word typing practice for absolute beginners.
 *
 * Differences from TypingTest:
 *  - Word-by-word mode: type one word then Space/Enter to advance
 *  - Visible, large input box (not hidden)
 *  - "Type this word" spotlight panel
 *  - Encouraging messages after each word
 *  - Rotating typing tips
 *  - No hard time pressure (generous 15 min)
 *  - Lower WPM target (20 WPM)
 */

export interface Props {
  testId?: string;
  title?: string;
  words?: string[];      // pass custom word list, or leave empty for built-in set
  duration?: number;     // seconds (default 900 = 15 min)
  wpmGoal?: number;
}

const {
  testId = "btt",
  title = "Beginner Typing Practice",
  words,
  duration = 900,
  wpmGoal = 20,
} = Astro.props;

const defaultWords = [
  // Level 1 — home row
  "fall","ask","has","flag","glad","flask","half","last","hall","slag",
  // Level 2 — common short words
  "the","and","for","are","but","not","you","all","can","her",
  "was","one","our","out","day","get","has","him","his","how",
  // Level 3 — slightly longer
  "time","year","good","just","know","take","than","them","then","this",
  "from","have","into","life","look","make","most","over","said","some",
  // Level 4 — real sentences
  "practice","keyboard","typing","speed","accuracy","finger","improve",
  "regular","effort","focus","skills","achieve","target","success",
];

const wordList = words ?? defaultWords;
const tips = [
  "🖐️ Keep all 10 fingers on the keyboard.",
  "👀 Look at the screen, not your hands.",
  "🪑 Sit up straight — good posture reduces fatigue.",
  "🏠 Home row: left hand on A S D F, right on J K L ;",
  "⏱️ Accuracy first, speed will follow naturally.",
  "🤏 Curl your fingers gently over the keys.",
  "↩️ Use your right pinky finger for the Enter key.",
  "🚫 Don't look at the keyboard while typing.",
  "🔁 Short daily sessions beat long occasional ones.",
  "💪 Even 15 minutes a day builds real speed fast.",
];
---

<div
  id={testId}
  class="btt-root"
  data-words={JSON.stringify(wordList)}
  data-duration={duration}
  data-wpm-goal={wpmGoal}
>
  <!-- ── Header ── -->
  <div class="btt-header">
    <div class="btt-header-left">
      <span class="btt-badge">🌱 Beginner</span>
      <h1 class="btt-title">{title}</h1>
    </div>
    <div class="btt-header-right">
      <div class="btt-stat-chip">
        <span class="btt-chip-val" id={`${testId}-wpm`}>0</span>
        <span class="btt-chip-lbl">WPM</span>
      </div>
      <div class="btt-timer-wrap" id={`${testId}-timer`}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id={`${testId}-timer-val`}>--:--</span>
      </div>
    </div>
  </div>

  <!-- ── Progress bar ── -->
  <div class="btt-prog-track">
    <div class="btt-prog-fill" id={`${testId}-bar`}></div>
    <span class="btt-prog-label" id={`${testId}-prog-label`}>0 / {wordList.length} words</span>
  </div>

  <!-- ── Main area ── -->
  <div class="btt-body">

    <!-- Word spotlight -->
    <div class="btt-spotlight-wrap">
      <p class="btt-spotlight-hint">Type this word ↓</p>
      <div class="btt-spotlight" id={`${testId}-spotlight`}>
        <span class="btt-spot-word" id={`${testId}-spot-word`}>–</span>
      </div>
    </div>

    <!-- Context passage strip -->
    <div class="btt-context" id={`${testId}-context`} aria-label="Word list preview"></div>

    <!-- Input area -->
    <div class="btt-input-wrap">
      <input
        type="text"
        class="btt-input"
        id={`${testId}-input`}
        placeholder="Start typing the word above…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        disabled
        aria-label="Type the word shown above"
      />
      <span class="btt-input-icon" id={`${testId}-input-icon`}>→</span>
    </div>

    <!-- Encouraging toast -->
    <div class="btt-toast" id={`${testId}-toast`} aria-live="polite"></div>

    <!-- Idle / start state -->
    <div class="btt-idle" id={`${testId}-idle`}>
      <div class="btt-idle-inner">
        <div class="btt-idle-emoji">⌨️</div>
        <h2>Ready to practise?</h2>
        <p>Type the highlighted word, then press <kbd>Space</kbd> or <kbd>Enter</kbd> to move on.</p>
        <button class="btt-start-btn" id={`${testId}-start`}>Start Practice</button>
        <p class="btt-idle-sub">No pressure — take your time</p>
      </div>
    </div>
  </div>

  <!-- ── Bottom strip: stats + tip ── -->
  <div class="btt-footer">
    <div class="btt-foostats">
      <div class="btt-fstat">
        <span class="btt-fstat-val btt-correct-val" id={`${testId}-correct`}>0</span>
        <span class="btt-fstat-lbl">Correct</span>
      </div>
      <div class="btt-fstat-sep"></div>
      <div class="btt-fstat">
        <span class="btt-fstat-val btt-err-val" id={`${testId}-errors`}>0</span>
        <span class="btt-fstat-lbl">Errors</span>
      </div>
      <div class="btt-fstat-sep"></div>
      <div class="btt-fstat">
        <span class="btt-fstat-val" id={`${testId}-acc`}>100%</span>
        <span class="btt-fstat-lbl">Accuracy</span>
      </div>
    </div>
    <div class="btt-tip-strip" id={`${testId}-tip`}>
      <span class="btt-tip-icon">💡</span>
      <span class="btt-tip-text" id={`${testId}-tip-text`}>{tips[0]}</span>
    </div>
  </div>

  <!-- ── Result overlay ── -->
  <div class="btt-result" id={`${testId}-result`} style="display:none" role="dialog">
    <div class="btt-result-card">
      <div class="btt-res-emoji" id={`${testId}-res-emoji`}>🎉</div>
      <h2 class="btt-res-title" id={`${testId}-res-title`}>Session Complete!</h2>
      <p  class="btt-res-sub"   id={`${testId}-res-sub`}></p>
      <div class="btt-res-grid">
        <div class="btt-rstat btt-rstat-wpm">
          <span class="btt-rstat-val" id={`${testId}-res-wpm`}>0</span>
          <span class="btt-rstat-lbl">WPM</span>
        </div>
        <div class="btt-rstat">
          <span class="btt-rstat-val" id={`${testId}-res-acc`}>100%</span>
          <span class="btt-rstat-lbl">Accuracy</span>
        </div>
        <div class="btt-rstat">
          <span class="btt-rstat-val btt-correct-val" id={`${testId}-res-correct`}>0</span>
          <span class="btt-rstat-lbl">Correct</span>
        </div>
        <div class="btt-rstat">
          <span class="btt-rstat-val btt-err-val" id={`${testId}-res-errors`}>0</span>
          <span class="btt-rstat-lbl">Errors</span>
        </div>
      </div>
      <!-- Stars -->
      <div class="btt-stars" id={`${testId}-stars`}></div>
      <div class="btt-res-actions">
        <button class="btt-res-btn btt-res-primary" id={`${testId}-retry`}>↺ Try Again</button>
        <a href="/mocktest/tests/osssc-typing" class="btt-res-btn btt-res-ghost">Try Full Test →</a>
      </div>
    </div>
  </div>
</div>

<script>
(() => {
  document.querySelectorAll<HTMLElement>('.btt-root').forEach(init);

  const praises = [
    '✅ Nice!','🎯 Spot on!','⚡ Fast!','🔥 Great!','💪 Nailed it!',
    '✨ Perfect!','🚀 Go!','👏 Yes!','💫 Super!','🌟 Wow!',
  ];
  const tips = [
    '🖐️ Keep all 10 fingers on the keyboard.',
    '👀 Look at the screen, not your hands.',
    '🪑 Sit straight — good posture reduces fatigue.',
    '🏠 Home row: A S D F | J K L ;',
    '⏱️ Accuracy first, speed will follow.',
    '🤏 Curl fingers gently over the keys.',
    '↩️ Right pinky for Enter/Shift keys.',
    '🚫 Never look at the keyboard while typing.',
    '🔁 Short daily sessions build real speed.',
    '💪 15 minutes a day is all it takes.',
  ];

  function init(root: HTMLElement) {
    const id       = root.id;
    const words    = JSON.parse(root.dataset.words ?? '[]') as string[];
    const dur      = parseInt(root.dataset.duration  ?? '900', 10);
    const goal     = parseInt(root.dataset.wpmGoal   ?? '20',  10);

    // refs
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const spotWord   = $(`#${id}-spot-word`);
    const contextEl  = $(`#${id}-context`);
    const inputEl    = root.querySelector<HTMLInputElement>(`#${id}-input`)!;
    const inputIcon  = $(`#${id}-input-icon`);
    const idleEl     = $(`#${id}-idle`);
    const timerVal   = $(`#${id}-timer-val`);
    const timerWrap  = $(`#${id}-timer`);
    const wpmEl      = $(`#${id}-wpm`);
    const barEl      = $(`#${id}-bar`);
    const progLabel  = $(`#${id}-prog-label`);
    const correctEl  = $(`#${id}-correct`);
    const errorsEl   = $(`#${id}-errors`);
    const accEl      = $(`#${id}-acc`);
    const toastEl    = $(`#${id}-toast`);
    const resultEl   = $(`#${id}-result`);
    const startBtn   = root.querySelector<HTMLButtonElement>(`#${id}-start`)!;
    const retryBtn   = root.querySelector<HTMLButtonElement>(`#${id}-retry`)!;
    const tipText    = $(`#${id}-tip-text`);
    const resEmoji   = $(`#${id}-res-emoji`);
    const resTitle   = $(`#${id}-res-title`);
    const resSub     = $(`#${id}-res-sub`);
    const resWpm     = $(`#${id}-res-wpm`);
    const resAcc     = $(`#${id}-res-acc`);
    const resCorrect = $(`#${id}-res-correct`);
    const resErrors  = $(`#${id}-res-errors`);
    const starsEl    = $(`#${id}-stars`);

    // state
    let state: 'idle'|'running'|'finished' = 'idle';
    let wordIdx = 0, correct = 0, errors = 0;
    let startTime = 0, remaining = dur, raf = 0;
    let toastTimer = 0, tipTimer = 0, tipIdx = 0;
    let wordErrors: Record<number, boolean> = {};

    // ── helpers ──
    function fmt(s: number) {
      return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(Math.floor(s%60)).padStart(2,'0')}`;
    }
    function wpm() {
      if (!startTime) return 0;
      const m = (Date.now() - startTime) / 60000;
      return m > 0 ? Math.round((correct / 5) / m) : 0;
    }
    function accuracy() {
      const t = correct + errors;
      return t === 0 ? 100 : Math.round((correct / t) * 100);
    }

    // ── Build context ──
    function buildContext() {
      contextEl.innerHTML = '';
      const start = Math.max(0, wordIdx - 4);
      const end   = Math.min(words.length, wordIdx + 8);
      words.slice(start, end).forEach((w, i) => {
        const abs = start + i;
        const sp = document.createElement('span');
        sp.textContent = w;
        sp.className = 'btt-ctx-word';
        if (abs < wordIdx)  sp.classList.add('btt-ctx-done');
        if (abs === wordIdx) sp.classList.add('btt-ctx-cur');
        if (abs > wordIdx)  sp.classList.add('btt-ctx-next');
        contextEl.appendChild(sp);
        if (abs < end - 1) {
          const sep = document.createElement('span');
          sep.textContent = ' '; sep.className = 'btt-ctx-sep';
          contextEl.appendChild(sep);
        }
      });
    }

    // ── Draw stats ──
    function draw() {
      const w = wpm(), a = accuracy();
      const pct = Math.round((wordIdx / words.length) * 100);
      if (state === 'running') remaining = Math.max(0, dur - (Date.now() - startTime) / 1000);

      wpmEl.textContent     = String(w);
      correctEl.textContent = String(correct);
      errorsEl.textContent  = String(errors);
      accEl.textContent     = `${a}%`;
      barEl.style.width     = `${pct}%`;
      progLabel.textContent = `${wordIdx} / ${words.length} words`;
      timerVal.textContent  = fmt(remaining);
      timerWrap.classList.toggle('btt-warn',   remaining < 120 && remaining >= 60);
      timerWrap.classList.toggle('btt-danger', remaining < 60);
    }

    function tick() {
      if (state !== 'running') return;
      draw();
      if (remaining <= 0) finish();
      else raf = requestAnimationFrame(tick);
    }

    // ── Set current word ──
    function setCurrent() {
      if (wordIdx >= words.length) { finish(); return; }
      const w = words[wordIdx];
      spotWord.textContent = w;
      spotWord.className = 'btt-spot-word';
      inputEl.value = '';
      inputEl.placeholder = `type "${w}" here…`;
      inputIcon.textContent = '→';
      inputEl.className = 'btt-input';
      buildContext();
    }

    // ── Toast ──
    function toast(msg: string) {
      clearTimeout(toastTimer);
      toastEl.textContent = msg;
      toastEl.classList.add('btt-toast-show');
      toastTimer = window.setTimeout(() => toastEl.classList.remove('btt-toast-show'), 1400);
    }

    // ── Rotate tips ──
    function rotateTip() {
      tipIdx = (tipIdx + 1) % tips.length;
      tipText.style.opacity = '0';
      setTimeout(() => { tipText.textContent = tips[tipIdx]; tipText.style.opacity = '1'; }, 300);
    }

    let isChecking = false;
    // ── Check input ──
    function check() {
      if (isChecking) return;
      const typed = inputEl.value.trim();
      const target = words[wordIdx];

      if (typed === target) {
        isChecking = true;
        inputEl.value = '';
        // Correct!
        spotWord.classList.add('btt-spot-correct');
        inputEl.classList.add('btt-input-ok');
        inputIcon.textContent = '✓';
        if (!wordErrors[wordIdx]) correct += target.length;
        toast(praises[Math.floor(Math.random() * praises.length)]);
        setTimeout(() => {
          wordIdx++;
          isChecking = false;
          if (wordIdx < words.length) setCurrent();
          else finish();
        }, 300);
      } else {
        isChecking = true;
        // Wrong
        errors++;
        wordErrors[wordIdx] = true;
        spotWord.classList.add('btt-spot-shake');
        inputEl.classList.add('btt-input-err');
        inputIcon.textContent = '✗';
        setTimeout(() => {
          spotWord.classList.remove('btt-spot-shake');
          inputEl.classList.remove('btt-input-err');
          inputIcon.textContent = '→';
          inputEl.value = '';
          isChecking = false;
        }, 500);
      }
      draw();
    }

    // ── Start ──
    function start() {
      state = 'running'; startTime = Date.now();
      idleEl.classList.add('btt-idle-gone');
      inputEl.disabled = false;
      inputEl.focus();
      setCurrent();
      draw();
      raf = requestAnimationFrame(tick);
      tipTimer = window.setInterval(rotateTip, 6000);
    }

    // ── Finish ──
    function finish() {
      cancelAnimationFrame(raf); clearInterval(tipTimer);
      state = 'finished'; remaining = 0; draw();
      inputEl.disabled = true;

      const w = wpm(), a = accuracy();
      const passed = w >= goal;
      const stars = passed && a >= 95 ? 3 : passed && a >= 80 ? 2 : 1;

      resEmoji.textContent   = stars === 3 ? '🏆' : stars === 2 ? '🎉' : '💪';
      resTitle.textContent   = stars === 3 ? 'Excellent!' : stars === 2 ? 'Well Done!' : 'Keep Practising!';
      resSub.textContent     = passed
        ? `You typed ${w} WPM with ${a}% accuracy. You're ready for the full test!`
        : `You typed ${w} WPM. Target is ${goal} WPM. A little more practice and you'll get there!`;
      resWpm.textContent     = String(w);
      resAcc.textContent     = `${a}%`;
      resCorrect.textContent = String(correct);
      resErrors.textContent  = String(errors);
      starsEl.innerHTML      = Array.from({length: 3}, (_, i) =>
        `<span class="btt-star ${i < stars ? 'btt-star-lit' : ''}">${i < stars ? '★' : '☆'}</span>`
      ).join('');

      resultEl.style.display = '';
    }

    // ── Reset ──
    function reset() {
      cancelAnimationFrame(raf); clearInterval(tipTimer);
      state = 'idle'; wordIdx = 0; correct = 0; errors = 0;
      startTime = 0; remaining = dur; wordErrors = {};
      inputEl.disabled = true; inputEl.value = ''; inputEl.placeholder = 'Start typing the word above…';
      idleEl.classList.remove('btt-idle-gone');
      resultEl.style.display = 'none';
      spotWord.textContent = '–'; spotWord.className = 'btt-spot-word';
      contextEl.innerHTML = '';
      draw(); timerVal.textContent = fmt(dur); wpmEl.textContent = '0';
    }

    // ── Events ──
    inputEl.addEventListener('keydown', e => {
      if ((e.key === ' ' || e.key === 'Enter') && state === 'running') {
        e.preventDefault();
        const typed = inputEl.value.trim();
        const target = words[wordIdx];
        if (typed === target) {
          check();
        }
      }
    });
    // Automatically advance as soon as the typed word matches the target word
    inputEl.addEventListener('input', () => {
      if (state !== 'running' || isChecking) return;
      const typed = inputEl.value.trim();
      const target = words[wordIdx];
      if (typed === target) {
        check();
      } else if (inputEl.value.endsWith(' ')) {
        inputEl.value = inputEl.value.trimEnd();
        if (inputEl.value.trim() === target) {
          check();
        }
      }
    });

    startBtn.addEventListener('click', start);
    retryBtn.addEventListener('click', reset);

    // Init
    draw(); timerVal.textContent = fmt(dur);
  }
})();
</script>

<style>
/* ════════════════════════════════════
   Root
════════════════════════════════════ */
.btt-root {
  --btt-brand:  var(--brand, #B00020);
  --btt-green:  #16a34a;
  --btt-red:    #dc2626;
  --btt-ink:    var(--ink, #1a1410);
  --btt-sub:    var(--ink-soft, #4b5563);
  --btt-muted:  #9ca3af;
  --btt-surf:   var(--surface, #fff);
  --btt-surf2:  var(--surface-2, #f8fafc);
  --btt-border: var(--rule, #e5e7eb);
  --btt-radius: 14px;

  background: var(--btt-surf);
  border: 1px solid var(--btt-border);
  border-radius: var(--btt-radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  min-height: 520px;
}

/* ── Header ── */
.btt-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 14px 20px;
  border-bottom: 1px solid var(--btt-border);
  background: var(--btt-surf);
  flex-shrink: 0;
}
.btt-header-left  { display: flex; align-items: center; gap: 10px; min-width: 0; }
.btt-header-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.btt-badge {
  font-size: .65rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase;
  background: #f0fdf4; color: #15803d;
  border: 1px solid #bbf7d0; padding: 3px 9px; border-radius: 20px; flex-shrink: 0;
}
.btt-title {
  font-family: var(--font-body, sans-serif);
  font-size: clamp(.9rem, 1.8vw, 1.1rem); font-weight: 700;
  color: var(--btt-ink); margin: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.btt-stat-chip {
  display: flex; align-items: baseline; gap: 4px;
  background: var(--btt-surf2); border: 1px solid var(--btt-border);
  border-radius: 20px; padding: 4px 12px;
}
.btt-chip-val { font-size: .9rem; font-weight: 700; color: var(--btt-ink); }
.btt-chip-lbl { font-size: .62rem; font-weight: 600; color: var(--btt-muted); letter-spacing: .04em; text-transform: uppercase; }

.btt-timer-wrap {
  display: flex; align-items: center; gap: 5px;
  font-size: .85rem; font-weight: 700; color: var(--btt-sub);
  font-family: 'Courier New', monospace;
}
.btt-warn   { color: #d97706; }
.btt-danger { color: var(--btt-red); animation: btt-pulse 1s infinite; }
@keyframes btt-pulse { 0%,100%{opacity:1} 50%{opacity:.5} }

/* ── Progress track ── */
.btt-prog-track {
  position: relative; height: 28px;
  background: var(--btt-surf2); border-bottom: 1px solid var(--btt-border);
  flex-shrink: 0;
}
.btt-prog-fill {
  position: absolute; left: 0; top: 0; bottom: 0; width: 0%;
  background: linear-gradient(90deg, #16a34a, #4ade80);
  transition: width .4s cubic-bezier(.4,0,.2,1);
  border-radius: 0;
}
.btt-prog-label {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: .72rem; font-weight: 600; color: var(--btt-sub);
  mix-blend-mode: multiply; /* stays readable over green */
}

/* ── Body ── */
.btt-body {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; gap: 20px;
  padding: 28px 24px 16px; position: relative;
  overflow: hidden;
}

/* Spotlight */
.btt-spotlight-wrap { text-align: center; width: 100%; }
.btt-spotlight-hint {
  font-size: .72rem; font-weight: 600; color: var(--btt-muted);
  text-transform: uppercase; letter-spacing: .07em; margin: 0 0 8px;
}
.btt-spotlight {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--btt-surf2); border: 2px solid var(--btt-border);
  border-radius: 12px; padding: 16px 36px;
  min-width: 160px; min-height: 64px;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
  transition: border-color .2s, box-shadow .2s;
}
.btt-spot-word {
  font-family: var(--font-body, sans-serif);
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 800; color: var(--btt-ink);
  letter-spacing: .02em;
  transition: color .15s, transform .15s;
}
.btt-spot-correct { color: var(--btt-green) !important; transform: scale(1.06); }
@keyframes btt-shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-6px)} 40%,80%{transform:translateX(6px)} }
.btt-spot-shake { animation: btt-shake .4s ease; }
.btt-root:has(.btt-spot-correct) .btt-spotlight { border-color: #86efac; box-shadow: 0 0 0 4px rgba(22,163,74,.08); }

/* Context words */
.btt-context {
  font-family: var(--font-body, sans-serif);
  font-size: clamp(.88rem, 1.6vw, 1rem);
