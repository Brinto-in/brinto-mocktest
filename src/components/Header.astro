---
const currentPath = Astro.url.pathname;

const nav = [
  {
    href: '/mocktest/tests',
    label: 'Tests',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>`
  },
  /*
  {
    href: '/mocktest/institutes',
    label: 'Institutes',
    comingSoon: true,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/></svg>`
  },
  */
  {
    href: '/mocktest/results',
    label: 'My Results',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`
  },
  {
    href: '/mocktest/leaderboard',
    label: 'Leaderboard',
    comingSoon: true,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>`
  },
];

function isNavActive(href: string) {
  if (href === '/mocktest' && (currentPath === '/mocktest' || currentPath === '/mocktest/')) {
    return true;
  }
  if (href !== '/mocktest' && currentPath.startsWith(href)) {
    return true;
  }
  return false;
}
---

<header class="header">
  <div class="wrap bar">
    <!-- Mobile Hamburger (Left Side) -->
    <button class="hamburger" id="hamburger-btn" aria-label="Toggle navigation menu" aria-expanded="false" onclick="toggleMenu(this)">
      <span></span><span></span><span></span>
    </button>

    <!-- Logo & Brand -->
    <a href="/mocktest" class="brand" aria-label="Brinto MockTest home">
      <img src="/logo.png" alt="Brinto MockTest logo" width="32" height="32" class="logo-mark" onerror="this.onerror=null;this.src='/mocktest/logo.png';" />
<!--      <span class="brand-wordmark">Brinto<span class="brand-wordmark-accent">MockTest</span></span>-->
    </a>

    <!-- Professional Search Bar next to Logo -->
    <div class="header-search-container">
      <form action="/mocktest/tests" method="get" class="header-search-form" role="search">
        <svg class="header-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input
          type="search"
          name="q"
          placeholder="Search tests, exams…"
          aria-label="Search tests and exams"
          class="header-search-input"
          autocomplete="off"
        />
        <button type="submit" class="header-search-submit" aria-label="Submit search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
      </form>
    </div>

    <!-- Centered Pill Navigation -->
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {nav.map(n => {
          const active = isNavActive(n.href);
          return (
            <li>
              <a
                href={n.comingSoon ? undefined : n.href}
                class={`nav-pill ${active ? 'active' : ''} ${n.comingSoon ? 'coming-soon-link' : ''}`}
                aria-current={active ? 'page' : undefined}
                aria-disabled={n.comingSoon ? 'true' : undefined}
                style={n.comingSoon ? 'pointer-events: none; opacity: 0.55; cursor: default;' : ''}
              >
                <span class="nav-pill-icon" set:html={n.icon} />
                <span>{n.label}</span>
                {n.comingSoon && <span class="nav-soon-badge">Soon</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Right Actions -->
    <div class="header-cta">
      <div class="auth-guest" data-auth-guest>
        <button type="button" class="btn-login-pill" data-open-login>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          <span>Sign In</span>
        </button>
      </div>
      <div class="profile" data-auth-user hidden>
        <button type="button" class="profile-btn" id="profile-btn" aria-label="Account menu" aria-haspopup="true" aria-expanded="false">
          <span class="profile-avatar" data-profile-initial>U</span>
        </button>
        <div class="profile-menu" id="profile-menu" role="menu" hidden>
          <div class="profile-info">
            <span class="profile-name" data-profile-name>User</span>
            <span class="profile-phone" data-profile-phone></span>
          </div>
          <a href="/mocktest/results" class="profile-item" role="menuitem">My Results</a>
          <button type="button" class="profile-item profile-logout" id="logout-btn" role="menuitem">Log out</button>
        </div>
      </div>
    </div>

    <!-- Mobile Actions (Search Icon + Auth/Profile) -->
    <div class="mobile-actions">
      <!-- Search Icon Button -->
      <button
        type="button"
        class="mobile-search-icon-btn"
        id="mobile-search-icon-btn"
        aria-label="Search tests and exams"
        aria-expanded="false"
        onclick="openMobileSearch()"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <button type="button" class="mobile-auth-btn auth-guest" data-auth-guest aria-label="Sign in" data-open-login>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </button>

      <div class="mobile-auth-profile profile auth-user" data-auth-user hidden>
        <button type="button" class="profile-btn mobile-profile-btn" id="mobile-profile-btn" aria-label="Account menu" aria-haspopup="true" aria-expanded="false">
          <span class="profile-avatar" data-profile-initial>U</span>
        </button>
        <div class="profile-menu" id="mobile-profile-menu" role="menu" hidden>
          <div class="profile-info">
            <span class="profile-name" data-profile-name>User</span>
            <span class="profile-phone" data-profile-phone></span>
          </div>
          <a href="/mocktest/results" class="profile-item" role="menuitem">My Results</a>
          <button type="button" class="profile-item profile-logout" id="mobile-dropdown-logout-btn" role="menuitem">Log out</button>
        </div>
      </div>
    </div>

  </div>

  <!-- Full-Width Mobile Search Overlay -->
  <div class="mobile-search-overlay" id="mobile-search-overlay" aria-hidden="true">
    <div class="wrap mobile-search-bar">
      <form action="/mocktest/tests" method="get" class="mobile-search-form" role="search" id="mobile-search-form">
        <!-- Back button to smoothly close search -->
        <button type="button" class="mobile-search-back-btn" id="mobile-search-back-btn" aria-label="Close search" onclick="closeMobileSearch()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>

        <!-- Full-Width Search Input Pill -->
        <div class="mobile-search-input-wrap">
          <svg class="mobile-search-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <input
            type="search"
            name="q"
            id="mobile-search-input"
            placeholder="Search tests, exams…"
            aria-label="Search tests and exams"
            class="mobile-search-input"
            autocomplete="off"
          />
          <button type="button" class="mobile-search-clear-btn" id="mobile-search-clear-btn" aria-label="Clear search input" onclick="clearMobileSearch()" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="mobile-search-submit-btn" aria-label="Submit search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</header>

<!-- Mobile Search Dimmed Backdrop Overlay -->
<div class="mobile-search-backdrop" id="mobile-search-backdrop" aria-hidden="true" onclick="closeMobileSearch()"></div>

<!-- Mobile Navigation Backdrop Overlay (outside header stacking context) -->
<div class="nav-mobile-backdrop" id="mobile-nav-backdrop" aria-hidden="true" onclick="closeMenu()"></div>

<!-- Mobile Navigation Right-To-Left Slide Drawer -->
<nav class="nav-mobile" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="drawer-inner">
    <!-- Drawer Header -->
    <div class="drawer-header">
      <a href="/mocktest" class="drawer-brand" onclick="closeMenu()">
        <img src="/logo.png" alt="Brinto Logo" width="28" height="28" class="drawer-logo" onerror="this.onerror=null;this.src='/mocktest/logo.png';" />
        <span class="drawer-brand-name">Brinto<span class="brand-accent">MockTest</span></span>
      </a>
      <button type="button" class="drawer-close-btn" aria-label="Close menu" onclick="closeMenu()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- User Profile Header in Drawer (Logged In) -->
    <div class="drawer-user-card" data-auth-user hidden style="--i: 1">
      <div class="drawer-user-avatar" data-profile-initial>U</div>
      <div class="drawer-user-info">
        <span class="drawer-user-name" data-profile-name>User</span>
        <span class="drawer-user-phone" data-profile-phone></span>
      </div>
      <span class="drawer-user-badge">Active</span>
    </div>

    <!-- Drawer Body / Nav List -->
    <div class="drawer-body">
      <p class="drawer-section-title">Navigation</p>
      <ul class="drawer-menu">
        {nav.map((n, idx) => {
          const active = isNavActive(n.href);
          return (
            <li style={`--i: ${idx + 2}`}>
              <a
                href={n.comingSoon ? undefined : n.href}
                class={`${active ? 'drawer-link active' : 'drawer-link'} ${n.comingSoon ? 'coming-soon-link' : ''}`}
                aria-current={active ? 'page' : undefined}
                aria-disabled={n.comingSoon ? 'true' : undefined}
                style={n.comingSoon ? 'pointer-events: none; opacity: 0.65; cursor: default;' : ''}
                onclick={n.comingSoon ? undefined : "closeMenu()"}
              >
                <span class="drawer-link-icon" set:html={n.icon} />
                <span class="drawer-link-text">{n.label}</span>
                {n.comingSoon ? (
                  <span class="drawer-soon-badge">Soon</span>
                ) : (
                  <svg class="drawer-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                )}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="drawer-divider"></div>

      <!-- Guest Actions -->
      <div class="drawer-guest-actions" data-auth-guest style="--i: 6">
        <button type="button" class="drawer-btn-login" data-open-login>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          <span>Log in</span>
        </button>
      </div>

      <!-- Logged In User Actions -->
      <div class="drawer-user-actions" data-auth-user hidden style="--i: 6">
        <button type="button" class="drawer-btn-logout" id="mobile-logout-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Log out</span>
        </button>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <span class="drawer-footer-text">Brinto MockTest Platform</span>
    </div>
  </div>
</nav>

<!-- Login Bottom Sheet / Modal Overlay -->
<div class="login-overlay" id="login-overlay" aria-hidden="true">
  <div class="login-modal" role="dialog" aria-modal="true" aria-labelledby="login-title">
    <div class="sheet-handle login-sheet-handle"></div>
    <button type="button" class="login-close" aria-label="Close login" data-close-login>&times;</button>
    <h2 id="login-title" class="login-title">Log in</h2>
    <p class="login-sub">Sign in with your mobile number to continue</p>

    <!-- Step 1: Mobile Number Input -->
    <div class="login-step" data-step="phone">
      <label class="login-label" for="login-phone">Mobile number</label>
      <div class="phone-row" id="phone-row-wrapper">
        <div class="phone-cc">
          <span class="flag-icon">🇮🇳</span>
          <span class="cc-text">+91</span>
        </div>
        <input
          id="login-phone"
          type="tel"
          inputmode="numeric"
          maxlength="10"
          placeholder="98765 43210"
          class="login-input"
          autocomplete="tel"
        />
      </div>
      <button type="button" class="login-submit" id="send-otp-btn">
        <span>Send OTP</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

    <!-- Step 2: Visual 6-Digit OTP Box Grid -->
    <div class="login-step" data-step="otp" hidden>
      <div class="otp-header">
        <label class="login-label" for="login-otp">Enter 6-digit OTP</label>
        <p class="otp-hint">Code sent to <span id="otp-target"></span></p>
      </div>

      <div class="otp-container" id="otp-container">
        <input
          id="login-otp"
          type="tel"
          inputmode="numeric"
          maxlength="6"
          class="otp-hidden-input"
          autocomplete="one-time-code"
        />
        <div class="otp-grid">
          <div class="otp-digit-box active" data-index="0"></div>
          <div class="otp-digit-box" data-index="1"></div>
          <div class="otp-digit-box" data-index="2"></div>
          <div class="otp-digit-box" data-index="3"></div>
          <div class="otp-digit-box" data-index="4"></div>
          <div class="otp-digit-box" data-index="5"></div>
        </div>
      </div>

      <button type="button" class="login-submit" id="verify-otp-btn">
        <span>Verify &amp; Continue</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>

      <div class="otp-footer">
        <button type="button" class="login-link" id="change-number-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <span>Change number</span>
        </button>
      </div>
    </div>

    <!-- Step 3: Success -->
    <div class="login-step" data-step="done" hidden>
      <div class="login-success-card">
        <div class="success-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <p class="login-success">Logged in successfully!</p>
      </div>
    </div>

    <p class="login-error" id="login-error" role="alert" hidden></p>
    <div id="recaptcha-container"></div>
  </div>
</div>

<!-- Logout Confirmation Bottom Sheet / Modal -->
<div class="logout-sheet-backdrop" id="logout-sheet-backdrop" aria-hidden="true" onclick="closeLogoutSheet()">
  <div class="logout-sheet" id="logout-sheet" role="dialog" aria-modal="true" aria-labelledby="logout-sheet-title" onclick="event.stopPropagation()">
    <div class="sheet-handle"></div>
    <div class="sheet-header">
      <div class="sheet-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </div>
      <div class="sheet-text">
        <h3 id="logout-sheet-title" class="sheet-title">Confirm Logout</h3>
        <p class="sheet-sub">Are you sure you want to log out of Brinto MockTest?</p>
      </div>
    </div>
    <div class="sheet-actions">
      <button type="button" class="sheet-btn-cancel" id="cancel-logout-btn" onclick="closeLogoutSheet()">Cancel</button>
      <button type="button" class="sheet-btn-confirm" id="confirm-logout-btn">Log out</button>
    </div>
  </div>
</div>

<script is:inline>
  var drawerTimer = null;
  var sheetTimer = null;

  var isMobileSearchOpen = false;

  function openMobileSearch() {
    const header = document.querySelector('.header');
    const overlay = document.getElementById('mobile-search-overlay');
    const backdrop = document.getElementById('mobile-search-backdrop');
    const input = document.getElementById('mobile-search-input');
    const searchBtn = document.getElementById('mobile-search-icon-btn');
    if (!overlay) return;

    if (typeof closeMenu === 'function') {
      closeMenu();
    }

    isMobileSearchOpen = true;
    window.isMobileSearchOpen = true;
    header?.classList.add('is-search-active');
    overlay.setAttribute('aria-hidden', 'false');
    if (backdrop) {
      backdrop.classList.add('open');
      backdrop.setAttribute('aria-hidden', 'false');
    }
    if (searchBtn) {
      searchBtn.setAttribute('aria-expanded', 'true');
    }

    if (input) {
      setTimeout(() => {
        input.focus();
        if (input.value) input.select();
      }, 70);
    }
  }

  function closeMobileSearch() {
    if (!isMobileSearchOpen) return;
    isMobileSearchOpen = false;
    window.isMobileSearchOpen = false;

    const header = document.querySelector('.header');
    const overlay = document.getElementById('mobile-search-overlay');
    const backdrop = document.getElementById('mobile-search-backdrop');
    const input = document.getElementById('mobile-search-input');
    const searchBtn = document.getElementById('mobile-search-icon-btn');

    header?.classList.remove('is-search-active');
    overlay?.setAttribute('aria-hidden', 'true');
    if (backdrop) {
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
    }
    if (searchBtn) {
      searchBtn.setAttribute('aria-expanded', 'false');
    }
    input?.blur();
  }

  function toggleMobileSearch() {
    if (isMobileSearchOpen) {
      closeMobileSearch();
    } else {
      openMobileSearch();
    }
  }

  function clearMobileSearch() {
    const input = document.getElementById('mobile-search-input');
    const clearBtn = document.getElementById('mobile-search-clear-btn');
    if (input) {
      input.value = '';
      input.focus();
    }
    if (clearBtn) {
      clearBtn.style.display = 'none';
    }
  }

  // Backwards compatibility aliases
  function toggleInlineMobileSearch() {
    toggleMobileSearch();
  }
  function closeInlineMobileSearch() {
    closeMobileSearch();
  }

  function toggleMenu(btn) {
    const nav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const hamburger = document.getElementById('hamburger-btn');
    if (!nav) return;

    if (drawerTimer) {
      clearTimeout(drawerTimer);
      drawerTimer = null;
    }

    const isOpen = nav.classList.contains('open');
    if (isOpen) {
      closeMenu();
    } else {
      closeMobileSearch();
      nav.style.display = 'block';
      if (backdrop) backdrop.style.display = 'block';

      // Force reflow for CSS transition
      void nav.offsetWidth;
      if (backdrop) void backdrop.offsetWidth;

      nav.classList.add('open');
      backdrop?.classList.add('open');
      hamburger?.classList.add('active');
      hamburger?.setAttribute('aria-expanded', 'true');
      nav.setAttribute('aria-hidden', 'false');
      backdrop?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    const nav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const hamburger = document.getElementById('hamburger-btn');

    if (!nav) return;

    nav.classList.remove('open');
    backdrop?.classList.remove('open');
    hamburger?.classList.remove('active');
    hamburger?.setAttribute('aria-expanded', 'false');
    nav.setAttribute('aria-hidden', 'true');
    backdrop?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    if (drawerTimer) clearTimeout(drawerTimer);
    drawerTimer = setTimeout(function() {
      if (!nav.classList.contains('open')) {
        nav.style.display = 'none';
        if (backdrop) backdrop.style.display = 'none';
      }
    }, 350);
  }

  function openLogoutSheet() {
    const sheetBackdrop = document.getElementById('logout-sheet-backdrop');
    if (!sheetBackdrop) return;

    if (sheetTimer) {
      clearTimeout(sheetTimer);
      sheetTimer = null;
    }

    sheetBackdrop.style.display = 'flex';
    void sheetBackdrop.offsetWidth;

    sheetBackdrop.classList.add('open');
    sheetBackdrop.setAttribute('aria-hidden', 'false');
  }

  function closeLogoutSheet() {
    const sheetBackdrop = document.getElementById('logout-sheet-backdrop');
    if (!sheetBackdrop) return;

    sheetBackdrop.classList.remove('open');
    sheetBackdrop.setAttribute('aria-hidden', 'true');

    if (sheetTimer) clearTimeout(sheetTimer);
    sheetTimer = setTimeout(function() {
      if (!sheetBackdrop.classList.contains('open')) {
        sheetBackdrop.style.display = 'none';
      }
    }, 350);
  }

  window.addEventListener('resize', function() {
    if (window.innerWidth > 768) {
      closeMenu();
    }
  });
</script>

<script>
  import { getFirebaseAuth } from '../lib/firebase';
  import { RecaptchaVerifier, signInWithPhoneNumber, type ConfirmationResult } from 'firebase/auth';
  import { loginWithMobile, saveAuth, getAuth, clearAuth } from '../lib/authService';

  let recaptcha: RecaptchaVerifier | null = null;
  let confirmation: ConfirmationResult | null = null;
  let currentPhone = '';
  let loginTimer: any = null;

  // --- Auth UI rendering (localStorage-backed) ---
  function renderAuth() {
    const auth = getAuth();
    const loggedIn = !!auth;
    document.querySelectorAll<HTMLElement>('[data-auth-guest]').forEach((el) => {
      el.hidden = loggedIn;
    });
    document.querySelectorAll<HTMLElement>('[data-auth-user]').forEach((el) => {
      el.hidden = !loggedIn;
    });
    if (loggedIn && auth) {
      const name = auth.user.name || auth.user.user_name || 'User';
      const initial = name.charAt(0).toUpperCase();
      document.querySelectorAll<HTMLElement>('[data-profile-name]').forEach((el) => {
        el.textContent = name;
      });
      document.querySelectorAll<HTMLElement>('[data-profile-initial]').forEach((el) => {
        el.textContent = initial;
      });
      document.querySelectorAll<HTMLElement>('[data-profile-phone]').forEach((el) => {
        el.textContent = auth.user.phone ? '+91 ' + auth.user.phone : '';
      });
    }
  }

  function logout() {
    clearAuth();
    renderAuth();
    const menu = document.getElementById('profile-menu');
    if (menu) menu.hidden = true;
    if (typeof (window as any).closeLogoutSheet === 'function') {
      (window as any).closeLogoutSheet();
    }
    if (typeof (window as any).closeMenu === 'function') {
      (window as any).closeMenu();
    }
    if (typeof (window as any).closeMobileSearch === 'function') {
      (window as any).closeMobileSearch();
    }
  }

  function ensureRecaptcha() {
    if (recaptcha) return recaptcha;
    const auth = getFirebaseAuth();
    recaptcha = new RecaptchaVerifier(auth, 'recaptcha-container', { size: 'invisible' });
    return recaptcha;
  }

  function initHeader() {
    const overlay = document.getElementById('login-overlay');
    const errorEl = document.getElementById('login-error');
    const phoneInput = document.getElementById('login-phone') as HTMLInputElement | null;
    const otpInput = document.getElementById('login-otp') as HTMLInputElement | null;
    const otpTarget = document.getElementById('otp-target');
    const sendBtn = document.getElementById('send-otp-btn') as HTMLButtonElement | null;
    const verifyBtn = document.getElementById('verify-otp-btn') as HTMLButtonElement | null;
    const changeBtn = document.getElementById('change-number-btn');
    const profileBtn = document.getElementById('profile-btn');
    const profileMenu = document.getElementById('profile-menu');

    function showError(msg: string) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      if (errorEl) errorEl.hidden = true;
    }
    function updateOtpGrid() {
      if (!otpInput) return;
      const digits = (otpInput.value || '').replace(/\D/g, '').slice(0, 6);
      otpInput.value = digits;
      const boxes = document.querySelectorAll<HTMLElement>('.otp-digit-box');
      boxes.forEach((box, i) => {
        const val = digits[i] || '';
        box.textContent = val;
        if (val) {
          box.classList.add('filled');
        } else {
          box.classList.remove('filled');
        }
        if (i === digits.length && digits.length < 6) {
          box.classList.add('active');
        } else {
          box.classList.remove('active');
        }
      });
    }
    function showStep(step: 'phone' | 'otp' | 'done') {
      document.querySelectorAll<HTMLElement>('.login-step').forEach((el) => {
        el.hidden = el.dataset.step !== step;
      });
      if (phoneInput) phoneInput.disabled = false;
      if (otpInput) otpInput.disabled = false;
      if (step === 'otp') {
        if (otpInput) otpInput.value = '';
        updateOtpGrid();
      }
    }
    function openModal() {
      if (!overlay) return;
      if (loginTimer) {
        clearTimeout(loginTimer);
        loginTimer = null;
      }
      if (typeof (window as any).closeMenu === 'function') {
        (window as any).closeMenu();
      }
      if (typeof (window as any).closeMobileSearch === 'function') {
        (window as any).closeMobileSearch();
      }
      overlay.style.display = 'flex';
      void overlay.offsetWidth;
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      clearError();
      showStep('phone');
      phoneInput?.focus();
    }
    function closeModal() {
      if (!overlay) return;
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (loginTimer) clearTimeout(loginTimer);
      loginTimer = setTimeout(() => {
        if (!overlay.classList.contains('open')) {
          overlay.style.display = 'none';
        }
      }, 350);
    }

    otpInput?.addEventListener('input', updateOtpGrid);
    otpInput?.addEventListener('focus', updateOtpGrid);
    otpInput?.addEventListener('blur', () => {
      document.querySelectorAll<HTMLElement>('.otp-digit-box').forEach(b => b.classList.remove('active'));
    });

    document.querySelectorAll('[data-open-login]').forEach((btn) => {
      btn.addEventListener('click', openModal);
    });
    document.querySelectorAll('[data-close-login]').forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    sendBtn?.addEventListener('click', async () => {
      clearError();
      const digits = (phoneInput?.value || '').replace(/\D/g, '');
      if (digits.length !== 10) {
        showError('Enter a valid 10-digit mobile number.');
        return;
      }
      currentPhone = digits;
      const phoneNumber = '+91' + digits;
      sendBtn.disabled = true;
      if (phoneInput) phoneInput.disabled = true;
      sendBtn.innerHTML = `<span>Sending OTP...</span>`;
      try {
        const auth = getFirebaseAuth();
        confirmation = await signInWithPhoneNumber(auth, phoneNumber, ensureRecaptcha());
        if (otpTarget) otpTarget.textContent = phoneNumber;
        showStep('otp');
        setTimeout(() => otpInput?.focus(), 100);
      } catch (err) {
        console.log('[v0] send OTP error:', err);
        showError('Could not send OTP. Please try again.');
      } finally {
        sendBtn.disabled = false;
        if (phoneInput) phoneInput.disabled = false;
        sendBtn.innerHTML = `
          <span>Send OTP</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        `;
      }
    });

    verifyBtn?.addEventListener('click', async () => {
      clearError();
      const code = (otpInput?.value || '').replace(/\D/g, '');
      if (code.length !== 6) {
        showError('Enter the 6-digit code.');
        return;
      }
      if (!confirmation) {
        showError('Session expired. Please resend the OTP.');
        return;
      }
      verifyBtn.disabled = true;
      if (otpInput) otpInput.disabled = true;
      if (changeBtn && 'disabled' in changeBtn) (changeBtn as any).disabled = true;
      verifyBtn.innerHTML = `<span>Verifying...</span>`;
      try {
        await confirmation.confirm(code);
        const auth = await loginWithMobile(currentPhone);
        if (!auth) {
          showError('No account found for this number.');
          return;
        }
        saveAuth(auth);
        renderAuth();
        showStep('done');
        setTimeout(() => {
          closeModal();
          const params = new URLSearchParams(window.location.search);
          const redirectUrl = params.get('redirect');
          if (redirectUrl) {
            window.location.href = redirectUrl;
          }
        }, 900);
      } catch (err) {
        console.log('[v0] verify OTP error:', err);
        showError('Invalid code. Please try again.');
      } finally {
        verifyBtn.disabled = false;
        if (otpInput) otpInput.disabled = false;
        if (changeBtn && 'disabled' in changeBtn) (changeBtn as any).disabled = false;
        verifyBtn.innerHTML = `
          <span>Verify &amp; Continue</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        `;
      }
    });

    changeBtn?.addEventListener('click', () => {
      clearError();
      if (otpInput) otpInput.value = '';
      updateOtpGrid();
      showStep('phone');
      phoneInput?.focus();
    });

    profileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!profileMenu) return;
      const open = profileMenu.hidden;
      profileMenu.hidden = !open;
      profileBtn.setAttribute('aria-expanded', String(open));
    });

    const mobileProfileBtn = document.getElementById('mobile-profile-btn');
    const mobileProfileMenu = document.getElementById('mobile-profile-menu');

    mobileProfileBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!mobileProfileMenu) return;
      const open = mobileProfileMenu.hidden;
      mobileProfileMenu.hidden = !open;
      mobileProfileBtn.setAttribute('aria-expanded', String(open));
    });

    function triggerLogoutPrompt(e: Event) {
      e.preventDefault();
      if (typeof (window as any).openLogoutSheet === 'function') {
        (window as any).openLogoutSheet();
      }
    }

    document.getElementById('logout-btn')?.addEventListener('click', triggerLogoutPrompt);
    document.getElementById('mobile-logout-btn')?.addEventListener('click', triggerLogoutPrompt);
    document.getElementById('mobile-dropdown-logout-btn')?.addEventListener('click', triggerLogoutPrompt);
    document.getElementById('confirm-logout-btn')?.addEventListener('click', logout);
    document.getElementById('cancel-logout-btn')?.addEventListener('click', () => {
      if (typeof (window as any).closeLogoutSheet === 'function') {
        (window as any).closeLogoutSheet();
      }
    });
    document.getElementById('hamburger-btn')?.addEventListener('click', renderAuth);

    renderAuth();

    // Wire mobile search input clear button
    const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;
    const mobileSearchClearBtn = document.getElementById('mobile-search-clear-btn') as HTMLElement | null;
    mobileSearchInput?.addEventListener('input', () => {
      if (mobileSearchClearBtn) {
        mobileSearchClearBtn.style.display = mobileSearchInput.value.length > 0 ? 'flex' : 'none';
      }
    });

    // Clean up any lingering overflow from previous pages
    document.body.style.overflow = '';

    // Open modal if URL has ?login=true
    if (new URLSearchParams(window.location.search).get('login') === 'true') {
      openModal();
      const url = new URL(window.location.href);
      url.searchParams.delete('login');
      window.history.replaceState({}, '', url.pathname + url.search);
    }
  }

  // Handle global Escape key and outside click for profile menu
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.getElementById('login-overlay');
      if (overlay?.classList.contains('open')) {
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      if (typeof (window as any).closeLogoutSheet === 'function') {
        (window as any).closeLogoutSheet();
      }
      if (typeof (window as any).closeMenu === 'function') {
        (window as any).closeMenu();
      }
      if (typeof (window as any).closeMobileSearch === 'function') {
        (window as any).closeMobileSearch();
      }
    }
  });

  document.addEventListener('click', (e) => {
    const profileBtn = document.getElementById('profile-btn');
    const profileMenu = document.getElementById('profile-menu');
    if (profileMenu && !profileMenu.hidden) {
      const t = e.target as Node;
      if (!profileMenu.contains(t) && t !== profileBtn) {
        profileMenu.hidden = true;
        profileBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    const mobileProfileBtn = document.getElementById('mobile-profile-btn');
    const mobileProfileMenu = document.getElementById('mobile-profile-menu');
    if (mobileProfileMenu && !mobileProfileMenu.hidden) {
      const t = e.target as Node;
      if (!mobileProfileMenu.contains(t) && t !== mobileProfileBtn) {
        mobileProfileMenu.hidden = true;
        mobileProfileBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    // Close mobile menu on click outside
    const mobileNav = document.getElementById('mobile-nav');
    const hamburgerBtn = document.getElementById('hamburger-btn');
    if (mobileNav && mobileNav.classList.contains('open')) {
      const t = e.target as Node;
      if (!mobileNav.contains(t) && hamburgerBtn && !hamburgerBtn.contains(t)) {
        if (typeof (window as any).closeMenu === 'function') {
          (window as any).closeMenu();
        }
      }
    }

    // Close mobile search on click outside header or clicking backdrop
    if ((window as any).isMobileSearchOpen) {
      const header = document.querySelector('.header');
      const backdrop = document.getElementById('mobile-search-backdrop');
      const t = e.target as Node;
      if ((header && !header.contains(t)) || t === backdrop) {
        if (typeof (window as any).closeMobileSearch === 'function') {
          (window as any).closeMobileSearch();
        }
      }
    }
  });

  window.addEventListener('storage', renderAuth);
  window.addEventListener('brinto:auth-changed', renderAuth);

  // Keyboard shortcut listener for search focus (Cmd+K or Ctrl+K)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (window.innerWidth <= 768) {
        if (typeof (window as any).openMobileSearch === 'function') {
          (window as any).openMobileSearch();
        }
      } else {
        const searchInput = document.querySelector('.header-search-input') as HTMLInputElement | null;
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        }
      }
    }
  });

  // Initialize on initial page load and on every ClientRouter page transition
  document.addEventListener('astro:page-load', initHeader);
</script>

