---

<div class="tab-toast" id="tab-toast" role="alert" aria-live="assertive">
  <div class="toast-icon-wrap">
    <svg
      width="18"
      height="18"
      fill="none"
      stroke="#fff"
      stroke-width="2.5"
      viewBox="0 0 24 24"
    >
      <path
        d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
      ></path>
      <line x1="12" y1="9" x2="12" y2="13"></line><line
        x1="12"
        y1="17"
        x2="12.01"
        y2="17"></line>
    </svg>
  </div>
  <div class="toast-content">
    <div class="toast-title" id="toast-title">Tab switch detected!</div>
    <div class="toast-sub" id="toast-sub">
      Please stay on this tab during the test.
    </div>
  </div>
  <span class="toast-badge" id="toast-badge">1 warning</span>
</div>

<style is:global>
  .tab-toast {
    position: fixed;
    top: 68px;
    left: 50%;
    transform: translateX(-50%) translateY(-16px);
    z-index: 999;
    background: var(--ink, #0f172a);
    color: #fff;
    border-radius: var(--radius-md, 14px);
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 8px 32px rgba(26, 20, 16, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    width: min(440px, calc(100vw - 32px));
    border-left: 4px solid var(--brand, #b00020);
  }
  .tab-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .toast-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--brand, #b00020);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .toast-content {
    flex: 1;
    min-width: 0;
  }
  .toast-title {
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.2;
  }
  .toast-sub {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 2px;
    line-height: 1.3;
  }
  .toast-badge {
    background: var(--brand, #b00020);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-pill, 999px);
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .tab-toast {
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      max-width: 100%;
      transform: translateY(-100%);
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      border-radius: 0;
      border-left: none;
      border-bottom: 4px solid var(--brand, #b00020);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    .tab-toast.show {
      transform: translateY(0);
    }
    .toast-icon-wrap {
      width: 28px;
      height: 28px;
    }
    .toast-icon-wrap svg {
      width: 15px;
      height: 15px;
    }
    .toast-content {
      width: 100%;
    }
    .toast-title {
      font-size: 0.85rem;
    }
    .toast-sub {
      font-size: 0.75rem;
    }
    .toast-badge {
      align-self: flex-end;
      font-size: 0.65rem;
      padding: 3px 8px;
    }
  }
</style>
