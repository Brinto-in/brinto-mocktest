---
import type { Test } from "../../lib/types";

interface Props {
  test?: Test;
}

const { test } = Astro.props;
---

<div
  class="instr-overlay"
  id="instr-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="instr-title"
>
  <div class="instr-modal">
    <div class="instr-header">
      <div class="instr-exam-name" id="instr-exam-name">
        {test?.exam ? `${test.exam} · Mock Test` : "OSSSC · Mock Test"}
      </div>
      <div class="instr-test-title" id="instr-title">
        {test?.title || "Mock Test"}
      </div>
      <div class="instr-meta-pills">
        <span class="instr-pill">
          <svg
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><circle cx="12" cy="12" r="10"></circle><polyline
              points="12 6 12 16 14"></polyline></svg
          >
          <span id="instr-duration">{test?.duration || 30}</span> Minutes
        </span>
        <span class="instr-pill">
          <svg
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path d="M9 11l3 3L22 4"></path><path
              d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
            ></path></svg
          >
          <span id="instr-questions">{test?.questions || 20}</span> Questions
        </span>
        <span class="instr-pill">
          <svg
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            ></path></svg
          >
          <span id="instr-marks">
            {
              test?.total_marks !== undefined
                ? test.total_marks
                : (test?.questions || 20) * (test?.correct_marks !== undefined ? test.correct_marks : 1)
            }
          </span> Marks Total
        </span>
        <span
          class="instr-pill"
          id="instr-neg-pill"
          style={
            test?.wrong_penalty && test.wrong_penalty > 0
              ? "background:rgba(176,0,32,0.3)"
              : "background:rgba(27,107,58,0.2); color:#1b6b3a;"
          }
        >
          <svg
            width="13"
            height="13"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
            ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
              x1="12"
              y1="17"
              x2="12.01"
              y2="17"></line></svg
          >
          <span id="instr-neg-text">
            {
              test?.wrong_penalty !== undefined
                ? test.wrong_penalty > 0
                  ? `Negative Marking (-${test.wrong_penalty})`
                  : "No Negative Marking"
                : "Negative Marking"
            }
          </span>
        </span>
        {
          (() => {
            const diff = test?.difficulty;
            let bg = "rgba(255, 255, 255, 0.12)";
            let color = "rgba(255, 255, 255, 0.85)";
            let border = "1px solid transparent";
            if (diff) {
              const d = String(diff).toLowerCase().trim();
              if (d === "easy") {
                bg = "rgba(34, 197, 94, 0.2)";
                color = "#4ade80";
                border = "1px solid rgba(74, 222, 128, 0.3)";
              } else if (d === "hard") {
                bg = "rgba(239, 68, 68, 0.22)";
                color = "#f87171";
                border = "1px solid rgba(248, 113, 113, 0.3)";
              } else {
                bg = "rgba(245, 158, 11, 0.2)";
                color = "#fbbf24";
                border = "1px solid rgba(251, 191, 36, 0.3)";
              }
            }
            return (
              <span
                class="instr-pill"
                id="instr-diff-pill"
                style={`background: ${bg}; color: ${color}; border: ${border}; ${diff ? "display:inline-flex;" : "display:none;"}`}
              >
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                </svg>
                <span id="instr-difficulty">{diff || ""}</span>
              </span>
            );
          })()
        }
      </div>
    </div>

    <div class="instr-body">
      <div class="instr-section-label">General Instructions</div>
      <ul class="instr-rules">
        <li class="instr-rule rule-warn">
          <span class="instr-rule-icon">🚫</span>
          <div class="instr-rule-text">
            <strong>Do not switch tabs or windows</strong>
            Switching to another browser tab or window will be recorded as a violation.
            Multiple violations may result in auto-submission of your test.
          </div>
        </li>
        <li class="instr-rule rule-warn">
          <span class="instr-rule-icon">📵</span>
          <div class="instr-rule-text">
            <strong>Do not switch apps (mobile)</strong>
            On mobile devices, minimising the browser or switching to another
            app will trigger a warning. Keep this tab open and active.
          </div>
        </li>
        <li class="instr-rule rule-warn">
          <span class="instr-rule-icon">🔄</span>
          <div class="instr-rule-text">
            <strong>Do not refresh or press Back</strong>
            Refreshing the page or using the browser's back button will end your
            test session and your answers will not be saved.
          </div>
        </li>
        <li class="instr-rule rule-info">
          <span class="instr-rule-icon">⏱️</span>
          <div class="instr-rule-text">
            <strong>Timer starts immediately</strong>
            The countdown begins the moment you click "Start Test" and cannot
            be paused. The test will auto-submit when time runs out.
          </div>
        </li>
        <li class="instr-rule rule-info">
          <span class="instr-rule-icon">🖱️</span>
          <div class="instr-rule-text">
            <strong>One question at a time</strong>
            Use the Next / Prev buttons or the Question Palette to navigate. You
            can change your answer any time before submission.
          </div>
        </li>
        <li class="instr-rule rule-ok">
          <span class="instr-rule-icon">⭐</span>
          <div class="instr-rule-text">
            <strong>Mark for Review</strong>
            You can mark any question for review and come back to it. Marked questions
            that are answered will still be evaluated.
          </div>
        </li>
        <li class="instr-rule rule-note">
          <span class="instr-rule-icon">💡</span>
          <div class="instr-rule-text">
            <strong>Stable internet recommended</strong>
            This test runs entirely in your browser. Your answers are saved locally
            even if connectivity drops — but do not close the tab.
          </div>
        </li>
      </ul>

      <div class="instr-section-label">Marking Scheme</div>
      <div class="instr-marking">
        <div style="font-size:0.88rem;color:var(--ink-soft);" id="instr-marking-desc">
          Each question carries <strong style="color:var(--ink)" id="instr-correct-text">
            {test?.correct_marks !== undefined ? `${test.correct_marks} mark${test.correct_marks === 1 ? '' : 's'}` : "1 mark"}
          </strong>. <span id="instr-penalty-desc">
            {test?.wrong_penalty !== undefined ? (test.wrong_penalty > 0 ? "Wrong answers attract a penalty." : "No penalty for wrong answers.") : "Wrong answers attract a penalty."}
          </span>
        </div>
        <div class="marking-grid">
          <div class="mg-item mg-correct">
            <div class="mg-val" id="instr-mg-correct">
              {test?.correct_marks !== undefined ? `+${test.correct_marks}` : "+1"}
            </div>
            <div class="mg-label">
              Correct Answer
            </div>
          </div>
          <div class="mg-item mg-wrong">
            <div class="mg-val" id="instr-mg-wrong">
              {test?.wrong_penalty !== undefined ? (test.wrong_penalty > 0 ? `-${test.wrong_penalty}` : "0") : "−¼"}
            </div>
            <div class="mg-label">
              Wrong Answer
            </div>
          </div>
          <div class="mg-item mg-skip">
            <div class="mg-val" id="instr-mg-skip">
              {test?.skipped_marks !== undefined ? `${test.skipped_marks}` : "0"}
            </div>
            <div class="mg-label">Skipped</div>
          </div>
        </div>
      </div>
    </div>

    <div class="instr-footer">
      <label class="instr-agree">
        <input type="checkbox" id="instr-agree-cb" />
        <span class="instr-agree-text">
          I have read all instructions carefully and agree to follow all test rules.
        </span>
      </label>
      <button class="btn-start-test" id="btn-start-test" disabled>
        Start Test →
      </button>
    </div>
  </div>
</div>
