---
---

<header class="exam-header" id="exam-header">
  <div class="eh-left">
    <a href="/mocktest" class="eh-brand">
      <img class="logo-desktop" src="/logo.png" alt="Brinto logo" height="28" style="height:28px; width:auto; object-fit:contain;" onerror="this.onerror=null;this.src='/mocktest/logo.png';" />
      <img class="logo-mobile" src="/favicon.png" alt="Brinto icon" height="28" width="28" style="height:28px; width:28px; object-fit:contain;" onerror="this.onerror=null;this.src='/mocktest/favicon.png';" />
    </a>
    <div class="eh-title" id="eh-title">Online Mock Test</div>
  </div>
  <div class="eh-right">
    <button class="btn-fullscreen" id="btn-fullscreen" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
    </button>
    <div class="timer-box">
      <svg
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        ><circle cx="12" cy="12" r="10"></circle><polyline
          points="12 6 12 16 14"></polyline></svg
      >
      <span id="timer">--:--</span>
    </div>
    <button class="btn-submit-header" id="btn-submit-header">Submit Test</button>
  </div>
</header>

<style is:global>
  .exam-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface, #ffffff);
    border-bottom: 1px solid var(--rule, #e2e8f0);
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 60px;
    flex-shrink: 0;
    width: 100%;
  }
  .eh-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex-shrink: 1;
  }
  .eh-right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto !important;
    flex-shrink: 0;
  }
  .eh-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink, #0f172a);
    flex-shrink: 0;
  }
  .logo-desktop {
    display: block;
    height: 28px;
    width: auto;
    object-fit: contain;
  }
  .logo-mobile {
    display: none;
    height: 28px;
    width: 28px;
    object-fit: contain;
  }
  .eh-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft, #475569);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .timer-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-2, #f1f5f9);
    border: 1px solid var(--rule, #e2e8f0);
    border-radius: var(--radius-sm, 8px);
    padding: 6px 14px;
    flex-shrink: 0;
  }
  .btn-fullscreen {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2, #f1f5f9);
    border: 1px solid var(--rule, #e2e8f0);
    border-radius: var(--radius-sm, 8px);
    padding: 8px;
    color: var(--ink-soft, #475569);
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .btn-fullscreen:hover {
    background: var(--surface, #ffffff);
    border-color: var(--brand, #b00020);
    color: var(--brand, #b00020);
  }
  .btn-submit-header {
    background: var(--brand, #b00020);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 8px 18px;
    border: none;
    border-radius: var(--radius-pill, 999px);
    flex-shrink: 0;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .btn-submit-header:hover {
    background: var(--brand-dark, #7b0015);
  }

  @media (max-width: 900px) {
    .exam-header {
      padding: 0 12px;
      gap: 10px;
    }
    .eh-title {
      display: none !important;
    }
    .eh-right {
      margin-left: auto !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      flex-shrink: 0 !important;
    }
    .timer-box {
      padding: 5px 8px;
      font-size: 0.85rem;
    }
    .btn-submit-header {
      padding: 7px 12px;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 640px) {
    .logo-desktop {
      display: none !important;
    }
    .logo-mobile {
      display: block !important;
    }
    .timer-box svg {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .exam-header {
      padding: 0 8px;
      gap: 6px;
    }
    .eh-right {
      gap: 6px !important;
    }
    .btn-fullscreen {
      padding: 6px;
    }
    .timer-box {
      padding: 4px 6px;
      font-size: 0.8rem;
    }
    .btn-submit-header {
      padding: 6px 10px;
      font-size: 0.78rem;
    }
  }
</style>
