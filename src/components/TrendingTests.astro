---
// "Top 10" style trending row (Hotstar / Netflix): big rank number + poster.
// Tests without an `image` from the API get a generated gradient poster.
import { fetchMockTests } from "../lib/api";
import { examTone } from "../lib/examTone";
import { testImage } from "../lib/testImages";
import { withStaticTrending } from "../lib/staticTrending";
import type { Test } from "../lib/types";

type TrendingTest = Test & { image?: string; info?: string; comingSoon?: boolean };

let tests: TrendingTest[] = [];

try {
  const items = await fetchMockTests(1, 10);
  if (Array.isArray(items) && items.length > 0) {
    tests = items.slice(0, 10).map((row: any) => ({
      title: row.title || row.name,
      exam: row.exam || row.category || "General",
      questions: Array.isArray(row.questions) ? row.questions.length : (row.questions || 0),
      duration: row.duration || 30,
      difficulty: row.difficulty || "Medium",
      attempts: row.attempts || 0,
      href: `/mocktest/test/${row.id}`,
      isNew: !!(row.isNew || row.is_new),
      isFree: !!(row.isFree || row.is_free),
      image: testImage(row.id, row.image || row.thumbnail),
    }));
  }
} catch (err) {
  console.error("Error fetching trending tests from API service:", err);
}

tests = withStaticTrending<TrendingTest>(tests, (s) => ({
  title: s.title,
  exam: s.exam,
  questions: 0,
  duration: 0,
  info: s.info,
  comingSoon: s.comingSoon,
  href: s.comingSoon ? undefined : s.href,
  image: testImage(s.id),
}));

// Removes a missing poster image so the generated art underneath shows instead
const IMG_FALLBACK = "this.closest('.tt-card')?.classList.remove('has-img');this.remove()";
---

<section class="section tt-section" aria-labelledby="tt-title">
  <div class="wrap">
    <div class="tt-head">
      <h2 id="tt-title" class="tt-title">Top 10 Trending Tests</h2>
      <div class="tt-head-right">
        <a href="/mocktest/tests" class="tt-see-all">View all</a>
        <div class="tt-nav" aria-hidden="true">
          <button type="button" class="tt-arrow" data-dir="-1" tabindex="-1">‹</button>
          <button type="button" class="tt-arrow" data-dir="1" tabindex="-1">›</button>
        </div>
      </div>
    </div>

    <ol class="tt-row" id="trending-tests-grid">
      {tests.map((t, i) => {
        const [a, b] = examTone(t.exam);
        const Tag = t.comingSoon ? "div" : "a";
        return (
          <li class="tt-item">
            <span class={`tt-rank ${i === 9 ? "is-ten" : ""}`} aria-hidden="true">{i + 1}</span>
            <Tag
              href={t.comingSoon ? undefined : t.href}
              class={`tt-card ${t.image ? "has-img" : ""} ${t.comingSoon ? "is-soon" : ""}`}
              style={`--tone-a:${a};--tone-b:${b};`}
              aria-label={t.comingSoon
                ? `#${i + 1} ${t.title} – coming soon`
                : `#${i + 1} ${t.title} – ${t.questions} questions, ${t.duration} minutes`}
              aria-disabled={t.comingSoon ? "true" : undefined}
            >
              <div class="tt-art">
                <span class="tt-exam">{t.exam}</span>
                <span class="tt-name">{t.title}</span>
              </div>
              {t.image && (
                <img class="tt-img" src={t.image} alt="" loading={i < 3 ? "eager" : "lazy"} decoding="async" onerror={IMG_FALLBACK} />
              )}
              <div class="tt-badges">
                {t.comingSoon && <span class="tt-badge tt-badge-soon">SOON</span>}
                {t.isNew && <span class="tt-badge tt-badge-new">NEW</span>}
                {t.isFree && <span class="tt-badge tt-badge-free">FREE</span>}
              </div>
              <div class="tt-info">
                <span>{t.info ?? `${t.questions} Qs · ${t.duration} min`}</span>
                <span class="tt-diff">{t.comingSoon ? "Coming soon" : t.difficulty}</span>
              </div>
            </Tag>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  import { examTone } from "../lib/examTone";
  import { testImage } from "../lib/testImages";
  import { withStaticTrending } from "../lib/staticTrending";

  const IMG_FALLBACK = "this.closest('.tt-card')?.classList.remove('has-img');this.remove()";

  const esc = (v: unknown) =>
    String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  const section = document.querySelector<HTMLElement>(".tt-section");
  const row = document.getElementById("trending-tests-grid");

  function setupArrows() {
    if (!section || !row) return;
    const arrows = section.querySelectorAll<HTMLButtonElement>(".tt-arrow");
    const update = () => {
      const max = row.scrollWidth - row.clientWidth - 2;
      arrows[0].disabled = row.scrollLeft <= 2;
      arrows[1].disabled = row.scrollLeft >= max;
      section.classList.toggle("tt-no-scroll", max <= 0);
    };
    arrows.forEach((btn) =>
      btn.addEventListener("click", () => {
        row.scrollBy({ left: Number(btn.dataset.dir) * row.clientWidth * 0.85, behavior: "smooth" });
      })
    );
    row.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  }

  // Ensure trending tests load from API on client if edge subrequest returned empty
  async function loadFallback() {
    if (!row || row.querySelector(".tt-card:not(.is-soon)")) return;
    try {
      const res = await fetch("https://brintoapi.brinto.in/api/mocktests?page=1&limit=10", {
        headers: { Accept: "application/json" },
      });
      if (!res.ok) {
        console.error("API Error: Unable to load tests (" + res.status + ")");
        return;
      }
      const json = await res.json();
      if (json?.error) {
        console.error("API Error: " + json.error);
        return;
      }
      const items = json?.data || json?.tests || (Array.isArray(json) ? json : []);
      if (!Array.isArray(items) || items.length === 0) return;

      const list = withStaticTrending<any>(items.slice(0, 10), (s) => ({ ...s, static: true }));

      row.innerHTML = list.map((t: any, i: number) => {
        const exam = t.exam || t.category || "General";
        const [a, b] = examTone(exam);
        const title = t.title || t.name;
        const qCount = Array.isArray(t.questions) ? t.questions.length : (t.questions || 0);
        const duration = t.duration || 30;
        const image = t.static ? testImage(t.id) : testImage(t.id, t.image || t.thumbnail);
        const soon = !!t.comingSoon;
        const tag = soon ? "div" : "a";
        const href = soon ? "" : ` href="${esc(t.static ? t.href : `/mocktest/test/${t.id}`)}"`;
        const label = soon
          ? `#${i + 1} ${esc(title)} – coming soon`
          : `#${i + 1} ${esc(title)} – ${qCount} questions, ${duration} minutes`;
        return `
          <li class="tt-item">
            <span class="tt-rank${i === 9 ? " is-ten" : ""}" aria-hidden="true">${i + 1}</span>
            <${tag}${href} class="tt-card${image ? " has-img" : ""}${soon ? " is-soon" : ""}" style="--tone-a:${a};--tone-b:${b};"
               aria-label="${label}"${soon ? ' aria-disabled="true"' : ""}>
              <div class="tt-art"><span class="tt-exam">${esc(exam)}</span><span class="tt-name">${esc(title)}</span></div>
              ${image ? `<img class="tt-img" src="${esc(image)}" alt="" loading="lazy" decoding="async" onerror="${IMG_FALLBACK}" />` : ""}
              <div class="tt-badges">
                ${soon ? '<span class="tt-badge tt-badge-soon">SOON</span>' : ""}
                ${t.is_new || t.isNew ? '<span class="tt-badge tt-badge-new">NEW</span>' : ""}
                ${t.is_free || t.isFree ? '<span class="tt-badge tt-badge-free">FREE</span>' : ""}
              </div>
              <div class="tt-info">
                <span>${esc(t.info ?? `${qCount} Qs · ${duration} min`)}</span>
                <span class="tt-diff">${soon ? "Coming soon" : esc(t.difficulty || "Medium")}</span>
              </div>
            </${tag}>
          </li>`;
      }).join("");
      row.dispatchEvent(new Event("scroll"));
    } catch (e) {
      console.error("Client fallback fetch failed:", e);
    }
  }

  setupArrows();
  loadFallback();
</script>

<style>
  .section {
    background: var(--surface);
    padding: 16px 0 20px;
  }

  /* Header */
  .tt-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  .tt-title {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .tt-head-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .tt-see-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand);
    white-space: nowrap;
  }

  .tt-see-all:hover {
    text-decoration: underline;
  }

  .tt-nav {
    display: flex;
    gap: 6px;
  }

  .tt-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .tt-arrow:hover:not(:disabled) {
    border-color: var(--ink);
    background: #f3f4f6;
  }

  .tt-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .tt-no-scroll .tt-nav {
    display: none;
  }

  /* Row */
  .tt-row {
    --pw: 176px; /* poster width */
    list-style: none;
    margin: 0;
    padding: 10px 0 12px;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    /* The rank glyph's line box overflows downward; without this the row
       also scrolls vertically and feels glitchy on trackpads. */
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tt-row::-webkit-scrollbar {
    display: none;
  }

  .tt-row :global(.tt-item) {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    scroll-snap-align: start;
  }

  /* Rank number: white fill with brand outline, overlapping the poster */
  .tt-row :global(.tt-rank) {
    position: relative;
    z-index: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: calc(var(--pw) * 0.9);
    line-height: 0.78;
    letter-spacing: 0;
    margin-right: calc(var(--pw) * -0.04);
    color: var(--surface);
    -webkit-text-stroke: 2.5px var(--brand);
    paint-order: stroke fill;
    text-shadow:
      0 4px 12px rgba(176, 0, 32, 0.2),
      0 8px 24px rgba(15, 23, 42, 0.08);
    user-select: none;
  }

  .tt-row :global(.tt-rank.is-ten) {
    letter-spacing: -0.08em;
    margin-right: calc(var(--pw) * -0.02);
  }

  /* Poster card */
  .tt-row :global(.tt-card) {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--pw);
    aspect-ratio: 3 / 4.5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 10%, rgba(255, 255, 255, 0.2), transparent 45%),
      radial-gradient(circle at 0% 100%, rgba(0, 0, 0, 0.3), transparent 55%),
      linear-gradient(160deg, var(--tone-a), var(--tone-b));
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    color: #ffffff;
  }

  .tt-row :global(.tt-card:hover),
  .tt-row :global(.tt-card:focus-visible) {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.2);
  }

  .tt-row :global(.tt-card:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .tt-row :global(.tt-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Generated poster art */
  .tt-row :global(.tt-art) {
    position: absolute;
    inset: 0;
    padding: 14px 12px 52px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .tt-row :global(.tt-exam) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--pw) * 0.17);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    word-break: break-word;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
  }

  .tt-row :global(.tt-name) {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    opacity: 0.92;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Badges */
  .tt-row :global(.tt-badges) {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 4px;
  }

  /* Image posters carry their own title at the top, so badges sit above the info strip */
  .tt-row :global(.tt-card.has-img .tt-badges) {
    top: auto;
    bottom: 34px;
  }

  .tt-row :global(.tt-badge) {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 3px 6px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .tt-row :global(.tt-badge-new) {
    background: var(--brand);
    color: #ffffff;
  }

  .tt-row :global(.tt-badge-soon) {
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
  }

  /* Coming-soon cards: not clickable, slightly muted, no hover lift */
  .tt-row :global(.tt-card.is-soon) {
    cursor: default;
  }

  .tt-row :global(.tt-card.is-soon:hover) {
    transform: none;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.1);
  }

  .tt-row :global(.tt-card.is-soon .tt-img),
  .tt-row :global(.tt-card.is-soon .tt-art) {
    filter: saturate(0.7);
  }

  .tt-row :global(.tt-badge-free) {
    background: #ffffff;
    color: var(--green);
  }

  /* Bottom info strip */
  .tt-row :global(.tt-info) {
    position: absolute;
    inset: auto 0 0 0;
    padding: 28px 10px 9px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .tt-row :global(.tt-diff) {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 6px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  /* Responsive */
  @media (min-width: 2560px) {
    .section { padding: 28px 0 36px; }
    .tt-row { --pw: 260px; gap: 22px; }
    .tt-head { margin-bottom: 14px; }
  }

  @media (min-width: 3840px) {
    .tt-row { --pw: 360px; gap: 30px; }
  }

  @media (max-width: 768px) {
    .section {
      padding: 12px 0 16px;
    }
    .tt-row {
      --pw: 158px;
      gap: 10px;
    }
    .tt-nav {
      display: none;
    }
    .tt-row :global(.tt-rank) {
      -webkit-text-stroke-width: 1.5px;
    }
    .tt-row :global(.tt-card) {
      aspect-ratio: 3 / 5;
    }
    .tt-row :global(.tt-info) {
      font-size: 0.62rem;
      padding: 24px 8px 8px;
    }
  }

  @media (max-width: 480px) {
    .tt-row {
      --pw: 132px;
      gap: 8px;
    }
    .tt-row :global(.tt-card) {
      aspect-ratio: 3 / 5.2;
    }
    .tt-row :global(.tt-name) {
      font-size: 0.72rem;
      -webkit-line-clamp: 3;
    }
    .tt-row :global(.tt-info) {
      padding: 24px 7px 7px;
      font-size: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tt-row :global(.tt-card) {
      transition: none;
    }
  }
</style>
