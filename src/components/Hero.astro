---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posters = [
  { src: "/images/typing-beginner.png", alt: "Typing practice for beginners" },
  { src: "/images/osssc-typing.png", alt: "OSSSC typing test" },
  { src: "/images/osssc.png", alt: "OSSSC RI, ICDS, VAW, JA, ARI, Amin mock test 2026" },
];
---
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <div class="live-badge" aria-live="polite">
        <span class="pulse-dot"></span>
        <span id="live-count">3,241</span> students practising now
      </div>
      <h1>
        Ace your government exam<br/>
        <em>with timed tests &amp; instant ranks.</em>
      </h1>
      <p class="hero-sub">
        Free, timed mock tests for OSSSC, OPSC, SSC, Railway and more —
        with instant analysis and leaderboard ranking. Built for all aspirants.
      </p>
      <div class="hero-actions">
        <a href="/mocktest/tests" class="btn-hero-primary">Browse all tests →</a>
        <a href="/mocktest/osssc" class="btn-hero-ghost">OSSSC Tests</a>
      </div>
      <div class="hero-trust">
        <span>✓ 100% Free</span>
        <span>✓ 280+ Tests</span>
        <span>✓ Instant analysis</span>
        <span>✓ Odia + English</span>
      </div>
    </div>

    <div class="hero-stack" aria-hidden="true">
      {posters.map((p, i) => (
        <img
          class={`hero-poster hero-poster-${i}`}
          src={`${base}${p.src}`}
          alt={p.alt}
          loading={i === 2 ? "eager" : "lazy"}
          decoding="async"
          onerror="this.onerror=null;this.src='/mocktest' + (this.getAttribute('src') || '');"
        />
      ))}
    </div>
  </div>
</section>

<script>
  // Animate live student count slightly to feel real-time
  const el = document.getElementById('live-count');
  if (el) {
    setInterval(() => {
      const base = 3241;
      const delta = Math.floor(Math.random() * 20) - 9;
      const curr = parseInt(el.textContent?.replace(',', '') ?? '3241');
      const next = Math.max(3000, curr + delta);
      el.textContent = next.toLocaleString('en-IN');
    }, 4000);
  }
</script>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 56px 0 48px;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    align-items: center;
  }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-light);
    color: var(--brand-dark);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 20px;
    border: 1px solid var(--brand-mid);
  }
  .pulse-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--brand);
    flex-shrink: 0;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }
  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    color: var(--ink);
    margin-bottom: 18px;
  }
  h1 em {
    font-style: italic;
    color: var(--brand);
  }
  .hero-sub {
    font-size: 1.06rem;
    color: var(--ink-soft);
    max-width: 50ch;
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .btn-hero-primary {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: var(--brand);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    transition: background 0.15s, transform 0.1s;
  }
  .btn-hero-primary:hover { background: var(--brand-dark); transform: translateY(-1px); }
  .btn-hero-ghost {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface-2);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
    transition: border-color 0.15s;
  }
  .btn-hero-ghost:hover { border-color: var(--ink-soft); }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  /* ── FANNED POSTER STACK (similar to OssscHero) ── */
  .hero-stack {
    --w: clamp(150px, 15vw, 210px);
    position: relative;
    height: calc(var(--w) * 1.5 + 40px);
    display: grid;
    place-items: center;
  }

  .hero-poster {
    position: absolute;
    width: var(--w);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.22);
    transition: transform 0.35s ease;
  }

  .hero-poster-0 {
    transform: translateX(-62%) rotate(-10deg) scale(0.9);
  }

  .hero-poster-1 {
    transform: translateX(62%) rotate(10deg) scale(0.9);
  }

  .hero-poster-2 {
    z-index: 2;
    transform: translateY(-6px);
  }

  .hero-stack:hover .hero-poster-0 {
    transform: translateX(-72%) rotate(-13deg) scale(0.9);
  }

  .hero-stack:hover .hero-poster-1 {
    transform: translateX(72%) rotate(13deg) scale(0.9);
  }

  @media (min-width: 2560px) {
    .hero { padding: 80px 0 72px; }
    .hero-inner {
      grid-template-columns: 1fr 600px;
      gap: 80px;
    }
  }

  @media (min-width: 3840px) {
    .hero { padding: 120px 0 100px; }
    .hero-inner {
      grid-template-columns: 1fr 800px;
      gap: 120px;
    }
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-stack {
      --w: clamp(120px, 32vw, 170px);
      order: -1;
    }
    .live-badge { margin: 0 auto 20px; }
    .hero-sub { margin: 0 auto 28px; }
    .hero-actions, .hero-trust { justify-content: center; }
  }

  @media (max-width: 768px) {
    .hero { padding: 36px 0 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-poster {
      transition: none;
    }
  }
</style>
