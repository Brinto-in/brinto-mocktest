---
// No props needed for this static component yet
---
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <div class="live-badge" aria-live="polite">
        <span class="pulse-dot"></span>
        <span id="live-count">3,241</span> students practising now
      </div>
      <h1>
        Crack your govt exam<br/>
        <em>one mock test at a time.</em>
      </h1>
      <p class="hero-sub">
        Free, timed mock tests for OSSSC, OPSC, SSC, Railway and more —
        with instant analysis and leaderboard ranking. Built for Odisha aspirants.
      </p>
      <div class="hero-actions">
        <a href="/tests" class="btn-hero-primary">Browse all tests →</a>
        <a href="/tests/osssc" class="btn-hero-ghost">OSSSC Tests</a>
      </div>
      <div class="hero-trust">
        <span>✓ 100% Free</span>
        <span>✓ 280+ Tests</span>
        <span>✓ Instant analysis</span>
        <span>✓ Odia + English</span>
      </div>
    </div>

    <div class="hero-card-col">
      <div class="score-card" aria-hidden="true">
        <div class="sc-header">
          <span class="sc-exam">OSSSC RI Mock Test 3</span>
          <span class="sc-badge">Completed</span>
        </div>
        <div class="sc-score">
          <div class="sc-ring">
            <svg viewBox="0 0 80 80" width="80" height="80">
              <circle cx="40" cy="40" r="34" fill="none" stroke="var(--rule)" stroke-width="8"/>
              <circle cx="40" cy="40" r="34" fill="none" stroke="var(--brand)" stroke-width="8"
                stroke-dasharray="213.6" stroke-dashoffset="53.4"
                stroke-linecap="round" transform="rotate(-90 40 40)"/>
            </svg>
            <span class="sc-pct">75%</span>
          </div>
          <div class="sc-breakdown">
            <div class="sc-row">
              <span class="sc-label">Correct</span>
              <span class="sc-val correct">75</span>
            </div>
            <div class="sc-row">
              <span class="sc-label">Wrong</span>
              <span class="sc-val wrong">15</span>
            </div>
            <div class="sc-row">
              <span class="sc-label">Skipped</span>
              <span class="sc-val">10</span>
            </div>
          </div>
        </div>
        <div class="sc-rank">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
          Your rank <strong>#347</strong> out of 12,480 students
        </div>
        <div class="sc-sections">
          <div class="ss-item">
            <span>GK</span>
            <div class="ss-bar"><div class="ss-fill" style="width:82%"></div></div>
            <span class="ss-pct">82%</span>
          </div>
          <div class="ss-item">
            <span>Reasoning</span>
            <div class="ss-bar"><div class="ss-fill" style="width:68%"></div></div>
            <span class="ss-pct">68%</span>
          </div>
          <div class="ss-item">
            <span>Maths</span>
            <div class="ss-bar"><div class="ss-fill" style="width:71%"></div></div>
            <span class="ss-pct">71%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Animate live student count slightly to feel real-time
  const el = document.getElementById('live-count');
  if (el) {
    setInterval(() => {
      const base = 3241;
      const delta = Math.floor(Math.random() * 20) - 9;
      const curr = parseInt(el.textContent?.replace(',', '') ?? '3241');
      const next = Math.max(3000, curr + delta);
      el.textContent = next.toLocaleString('en-IN');
    }, 4000);
  }
</script>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding: 72px 0 64px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    align-items: center;
  }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-light);
    color: var(--brand-dark);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 20px;
    border: 1px solid var(--brand-mid);
  }
  .pulse-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--brand);
    flex-shrink: 0;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }
  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    color: var(--ink);
    margin-bottom: 18px;
  }
  h1 em {
    font-style: italic;
    color: var(--brand);
  }
  .hero-sub {
    font-size: 1.06rem;
    color: var(--ink-soft);
    max-width: 50ch;
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .btn-hero-primary {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    background: var(--brand);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    transition: background 0.15s, transform 0.1s;
  }
  .btn-hero-primary:hover { background: var(--brand-dark); transform: translateY(-1px); }
  .btn-hero-ghost {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--surface-2);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule);
    transition: border-color 0.15s;
  }
  .btn-hero-ghost:hover { border-color: var(--ink-soft); }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  /* ── SCORE CARD (hero visual) ── */
  .hero-card-col { display: flex; justify-content: center; }
  .score-card {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 24px;
    width: 100%;
    max-width: 380px;
    box-shadow: 0 20px 48px rgba(26,20,16,0.1);
  }
  .sc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .sc-exam { font-weight: 600; font-size: 0.9rem; color: var(--ink); }
  .sc-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--green);
    background: var(--green-light);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }
  .sc-score {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 16px;
  }
  .sc-ring { position: relative; flex-shrink: 0; }
  .sc-pct {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--brand);
  }
  .sc-breakdown { display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .sc-row { display: flex; justify-content: space-between; font-size: 0.85rem; }
  .sc-label { color: var(--ink-soft); }
  .sc-val { font-weight: 700; }
  .sc-val.correct { color: var(--green); }
  .sc-val.wrong { color: var(--brand); }
  .sc-rank {
    background: var(--brand-light);
    color: var(--brand-dark);
    font-size: 0.82rem;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
  }
  .sc-sections { display: flex; flex-direction: column; gap: 10px; }
  .ss-item {
    display: grid;
    grid-template-columns: 76px 1fr 36px;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .ss-bar {
    height: 6px;
    background: var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }
  .ss-fill {
    height: 100%;
    background: var(--brand);
    border-radius: 3px;
  }
  .ss-pct { font-weight: 600; color: var(--ink); text-align: right; }
</style>