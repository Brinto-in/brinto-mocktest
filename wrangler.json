{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brinto-mocktest",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat_v2"
  ],
  "routes": [
    {
      "pattern": "www.brinto.in/mocktest*",
      "custom_domain": false
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
